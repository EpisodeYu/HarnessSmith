@echo off
REM One-click launcher for {{ display_name }} - generated by HarnessSmith.
REM Prefers uv (auto-syncs deps); offers to install uv if it's missing.
REM {% if interfaces.web %}Starts the web UI and opens it in your browser.{% else %}Starts an interactive chat in this window.{% endif %}
echo [{{ project_slug }}] One-click launcher (generated by HarnessSmith)
cd /d "%~dp0"
echo [{{ project_slug }}] Folder: %CD%
set "ACTION={% if interfaces.web %}serve --open{% else %}chat{% endif %}"
echo [{{ project_slug }}] Action: %ACTION%
echo.
REM --- Reuse the system proxy (corporate networks) so uv sync + npx can reach the
REM net. Only when none is already set; npx/npm don't read the Windows proxy on
REM their own, so we hand it to the whole session via HTTP(S)_PROXY.
if defined HTTP_PROXY goto :hf_proxy_done
if defined HTTPS_PROXY goto :hf_proxy_done
for /f "usebackq delims=" %%p in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' -ErrorAction SilentlyContinue; if ($s.ProxyEnable -eq 1 -and $s.ProxyServer) { $p=[string]$s.ProxyServer; if ($p -match 'https?=([^;]+)') { $p=$matches[1] }; if ($p -notmatch '://') { $p='http://'+$p }; $p }"`) do set "HTTP_PROXY=%%p"
if not defined HTTP_PROXY goto :hf_proxy_done
set "HTTPS_PROXY=%HTTP_PROXY%"
echo [{{ project_slug }}] Using system proxy: %HTTP_PROXY%
echo.
:hf_proxy_done
{% if spec.mcp.enabled and mcp_needs_node %}
REM --- Node.js for the Node-based MCP server (e.g. desktop-commander via npx) ---
REM Windows rarely has Node; offer a user-local portable Node (no admin, not bundled
REM in the repo) and put it on PATH for this session so the product's npx works.
where node >nul 2>nul && where npx >nul 2>nul && goto :hf_node_ok
set "HF_NODE_DIR=%LOCALAPPDATA%\{{ project_slug }}\node-{{ node_version }}-win-x64"
if exist "%HF_NODE_DIR%\node.exe" (
    set "PATH=%HF_NODE_DIR%;%PATH%"
    goto :hf_node_ok
)
echo [{{ project_slug }}] A Node-based MCP tool (desktop-commander) needs Node.js, which isn't installed.
echo   Install a portable Node into your user folder? No admin; it only affects this app.
echo     [1] Standard - download Node from nodejs.org
echo     [2] China mirror - download Node from npmmirror.com
echo     [n] Skip (that tool stays off; everything else still works)
set "NCHOICE=1"
set /p "NCHOICE=  Choose [1/2/n]: "
if /i "%NCHOICE%"=="n" goto :hf_node_ok
set "HF_NODE_BASE=https://nodejs.org/dist"
if "%NCHOICE%"=="2" set "HF_NODE_BASE=https://npmmirror.com/mirrors/node"
echo [{{ project_slug }}] Downloading Node {{ node_version }} win-x64 (one-time setup) ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $u='%HF_NODE_BASE%/{{ node_version }}/node-{{ node_version }}-win-x64.zip'; $z=Join-Path $env:TEMP 'hf-node.zip'; $d=Join-Path $env:LOCALAPPDATA '{{ project_slug }}'; Invoke-WebRequest -Uri $u -OutFile $z; New-Item -ItemType Directory -Force -Path $d | Out-Null; Expand-Archive -Path $z -DestinationPath $d -Force; Remove-Item $z"
if exist "%HF_NODE_DIR%\node.exe" (
    set "PATH=%HF_NODE_DIR%;%PATH%"
    echo [{{ project_slug }}] Node is ready.
) else (
    echo [{{ project_slug }}] Node setup failed - desktop-commander stays off. Install Node from https://nodejs.org and re-run.
)
:hf_node_ok
echo.
{% endif %}
echo [{{ project_slug }}] Step 1/4: looking for uv on PATH ...
where uv >nul 2>nul
if not errorlevel 1 goto :run

echo [{{ project_slug }}] Step 2/4: checking known uv install locations ...
if exist "%USERPROFILE%\.local\bin\uv.exe" set "PATH=%USERPROFILE%\.local\bin;%PATH%"
if exist "%LOCALAPPDATA%\Microsoft\WinGet\Links\uv.exe" set "PATH=%LOCALAPPDATA%\Microsoft\WinGet\Links;%PATH%"
where uv >nul 2>nul
if not errorlevel 1 goto :run

REM Look for the installed console script by its .exe name on purpose: a bare
REM `{{ project_slug }}` could resolve to THIS file ({{ project_slug }}.bat) first,
REM since Windows searches the current dir and is case-insensitive -> relaunch loop.
echo [{{ project_slug }}] Step 3/4: looking for an installed {{ project_slug }} command ...
where {{ project_slug }}.exe >nul 2>nul
if not errorlevel 1 goto :run_cmd

echo [{{ project_slug }}] Step 4/4: uv is not installed yet.
echo.
echo   This app needs uv - a small tool that manages Python and dependencies for
echo   you (user-level install, no admin required). How would you like to install it?
echo     [1] Standard - official installer (downloads uv from GitHub)
echo     [2] China mirror - pip + Tsinghua mirror (needs Python already installed)
echo     [n] Don't install
set "CHOICE=1"
set /p "CHOICE=  Choose [1/2/n]: "
if /i "%CHOICE%"=="n" goto :manual
if "%CHOICE%"=="2" goto :install_cn

REM Use the official installer directly (NOT winget): winget first updates its
REM own source CDN, which hangs for a long time and fails on some networks (e.g.
REM behind the GFW) even when the GitHub download itself works fine.
echo [{{ project_slug }}] Installing uv via the official installer ...
powershell -ExecutionPolicy Bypass -NoProfile -Command "irm https://astral.sh/uv/install.ps1 | iex"
if exist "%USERPROFILE%\.local\bin\uv.exe" set "PATH=%USERPROFILE%\.local\bin;%PATH%"
where uv >nul 2>nul
if not errorlevel 1 goto :run
goto :manual

:install_cn
echo [{{ project_slug }}] China mirror: installing uv from the Tsinghua PyPI mirror ...
set "PY="
where py >nul 2>nul && set "PY=py -3"
if not defined PY (
    where python >nul 2>nul && set "PY=python"
)
if not defined PY (
    echo [{{ project_slug }}] No Python found - the China-mirror path needs Python first.
    goto :manual_cn
)
%PY% -m pip install --user uv -i https://pypi.tuna.tsinghua.edu.cn/simple
%PY% -m uv --version >nul 2>nul
if errorlevel 1 (
    echo [{{ project_slug }}] pip did not produce a runnable uv.
    goto :manual_cn
)
echo [{{ project_slug }}] uv installed. Using the Tsinghua mirror + your system Python.
set "UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple"
set "UV_PYTHON_PREFERENCE=only-system"
goto :run_py

:manual
echo.
echo [{{ project_slug }}] Could not find or install uv. Install it manually (user-level, no admin):
echo     winget install astral-sh.uv
echo     - or -  powershell -c "irm https://astral.sh/uv/install.ps1 ^| iex"
echo   then double-click this again.
echo.
pause
goto :eof

:manual_cn
echo.
echo [{{ project_slug }}] The China-mirror path needs Python. Options:
echo     1) Install Python (https://www.python.org/downloads/ , reachable in China),
echo        then run this again and choose [2].
echo     2) Or with Python present:  pip install uv -i https://pypi.tuna.tsinghua.edu.cn/simple
echo     3) Or use a VPN/proxy and choose [1].
echo.
pause
goto :eof

:run
REM Auto-pick the package index: when no index is pinned and the official PyPI is
REM unreachable (e.g. behind the GFW), use the Tsinghua mirror for this run so the
REM first `uv sync` can still fetch deps. An explicit UV_DEFAULT_INDEX always wins;
REM we only probe when curl is present (ships with Windows 10 1803+).
if defined UV_DEFAULT_INDEX goto :run_go
where curl >nul 2>nul
if errorlevel 1 goto :run_go
echo [{{ project_slug }}] Checking whether PyPI is reachable ...
curl -sS -m 3 -I https://pypi.org/simple/ >nul 2>nul
if not errorlevel 1 goto :run_go
echo [{{ project_slug }}] PyPI looks unreachable - using the Tsinghua mirror this run.
set "UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple"
:run_go
echo [{{ project_slug }}] Launching: uv run {{ project_slug }} %ACTION%
echo.
uv run {{ project_slug }} %ACTION%
echo.
echo [{{ project_slug }}] Process exited (code %errorlevel%). Press a key to close.
pause >nul
goto :eof

:run_cmd
echo [{{ project_slug }}] Launching: {{ project_slug }}.exe %ACTION%
echo.
{{ project_slug }}.exe %ACTION%
echo.
echo [{{ project_slug }}] Process exited (code %errorlevel%). Press a key to close.
pause >nul
goto :eof

:run_py
echo [{{ project_slug }}] Launching: %PY% -m uv run {{ project_slug }} %ACTION%
echo.
%PY% -m uv run {{ project_slug }} %ACTION%
echo.
echo [{{ project_slug }}] Process exited (code %errorlevel%). Press a key to close.
pause >nul
goto :eof
