[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "Agent harness generated by HarnessSmith — you own this code."
readme = "README.md"
requires-python = ">=3.11"
license = { text = "MIT" }
# No agent-framework lock-in: this project has ZERO dependency on any
# agent-orchestration framework. The loop is yours. Everything below is an
# ordinary, general-purpose library.
dependencies = [
    "openai>=1.40",
    "pydantic>=2.6",
    "pydantic-settings>=2.2",
    "pyyaml>=6.0",
    "typer>=0.12",
{% if interfaces.web %}    # Web interface (interfaces.web): FastAPI + uvicorn. General-purpose web
    # libraries, NOT an agent framework. Absent entirely when web is disabled.
    "fastapi>=0.110",
    "uvicorn>=0.29",
    # ruamel.yaml: comment-preserving YAML round-trip so the /config panel can
    # write edits back to config.yaml WITHOUT losing your comments (plain PyYAML
    # would strip them). Only the web panel needs it; absent when web is disabled.
    "ruamel.yaml>=0.18",
{% endif %}{% if spec.mcp.enabled %}    # MCP tools (mcp.enabled): the official Model Context Protocol SDK — a
    # protocol client, NOT an agent framework. Absent when MCP is disabled.
    "mcp>=1.16,<2",
{% endif %}    # Native Anthropic Messages (llms[].provider: anthropic): the official
    # Anthropic SDK — an API client, NOT an agent framework. Ships in every
    # product so a profile can switch provider at runtime (config.yaml / panel).
    "anthropic>=0.92",
]

# Test dependencies, installed by `uv sync` (uv-native dependency group). They
# are NOT runtime deps and never ship to production.
[dependency-groups]
dev = ["pytest>=8.0"{% if interfaces.web %}, "httpx>=0.27"{% endif %}]

[project.scripts]
{{ project_slug }} = "{{ project_slug }}.interfaces.cli:app"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_slug }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
