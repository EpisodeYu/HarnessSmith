def test_missing_launcher_is_not_retried(monkeypatch):
    """A missing launcher (no Node/uv → FileNotFoundError, possibly wrapped in a
    TaskGroup) goes red at once — retrying can't conjure the binary."""
    monkeypatch.setattr(mcp_module.McpManager, "_BACKOFF_BASE", 0.02)
    monkeypatch.setattr(mcp_module.McpManager, "_BACKOFF_CAP", 0.02)
    attempts = {"n": 0}

    async def fake_prefetch(self, server, errlog):
        return None

    async def missing(self, stack, server, errlog=None):
        attempts["n"] += 1
        raise BaseExceptionGroup("unhandled errors in a TaskGroup", [FileNotFoundError("npx")])

    monkeypatch.setattr(mcp_module.McpManager, "_prefetch", fake_prefetch)
    monkeypatch.setattr(mcp_module.McpManager, "_connect", missing)
    mgr = mcp_module.McpManager(_dummy_cfg(connect_max_retries=5))  # retries available …
    mgr.start()
    try:
        assert _wait_until(lambda: mgr.errors.get("dummy") is not None)
        time.sleep(0.2)
        assert attempts["n"] == 1  # … but a missing launcher isn't retried
    finally:
        mgr.close()


def test_auto_heal_respects_total_deadline(monkeypatch):
    """Auto-heal stops at the total heal budget even with retries left — so a server
    that hangs/fails every attempt can't churn forever."""
    monkeypatch.setattr(mcp_module.McpManager, "_BACKOFF_BASE", 0.02)
    monkeypatch.setattr(mcp_module.McpManager, "_BACKOFF_CAP", 0.02)
    monkeypatch.setattr(mcp_module.McpManager, "_HEAL_DEADLINE_SECONDS", 0.01)
    attempts = {"n": 0}

    async def fake_prefetch(self, server, errlog):
        return None

    async def keep_failing(self, stack, server, errlog=None):
        attempts["n"] += 1
        raise RuntimeError("boom")

    monkeypatch.setattr(mcp_module.McpManager, "_prefetch", fake_prefetch)
    monkeypatch.setattr(mcp_module.McpManager, "_connect", keep_failing)
    mgr = mcp_module.McpManager(_dummy_cfg(connect_max_retries=100))  # deadline, not count, stops it
    mgr.start()
    try:
        assert _wait_until(lambda: mgr.errors.get("dummy") is not None)
        time.sleep(0.2)
        assert attempts["n"] < 100  # bounded by the deadline, not the retry count
    finally:
        mgr.close()


def test_connect_error_explains_unreachable_and_cold_start(monkeypatch):
    """A stdio npx connect failure becomes a readable message: unreachable-registry
    advice when no source resolved, else a cold-download / `mcp warm` hint."""
    _clear_net_env(monkeypatch)
    server = McpServerConfig(name="dc", command="npx", args=["-y", "pkg"])
    group = BaseExceptionGroup(
        "unhandled errors in a TaskGroup (1 sub-exception)", [TimeoutError("TimeoutError")]
    )
    unreachable = mcp_module._connect_error(server, group, {})
    assert "couldn't reach an npm registry" in unreachable

    warm_hint = mcp_module._connect_error(
        server, group, {"npm_config_registry": mcp_module._NPM_OFFICIAL}
    )
    assert "mcp warm" in warm_hint
