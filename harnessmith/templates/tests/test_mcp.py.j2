def test_warm_argv_builds_npm_install_and_uvx_fetch():
    """An npx server warms via `npm install` into its STABLE per-server prefix (the
    launch is then a direct `node <bin>`, never the ephemeral npx cache); a uvx
    server resolves its env via a no-op python; other launchers have nothing."""
    import os

    npx = McpServerConfig(name="dc", command="npx", args=["-y", "@scope/pkg@latest"])
    prefix = os.path.join(".harness", "mcp-node", "dc")
    assert mcp_module._warm_argv(npx) == (
        "npm",
        ["install", "--prefix", prefix, "@scope/pkg@latest",
         "--no-save", "--no-fund", "--no-audit", "--loglevel", "error"],
    )
    uvx = McpServerConfig(name="g", command="uvx", args=["mcp-server-git", "--repository", "."])
    assert mcp_module._warm_argv(uvx) == ("uvx", ["--from", "mcp-server-git", "python", "-c", ""])
    assert mcp_module._warm_argv(McpServerConfig(name="x", command="mytool")) is None


def _fake_node_install(tmp_path, name, pkg_dir_name, *, version="1.0.0", bin_field):
    """Create a fake `npm install`ed package under .harness/mcp-node/<name> so the
    node-launch helpers resolve against a real package.json (no real npm)."""
    pkg_dir = tmp_path / ".harness" / "mcp-node" / name / "node_modules"
    for part in pkg_dir_name.split("/"):
        pkg_dir = pkg_dir / part
    pkg_dir.mkdir(parents=True, exist_ok=True)
    (pkg_dir / "package.json").write_text(
        json.dumps({"name": pkg_dir_name, "version": version, "bin": bin_field}),
        encoding="utf-8",
    )
    return pkg_dir


def test_node_bin_resolves_from_string_and_map(tmp_path, monkeypatch):
    """`_node_bin_path` reads the installed package.json `bin`: a string directly,
    or the entry whose key matches the package name in a bin MAP (e.g. Desktop
    Commander's {desktop-commander, setup, remove})."""
    monkeypatch.chdir(tmp_path)
    _fake_node_install(tmp_path, "web", "open-websearch", version="2.1.11",
                       bin_field={"open-websearch": "build/index.js"})
    web = McpServerConfig(name="web", command="npx", args=["-y", "open-websearch@2.1.11"])
    assert mcp_module._node_bin_path(web).endswith(
