def test_reconnect_server_restarts_one_in_place():
    """reconnect_server() restarts ONE server's session without touching the others;
    both stay discoverable and callable afterwards."""
    mgr = McpManager(
        McpConfig(
            servers=[
                McpServerConfig(name="a", command=sys.executable, args=[DUMMY]),
                McpServerConfig(name="b", command=sys.executable, args=[DUMMY]),
            ]
        )
    )
    mgr.start()
    try:
        mgr.reconnect_server("a")  # restart only 'a'
        mgr.wait_server_ready("a", timeout=30)
        assert "a" in mgr.discovered and "b" in mgr.discovered, mgr.errors
        registry = Registry()
        register_mcp_tools(
            _config([{"name": "a__echo", "enabled": True}, {"name": "b__add", "enabled": True}]),
            mgr,
            registry,
        )
        assert "hi" in registry.call("a__echo", json.dumps({"text": "hi"}))
        assert "5" in registry.call("b__add", json.dumps({"a": 2, "b": 3}))
    finally:
        mgr.close()


def test_begin_is_non_blocking_then_wait_ready():
    """begin() returns immediately (connect runs on the bg thread); wait_ready()
    blocks until the first round settles — the split that lets the UI show amber."""
    mgr = McpManager(
        McpConfig(servers=[McpServerConfig(name="dummy", command=sys.executable, args=[DUMMY])])
    )
    try:
        mgr.begin()  # must not raise / not block on connect
        mgr.wait_ready(timeout=30)
        assert "dummy" in mgr.discovered, mgr.errors
    finally:
        mgr.close()


def test_format_exception_surfaces_taskgroup_leaves():
    """_format_exception drills an ExceptionGroup (the SDK's 'unhandled errors in a
    TaskGroup' wrapper) down to its actionable leaf message(s)."""
    leaf = FileNotFoundError(2, "No such file or directory")
    group = BaseExceptionGroup("unhandled errors in a TaskGroup (1 sub-exception)", [leaf])
    msg = _format_exception(group)
    assert "FileNotFoundError" in msg and "No such file" in msg


def _clear_net_env(monkeypatch):
    """Forget any registry/proxy env so resolution starts from a clean slate."""
    for name in (
        "UV_DEFAULT_INDEX", "UV_INDEX", "npm_config_registry", "NPM_CONFIG_REGISTRY",
        "HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy",
    ):
        monkeypatch.delenv(name, raising=False)
    monkeypatch.setattr("urllib.request.getproxies", lambda: {})  # no system proxy leaks in


def _fake_probe(reachable):
    """A `_url_ok` stand-in: only the listed ``(url, proxy)`` pairs respond."""
    def probe(url, proxy=None, timeout=3.0):
        return (url, proxy) in reachable
    return probe


def test_discover_proxy_prefers_config_then_system(monkeypatch):
    """`_discover_proxy` uses an explicit `mcp.proxy`, else the system proxy."""
    assert mcp_module._discover_proxy(McpConfig(proxy="http://cfg:1")) == "http://cfg:1"
    monkeypatch.setattr("urllib.request.getproxies", lambda: {"https": "http://sys:2"})
    assert mcp_module._discover_proxy(McpConfig()) == "http://sys:2"
    monkeypatch.setattr("urllib.request.getproxies", lambda: {})
    assert mcp_module._discover_proxy(McpConfig()) is None


def test_stdio_net_env_picks_official_direct_for_foreign_users(monkeypatch):
    """Direct internet: the official registry/index responds, so it is chosen with
    no proxy injected."""
    _clear_net_env(monkeypatch)
    monkeypatch.setattr(
        mcp_module, "_url_ok",
        _fake_probe({(mcp_module._NPM_OFFICIAL, None), (mcp_module._PYPI_OFFICIAL, None)}),
    )
    servers = [
        McpServerConfig(name="n", command="npx", args=["-y", "pkg"]),
        McpServerConfig(name="u", command="uvx", args=["pkg"]),
    ]
    out = mcp_module._stdio_net_env(servers, McpConfig(servers=servers))
    assert out["npm_config_registry"] == mcp_module._NPM_OFFICIAL
    assert out["UV_DEFAULT_INDEX"] == mcp_module._PYPI_OFFICIAL
    assert "HTTP_PROXY" not in out


