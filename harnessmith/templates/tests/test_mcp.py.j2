def test_sync_mcp_tools_resyncs_registry(manager):
    """sync_mcp_tools keeps the registry in lock-step with the allowlist: it drops
    every prior MCP entry, then re-registers the currently-allowlisted ones."""
    from {{ project_slug }}.harness.mcp import sync_mcp_tools

    registry = Registry()
    sync_mcp_tools(_config([{"name": "dummy__echo", "enabled": True}]), manager, registry)
    assert registry.get("dummy__echo")
    with pytest.raises(ToolError):
        registry.get("dummy__add")
    # Enable add too -> resync registers it (without dropping echo).
    sync_mcp_tools(
        _config([{"name": "dummy__echo", "enabled": True}, {"name": "dummy__add", "enabled": True}]),
        manager,
        registry,
    )
    assert registry.get("dummy__echo") and registry.get("dummy__add")
    # Disable echo -> resync removes it.
    sync_mcp_tools(_config([{"name": "dummy__add", "enabled": True}]), manager, registry)
    with pytest.raises(ToolError):
        registry.get("dummy__echo")


def test_connects_multiple_servers_concurrently():
    """Each server gets its own task and connects in parallel; all are discovered.

    Exercises the per-server-task lifecycle (>1 server) the concurrent connect path
    relies on — both sessions are usable and tear down cleanly on close().
    """
    mgr = McpManager(
        McpConfig(
            servers=[
                McpServerConfig(name="a", command=sys.executable, args=[DUMMY]),
                McpServerConfig(name="b", command=sys.executable, args=[DUMMY]),
            ]
        )
    )
    mgr.start()
    try:
        assert "a" in mgr.discovered and "b" in mgr.discovered, mgr.errors
        registry = Registry()
        register_mcp_tools(
            _config([{"name": "a__echo", "enabled": True}, {"name": "b__add", "enabled": True}]),
            mgr,
            registry,
        )
        assert "hi" in registry.call("a__echo", json.dumps({"text": "hi"}))
        assert "5" in registry.call("b__add", json.dumps({"a": 2, "b": 3}))
    finally:
        mgr.close()


def test_server_contexts_enter_and_exit_in_same_task(monkeypatch):
    """Regression: keep MCP session setup, calls, and teardown in one server task.

    `wait_for` runs the wrapped coroutine in a child Task; anyio cancel scopes used
    by MCP transports then enter in that child and exit in the server owner task,
    raising "Attempted to exit cancel scope in a different task..." on first use.
    Calling a ClientSession from a separate dispatcher task is also unsafe; the
    server task must own both the session lifecycle and its tool calls.
    """
    import asyncio
    import mcp

    import {{ project_slug }}.harness.mcp as mcp_bridge

    class SameTaskContext:
        async def __aenter__(self):
            self.task = asyncio.current_task()
            return ("read", "write")

        async def __aexit__(self, exc_type, exc, tb):
            assert asyncio.current_task() is self.task

    class FakeSession(SameTaskContext):
        def __init__(self, read, write):
            pass

        async def __aenter__(self):
            self.task = asyncio.current_task()
            return self

        async def initialize(self):
            return None

        async def list_tools(self):
            return SimpleNamespace(tools=[SimpleNamespace(name="echo", description="", inputSchema={})])

        async def call_tool(self, name, arguments):
            assert asyncio.current_task() is self.task
            return SimpleNamespace(
                content=[SimpleNamespace(text=f"{name}:{arguments.get('text', '')}")],
                isError=False,
            )

    monkeypatch.setattr(mcp_bridge, "_open_streams", lambda server, *a, **k: SameTaskContext())
    monkeypatch.setattr(mcp, "ClientSession", FakeSession)

    mgr = McpManager(McpConfig(servers=[McpServerConfig(name="fake", command=sys.executable)]))
    mgr.start()
    try:
        assert "fake" in mgr.discovered, mgr.errors
        registry = Registry()
        register_mcp_tools(_config([{"name": "fake__echo", "enabled": True}]), mgr, registry)
        assert registry.call("fake__echo", json.dumps({"text": "ok"})) == "echo:ok"
    finally:
        mgr.close()


