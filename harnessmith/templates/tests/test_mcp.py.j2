def test_server_requires_exactly_one_transport():
    with pytest.raises(Exception):
        McpServerConfig(name="bad")  # neither command nor url
    with pytest.raises(Exception):
        McpServerConfig(name="bad", command="x", url="https://y")  # both


def test_transport_field_selects_kind_and_validates():
    """`transport` (stdio/http/sse) is inferred from shape when unset, explicit
    otherwise — `sse` is the legacy transport for older remote servers."""
    assert McpServerConfig(name="s", command="x").kind == "stdio"
    assert McpServerConfig(name="r", url="https://x/mcp").kind == "http"
    assert McpServerConfig(name="r", url="https://x/sse", transport="sse").kind == "sse"
    assert McpServerConfig(name="r", url="https://x/mcp", transport="http").kind == "http"
    with pytest.raises(Exception):  # transport must match the shape
        McpServerConfig(name="bad", url="https://x", transport="stdio")
    with pytest.raises(Exception):
        McpServerConfig(name="bad", command="x", transport="http")


