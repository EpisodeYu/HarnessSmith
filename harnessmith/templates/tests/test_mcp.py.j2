def test_stdio_net_env_uses_proxy_when_direct_is_blocked(monkeypatch):
    """Corporate network: direct is blocked but the official registry responds via
    the proxy, so the proxy is injected (as HTTP(S)_PROXY + npm_config_proxy)."""
    _clear_net_env(monkeypatch)
    proxy = "http://corp:8080"
    monkeypatch.setattr(
        mcp_module, "_url_ok",
        _fake_probe({(mcp_module._NPM_OFFICIAL, proxy), (mcp_module._PYPI_OFFICIAL, proxy)}),
    )
    servers = [
        McpServerConfig(name="n", command="npx", args=["-y", "pkg"]),
        McpServerConfig(name="u", command="uvx", args=["pkg"]),
    ]
    out = mcp_module._stdio_net_env(servers, McpConfig(servers=servers, proxy=proxy))
    assert out["npm_config_registry"] == mcp_module._NPM_OFFICIAL
    assert out["HTTP_PROXY"] == proxy and out["HTTPS_PROXY"] == proxy
    assert out["npm_config_proxy"] == proxy and out["npm_config_https-proxy"] == proxy


