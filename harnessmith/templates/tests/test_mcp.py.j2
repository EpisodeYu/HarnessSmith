    assert registered == []


def test_safe_tools_grade_risk_and_read_only_paradigms_see_them(manager):
    """`safe_tools` marks read-only tools as risk=safe; everything else is high.

    Read-only paradigms (plan/ask) call active_names(allow_high_risk=False), so a
    high-risk MCP tool is dropped while a safe one is still offered.
    """
    registry = Registry()
    config = _config(
        [
            {"name": "dummy__echo", "enabled": True},
            {"name": "dummy__add", "enabled": True},
        ],
        servers=[
            {"name": "dummy", "command": sys.executable, "args": [DUMMY], "safe_tools": ["echo"]}
        ],
    )
    register_mcp_tools(config, manager, registry)

    assert registry.get("dummy__echo").risk == SAFE
    assert registry.get("dummy__add").risk == HIGH

    enabled = config.enabled_tool_names()
    read_only = registry.active_names(enabled, allow_high_risk=False)
    assert "dummy__echo" in read_only
    assert "dummy__add" not in read_only


def test_environment_note_surfaces_disabled_capabilities():
    """The system prompt names the host OS and any installed-but-disabled server,
    so a turned-off capability (e.g. shell/file write) is never silently missing."""
    config = Config.model_validate(
        {
            "llms": [{"name": "default", "model": "m"}],
            "roles": {"generation": "default"},
            "prompts": {"system": "You are a test agent."},
            "tools": [
                {"name": "git__git_status", "enabled": True},  # git is active
                {"name": "shellbox__run", "enabled": False},  # shellbox stays dormant
            ],
            "observability": {"trace": False},
            "mcp": {
                "servers": [
                    {"name": "git", "command": "uvx", "args": ["mcp-server-git"], "safe_tools": ["git_status"]},
