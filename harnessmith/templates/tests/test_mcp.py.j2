def test_windows_wraps_cmd_shim_for_stdio(monkeypatch):
    """On Windows, .cmd/.bat shims (npx) are launched via `cmd.exe /d /c`; .exe is direct.

    Windows CreateProcess cannot exec a .cmd batch shim, so a bare `npx` fails with
    WinError 2 — wrapping it in `cmd.exe /d /c` is what makes it spawn.
    """
    import shutil

    from {{ project_slug }}.harness.mcp import _windows_stdio_command

    monkeypatch.setattr(sys, "platform", "win32")
    monkeypatch.setenv("COMSPEC", r"C:\Windows\System32\cmd.exe")
    monkeypatch.setattr(
        shutil,
        "which",
        lambda c: r"C:\Program Files\nodejs\npx.cmd" if c == "npx" else r"C:\uv\uvx.exe",
    )

    assert _windows_stdio_command("npx", ["-y", "pkg"]) == (
        r"C:\Windows\System32\cmd.exe",
        ["/d", "/c", r"C:\Program Files\nodejs\npx.cmd", "-y", "pkg"],
    )
    assert _windows_stdio_command("uvx", ["pkg"]) == ("uvx", ["pkg"])


