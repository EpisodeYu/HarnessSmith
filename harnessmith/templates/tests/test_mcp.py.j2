DUMMY = str(Path(__file__).parent / "_mcp_dummy_server.py")


def _config(tools, servers=None):
    data = {
        "llms": [{"name": "default", "model": "m"}],
        "roles": {"generation": "default"},
        "tools": tools,
        "observability": {"trace": False},
    }
    if servers is not None:
        data["mcp"] = {"servers": servers}
    return Config.model_validate(data)


@pytest.fixture
def manager():
    mgr = McpManager(
        McpConfig(servers=[McpServerConfig(name="dummy", command=sys.executable, args=[DUMMY])])
    )
    mgr.start()
    yield mgr
    mgr.close()


def test_call_timeout_fails_one_call_not_the_server():
    """A tool call that exceeds ``mcp.call_timeout_seconds`` fails with a
    TimeoutError naming the knob — the loop sees an ERROR observation instead of
    hanging the turn forever (Stop works again at the next boundary). The server
    session survives and keeps serving later calls."""
    mgr = McpManager(
        McpConfig(
            servers=[McpServerConfig(name="dummy", command=sys.executable, args=[DUMMY])],
            call_timeout_seconds=1.0,
        )
    )
    mgr.start()
    try:
        assert "dummy" in mgr.discovered, mgr.errors
        started = time.monotonic()
        with pytest.raises(TimeoutError, match="call_timeout_seconds"):
            mgr.call("dummy", "nap", {"seconds": 2.5})
        assert time.monotonic() - started < 10  # returned at the timeout, not after the nap
        time.sleep(2.0)  # let the abandoned nap drain server-side either way
        assert "hi" in mgr.call("dummy", "echo", {"text": "hi"})
    finally:
        mgr.close()


def test_stdio_discovers_and_calls_tool(manager):
    assert "dummy" in manager.discovered, manager.errors
    names = {tool.name for tool in manager.discovered["dummy"]}
    assert {"echo", "add"} <= names

    registry = Registry()
    registered = register_mcp_tools(_config([{"name": "dummy__echo", "enabled": True}]), manager, registry)

    assert registered == ["dummy__echo"]
    assert registry.get("dummy__echo").risk == HIGH  # MCP tools default to high-risk
    assert "hello" in registry.call("dummy__echo", json.dumps({"text": "hello"}))


def test_wildcard_enables_all_server_tools(manager):
    """A `<server>__*` allowlist entry enables every discovered tool of that server
    (no per-tool listing), and risk grading still follows `safe_tools`."""
    registry = Registry()
    config = _config(
        [{"name": "dummy__*", "enabled": True}],
        servers=[{"name": "dummy", "command": sys.executable, "args": [DUMMY], "safe_tools": ["echo"]}],
    )
    registered = register_mcp_tools(config, manager, registry)

    assert set(registered) == {"dummy__echo", "dummy__add", "dummy__nap"}  # whole toolset on
    assert registry.get("dummy__echo").risk == SAFE  # safe_tools still grades risk
    assert registry.get("dummy__add").risk == HIGH

    # The wildcard also gates active_names (what the model is offered).
    enabled = config.enabled_tool_names()
    assert set(registry.active_names(enabled)) == {"dummy__echo", "dummy__add", "dummy__nap"}
    # Read-only paradigms still drop the high-risk tool, keep the safe one.
    read_only = registry.active_names(enabled, allow_high_risk=False)
    assert read_only == ["dummy__echo"]


def test_disabled_wildcard_enables_nothing(manager):
    """`<server>__*` with `enabled: false` is a no-op (no tool registered)."""
    registry = Registry()
    registered = register_mcp_tools(_config([{"name": "dummy__*", "enabled": False}]), manager, registry)
    assert registered == []


def test_non_allowlisted_tool_is_not_registered(manager):
