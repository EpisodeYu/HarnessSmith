def test_chat_run_and_session_precede_title_generation(monkeypatch):
    """run/session/provisional-title are yielded BEFORE the LLM title is computed:
    the title call runs on a background thread started only after those yields, so
    run_id ships immediately even when the title model is slow (no multi-second
    silent window / disabled Stop on reasoning models).

    Driven on the generator directly because TestClient buffers a streamed response
    fully before exposing it, which would hide the ordering this guards."""
    import {{ project_slug }}.interfaces.web as webmod
    from {{ project_slug }}.interfaces.web import _chat_events

    called = []
    monkeypatch.setattr(
        webmod, "_generate_title", lambda *a, **k: (called.append(1), "LLM title")[1]
    )
    gen = _chat_events(
        "hi there", _config(), mock=True, stream=False,
        session_id="s1", auto_title=True,
    )
    try:
        first = next(gen)   # run (carries run_id)
        second = next(gen)  # session
        third = next(gen)   # provisional title (from the message)
    finally:
        gen.close()
    assert "event: run" in first and '"run_id"' in first
    assert "event: session" in second
    assert "event: title" in third and "hi there" in third
    assert called == []  # the LLM title has NOT been called by this point


