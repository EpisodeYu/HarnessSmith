def test_env_status_includes_mcp_auth_and_env_names(tmp_path, monkeypatch):
    """GET /env-status now also reports MCP servers' auth token + stdio env-var
    NAMES (booleans only), so the panel can mask an already-set MCP secret and flag
    a missing one — never echoing a value."""
    monkeypatch.chdir(tmp_path)
    config = Config.model_validate({
