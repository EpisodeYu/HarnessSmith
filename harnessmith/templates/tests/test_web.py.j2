def test_mcp_add_server_enables_its_tools_by_default(tmp_path):
    """A newly added server defaults to its WHOLE toolset enabled — a `<server>__*`
    wildcard, like preset-prefilled servers — so its tools are usable the moment it
    connects instead of starting disabled until each is ticked by hand."""
    from {{ project_slug }}.harness.tools import registry

    cfg_path = tmp_path / "config.yaml"
    cfg_path.write_text(
        "llms:\n  - name: default\n    model: mock-model\n"
        "roles:\n  generation: default\n"
        "observability:\n  trace: false\n"
        "sessions:\n  enabled: false\n"
        "mcp:\n  servers: []\n",
        encoding="utf-8",
    )
    app = create_app(mock=True, config_path=cfg_path)
    client = TestClient(app)
    resp = client.post(
        "/mcp/servers", json={"name": "dummy", "command": sys.executable, "args": [_DUMMY]}
    )
    assert resp.status_code == 200, resp.text
    # The wildcard is persisted to the allowlist and offered to the model...
    assert "dummy__*" in cfg_path.read_text(encoding="utf-8")
    assert "dummy__*" in app.state.config.enabled_tool_names()
    assert registry.get("dummy__add").name == "dummy__add"  # connected -> registered
    # ...and discovery reflects every tool as enabled on the panel.
    data = client.get("/mcp/discover").json()
    tools = {t["short"]: t for t in data["servers"][0]["tools"]}
    assert tools["add"]["enabled"] is True and tools["echo"]["enabled"] is True


