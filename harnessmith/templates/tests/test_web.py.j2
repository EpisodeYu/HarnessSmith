def test_mcp_discover_reports_pending_and_per_server_state():
    """/mcp/discover is non-blocking: each server carries its live connect state and
    a top-level `pending` flag, converging to settled — so one slow/failed server
    never holds back the others' tools."""
    app = create_app(_mcp_config(), mock=True)
    client = TestClient(app)
    first = client.get("/mcp/discover").json()
    assert "pending" in first
    dummy = {s["name"]: s for s in first["servers"]}["dummy"]
    assert "connecting" in dummy and "connected" in dummy
    app.state.mcp_manager.wait_ready(timeout=30)
    settled = client.get("/mcp/discover").json()
    assert settled["pending"] is False
    assert {s["name"]: s for s in settled["servers"]}["dummy"]["connected"] is True


