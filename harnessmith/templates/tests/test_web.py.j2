def test_mcp_status_reports_live_server_health():
    """/mcp/status backs the management page: live connection + tool counts + the
    editable server config (env-var NAMES only, never secret values). It is
    NON-blocking — a server may report `connecting` (amber) first, then converge to
    `connected`, so a slow uvx/npx cold-start never hangs the page."""
    app = create_app(_mcp_config(), mock=True)
    client = TestClient(app)
    first = {x["name"]: x for x in client.get("/mcp/status").json()["servers"]}["dummy"]
    assert first["transport"] == "stdio"
    assert first["connected"] or first["connecting"]  # live; may still be in flight
    app.state.mcp_manager.wait_ready(timeout=30)  # let the dummy finish connecting
    s = {x["name"]: x for x in client.get("/mcp/status").json()["servers"]}["dummy"]
    assert s["connected"] is True and s["connecting"] is False and s["error"] is None
    assert s["enabled_count"] == 1 and s["tool_count"] >= 2
    assert s["config"]["command"] == sys.executable  # editable config surfaced


def test_mcp_reconnect_single_server():
    """POST /mcp/servers/{name}/reconnect restarts just that server in place and
    returns live status immediately (may be connecting), converging to connected."""
    app = create_app(_mcp_config(), mock=True)
    client = TestClient(app)
    client.get("/mcp/discover")  # start the manager (non-blocking)
    app.state.mcp_manager.wait_ready(timeout=30)  # let the dummy connect first
    resp = client.post("/mcp/servers/dummy/reconnect")
    assert resp.status_code == 200, resp.text
    app.state.mcp_manager.wait_server_ready("dummy", timeout=30)
    s = {x["name"]: x for x in client.get("/mcp/status").json()["servers"]}["dummy"]
    assert s["connected"] is True and s["error"] is None


def test_mcp_add_and_delete_server_persists_and_reconnects(tmp_path):
    """POST/DELETE /mcp/servers writes config.yaml back (env-var names only) and
    hot-reconnects the manager, so a server can be managed from the panel."""
    cfg_path = tmp_path / "config.yaml"
    cfg_path.write_text(
        "llms:\n  - name: default\n    model: mock-model\n"
        "roles:\n  generation: default\n"
        "observability:\n  trace: false\n"
        "sessions:\n  enabled: false\n"
        "mcp:\n  servers: []\n",
        encoding="utf-8",
    )
    client = TestClient(create_app(mock=True, config_path=cfg_path))
    resp = client.post(
        "/mcp/servers", json={"name": "dummy", "command": sys.executable, "args": [_DUMMY]}
