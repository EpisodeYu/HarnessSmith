# --- reasoning_content passback (thinking models + tool calls) --------------


def _tool_call_msg(reasoning=None, signature=None):
    """A tool-calling assistant history dict, optionally carrying reasoning."""
    msg = {
        "role": "assistant",
        "content": "",
        "tool_calls": [
            {"id": "c1", "type": "function", "function": {"name": "calc", "arguments": "{}"}}
        ],
    }
    if reasoning is not None:
        msg["reasoning_content"] = reasoning
    if signature is not None:
        msg["reasoning_signature"] = signature
    return msg


def test_openai_complete_captures_reasoning_content():
    """A thinking model's reasoning is read off the response (``reasoning_content``,
    falling back to ``reasoning``) so it can be echoed back later."""
    import types

    from {{ project_slug }}.harness.config import LLMProfileConfig
    from {{ project_slug }}.harness.llm import OpenAIClient

    client = OpenAIClient(LLMProfileConfig(name="d", model="m"))

    def _resp(**msgkw):
        msg = types.SimpleNamespace(
            content=msgkw.get("content"),
            tool_calls=msgkw.get("tool_calls"),
            reasoning_content=msgkw.get("reasoning_content"),
            reasoning=msgkw.get("reasoning"),
        )
        return types.SimpleNamespace(choices=[types.SimpleNamespace(message=msg)], usage=None)

    client._client = types.SimpleNamespace(
        chat=types.SimpleNamespace(
            completions=types.SimpleNamespace(create=lambda **kw: _resp(reasoning_content="cot"))
        )
    )
    assert client.complete([], None).reasoning == "cot"

    client._client = types.SimpleNamespace(
        chat=types.SimpleNamespace(
            completions=types.SimpleNamespace(create=lambda **kw: _resp(content="hi", reasoning="alt"))
        )
    )
    assert client.complete([], None).reasoning == "alt"  # falls back to `reasoning`


def test_assistant_message_carries_reasoning_only_with_tool_calls():
    """The reasoning carrier rides a tool-calling assistant message (where reasoning
    endpoints require it); a plain answer message carries nothing extra."""
    from {{ project_slug }}.harness.paradigms import assistant_message

    with_tools = assistant_message(
        LLMResponse(
            tool_calls=[ToolCall(id="c1", name="calc", arguments="{}")],
            reasoning="why",
            reasoning_signature="sig",
        )
    )
    assert with_tools["reasoning_content"] == "why"
    assert with_tools["reasoning_signature"] == "sig"

    final = assistant_message(LLMResponse(content="the answer", reasoning="why"))
    assert "reasoning_content" not in final  # no tool calls -> nothing to preserve


def test_openai_wire_messages_reemits_renames_strips_and_can_disable():
    """The wire layer maps the neutral carrier to the endpoint's shape: re-emit
    under the configured field (default ``reasoning_content``, or ``reasoning``),
    drop the Anthropic-only signature, or disable passback with ``""``."""
    from {{ project_slug }}.harness.config import LLMProfileConfig
    from {{ project_slug }}.harness.llm import OpenAIClient

    hist = [{"role": "user", "content": "q"}, _tool_call_msg(reasoning="why", signature="sig")]

    default = OpenAIClient(LLMProfileConfig(name="d", model="m"))._wire_messages(hist)[1]
    assert default["reasoning_content"] == "why"
    assert "reasoning_signature" not in default  # Anthropic-only, never sent to OpenAI

    renamed = OpenAIClient(
        LLMProfileConfig(name="d", model="m", reasoning_history_field="reasoning")
    )._wire_messages(hist)[1]
    assert renamed["reasoning"] == "why" and "reasoning_content" not in renamed

    off = OpenAIClient(
        LLMProfileConfig(name="d", model="m", reasoning_history_field="")
    )._wire_messages(hist)[1]
    assert not any(k.startswith("reasoning") for k in off)

    assert hist[1]["reasoning_signature"] == "sig"  # the original history is not mutated


