def test_openai_client_stream_closes_on_cancel():
    """STOP-1: OpenAIClient.stream closes the HTTP stream the moment cancel trips,
    stops reading chunks, and returns the half-assembled response."""
    import types

    from {{ project_slug }}.harness.llm import OpenAIClient

    closed = {"v": False}

    def _chunk(text):
        delta = types.SimpleNamespace(content=text, tool_calls=None)
        return types.SimpleNamespace(usage=None, choices=[types.SimpleNamespace(delta=delta)])

    class _Stream:
        def __init__(self):
            self._chunks = [_chunk("a"), _chunk("b"), _chunk("c")]

        def __iter__(self):
            return iter(self._chunks)

        def close(self):
            closed["v"] = True

    client = OpenAIClient.__new__(OpenAIClient)  # bypass __init__ (no SDK / network)
    client.model = "m"
    client.temperature = client.max_tokens = client.reasoning_effort = None
    client.top_p = client.frequency_penalty = client.presence_penalty = None
    client.seed = client.stop = None
    client.extra_body = {}
    client.reasoning_history_field = "reasoning_content"
    client._client = types.SimpleNamespace(
        chat=types.SimpleNamespace(
            completions=types.SimpleNamespace(create=lambda **kw: _Stream())
        )
    )

    seen = []
    n = {"c": 0}

    def cancel():
        n["c"] += 1
        return n["c"] > 1  # cancel right after the first chunk

    resp = client.stream([], None, on_delta=seen.append, cancel=cancel)
    assert closed["v"] is True  # the stream was closed, not drained
    assert seen == ["a"] and resp.content == "a"


def test_crash_recovery_via_checkpoint_is_resumable(tmp_path):
    """Tier B: a turn write-ahead checkpoints each step. Simulating a hard crash
    (only the checkpoint file remains, status != complete), load repairs+returns a
    legal body and a fresh turn resumes from it."""
    from {{ project_slug }}.harness import session as session_store

    config = _config(tmp_path)
    sdir = str(tmp_path / "s")
    sid = session_store.new_id()
    client = MockLLM(script=[ScriptedCall("get_current_time", {}), "done"])
    # The caller "crashes" before the final save — only the per-step checkpoint
    # write-ahead reaches disk.
    run(
        "go",
        client=client,
        config=config,
        checkpoint=lambda body: session_store.checkpoint(sid, body, sdir),
    )

    assert session_store.status_of(sid, sdir) == "running"  # never cleanly finished
    history = session_store.load(sid, sdir)  # repaired if needed -> legal sequence
    assert any(m["role"] == "user" and m["content"] == "go" for m in history)

    resumed = run("and now?", client=MockLLM(script=["ok"]), config=config, history=history)
    assert resumed.stop_reason == "final"
    assert any(m.get("content") == "go" for m in resumed.messages)  # prior turn carried


