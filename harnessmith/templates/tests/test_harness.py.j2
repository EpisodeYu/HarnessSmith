def test_stream_cancel_interrupts_and_messages_stay_legal(tmp_path):
    """A cancel that trips mid-stream stops the turn with stop_reason interrupted,
    drops the half-streamed answer (never appended), and leaves a legal body."""
    config = _config(tmp_path)
    n = {"c": 0}

    def cancel():
        n["c"] += 1
        return n["c"] > 2  # step-boundary check + one token, then cancel

    deltas = []
    client = MockLLM(script=["one two three four five"])
    result = run("hi", client=client, config=config, on_delta=deltas.append, cancel=cancel)

    assert result.stop_reason == "interrupted"
    assert deltas and "".join(deltas) != "one two three four five"  # only a partial showed
    # the half output was discarded: the body is just the user message (legal)
    assert result.messages == [{"role": "user", "content": "hi"}]


