def test_context_window_pct_uses_real_usage_and_is_inactive_without_window():
    """window_pct compacts at a fraction of the model's window using the real last
    prompt-token count; with no context_window it never fires (overflow rescue is
    the net)."""
    from {{ project_slug }}.harness.context import ContextInfo, fit, should_compact

    ctx = ContextConfig(strategy="truncate", triggers={"window_pct": 0.8}, keep_last_turns=2)
    messages = _conversation(6)
    # 9000 / 10000 = 90% >= 80% -> compact
    hot = ContextInfo(last_prompt_tokens=9000, context_window=10000)
    assert should_compact(messages, ctx, info=hot) is True
    # 1000 / 10000 = 10% -> no compaction
    cool = ContextInfo(last_prompt_tokens=1000, context_window=10000)
    assert should_compact(messages, ctx, info=cool) is False
    # no context_window -> inactive regardless of usage
    nowin = ContextInfo(last_prompt_tokens=9_000_000, context_window=None)
    assert should_compact(messages, ctx, info=nowin) is False
    assert fit(messages, ctx, last_prompt_tokens=9_000_000) is messages  # unset -> no-op


def test_context_max_tokens_prefers_real_usage_over_estimate():
    """The max_tokens condition uses the real last prompt_tokens when known, and
    falls back to the char estimate only on the first call (no usage yet)."""
    from {{ project_slug }}.harness.context import ContextInfo, should_compact

    ctx = ContextConfig(strategy="truncate", triggers={"max_tokens": 5000}, keep_last_turns=2)
    small = _conversation(2)  # char estimate well under 5000
    # real usage says we're over -> compact even though the estimate is small
    assert should_compact(small, ctx, info=ContextInfo(last_prompt_tokens=6000)) is True
    # no usage yet -> the small estimate is under the threshold -> no compaction
    assert should_compact(small, ctx, info=ContextInfo(last_prompt_tokens=0)) is False


