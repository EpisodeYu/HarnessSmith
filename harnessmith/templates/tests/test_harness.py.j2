class _FakeAsker:
    """Records requests and replays a canned response (the test's "user")."""

    def __init__(self, response):
        self.response = response
        self.requests = []

    def ask(self, req):
        self.requests.append(req)
        return self.response


def test_ask_resolves_via_contextvar_and_restores():
    """ask() routes to the asker bound by using_asker, and restores the prior one
    (the degrade) when the block exits — the contextvar injection spine."""
    from {{ project_slug }}.harness.interaction import (
        AskRequest,
        AskResponse,
        ask,
        using_asker,
    )

    asker = _FakeAsker(AskResponse(text="bound"))
    with using_asker(asker):
        assert ask(AskRequest(kind="question", prompt="x")).text == "bound"
    assert asker.requests and asker.requests[0].prompt == "x"
    # outside the block: back to the non-interactive degrade
    assert "no interactive user" in ask(AskRequest(kind="question", prompt="x")).text


