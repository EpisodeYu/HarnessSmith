def test_compaction_keeps_reasoning_on_surviving_tool_call():
    """Compaction keeps surviving messages whole, so a kept tool-calling assistant
    keeps its reasoning carrier (stripping it would 400 the reasoning endpoint)."""
    messages = [
        {"role": "system", "content": "s"},
        {"role": "user", "content": "old"},
        {"role": "assistant", "content": "old answer"},
        {"role": "user", "content": "now"},
        _tool_call_msg(reasoning="why"),
        {"role": "tool", "tool_call_id": "c1", "content": "ok"},
    ]

    truncated = fit(messages, ContextConfig(strategy="truncate", keep_last_turns=1), force=True)
    kept = [m for m in truncated if m.get("role") == "assistant" and m.get("tool_calls")]
    assert kept and kept[0]["reasoning_content"] == "why"  # survived truncate

    summarized = fit(
        messages,
        ContextConfig(strategy="summarize", keep_last_turns=1),
        summarizer=MockLLM(script=["summary"]),
        force=True,
    )
    kept = [m for m in summarized if m.get("role") == "assistant" and m.get("tool_calls")]
    assert kept and kept[0]["reasoning_content"] == "why"  # survived summarize


