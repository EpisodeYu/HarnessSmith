        tools=[
            {"name": "danger_write", "enabled": True},
            {"name": "safe_read", "enabled": True},
        ],
    )
    # The scripted mock calls danger_write even though plan never offers it.
    client = MockLLM(script=[ScriptedCall("danger_write", {}), "done"])
    result = run("plan it", client=client, config=config, registry=registry, mode="plan")
    assert result.stop_reason == "final"
    assert "danger_write" not in calls  # refused at the execution boundary
    tool_msgs = [m for m in result.messages if m.get("role") == "tool"]
    assert tool_msgs and "not available" in tool_msgs[0]["content"]
