# --- LLM call robustness (overflow rescue / fallback / SDK reliability) -----


def test_is_context_overflow_matches_only_overlong_request_errors():
    from {{ project_slug }}.harness.llm import is_context_overflow

    class _Err(Exception):
        def __init__(self, msg, status=None):
            super().__init__(msg)
            self.status_code = status

    assert is_context_overflow(_Err("This model's maximum context length is 8192 tokens", 400))
    assert is_context_overflow(_Err("prompt is too long for the context window"))
    assert not is_context_overflow(_Err("503 service unavailable", 503))
    assert not is_context_overflow(_Err("rate limited", 429))


class _OverflowOnceClient:
    """Rejects the first call as over-long, then succeeds (B2 retry)."""

    def __init__(self):
        self.calls = 0
        self.last_len = None

    def complete(self, messages, tools=None, *, cancel=None):
        self.calls += 1
        if self.calls == 1:
            raise RuntimeError("This model's maximum context length is 8192 tokens")
        self.last_len = len(messages)
        return LLMResponse(content="recovered", usage=Usage(10, 5, 15))

    def stream(self, messages, tools=None, *, on_delta=None, on_thinking=None, cancel=None):
        return self.complete(messages, tools, cancel=cancel)


def test_generate_rescues_context_overflow_and_retries_once():
    """B2: an over-long request is caught, the history force-compacted, and the
    step retried once — the caller adopts the compacted messages."""
    from {{ project_slug }}.harness.paradigms import generate

    client = _OverflowOnceClient()
    ctx = ContextConfig(strategy="truncate", keep_last_turns=2)
    messages = _conversation(8)
    response, new_messages = generate(client, messages, None, context_cfg=ctx)

    assert response.content == "recovered"
    assert client.calls == 2  # failed once, retried after compaction
    assert len(new_messages) < len(messages)  # compacted body adopted
    assert client.last_len == len(new_messages)  # the retry used the compacted body


def test_generate_falls_back_to_another_profile_on_error(tmp_path, monkeypatch):
    """B3: a non-overflow error before any output streamed retries the step on the
    profile's fallback (resolved by name)."""
    from {{ project_slug }}.harness import llm as llm_mod
    from {{ project_slug }}.harness.paradigms import generate

    class _Boom:
        def complete(self, messages, tools=None, *, cancel=None):
            raise RuntimeError("503 service unavailable")

    class _Backup:
        def complete(self, messages, tools=None, *, cancel=None):
            return LLMResponse(content="from-backup", usage=Usage(1, 1, 2))

    monkeypatch.setattr(llm_mod, "client_for_profile_name", lambda cfg, name: _Backup())
    response, _ = generate(
        _Boom(), [{"role": "user", "content": "hi"}], None,
        config=_config(tmp_path), fallback_name="backup",
    )
    assert response.content == "from-backup"


def test_generate_does_not_fall_back_after_streaming_started(tmp_path, monkeypatch):
    """B3 caveat: once tokens have streamed, a mid-stream break is NOT retried (the
    partial output already showed) — the error propagates instead."""
    from {{ project_slug }}.harness import llm as llm_mod
    from {{ project_slug }}.harness.paradigms import generate

    class _PartialThenBoom:
        def stream(self, messages, tools=None, *, on_delta=None, on_thinking=None, cancel=None):
            if on_delta is not None:
                on_delta("partial")
            raise RuntimeError("network reset mid-stream")

    fb_calls = {"n": 0}
    monkeypatch.setattr(
        llm_mod, "client_for_profile_name",
        lambda cfg, name: fb_calls.__setitem__("n", fb_calls["n"] + 1),
    )
    with pytest.raises(RuntimeError):
        generate(
            _PartialThenBoom(), [{"role": "user", "content": "hi"}], None,
            on_delta=lambda t: None, config=_config(tmp_path), fallback_name="backup",
        )
    assert fb_calls["n"] == 0  # never fell back after a partial stream


def test_openai_client_passes_timeout_and_retries_to_sdk():
    """timeout_seconds / max_retries are forwarded to the SDK client (only when set)."""
    from {{ project_slug }}.harness.config import LLMProfileConfig
    from {{ project_slug }}.harness.llm import OpenAIClient

    tuned = OpenAIClient(
