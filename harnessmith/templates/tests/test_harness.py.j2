def test_plan_mode_refuses_unoffered_high_tool_at_execution(tmp_path):
    """Execution-boundary guardrail (PARA-1): even when the model hallucinates a
    high-risk tool that plan never offered, run_tool refuses it — so the read-only
    contract holds beyond the offered schema, not just inside it."""
    registry = Registry()
    calls = []

    @registry.tool(name="danger_write", description="High-risk writer.", risk="high")
    def danger_write() -> str:
        calls.append("danger_write")
