def _ledger(tmp_path):
    """An isolated on-disk usage ledger (so a limit test never reads/clobbers the
    real .harness/usage.json or another test's counts)."""
    from {{ project_slug }}.harness.usage import UsageLedger

    return UsageLedger(str(tmp_path / "usage.json"))


def test_usage_ledger_accumulates_across_runs(tmp_path):
    """Per-LLM spend persists across runs (the Budget page's source of truth)."""
    config = _config(tmp_path)
    config.llms[0].input_cost_per_million = 1000.0
    config.llms[0].output_cost_per_million = 1000.0
    ledger = _ledger(tmp_path)

    run("hi", client=MockLLM(), config=config, trace=Trace(enabled=False, ledger=ledger))
    after_one = ledger.snapshot(config)[0]
    run("hi", client=MockLLM(), config=config, trace=Trace(enabled=False, ledger=ledger))
    after_two = ledger.snapshot(config)[0]

    assert after_one["prompt_tokens"] > 0 and after_one["cost"] > 0
    assert after_two["prompt_tokens"] == 2 * after_one["prompt_tokens"]  # accrued, not reset
    assert after_two["name"] == "default"


def test_usage_store_retries_transient_replace_lock(tmp_path, monkeypatch):
    """On Windows os.replace can transiently fail with PermissionError when an
    AV/indexer momentarily holds the file open; _atomic_replace retries so the
    write still lands. Force the Windows path + a one-shot failure so the retry
    is exercised on any OS (POSIX takes the plain single-call path unchanged)."""
    from {{ project_slug }}.harness import usage as usage_mod

    # Force the Windows retry branch via the module flag — NOT by patching
    # os.name (that flips pathlib to WindowsPath and breaks on a POSIX host).
    monkeypatch.setattr(usage_mod, "_IS_WINDOWS", True)
    monkeypatch.setattr(usage_mod.time, "sleep", lambda _s: None)  # no real backoff wait
    real_replace = usage_mod.os.replace
    calls = {"n": 0}

    def flaky_replace(src, dst):
        calls["n"] += 1
        if calls["n"] == 1:
            raise PermissionError("simulated WinError 5: file in use")
        return real_replace(src, dst)

    monkeypatch.setattr(usage_mod.os, "replace", flaky_replace)

    ledger = _ledger(tmp_path)
    ledger.record("default", Usage(prompt_tokens=7, completion_tokens=3, total_tokens=10))

    assert calls["n"] >= 2  # retried past the first transient failure
    # the write actually persisted despite the first failed replace
    reread = _ledger(tmp_path).snapshot(_config(tmp_path))
    row = next(r for r in reread if r["name"] == "default")
    assert row["prompt_tokens"] == 7


def test_llm_cost_limit_blocks_an_over_budget_llm(tmp_path):
    """block_stop: an LLM already over its cost_limit is not called at all — the
    run ends immediately with stop_reason 'llm_budget' naming it."""
    config = _config(tmp_path)
    config.llms[0].input_cost_per_million = 1_000_000.0  # 1 unit / token
    config.llms[0].cost_limit = 1.0
    ledger = _ledger(tmp_path)
    ledger.record("default", Usage(prompt_tokens=5, completion_tokens=0, total_tokens=5))  # cost 5 >= 1

    result = run("hi", client=MockLLM(), config=config, trace=Trace(enabled=False, ledger=ledger))
    assert result.stop_reason == "llm_budget"
    assert result.steps == 0  # never called the LLM
    assert "default" in result.answer


def test_llm_cost_limit_stops_mid_run(tmp_path):
    """Cost accrues over steps; once it crosses the limit the loop stops using the
    LLM at the next step boundary (off by one) instead of spending more."""
    config = _config(tmp_path)
    config.llms[0].output_cost_per_million = 1_000_000.0  # 1 unit / completion token (5/call)
    config.llms[0].cost_limit = 7.0
    ledger = _ledger(tmp_path)
    # Finite script so a broken limit fails the assertion instead of looping forever.
    client = MockLLM(
        script=[
            ScriptedCall("get_current_time", {}),
            ScriptedCall("get_current_time", {}),
            ScriptedCall("get_current_time", {}),
            "done",
        ]
    )
    result = run("x", client=client, config=config, trace=Trace(enabled=False, ledger=ledger))
    assert result.stop_reason == "llm_budget"
    assert "default" in result.answer


