def test_openai_request_sends_sampling_knobs_only_when_set():
    """The new sampling knobs are sent ONLY when set; extra_body is merged for
    non-standard provider params (top_k, ...). A bare profile sends none of them."""
    from {{ project_slug }}.harness.config import LLMProfileConfig
    from {{ project_slug }}.harness.llm import OpenAIClient

    bare = OpenAIClient(LLMProfileConfig(name="d", model="m"))
    kw = bare._request_kwargs([{"role": "user", "content": "hi"}], None)
    for key in ("temperature", "top_p", "frequency_penalty", "presence_penalty",
                "seed", "stop", "extra_body"):
        assert key not in kw

    full = OpenAIClient(
        LLMProfileConfig(
            name="d", model="m", temperature=0.3, top_p=0.9, frequency_penalty=0.5,
            presence_penalty=0.2, seed=7, stop=["END"], extra_body={"top_k": 40},
        )
    )
    kw = full._request_kwargs([{"role": "user", "content": "hi"}], None)
    assert kw["temperature"] == 0.3 and kw["top_p"] == 0.9
    assert kw["frequency_penalty"] == 0.5 and kw["presence_penalty"] == 0.2
    assert kw["seed"] == 7 and kw["stop"] == ["END"]
    assert kw["extra_body"] == {"top_k": 40}  # non-standard params ride along


def test_openai_usage_reads_cached_and_reasoning_details():
    """Optional usage breakdowns (cached prompt tokens / reasoning tokens) are read
    when the provider sends them, and default to 0 when it doesn't."""
    import types

    from {{ project_slug }}.harness.llm import _usage_from_openai

    raw = types.SimpleNamespace(
        prompt_tokens=100, completion_tokens=50, total_tokens=150,
        prompt_tokens_details=types.SimpleNamespace(cached_tokens=80),
        completion_tokens_details=types.SimpleNamespace(reasoning_tokens=20),
    )
    usage = _usage_from_openai(raw)
    assert (usage.prompt_tokens, usage.completion_tokens) == (100, 50)
    assert usage.cached_prompt_tokens == 80 and usage.reasoning_tokens == 20

    bare = types.SimpleNamespace(
        prompt_tokens=10, completion_tokens=5, total_tokens=15,
        prompt_tokens_details=None, completion_tokens_details=None,
    )
    b = _usage_from_openai(bare)
    assert b.cached_prompt_tokens == 0 and b.reasoning_tokens == 0


def test_compute_cost_discounts_cached_tokens_only_when_priced():
    """Cached prompt tokens bill at the cached price when set; left unset they fall
    back to the full input price (so an unset cached price never under-counts)."""
    from {{ project_slug }}.harness.config import LLMProfileConfig
    from {{ project_slug }}.harness.llm import Usage
    from {{ project_slug }}.harness.trace import compute_cost

    usage = Usage(prompt_tokens=1_000_000, completion_tokens=0, cached_prompt_tokens=400_000)
    priced = LLMProfileConfig(
        name="d", model="m", input_cost_per_million=10.0, cached_input_cost_per_million=1.0
    )
    # fresh 600k @10/M + cached 400k @1/M = 6.0 + 0.4
    assert compute_cost(usage, priced) == 6.4
    unpriced = LLMProfileConfig(name="d", model="m", input_cost_per_million=10.0)
