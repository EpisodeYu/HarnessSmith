    @app.get("/mcp/status")
    async def mcp_status() -> dict:
        """Live per-server health for the MCP management page + the Tools page dots.

        Reads the ONE live manager (started on first use): each configured server's
        transport, connection state, discovered tool count, how many of its tools
        are allowlisted, and any connect error — plus its editable config (env-var
        NAMES only, never secret values). A server that won't connect is reported
        (not fatal). This is also the data the page polls to "refresh promptly".
        """
        from ..harness.mcp import auth_blocked, missing_secrets

        config = app.state.config
        if not config.mcp.servers:
            return {"servers": []}
        manager = await run_in_threadpool(lambda: _ensure_mcp_manager(app))
        enabled = config.enabled_tool_names()
        live = {s["name"]: s for s in manager.status()}
        servers = []
        for server in config.mcp.servers:
            st = live.get(server.name, {})
            tool_count = st.get("tool_count", 0)
            # A `<server>__*` wildcard enables every discovered tool.
            if f"{server.name}__*" in enabled:
                enabled_count = tool_count
            else:
                enabled_count = sum(1 for n in enabled if n.startswith(server.name + "__"))
            servers.append({
                "name": server.name,
                "transport": server.kind,
                "connected": bool(st.get("connected")),
                "connecting": bool(st.get("connecting")),
                "connecting_seconds": st.get("connecting_seconds"),
                "log_tail": st.get("log_tail") or "",
                "error": st.get("error"),
                "tool_count": tool_count,
                "enabled_count": enabled_count,
                # Auth is a SEPARATE axis from the connection dot: `missing_secrets`
                # are declared env/auth NAMES with no value (advisory, both transports);
                # `needs_auth` is the hard gate (a remote server whose required bearer
                # is unset — its tools are withheld and greyed out). NAMES only, no
                # values, so the secret red line holds.
                "missing_secrets": missing_secrets(server),
                "needs_auth": auth_blocked(server),
                "config": server.model_dump(mode="json", exclude_none=True),
            })
        return {"servers": servers}

    @app.get("/mcp/discover")
    async def mcp_discover() -> dict:
        """List each configured server's tools (from the live manager) so the Tools
        tab can offer them without hand-writing the ``<server>__<tool>`` allowlist.

        NON-blocking: it returns whatever each server has discovered SO FAR plus its
        live connection state, so a server's tools show up the moment IT connects —
        one slow/failing server never holds back the others. The page polls this
        while any server is still connecting. Read-only; enabling a tool still goes
        through POST /config. Per-server connect failures surface in ``error``.
        """
        from ..harness.mcp import auth_blocked, missing_secrets

        config = app.state.config
        if not config.mcp.servers:
            return {"servers": [], "pending": False}

        manager = await run_in_threadpool(lambda: _ensure_mcp_manager(app))
        enabled = config.enabled_tool_names()
        listed = {tool.name for tool in config.tools}
        live = {s["name"]: s for s in manager.status()}
        servers = []
        pending = False
        for server in config.mcp.servers:
            st = live.get(server.name, {})
            connecting = bool(st.get("connecting"))
            pending = pending or connecting
            wildcard = f"{server.name}__*" in enabled  # enables the whole server
            tools = []
            for tool in manager.discovered.get(server.name, []):
                full = f"{server.name}__{tool.name}"
                tools.append({
                    "name": full,
                    "short": tool.name,
                    "description": tool.description or "",
                    "listed": full in listed,
                    "enabled": full in enabled or wildcard,
                })
            servers.append({
                "name": server.name,
                "error": manager.errors.get(server.name),
                "connecting": connecting,
                "connected": bool(st.get("connected")),
                "connecting_seconds": st.get("connecting_seconds"),
                "log_tail": st.get("log_tail") or "",
                # `needs_auth` greys out this server's tools on the Tools page (a
                # remote server with an unset required bearer — they're withheld from
                # the model too); `missing_secrets` names what to set (NAMES only).
                "needs_auth": auth_blocked(server),
                "missing_secrets": missing_secrets(server),
                "tools": tools,
            })
        # `pending` lets the Tools page know to poll again until every server settles.
        return {"servers": servers, "pending": pending}

    @app.post("/mcp/servers")
    async def upsert_mcp_server(request: Request):
        """Add or edit an MCP server (upsert by name), then hot-reconnect.

        Validates the server config, writes it back to config.yaml (env-var NAMES
        only — never secret values), rebuilds the manager, and returns the fresh
        status. NOTE: adding a stdio server lets this product spawn that local
        command — a local, trusted-user control (threat model A), so don't expose
        /config or /mcp publicly. See README "MCP management".
        """
        from ..harness.config import McpServerConfig, ToolConfig

        body = await request.json()
        try:
            server = McpServerConfig.model_validate(body)
        except Exception as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        config = app.state.config
        existed = any(s.name == server.name for s in config.mcp.servers)
        # Editing an existing server replaces it IN PLACE; only a genuinely new one
        # is appended. Re-appending on every edit would jump its card to the bottom
        # of the management page on each save+reconnect — jarring once the user has
        # arranged the servers in a stable reading order.
        if existed:
            config.mcp.servers = [
                server if s.name == server.name else s for s in config.mcp.servers
            ]
        else:
            config.mcp.servers = [*config.mcp.servers, server]
        persist = ["mcp"]
        # A newly added server defaults to its WHOLE toolset enabled — a
        # `<server>__*` wildcard, exactly like preset-prefilled servers — so its
        # tools are usable the moment it connects instead of every tool starting
        # off. Only for a genuinely new server with no allowlist entry yet, so
        # editing one never clobbers an intentionally narrowed list.
        if not existed and not any(
            t.name == f"{server.name}__*" or t.name.startswith(f"{server.name}__")
            for t in config.tools
        ):
            config.tools.append(ToolConfig(name=f"{server.name}__*", enabled=True))
            persist.append("tools")
        _persist_config_keys(app, persist)
        await run_in_threadpool(lambda: _rebuild_mcp_manager(app))
        return await mcp_status()

    @app.delete("/mcp/servers/{name}")
    async def delete_mcp_server(name: str):
        """Remove a server (and drop its ``<name>__*`` allowlist entries), then
        hot-reconnect. Idempotent — a missing name just rebuilds unchanged."""
        config = app.state.config
        config.mcp.servers = [s for s in config.mcp.servers if s.name != name]
        config.tools = [t for t in config.tools if not t.name.startswith(name + "__")]
        _persist_config_keys(app, ["mcp", "tools"])
        await run_in_threadpool(lambda: _rebuild_mcp_manager(app))
        return await mcp_status()

    @app.post("/mcp/reconnect")
    async def reconnect_mcp() -> dict:
        """Rebuild the manager from the current config (reconnect every server) —
        the management page's "reconnect all" button for a fresh start."""
        await run_in_threadpool(lambda: _rebuild_mcp_manager(app))
        return await mcp_status()

    @app.post("/mcp/servers/{name}/reconnect")
    async def reconnect_one_mcp_server(name: str) -> dict:
        """Reconnect a SINGLE server in place — the per-server "reconnect" button.

        Restarts just this server's session (others keep running), returns
        immediately while it's connecting (the dot goes amber; the page polls), and
        re-syncs the registry in the background once it settles.
        """
        from ..harness.mcp import sync_mcp_tools

        def _restart_one():
            manager = _ensure_mcp_manager(app)
            manager.reconnect_server(name)  # fast: tear down + respawn (now connecting)
            return manager

        manager = await run_in_threadpool(_restart_one)

        def _resync_when_ready():
            manager.wait_server_ready(
                name, timeout=app.state.config.mcp.connect_timeout_seconds + 5
            )
            sync_mcp_tools(app.state.config, manager)

        threading.Thread(target=_resync_when_ready, daemon=True).start()
        return await mcp_status()
