class _StreamHooks(Hooks):
    """Push loop lifecycle events onto a queue, formatted as SSE later.

    Composes with an ``inner`` Hooks (the one named in ``config.hooks``, if any):
    each lifecycle method runs the user's hook first, then emits the SSE event, so
    a configured guardrail / audit hook works under the web UI too — not just the CLI.
    """

    def __init__(self, q: queue.Queue, inner: Hooks | None = None) -> None:
        self._q = q
        self._inner = inner or Hooks()

    def before_step(self, step: int, messages: list[dict]) -> None:
        self._inner.before_step(step, messages)

    def after_step(self, step: int, response: LLMResponse) -> None:
        self._inner.after_step(step, response)
        # prompt_tokens is the real size of the context just sent — the web UI's
        # context meter reads it (against the profile's context_window) live.
        self._q.put((
            "step",
            {
                "step": step,
                "tools": [c.name for c in response.tool_calls],
                "prompt_tokens": response.usage.prompt_tokens,
            },
        ))

    def before_tool(self, call: ToolCall) -> str | None:
        # Forward the user hook's policy decision (a returned string refuses the
        # call) while still surfacing the attempt to the UI.
        refusal = self._inner.before_tool(call)
        self._q.put(("tool_call", {"name": call.name, "arguments": call.arguments}))
        return refusal

    def after_tool(self, call: ToolCall, result: str) -> str | None:
        # Let the user hook redact/rewrite the result; the UI shows what the model
        # actually gets (the rewritten value when one was returned).
        rewritten = self._inner.after_tool(call, result)
        shown = rewritten if rewritten is not None else result
        self._q.put(("tool_result", {"name": call.name, "result": shown}))
        return rewritten

    def on_error(self, where: str, error: Exception) -> None:
        # Observer ONLY — must never terminate the SSE stream. `run_tool` calls this
        # for a tool error it has ALREADY recovered (the loop keeps running and the
        # failure is surfaced to the UI as that tool's ERROR result, via `after_tool`
        # -> `tool_result`); a genuinely fatal run error is surfaced once, terminally,
        # by the worker's `except` below ({"where": "run"}). Emitting an `error` SSE
        # event here too made the frontend tear the stream down (finishStream ->
        # EventSource.close -> the worker's run is cancelled) on a tool failure the
        # loop had already absorbed — the chat appeared to crash mid-run for nothing.
        self._inner.on_error(where, error)


class _HookLog:
    """A small in-process ring buffer of hook invocations for the Hooks page.

    Records WHEN each mounted hook fired and at WHICH lifecycle point — names,
    methods, and a safe detail (tool name / step number / error type) ONLY, never
    arguments, results, or message content (same privacy contract as the debug
    log). Process-local and capped, so a long session can't grow it without bound;
    cleared by hand from the page. No-op unless at least one hook is mounted.
    """

    def __init__(self, capacity: int = 500) -> None:
        self._entries: deque[dict] = deque(maxlen=capacity)
        self._lock = threading.Lock()

    def record(self, label: str, method: str, detail: str = "") -> None:
        with self._lock:
            self._entries.append(
                {"ts": time.time(), "hook": label, "method": method, "detail": detail}
            )

    def snapshot(self) -> list[dict]:
        with self._lock:
            return list(self._entries)

    def clear(self) -> None:
        with self._lock:
            self._entries.clear()


class _RecordingHooks(Hooks):
    """Wrap ONE user hook so each lifecycle call is timestamped into a ``_HookLog``
    under that hook's class path, then delegated unchanged (return values for
    ``before_tool`` / ``after_tool`` are preserved, so policy/redaction still work).
    """

    def __init__(self, inner: Hooks, label: str, hook_log: _HookLog) -> None:
        self._inner = inner
        self._label = label
        self._log = hook_log

    def before_step(self, step: int, messages: list[dict]) -> None:
        self._log.record(self._label, "before_step", f"step {step}")
        self._inner.before_step(step, messages)

    def after_step(self, step: int, response: LLMResponse) -> None:
        self._log.record(self._label, "after_step", f"step {step}")
        self._inner.after_step(step, response)

    def before_tool(self, call: ToolCall) -> str | None:
        self._log.record(self._label, "before_tool", call.name)
        return self._inner.before_tool(call)

    def after_tool(self, call: ToolCall, result: str) -> str | None:
        self._log.record(self._label, "after_tool", call.name)
        return self._inner.after_tool(call, result)

    def on_error(self, where: str, error: Exception) -> None:
        self._log.record(self._label, "on_error", f"{where}: {type(error).__name__}")
        self._inner.on_error(where, error)


def _recording_hooks(config: Config, hook_log: _HookLog | None) -> Hooks:
    """Build the mounted hooks, each wrapped to log its calls into ``hook_log``.

    Same composition as ``extensions.load_hooks`` (no-op when none, single when
    one, composite otherwise) but per-hook recording-aware so the Hooks page can
    show which hook fired when. Without a ``hook_log`` it is plain ``load_hooks``.
    """
    pairs = build_hook_instances(config)
    if not pairs:
        return Hooks()
    if hook_log is not None:
        wrapped: list[Hooks] = [_RecordingHooks(inst, label, hook_log) for label, inst in pairs]
    else:
        wrapped = [inst for _, inst in pairs]
    return wrapped[0] if len(wrapped) == 1 else CompositeHooks(wrapped)


def _sse(event: str, data: dict) -> str:
    return f"event: {event}\ndata: {json.dumps(data, ensure_ascii=False)}\n\n"


class WebAsker:
    """Ask the user over the open SSE stream + a POST back — the web side of the
    shared interaction channel (the ``ask_question`` tool, and HITL confirmation
    later).

    ``ask`` pushes an ``("ask", {...})`` event (the page renders a card), then
    BLOCKS on a per-request reply queue until ``POST /chat/{run_id}/respond`` (or a
    cancel/disconnect sentinel) delivers the answer. The loop is serial, so one run
    has at most one pending ask at a time; a small per-run table maps request id ->
    reply queue. A ``None`` sentinel (stop / disconnect) degrades fail-closed
    (a question -> "use your judgment", an approval -> reject).
    """

    def __init__(self, event_q: queue.Queue, pending: dict, lock) -> None:
        self._q = event_q
        self._pending = pending  # this run's {request_id -> reply Queue}
        self._lock = lock

    def ask(self, req) -> AskResponse:
        request_id = session_store.new_id()
        reply_q: queue.Queue = queue.Queue()
        with self._lock:
            self._pending[request_id] = reply_q
        self._q.put((
            "ask",
            {
                "request_id": request_id,
                "kind": req.kind,
                "prompt": req.prompt,
                "options": [{"id": o.id, "label": o.label} for o in req.options],
                "allow_text": req.allow_text,
                "allow_multiple": req.allow_multiple,
                "context": req.context,
            },
        ))
        try:
            reply = reply_q.get()  # blocks until /respond or a cancel sentinel
        finally:
            with self._lock:
                self._pending.pop(request_id, None)
        if reply is None:  # stopped / disconnected -> fail-closed degrade
            return noninteractive_response(req)
        return AskResponse(
            option_ids=list(reply.get("option_ids") or []),
            text=reply.get("text"),
        )


_TITLE_PROMPT = (
    "You are a session-title generator. You do NOT answer, fulfill, or respond to "
    "the request — your ONLY job is to name its TOPIC as a short label.\n\n"
    "Rules:\n"
    "- Reply in the SAME language as the request.\n"
    "- Output ONLY the title — no quotes, no surrounding punctuation, no commentary, "
    "and NEVER an answer to the request.\n"
    "- A concise noun phrase naming the topic, not a full sentence and not a reply.\n"
    "- <= 8 words, or <= 16 Chinese characters."
)

# How long the worker waits for the parallel LLM title before persisting with the
# provisional one instead. Generous on purpose: the LLM title (one call) is almost
# always ready before the loop finishes, so this never fires in practice — it only
# stops a wedged title call from holding up the final save indefinitely.
_TITLE_JOIN_TIMEOUT = 120.0

# Hard cap on the /config "test" probe. The loop's profile may set a generous
# timeout (or none — the SDK then defaults to 600s) and retries, both wrong for a
# reachability check that should fail FAST. The probe overrides them with this and
# zero retries so a dead endpoint reports in seconds, not minutes.
_PROBE_TIMEOUT_SECONDS = 20.0


def _generate_title(client, question: str) -> str:
    """Summarize the first user message into a short session title (best-effort).

    Uses the ``title`` role's client (falls back to ``generation``). Any failure
    returns "" so the caller just leaves the title empty (retried next turn) —
    auto-titling must never break the chat.
    """
    q = (question or "").strip()
    if not q:
        return ""
    try:
        resp = client.complete(
            [
                {"role": "system", "content": _TITLE_PROMPT},
                # Wrap the message as material to be NAMED (delimited), not a turn to
                # answer — a bare question like "what is X?" otherwise tempts the model
                # to reply instead of titling.
                {
                    "role": "user",
                    "content": (
                        "Name the topic of this request as a short title "
                        "(do NOT answer it):\n\n<request>\n" + q[:2000] + "\n</request>"
                    ),
                },
            ],
            None,
        )
    except Exception:
        return ""
    text = (resp.content or "").strip()
    line = next((ln.strip() for ln in text.splitlines() if ln.strip()), "")
    return line.strip("\"'").strip()[:60]


def _provisional_title(question: str) -> str:
    """A zero-cost placeholder title taken from the user's message itself: the
    first non-empty line, trimmed. Shown the instant a session starts so the
    sidebar is named before the (slower) LLM title arrives, and kept as the
    fallback if the LLM title fails or times out."""
    line = next((ln.strip() for ln in (question or "").splitlines() if ln.strip()), "")
    return line[:40].strip()


def _safe_repo_path(path: str) -> Path | None:
    """Resolve ``path`` under the project dir, or ``None`` if it's empty, absolute,
    or escapes the project root. Confines rule-file reads/writes to this repo so the
    panel can never read/overwrite arbitrary files on the host."""
    if not path or Path(path).is_absolute():
        return None
    root = Path.cwd().resolve()
    candidate = (root / path).resolve()
    try:
        candidate.relative_to(root)
    except ValueError:
        return None
    return candidate


def _resolve_working_dir(cwd: str | None, session_id: str | None, config: Config) -> str | None:
    """The working-directory hint for a chat run (absolute path), or ``None``.

    Resolution order: an explicit ``cwd`` from the request (resolved to absolute);
    else the session's stored ``cwd`` (so a later turn / resume reuses it); else
    ``None`` (no injection — the system prompt is unchanged). This is a prompt
    HINT only — never a ``chdir`` or a path fence (Web is single-process /
    multi-session, so a process cwd would let two sessions cross)."""
    if cwd is not None and cwd.strip():
        return str(Path(cwd).expanduser().resolve())
    if session_id is not None and config.sessions.enabled:
        stored = session_store.cwd_of(session_id, config.sessions.dir)
        if stored.strip():
            return str(Path(stored).expanduser().resolve())
    return None


def _list_subdirectories(path: str | None) -> dict:
    """List immediate child DIRECTORIES of ``path`` (defaults to the process cwd).

    Returns ``{path, parent, dirs}``: the resolved absolute path, its parent (same
    path at the filesystem root), and the sorted names of its subdirectories. Used
    by the web directory picker so a user can browse to a working-directory hint
    without typing a full path. Names only — file contents are never read, and only
    directory entries are returned. A LOCAL, trusted-user control (like MCP server
    management): don't expose ``/fs`` / ``/config`` on a public network."""
    base = Path(path).expanduser() if path and path.strip() else Path.cwd()
    try:
        base = base.resolve()
    except OSError:
        base = Path.cwd().resolve()
    dirs: list[str] = []
    if base.is_dir():
        try:
            for entry in sorted(base.iterdir(), key=lambda p: p.name.lower()):
                try:
                    if entry.is_dir():
                        dirs.append(entry.name)
                except OSError:
                    continue
        except OSError:
            pass
    return {"path": str(base), "parent": str(base.parent), "dirs": dirs}

