def _chat_events(
    message: str,
    config: Config,
    *,
    mock: bool,
    stream: bool = True,
    mode: str | None = None,
    session_id: str | None = None,
    history: list[dict] | None = None,
    auto_title: bool = False,
    runs: dict | None = None,
    pending: dict | None = None,
    lock=None,
    confirm_sessions: dict | None = None,
    config_path=None,
):
    """Drive one ``run()`` in a worker thread and yield its events as SSE.

    With ``stream=True`` assistant text is forwarded token-by-token as
    ``event: token``; otherwise only step/tool/final events are emitted. ``mode``
    selects the loop paradigm (defaults to ``config.paradigms.default``).
    ``history`` resumes a prior conversation; the updated body is saved under
    ``session_id`` when sessions are enabled. When ``auto_title`` is set, the
    first message is summarized into a session title (``title`` role) BEFORE the
    answer so the sidebar names the session up front.

    A cancel token is registered in ``runs`` under a fresh ``run_id`` (emitted as
    the first ``event: run``) so ``POST /chat/{run_id}/stop`` — or a client
    disconnect (``GeneratorExit``) — can stop the loop mid-flight. An interrupted
    turn still persists its partial body (``status="interrupted"``) and emits
    ``event: stopped`` instead of ``event: final``, so the chat stays resumable.
    Each completed step is also write-ahead checkpointed for crash safety.

    ``pending`` registers this run's open asks (an ``event: ask`` card waiting for
    ``POST /chat/{run_id}/respond``) so a reply can reach the blocked worker, and a
    stop/disconnect can unblock any pending ask (fail-closed) instead of stranding
    the worker thread.
    """
    q: queue.Queue = queue.Queue()
    hooks = _StreamHooks(q, load_hooks(config))
    on_delta = (lambda text: q.put(("token", {"text": text}))) if stream else None
    # Thinking channel: reasoning models sit silent for seconds before the first
    # token; `event: thinking` lets the UI show "thinking …" instead of nothing.
    # `text` may be "" (reasoning started but its content is hidden).
    on_thinking = (lambda text: q.put(("thinking", {"text": text}))) if stream else None
    router = ClientRouter(config, mock=mock)

    # Register this run's cancel token so /stop (and disconnect) can reach it, plus
    # a per-run pending-ask table so /respond can deliver an answer to the worker.
    run_id = session_store.new_id()
    cancel_event = threading.Event()
    run_pending: dict = {}
    if runs is not None and lock is not None:
        with lock:
            runs[run_id] = cancel_event
            if pending is not None:
                pending[run_id] = run_pending

    # The asker the loop reaches via the interaction contextvar: over the web it's
    # the SSE-card asker; with no pending table (e.g. a direct unit call) it degrades.
    asker = (
        WebAsker(q, run_pending, lock)
        if pending is not None and lock is not None
        else NonInteractiveAsker()
    )

    # HITL tool-confirmation gate (None when the `confirm` policy is off). The
    # allow-set is scoped to this session (so "allow for session" sticks across the
    # session's messages); "always allow" rewrites config.yaml + applies in-process.
    from ..harness.tools import registry as _tool_registry

    confirm_needs = _tool_registry.confirm_names(config.confirm)
    confirmer = None
    if confirm_needs:
        if confirm_sessions is not None and session_id is not None:
            session_set = confirm_sessions.setdefault(session_id, set())
        else:
            session_set = set()

        def _persist_confirm(remaining: set[str]) -> None:
            from ..harness.config import persist_confirm

            policy = sorted(remaining)
            config.confirm = policy  # apply in-process so a later message agrees
            if config_path is not None:
                try:
                    persist_confirm(policy, config_path)
                except Exception:
                    pass  # in-process allow still holds; persistence is best-effort

        confirmer = ToolConfirmer(confirm_needs, persist=_persist_confirm, session=session_set)

    # Auto-title first (best-effort): the sidebar gets a name before the answer.
    new_title = ""
    if auto_title and message.strip():
        title_role = "title" if "title" in config.roles else "generation"
        new_title = _generate_title(router.client_for(title_role), message)

    save_mode = mode or config.paradigms.default

    def _checkpoint(body: list[dict]) -> None:
        if session_id is not None and config.sessions.enabled:
            session_store.checkpoint(session_id, body, config.sessions.dir, mode=save_mode)

    def worker() -> None:
        try:
            # Set the asker + HITL confirmer inside the worker thread: a ContextVar
            # does not propagate across threads, so the loop must bind them here to
            # reach the user (ask_question / tool confirmation) from this thread.
            with using_asker(asker), using_confirmer(confirmer):
                result = run_loop(
                    message,
                    mode=mode,
                    client_for=router.client_for,
                    config=config,
                    hooks=hooks,
                    on_delta=on_delta,
                    on_thinking=on_thinking,
                    history=history,
                    cancel=cancel_event.is_set,
                    checkpoint=_checkpoint,
                )
            interrupted = result.stop_reason == "interrupted"
            if session_id is not None and config.sessions.enabled:
                session_store.save(
                    session_id, result.messages, config.sessions.dir,
                    mode=result.mode, title=new_title or None,
                    status="interrupted" if interrupted else "complete",
                )
{% if spec.memory.enabled %}            from ..harness.memory import record_turn

            record_turn(config, result.messages)
{% endif %}            payload = {
                "answer": result.answer,
                "mode": result.mode,
                "stop_reason": result.stop_reason,
                "steps": result.steps,
                "tokens": result.trace.total_tokens,
                "cost_usd": round(result.trace.cost_usd, 6),
                "session": session_id,
            }
            # Interrupted = stopped on purpose: emit `stopped` (resumable), not a
            # synthetic final answer.
            q.put(("stopped" if interrupted else "final", payload))
        except Exception as exc:  # never leave the stream hanging
            log.debug("web chat run %s FAILED", run_id, exc_info=True)
            q.put(("error", {"where": "run", "error": str(exc)}))
        finally:
            q.put(None)

    # Announce the run id (for /stop) + session id (to resume) up front, then the
    # title (if we made one) so the sidebar updates immediately. context_window is
    # the generation profile's declared window (None if unset) so the chat's context
    # meter can show usage as a fraction of it.
    try:
        gen_window = config.profile_for("generation").context_window
    except Exception:
        gen_window = None
    yield _sse("run", {"run_id": run_id, "context_window": gen_window})
    if session_id is not None:
        yield _sse("session", {"id": session_id})
    if new_title:
        yield _sse("title", {"id": session_id, "title": new_title})
    threading.Thread(target=worker, daemon=True).start()
    try:
        while True:
            item = q.get()
            if item is None:
                break
            yield _sse(*item)
    except GeneratorExit:
        # Client disconnected (closed tab / dropped network): cancel the run so
        # the loop stops at the next boundary instead of running on unwatched, and
        # unblock any pending ask (fail-closed) so the worker thread isn't stranded.
        cancel_event.set()
        if lock is not None:
            with lock:
                for reply_q in list(run_pending.values()):
                    reply_q.put(None)
        raise
    finally:
        if runs is not None and lock is not None:
            with lock:
                runs.pop(run_id, None)
                if pending is not None:
                    pending.pop(run_id, None)


def create_app(
    config: Config | None = None,
    *,
    mock: bool = False,
    config_path: str | Path | None = None,
) -> FastAPI:
    """Build the FastAPI app.

    With no ``config`` it loads ``config_path`` (default ``config.yaml``) and
    keeps that path so a ``/config`` Save persists back to it. When ``config`` is
    passed in (e.g. tests) the path is only tracked if given explicitly — a
    config built in code (no path) never gets written to a stray file.
    """
    app = FastAPI(title="{{ display_name }} — web")
    if config is None:
        config_path = config_path or DEFAULT_CONFIG_PATH
        config = load_config(config_path)
    app.state.config = config
    # Where a /config Save writes back to (None = apply in-process, don't persist).
    app.state.config_path = Path(config_path) if config_path is not None else None
    app.state.mock = mock
    # In-flight chat runs: run_id -> cancel Event, so POST /chat/{run_id}/stop can
    # signal a running loop. The lock guards the dict across worker threads.
    app.state.runs = {}
    # Open asks per run: run_id -> {request_id -> reply Queue}, so POST
    # /chat/{run_id}/respond can deliver an answer to a blocked worker (and stop /
    # disconnect can unblock any pending ask). Guarded by the same lock.
    app.state.pending = {}
    # HITL "allow for this session" sets, keyed by session id, so an approval
    # sticks across a session's turns (held in process; reset on restart).
    app.state.confirm_sessions = {}
    app.state.runs_lock = threading.Lock()
{% if spec.mcp.enabled %}    # The live MCP manager: ONE per serving process, the single source of truth
    # for the MCP page, the Tools page, and the tools offered to the model. Started
    # lazily on the first /mcp call (or eagerly by `serve`), and rebuilt on a server
    # edit. Its own lock guards the blocking (re)connect so it never holds up a
    # chat run's bookkeeping (which uses runs_lock).
    app.state.mcp_manager = None
    app.state.mcp_lock = threading.Lock()
{% endif %}    # Load config.extensions so custom @register_* (tools / paradigms / conditions /
    # backends) are available to this web process; serve() also runs the full
    # diagnostics + fail-fast before binding.
    import_extensions(app.state.config)
{% if spec.memory.enabled %}    from ..harness.memory import register_memory_tools

    register_memory_tools(app.state.config)
{% endif %}
    @app.get("/", response_class=HTMLResponse)
    def index() -> str:
        return _INDEX_HTML

    @app.get("/chat")
    def chat(
        message: str,
        stream: bool = True,
        mode: str | None = None,
        session: str | None = None,
        edit_turn: int | None = None,
    ) -> StreamingResponse:
        cfg = app.state.config
        # Resume the given session, or mint a new id; disabled sessions => one-shot.
        if cfg.sessions.enabled:
            session_id = session or session_store.new_id()
            history = session_store.load(session_id, cfg.sessions.dir) if session else []
            # Re-ask: an edited historical question. Drop everything from that user
            # turn onward, then regenerate from there (destructive truncation — the
            # later conversation is overwritten on save, not forked).
            if edit_turn is not None and history:
                history = session_store.truncate_to_turn(history, edit_turn)
        else:
            session_id, history = None, None
        # Auto-title a session that has no title yet (new, or an earlier attempt
        # failed). Skips sessions that already have one.
        auto_title = bool(
            cfg.sessions.enabled
            and cfg.sessions.auto_title
            and session_id is not None
            and not session_store.title_of(session_id, cfg.sessions.dir)
        )
        return StreamingResponse(
            _chat_events(
                message, cfg, mock=app.state.mock, stream=stream, mode=mode,
                session_id=session_id, history=history, auto_title=auto_title,
                runs=app.state.runs, pending=app.state.pending, lock=app.state.runs_lock,
                confirm_sessions=app.state.confirm_sessions,
                config_path=app.state.config_path,
            ),
            media_type="text/event-stream",
        )

    @app.post("/chat/{run_id}/stop")
    def stop_chat(run_id: str) -> dict:
        """Stop an in-flight chat run: set its cancel token so the loop ends at the
        next boundary (mid-token for a streaming turn; the partial answer is
        dropped and the conversation saved as resumable). Any pending ask is
        unblocked fail-closed so a stopped run never strands a worker. Idempotent —
        an unknown or already-finished run_id is a no-op 200."""
        with app.state.runs_lock:
            event = app.state.runs.get(run_id)
            replies = list(app.state.pending.get(run_id, {}).values())
        if event is not None:
            event.set()
        for reply_q in replies:
            reply_q.put(None)  # unblock a pending ask (question degrades / approval rejects)
        return {"ok": True, "run_id": run_id}

    @app.post("/chat/{run_id}/respond")
    async def respond_chat(run_id: str, request: Request):
        """Deliver the user's answer to a pending ask — the card shown for an
        ``event: ask`` (a model ``ask_question``, or HITL confirmation later).

        Body ``{request_id, option_ids, text}`` is routed to the blocked worker so
        the loop resumes with the answer. Idempotent — an unknown run/request id is
        a no-op 200 (e.g. the run already finished or was stopped)."""
        body = await request.json()
        request_id = str(body.get("request_id", ""))
        with app.state.runs_lock:
            reply_q = app.state.pending.get(run_id, {}).get(request_id)
        if reply_q is not None:
            reply_q.put(
                {"option_ids": body.get("option_ids", []), "text": body.get("text")}
            )
        return {"ok": True}

    @app.get("/sessions")
    def sessions() -> dict:
        """List saved sessions (most recent first) for the chat session picker."""
        cfg = app.state.config
        if not cfg.sessions.enabled:
            return {"sessions": []}
        return {"sessions": session_store.summaries(cfg.sessions.dir)}

    @app.get("/sessions/{session_id}")
    def session_detail(session_id: str) -> dict:
        """Return one session's message body so the UI can replay it on resume."""
        cfg = app.state.config
        return {
            "id": session_id,
            "messages": session_store.load(session_id, cfg.sessions.dir),
        }

    @app.patch("/sessions/{session_id}")
    async def rename_session(session_id: str, request: Request):
        """Rename a session (set its sidebar title); keeps its messages."""
        cfg = app.state.config
        if not cfg.sessions.enabled:
            return JSONResponse({"error": "sessions disabled"}, status_code=400)
        title = str((await request.json()).get("title", "")).strip()[:120]
        if not session_store.set_title(session_id, title, cfg.sessions.dir):
            return JSONResponse({"error": "unknown session"}, status_code=404)
        return {"id": session_id, "title": title}

    @app.delete("/sessions/{session_id}")
    def delete_session(session_id: str) -> dict:
        """Delete a session (idempotent — a missing one is a no-op)."""
        cfg = app.state.config
        session_store.delete(session_id, cfg.sessions.dir)
        return {"ok": True}

    @app.get("/paradigms")
    def paradigms() -> dict:
        """The runtime paradigm roster, for the chat-mode dropdown."""
        return app.state.config.paradigms.model_dump(mode="json")

    @app.get("/registries")
    def registries() -> dict:
        """What's registered in code — the extension universe behind the config
        dropdowns. A custom ``@register_paradigm`` / ``@register_strategy`` /
