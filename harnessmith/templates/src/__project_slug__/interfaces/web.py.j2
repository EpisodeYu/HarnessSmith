    @app.post("/mcp/servers/{name}/reconnect")
    async def reconnect_one_mcp_server(name: str) -> dict:
        """Reconnect a SINGLE server in place — the per-server "reconnect" button.

        Restarts just this server's session (others keep running), returns
        immediately while it's connecting (the dot goes amber; the page polls), and
        re-syncs the registry in the background once it settles.
        """
        from ..harness.mcp import sync_mcp_tools

        def _restart_one():
            manager = _ensure_mcp_manager(app)
            manager.reconnect_server(name)  # fast: tear down + respawn (now connecting)
            return manager

        manager = await run_in_threadpool(_restart_one)

        def _resync_when_ready():
            manager.wait_server_ready(
                name, timeout=app.state.config.mcp.connect_timeout_seconds + 5
            )
            sync_mcp_tools(app.state.config, manager)

        threading.Thread(target=_resync_when_ready, daemon=True).start()
        return await mcp_status()
