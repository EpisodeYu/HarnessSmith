        Parses + validates the payload (``Config.model_validate`` — a bad config is
        rejected WITHOUT touching the running one), applies it in-process, and
        writes it back to config.yaml verbatim. Secrets are never accepted here:
        config only holds env-var NAMES; real values stay in .env. Like the MCP
        editor this is a LOCAL, trusted-user control — don't expose /config or this
        endpoint on a public network.
        """
        raw = (await request.body()).decode("utf-8")
        try:
            data = yaml.safe_load(raw) if raw.strip() else None
        except yaml.YAMLError as exc:
            return JSONResponse({"error": f"could not parse config: {exc}"}, status_code=400)
        if not isinstance(data, dict):
            return JSONResponse(
                {"error": "config must be a YAML/JSON mapping at the top level"},
                status_code=400,
            )
        try:
            new_config = Config.model_validate(data)
        except Exception as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        app.state.config = new_config
        # Re-arm runtime state that depends on the new config (mirrors POST /config):
        # the local debug log + any custom @register_* extension modules.
        obs = new_config.observability
        setup_debug_log(obs.debug, obs.debug_dir)
        import_extensions(new_config)
