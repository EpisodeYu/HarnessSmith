        from ..harness.subagents import register_subagent_tools

        register_subagent_tools(app.state.config, mock=app.state.mock)
{% endif %}        log.debug("web /config: updated sections %s", sorted(k for k in _EDITABLE_FIELDS if k in patch))
{% if spec.mcp.enabled %}        # Keep the registry's MCP tools in lock-step with the new allowlist so what
