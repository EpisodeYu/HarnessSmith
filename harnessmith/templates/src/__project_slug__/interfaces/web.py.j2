    @app.get("/rules")
    def get_rules() -> dict:
        """Return the content of each always-apply rule file the agent injects: the
        explicit ``prompts.rules_files`` plus any auto-recognized convention file
        present at the root (CLAUDE.md), flagged ``auto`` so the panel can show it
        read-only. A not-yet-written (or out-of-repo) file comes back empty. These
        are plain markdown files you own — the AGENTS.md / CLAUDE.md pattern."""
        from ..harness.prompts import _CONVENTION_RULE_FILES

        seen: set[str] = set()
        rules: list[dict] = []

        def _add(path: str, auto: bool) -> None:
            key = str(Path(path))
            if key in seen:
                return
            seen.add(key)
            resolved = _safe_repo_path(path)
            exists = resolved is not None and resolved.is_file()
            if auto and not exists:
                return  # only surface convention files that actually exist
            content = resolved.read_text(encoding="utf-8") if exists else ""
            rules.append({"path": path, "content": content, "exists": exists, "auto": auto})

        for path in app.state.config.prompts.rules_files:
            _add(path, False)
        for path in _CONVENTION_RULE_FILES:
            _add(path, True)
        return {"rules": rules}

    @app.post("/rules")
    async def set_rule(request: Request):
        """Write one rule file's content to disk (markdown you own). The path must be
        relative and stay inside the project directory — absolute paths or ``..``
        escapes are rejected. Add the path to ``prompts.rules_files`` (POST /config)
        for it to be injected."""
        body = await request.json()
        resolved = _safe_repo_path(str(body.get("path", "")).strip())
        if resolved is None:
            return JSONResponse(
                {"error": "path must be relative and inside the project directory"},
                status_code=400,
            )
        resolved.parent.mkdir(parents=True, exist_ok=True)
        resolved.write_text(str(body.get("content", "")), encoding="utf-8")
        return {"ok": True}
