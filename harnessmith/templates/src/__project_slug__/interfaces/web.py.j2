            )
{% endif %}        # Persist the editable fields back to config.yaml (comments preserved) so
        # the edit survives a restart, not just this process. exclude_none keeps
        # unset knobs from being written out as explicit `null`s; secrets are
        # never in _EDITABLE_FIELDS, so only env-var NAMES ever reach the file.
        if app.state.config_path is not None:
            updates = app.state.config.model_dump(
                mode="json", include=set(_EDITABLE_FIELDS), exclude_none=True, by_alias=True
            )
            try:
                save_config(updates, app.state.config_path)
            except Exception as exc:
                return JSONResponse(
                    {"error": f"applied in-process but could not write config.yaml: {exc}"},
                    status_code=500,
                )
        return app.state.config.model_dump(
            mode="json", include=set(_EDITABLE_FIELDS), by_alias=True
        )

    @app.get("/system/config-export")
    def export_config() -> Response:
        """Download the whole config.yaml — every behavioral setting EXCEPT secrets.

        config.yaml only ever stores env-var NAMES (real values live in .env), so
        the exported file is safe to back up / share / move to another machine.
        Returns the on-disk file verbatim (comments preserved) when there is a
        config_path; otherwise serializes the live in-process config to YAML.
        """
        path = app.state.config_path
        if path is not None and Path(path).is_file():
            text = Path(path).read_text(encoding="utf-8")
        else:
            text = yaml.safe_dump(
                app.state.config.model_dump(mode="json", exclude_none=True, by_alias=True),
                sort_keys=False, allow_unicode=True,
            )
        return Response(
            content=text,
            media_type="application/x-yaml",
            headers={"Content-Disposition": "attachment; filename=config.yaml"},
        )

    @app.post("/system/config-import")
    async def import_config(request: Request):
        """Replace the whole runtime config from an uploaded/pasted config.yaml.

        Parses + validates the payload (``Config.model_validate`` — a bad config is
        rejected WITHOUT touching the running one), applies it in-process, and
        writes it back to config.yaml verbatim. Secrets are never accepted here:
        config only holds env-var NAMES; real values stay in .env. Like the MCP
        editor this is a LOCAL, trusted-user control — don't expose /config or this
        endpoint on a public network.
        """
        raw = (await request.body()).decode("utf-8")
        try:
            data = yaml.safe_load(raw) if raw.strip() else None
        except yaml.YAMLError as exc:
            return JSONResponse({"error": f"could not parse config: {exc}"}, status_code=400)
        if not isinstance(data, dict):
            return JSONResponse(
                {"error": "config must be a YAML/JSON mapping at the top level"},
                status_code=400,
            )
        try:
            new_config = Config.model_validate(data)
        except Exception as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        app.state.config = new_config
        # Re-arm runtime state that depends on the new config (mirrors POST /config):
        # the local debug log + any custom @register_* extension modules.
        obs = new_config.observability
        setup_debug_log(obs.debug, obs.debug_dir)
        import_extensions(new_config)
{% if spec.memory.enabled %}        from ..harness.memory import register_memory_tools

        register_memory_tools(new_config)  # re-bind the long-term memory tools
{% endif %}{% if spec.subagents.enabled %}        from ..harness.subagents import register_subagent_tools

        register_subagent_tools(new_config, mock=app.state.mock)  # re-bind the subagents tool to the new roster
{% endif %}{% if spec.mcp.enabled %}        # Rebuild the MCP manager so connected servers + offered tools match the import.
        if app.state.mcp_manager is not None:
            await run_in_threadpool(lambda: _rebuild_mcp_manager(app))
{% endif %}        # Persist verbatim so the imported file survives a restart. No config_path
        # (a config built in code, e.g. tests) -> in-process only, never a stray file.
        if app.state.config_path is not None:
            try:
                Path(app.state.config_path).write_text(raw, encoding="utf-8")
            except Exception as exc:
                return JSONResponse(
                    {"error": f"applied in-process but could not write config.yaml: {exc}"},
                    status_code=500,
                )
        return {"ok": True}

    @app.get("/rules")
    def get_rules() -> dict:
        """Return the content of each always-apply rule file the agent injects: the
        explicit ``prompts.rules_files`` plus any auto-recognized convention file
        present at the root (CLAUDE.md), flagged ``auto`` so the panel can show it
        read-only. A not-yet-written (or out-of-repo) file comes back empty. These
        are plain markdown files you own — the AGENTS.md / CLAUDE.md pattern."""
        from ..harness.prompts import _CONVENTION_RULE_FILES

        seen: set[str] = set()
        rules: list[dict] = []

        def _add(path: str, auto: bool) -> None:
            key = str(Path(path))
            if key in seen:
                return
            seen.add(key)
            resolved = _safe_repo_path(path)
            exists = resolved is not None and resolved.is_file()
            if auto and not exists:
                return  # only surface convention files that actually exist
            content = resolved.read_text(encoding="utf-8") if exists else ""
            rules.append({"path": path, "content": content, "exists": exists, "auto": auto})

        for path in app.state.config.prompts.rules_files:
            _add(path, False)
        for path in _CONVENTION_RULE_FILES:
            _add(path, True)
        return {"rules": rules}

    @app.post("/rules")
    async def set_rule(request: Request):
        """Write one rule file's content to disk (markdown you own). The path must be
        relative and stay inside the project directory — absolute paths or ``..``
        escapes are rejected. Add the path to ``prompts.rules_files`` (POST /config)
        for it to be injected."""
        body = await request.json()
        resolved = _safe_repo_path(str(body.get("path", "")).strip())
        if resolved is None:
            return JSONResponse(
                {"error": "path must be relative and inside the project directory"},
                status_code=400,
            )
        resolved.parent.mkdir(parents=True, exist_ok=True)
        resolved.write_text(str(body.get("content", "")), encoding="utf-8")
        return {"ok": True}
