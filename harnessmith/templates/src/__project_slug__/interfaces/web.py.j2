    @app.post("/env")
    async def set_env(request: Request):
        """Write a secret VALUE into the local .env (write-only; never returned).

        config.yaml stores only the env-var NAME; this fills its value in .env
        (gitignored). The value is never echoed back, logged, or put in config.
        """
        body = await request.json()
        name = str(body.get("name", "")).strip()
        if not name:
            return JSONResponse({"error": "name required"}, status_code=400)
        try:
            set_env_value(name, str(body.get("value", "")))
        except ConfigError as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        return {"ok": True, "name": name}  # never return the value

    @app.post("/test-llm")
    async def test_llm(request: Request) -> dict:
        """Probe one LLM profile and return ``{ok, error}`` FAST.

        All this needs to prove is reachable + authenticated + the model exists —
        NOT a thoughtful reply. So it STREAMS and bails the instant the first chunk
        lands (which only happens after the endpoint has accepted the request), then
        closes the connection. A reasoning model (MiMo / DeepSeek-thinking / …) would
        otherwise spend 5-10s deliberating over "ping" before a non-streaming call
        returns — and lowering ``reasoning_effort`` doesn't help, the model thinks
        regardless. First-chunk latency is ~1s instead, on reasoning and plain models
        alike, so there is no reasoning-effort dance and no second probe.

        Reliability is overridden for the probe (``_PROBE_TIMEOUT_SECONDS``, no
        retries): the loop's profile may set a long/absent timeout + retries, which
        would let a dead endpoint hang for minutes. The probe must fail in seconds.
        Uses the same client class as the loop, so a genuine failure surfaces the
        real provider error (401/404/timeout). Secrets stay server-side — the request
        carries the env-var NAME, the key is resolved from .env here. Obvious config
        gaps (no model, unresolved key with no custom base_url) are reported up front
        without a network call.
        """
        body = await request.json()
        try:
            profile = LLMProfileConfig.model_validate(body)
        except Exception as exc:
            return {"ok": False, "error": f"invalid profile: {exc}"}
        if not profile.model.strip():
            return {"ok": False, "error": "model is required"}
        api_key = resolve_env(profile.api_key_env)
        base_url = resolve_env(profile.base_url_env)
        if not api_key and not base_url:
            return {"ok": False, "error": (
                f"no API key: env var {profile.api_key_env} is not set in .env or the "
                "environment — set its value first (or configure a custom base_url)"
            )}

        # Clamp reliability to a fast-fail check, then stream and stop at chunk #1
        # (`cancel` returns True on the loop's first check — the chunk has already
        # arrived from the network, proving the round-trip worked — so the stream is
        # closed without waiting for the full answer).
        probe = profile.model_copy(update={
            "timeout_seconds": min(profile.timeout_seconds or _PROBE_TIMEOUT_SECONDS, _PROBE_TIMEOUT_SECONDS),
            "max_retries": 0,
        })

        def _probe() -> None:
            _client_for_profile(probe).stream(
                [{"role": "user", "content": "ping"}], None, cancel=lambda: True,
            )

        try:
            await run_in_threadpool(_probe)
            return {"ok": True}
        except Exception as exc:
            return {"ok": False, "error": str(exc)}

    @app.post("/config")
    async def set_config(request: Request):
        patch = await request.json()
        current = app.state.config.model_dump(mode="json", by_alias=True)
        for key in _EDITABLE_FIELDS:  # secrets/structural keys are ignored
            if key in patch:
                current[key] = patch[key]
        try:
            new_config = Config.model_validate(current)
            # Import any newly-added extensions module so its @register_* run now
            # and show up in /registries; a bad module name fails the save cleanly
            # (and leaves the running config untouched). Removing a module here
            # cannot un-import it — that takes a restart (documented).
            import_extensions(new_config)
        except Exception as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        app.state.config = new_config
        # Re-arm the local debug log so the Observability toggle takes effect
        # immediately (no restart). Section NAMES only — values never logged here.
        obs = app.state.config.observability
        setup_debug_log(obs.debug, obs.debug_dir)
