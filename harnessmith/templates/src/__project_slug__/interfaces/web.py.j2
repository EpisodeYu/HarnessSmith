    @app.post("/memory")
    async def set_memory(request: Request):
        """Overwrite the whole memory note (manual curation). Rejected when memory
        is configured read-only or the backend has no writable note."""
        from ..harness.memory import get_backend

        cfg = app.state.config
        if cfg.memory.read_only:
            return JSONResponse({"error": "memory is read-only"}, status_code=400)
        backend = get_backend(cfg)
        if backend is None or not hasattr(backend, "write"):
            return JSONResponse(
                {"error": "memory backend has no writable note"}, status_code=400
            )
        backend.write(str((await request.json()).get("content", "")))
        return {"ok": True}

    @app.delete("/memory")
    def clear_memory() -> dict:
        """Forget everything (clear the note). Idempotent."""
        from ..harness.memory import get_backend

