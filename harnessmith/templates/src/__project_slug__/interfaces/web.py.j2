def _persist_config_keys(app, keys: list[str]) -> None:
    """Best-effort write of the named top-level config keys back to config.yaml
    (comments preserved). No-op without a config_path (an in-memory config, e.g.
    tests), so a runtime edit never spawns a stray file. Secrets never appear here
    — MCP server config carries only env-var NAMES."""
    if app.state.config_path is None:
        return
    from ..harness.config import save_config

    dump = app.state.config.model_dump(mode="json", exclude_none=True)
    updates = {key: dump[key] for key in keys if key in dump}
    try:
        save_config(updates, app.state.config_path)
    except Exception:
        pass  # in-process change still applies; persistence is best-effort


def _ensure_mcp_manager(app):
    """Return the live MCP manager, starting it on first use — NON-blocking.

    Connects EVERY configured server (so the management page has live status +
    discovery) but registers only allowlisted tools into the registry. Idempotent
    and lock-guarded. The connect runs on the manager's own thread and a background
    warmer registers the tools once the first round settles, so ``/mcp/status`` can
    immediately report a live "connecting" state instead of hanging until every
    (possibly slow uvx/npx cold-start) server is up.
    """
    from ..harness.mcp import McpManager, sync_mcp_tools

    with app.state.mcp_lock:
        if app.state.mcp_manager is None:
            # on_connected: re-sync the registry on EVERY (re)connect, so a server
            # that auto-heals in the background still gets its tools to the model.
            manager = McpManager(
                app.state.config.mcp,
                on_connected=lambda m: sync_mcp_tools(app.state.config, m),
            )
            manager.begin()  # start connecting without blocking the request
            app.state.mcp_manager = manager
            _warm_mcp_tools(app, manager)
        return app.state.mcp_manager


def _warm_mcp_tools(app, manager, close_after=None):
    """Background: wait for the first connect round to settle, then sync the registry
    (and optionally close a superseded manager). Keeps tool registration off the
    request path so the UI can show live connecting status."""
    from ..harness.mcp import sync_mcp_tools

    def run():
        try:
            manager.wait_ready()
            sync_mcp_tools(app.state.config, manager)
        finally:
            if close_after is not None:
                close_after.close()

    threading.Thread(target=run, daemon=True).start()


def _rebuild_mcp_manager(app):
    """Hot-reconnect after a server add/edit/delete: rebuild the manager from the
    current config (the new one is started before the old is closed) and re-sync
    the registry, so the page, the live sessions, and the model's tools all agree.
    """
    from ..harness.mcp import rebuild_manager, sync_mcp_tools

    with app.state.mcp_lock:
        manager = rebuild_manager(
            app.state.mcp_manager,
            app.state.config.mcp,
            on_connected=lambda m: sync_mcp_tools(app.state.config, m),
        )
        sync_mcp_tools(app.state.config, manager)
        app.state.mcp_manager = manager
        return manager
