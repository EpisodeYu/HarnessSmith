    @app.post("/usage/clear")
    async def clear_usage(request: Request):
        """Reset one LLM's accrued usage (``{"profile": name}``) or all of them
        (``{"all": true}``). Manual only — usage never auto-clears, not even when a
        profile's model changes."""
        body = await request.json()
        ledger = UsageLedger()
        if body.get("all"):
            ledger.clear_all()
        else:
            name = str(body.get("profile", "")).strip()
            if not name:
                return JSONResponse({"error": "profile or all required"}, status_code=400)
            ledger.clear(name)
        return {"ok": True, "profiles": ledger.snapshot(app.state.config)}
