      const obs = cfg.observability || {};
      $("cfg-obs-trace").checked = !!obs.trace;
      $("cfg-obs-tracedir").value = obs.trace_dir || "traces";
      $("cfg-obs-debug").checked = !!obs.debug;
      $("cfg-obs-debugdir").value = obs.debug_dir || "logs";
      // System tab: extensions / hooks editors + read-only registry mirror
      buildExtensions();
      buildHooks();
      buildRegistered();
    }

    function collectConfig() {
      const patch = {};
      patch.llms = Array.from(document.querySelectorAll("#cfg-profiles .profile"))
        .map(cardToProfile)
        .filter((o) => o.name || o.model);  // drop empty (freshly-added, unfilled) cards
      const roles = {};
      document.querySelectorAll("#cfg-roles .role-target").forEach((el) => {
        if (el.value.trim()) roles[el.dataset.role] = el.value.trim();
      });
      patch.roles = roles;
      patch.context = {
        strategy: $("cfg-ctx-strategy").value,
        keep_last_turns: Number($("cfg-ctx-keep").value || 6),
        combine: $("cfg-ctx-combine").value,
        max_tool_result_chars: Number($("cfg-ctx-toolcap").value || 0),
      };
      const triggers = {};
      document.querySelectorAll("#cfg-ctx-triggers .cfg-trigger").forEach((el) => {
        const v = numOrNull(el.value); if (v != null) triggers[el.dataset.cond] = v;
      });
      patch.context.triggers = triggers;
      // Pricing + per-LLM cost limit are edited on the Budget tab; merge them into
      // the llms patch by name so a Save from any tab keeps them (a profile with no
      // Budget row — e.g. just added — defaults to free / no limit).
      const budByName = {};
      document.querySelectorAll("#cfg-bud-rows .bud-row").forEach((row) => {
        budByName[row.dataset.name] = {
          input_cost_per_million: numOrNull(row.querySelector(".b-input").value) ?? 0,
          output_cost_per_million: numOrNull(row.querySelector(".b-output").value) ?? 0,
          cached_input_cost_per_million: numOrNull(row.querySelector(".b-cached").value) ?? 0,
          cost_limit: numOrNull(row.querySelector(".b-limit").value) ?? 0,
        };
      });
      patch.llms.forEach((p) => {
        Object.assign(p, budByName[p.name] || {
          input_cost_per_million: 0, output_cost_per_million: 0,
          cached_input_cost_per_million: 0, cost_limit: 0,
        });
      });
      // reasoning_history_field is a yaml-only expert knob (no card input): carry a
      // non-default value over by name so a Save from any tab never silently
      // reverts it (the whole llms list is replaced on POST /config).
      const origByName = {};
      (cfg.llms || []).forEach((p) => { if (p && p.name) origByName[p.name] = p; });
      patch.llms.forEach((p) => {
        const orig = origByName[p.name];
        if (orig && orig.reasoning_history_field && orig.reasoning_history_field !== "reasoning_content") {
          p.reasoning_history_field = orig.reasoning_history_field;
        }
      });
      // Collect from the live checkboxes: a previously-listed tool always
      // round-trips (unchecking just disables it); a discovered tool is written to
      // the allowlist only when ticked, so config isn't bloated with every tool a
      // server happens to expose. A fully-on MCP server collapses to a single
      // `<server>__*` wildcard (so future tools stay enabled too).
      const toolsOut = [];
      const pushCb = (cb) => {
        if (cb.dataset.listed === "1" || cb.checked) toolsOut.push({ name: cb.dataset.name, enabled: cb.checked });
      };
      document.querySelectorAll("#cfg-tools .tool-en").forEach((cb) => {
        if (!cb.closest("details")) pushCb(cb);  // local (custom/built-in) tool
      });
      document.querySelectorAll("#cfg-tools details").forEach((d) => {
        const master = d.querySelector(".mcp-master");
        const cbs = Array.from(d.querySelectorAll(".tool-en"));
        if (master && cbs.length && cbs.every((c) => c.checked)) {
          toolsOut.push({ name: master.dataset.server + "__*", enabled: true });
        } else {
          cbs.forEach(pushCb);
        }
      });
      patch.tools = toolsOut;
      const prompts = {};
      if ($("cfg-p-system").value.trim()) prompts.system = $("cfg-p-system").value.trim();
      // Only explicit rows go into rules_files; auto-recognized convention files
      // (root CLAUDE.md) are injected by convention and stay out of the list.
      prompts.rules_files = Array.from(document.querySelectorAll("#cfg-rules .rule"))
        .filter((row) => row.dataset.auto !== "1")
        .map((row) => row.querySelector(".r-path").value.trim()).filter(Boolean);
      patch.prompts = prompts;
      patch.paradigms = {
        enabled: Array.from(document.querySelectorAll(".cfg-par-cb"))
          .filter((c) => c.checked).map((c) => c.dataset.name),
        default: $("cfg-par-default").value.trim(),
      };
      patch.observability = {
        trace: $("cfg-obs-trace").checked, trace_dir: $("cfg-obs-tracedir").value.trim() || "traces",
        debug: $("cfg-obs-debug").checked, debug_dir: $("cfg-obs-debugdir").value.trim() || "logs",
      };
{% if spec.memory.enabled %}      // Memory config knobs (the note body is saved separately). Spread the
      // current memory config first so unsurfaced fields (path) round-trip.
      patch.memory = Object.assign({}, cfg.memory || {}, {
        backend: $("cfg-mem-backend").value,
        read_only: $("cfg-mem-readonly").checked,
        inject_max_chars: Number($("cfg-mem-capacity").value || 4000),
        auto_consolidate: $("cfg-mem-auto").checked,
        policy: $("cfg-mem-policy").value.trim() || null,
      });
{% endif %}      // Extensions: dotted module paths (drop blanks).
      patch.extensions = Array.from(document.querySelectorAll("#cfg-extensions .ext-mod"))
        .map((el) => el.value.trim()).filter(Boolean);
      // Hooks: always a list ({class, enabled, config}); a blank class row is
      // skipped, invalid config JSON falls back to {} (flagged red in the UI).
      const hooksOut = [];
      document.querySelectorAll("#cfg-hooks .hook-row").forEach((row) => {
        const cls = row.querySelector(".hk-class").value.trim();
        if (!cls) return;
        let config = {};
        const raw = row.querySelector(".hk-config").value.trim();
        if (raw) { try { const v = JSON.parse(raw); if (v && typeof v === "object" && !Array.isArray(v)) config = v; } catch (e) {} }
        hooksOut.push({ class: cls, enabled: row.querySelector(".hk-enabled").checked, config });
      });
      patch.hooks = hooksOut;
      return patch;
    }

    // Everything the config view persists, serialized: the config patch plus the
    // rule-file editor rows (path + body, which Save writes via POST /rules but
    // collectConfig doesn't carry). Comparing this to `savedSnapshot` is how we
    // decide "unsaved", so it must be a pure read of the current DOM.
    function configSnapshot() {
      const rules = Array.from(document.querySelectorAll("#cfg-rules .rule"))
        .map((row) => [row.querySelector(".r-path").value, row.querySelector(".r-content").value]);
      return JSON.stringify([collectConfig(), rules]);
    }
    // Recompute "unsaved" from the actual view vs. the last saved snapshot. Driven
    // by edits (and rule add/remove); using a comparison rather than a sticky flag
    // means a stray event from a programmatic rebuild can't leave it wrongly set.
    function refreshDirty() { setDirty(configSnapshot() !== savedSnapshot); }
    // Capture the current view as the saved baseline (call after load/Save once
    // the DOM reflects server state), then clear the marker.
    function markSaved() { savedSnapshot = configSnapshot(); setDirty(false); }

    // Flip the unsaved marker + highlight the Save button so a forgotten Save is
    // visible.
    function setDirty(v) {
      dirty = v;
      $("cfg-unsaved").classList.toggle("hidden", !v);
      $("cfg-save").classList.toggle("ring-2", v);
      $("cfg-save").classList.toggle("ring-amber-400", v);
    }

    async function loadUsage() {
      try { usageRows = (await (await fetch("/usage")).json()).profiles || []; }
      catch (e) { usageRows = []; }
    }
    async function loadEnvStatus() {
      // {NAME: bool} — which configured key/url env-vars resolve to a value (never
      // the value itself). On error keep the last map; nothing masked is harmless.
      try { envStatus = await (await fetch("/env-status")).json(); } catch (e) {}
    }
    async function loadConfig() {
      cfg = await (await fetch("/config")).json();
      try { reg = await (await fetch("/registries")).json(); } catch (e) { /* keep last */ }
      await loadUsage();  // per-LLM accrued cost/tokens for the Budget tab
      await loadRules();  // rule files (explicit + auto-recognized) for the Prompts tab
      await loadEnvStatus();  // mask any key/url already set in .env on (re)render
{% if spec.memory.enabled %}      await loadMemory();  // the long-term memory note for the Memory tab
{% endif %}      renderConfig();
      gateChat();
      populateGenerator();  // the chat generator dropdown mirrors roles.generation
      markSaved();  // the freshly rendered view is, by definition, the saved state
      $("cfg-status").textContent = "";
    }
    $("cfg-add-profile").addEventListener("click", () => {
      $("cfg-profiles").appendChild(profileCard({}, true));  // new card: key/url empty, not masked
      buildRoles();  // a new (empty) profile may already provide a name to bind
    });
    // Keep the role dropdowns in sync as profile names are typed; flag invalid
    // extra_body JSON live (it's dropped on Save, never sent half-parsed).
    $("cfg-profiles").addEventListener("input", (e) => {
      if (e.target.classList.contains("p-name")) buildRoles();
      if (e.target.classList.contains("p-extra")) {
        const txt = e.target.value.trim();
        let ok = true;
        if (txt) { try { const v = JSON.parse(txt); ok = v && typeof v === "object" && !Array.isArray(v); } catch (err) { ok = false; } }
        e.target.classList.toggle("border-red-500", !ok);
      }
    });
    // Test a profile, remove it, or write an env-var VALUE (api key / base url)
    // into the local .env (gitignored). Written values are write-only: posted
    // once, never read back into the UI.
    $("cfg-profiles").addEventListener("click", async (e) => {
      const rm = e.target.closest(".p-remove");
      if (rm) { rm.closest(".profile").remove(); buildRoles(); return; }
      const testBtn = e.target.closest(".p-test");
      if (testBtn) {
        const row = testBtn.closest(".profile");
        const status = row.querySelector(".p-teststatus");
        status.className = "p-teststatus text-xs text-slate-500";
        status.textContent = t("test_running");
        testBtn.disabled = true;
        // Client-side deadline so the button never hangs forever if the server is
        // wedged — a touch above the server's own probe cap to let its result win.
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 30000);
        try {
          const resp = await fetch("/test-llm", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(cardToProfile(row)), signal: ctrl.signal,
          });
          const data = await resp.json();
          if (data.ok) { status.className = "p-teststatus text-xs font-semibold text-emerald-700"; status.textContent = "PASSED"; }
          else { status.className = "p-teststatus text-xs text-red-600"; status.textContent = data.error || t("cfg_invalid"); }
        } catch (err) {
          status.className = "p-teststatus text-xs text-red-600";
          status.textContent = err && err.name === "AbortError" ? t("test_timeout") : String(err);
        } finally { clearTimeout(timer); testBtn.disabled = false; }
        return;
      }
      const isKey = e.target.closest(".p-setkey");
      const btn = isKey || e.target.closest(".p-seturl");
      if (!btn) return;
      const row = btn.closest(".profile");
      const sel = isKey
        ? { name: ".p-key", val: ".p-keyval", status: ".p-keystatus" }
        : { name: ".p-baseurl", val: ".p-urlval", status: ".p-urlstatus" };
      const name = row.querySelector(sel.name).value.trim();
      const status = row.querySelector(sel.status);
      const valEl = row.querySelector(sel.val);
      if (!name) { status.textContent = t("key_need_name"); return; }
      // Still masked => already set in .env and untouched: don't overwrite it with
      // the placeholder, and never POST the sentinel.
      if (valEl.dataset.masked === "1") { status.textContent = t("key_unchanged"); return; }
      const resp = await fetch("/env", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, value: valEl.value }),
      });
      const data = await resp.json();
      if (resp.ok) {
        // Don't clear: re-mask the box (the value is in .env now, never echoed) and
        // remember it's set so a Save-driven re-render keeps the placeholder.
        valEl.value = ENV_MASK; valEl.dataset.masked = "1";
        envStatus[name] = true;
        status.textContent = t("key_saved");
      } else { status.textContent = data.error || t("cfg_invalid"); }
    });
    // Masked key/url boxes: focusing clears the placeholder so a new value can be
    // typed; leaving it empty restores the mask (an idle click never wipes the
    // stored value). A non-empty edit drops the masked flag => it gets written.
    $("cfg-profiles").addEventListener("focusin", (e) => {
      const el = e.target;
      if (el.dataset && el.dataset.masked === "1" &&
          (el.classList.contains("p-keyval") || el.classList.contains("p-urlval"))) {
        el.value = ""; el.dataset.masked = "editing";
      }
    });
    $("cfg-profiles").addEventListener("focusout", (e) => {
      const el = e.target;
      if (el.dataset && el.dataset.masked === "editing" &&
          (el.classList.contains("p-keyval") || el.classList.contains("p-urlval"))) {
        if (el.value === "") { el.value = ENV_MASK; el.dataset.masked = "1"; }
        else { delete el.dataset.masked; }
      }
    });
    // Recompute "unsaved" by comparing the live view to the saved snapshot on
    // every edit (delegated). This is robust to the spurious input/change events a
    // programmatic rebuild fires while tearing down focused fields: those don't
    // change the serialized form, so the view still reads as saved.
    $("view-config").addEventListener("input", refreshDirty);
    $("view-config").addEventListener("change", refreshDirty);

    // Budget tab: recompute a card's derived cost live as a price/limit is edited
    // (refreshDirty already fires via the view-config input listener above).
    $("cfg-bud-rows").addEventListener("input", (e) => {
      const div = e.target.closest(".bud-row");
      if (div) updateBudCost(div);
    });
    // Per-LLM "Clear" resets that counter on the server immediately (no Save), then
