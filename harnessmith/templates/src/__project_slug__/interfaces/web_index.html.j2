    function show(which) {
      $("view-chat").classList.toggle("hidden", which !== "chat");
      $("view-config").classList.toggle("hidden", which !== "config");
      // Active = bold text only (no filled box), so the Config row stays visually
      // consistent with the Theme row above it (especially in dark mode).
      $("tab-config").classList.toggle("font-medium", which === "config");
      updateMainTitle();
      // Don't reload over unsaved edits when coming back to Config — that silent
      // overwrite was the main way users lost a profile they forgot to Save.
      if (which === "config") { showCfg(cfgTab); if (!dirty) loadConfig(); }
    }
    // Leaving Config with unsaved edits: remind that they won't apply until Saved.
    function leaveConfigOk() {
      if (!dirty || $("view-config").classList.contains("hidden")) return true;
      return confirm(t("cfg_leave_confirm"));
    }
    $("tab-chat").addEventListener("click", () => { if (leaveConfigOk()) show("chat"); });
    $("tab-config").addEventListener("click", () => show("config"));
    $("no-llm-link").addEventListener("click", () => { show("config"); showCfg("llm"); });
    // A reload/close drops in-DOM edits entirely — let the browser confirm.
    window.addEventListener("beforeunload", (e) => {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = "";
    });

    // ---- System tab: theme + streaming + language + config import/export ----
    // Theme is a pure client-side preference (light default / dark) kept in
    // localStorage; the head script applies it pre-paint, this keeps the toggle in
    // sync and repaints on click.
    const THEME_KEY = "hf_theme";
    function themePref() { return localStorage.getItem(THEME_KEY) === "dark" ? "dark" : "light"; }
    function applyTheme() {
      const pref = themePref();
      document.documentElement.classList.toggle("dark", pref === "dark");
      document.querySelectorAll("#theme-toggle [data-theme]").forEach((b) => {
        b.classList.toggle("bg-slate-200", b.dataset.theme === pref);
      });
    }
    document.querySelectorAll("#theme-toggle [data-theme]").forEach((b) => {
      b.addEventListener("click", () => { localStorage.setItem(THEME_KEY, b.dataset.theme); applyTheme(); });
    });

    // Streaming is a client-side chat preference (enabled by default): it drives
    // the `/chat?stream=` flag. Kept in localStorage (`hf_stream`, "0" = disabled).
    const STREAM_KEY = "hf_stream";
    function streamEnabled() { return localStorage.getItem(STREAM_KEY) !== "0"; }
    function applyStreamToggle() {
      const on = streamEnabled();
      document.querySelectorAll("#sys-stream-toggle [data-stream]").forEach((b) => {
        b.classList.toggle("bg-slate-200", (b.dataset.stream === "1") === on);
      });
    }
    document.querySelectorAll("#sys-stream-toggle [data-stream]").forEach((b) => {
      b.addEventListener("click", () => { localStorage.setItem(STREAM_KEY, b.dataset.stream); applyStreamToggle(); });
    });

    // Language selector in the System tab mirrors the sidebar one (shared state).
    const sysLangSel = $("sys-lang");
    if (sysLangSel) sysLangSel.addEventListener("change", () => {
      lang = sysLangSel.value; localStorage.setItem("hf_lang", lang); applyI18n();
    });

    // Export: download the current config.yaml (no secrets — keys live in .env).
    $("sys-export").addEventListener("click", () => {
      const a = document.createElement("a");
      a.href = "/system/config-export"; a.download = "config.yaml";
      document.body.appendChild(a); a.click(); a.remove();
    });
    // Import: load a file into the textarea, then POST the text (raw YAML/JSON) to
    // /system/config-import which validates + applies + persists it. Acts
    // immediately (not via the Save button); a refresh re-renders every tab.
    $("sys-import-file").addEventListener("change", async (e) => {
      const f = e.target.files[0];
      if (f) $("sys-import-text").value = await f.text();
    });
    $("sys-import").addEventListener("click", async () => {
      const status = $("sys-import-status");
      const text = $("sys-import-text").value;
      if (!text.trim()) { status.className = "text-xs text-red-600"; status.textContent = t("sys_import_failed"); return; }
      if (!confirm(t("sys_import_confirm"))) return;
      try {
        const resp = await fetch("/system/config-import", {
          method: "POST", headers: { "Content-Type": "text/plain" }, body: text,
        });
        const data = await resp.json();
        if (resp.ok) {
          status.className = "text-xs text-emerald-700"; status.textContent = t("sys_import_done");
          $("sys-import-text").value = ""; $("sys-import-file").value = "";
          await loadConfig(); loadParadigms();  // re-render every tab + chat-mode list
        } else {
          status.className = "text-xs text-red-600"; status.textContent = data.error || t("cfg_invalid");
        }
      } catch (err) { status.className = "text-xs text-red-600"; status.textContent = String(err); }
    });

    applyI18n();
    applyTheme();
    applyStreamToggle();
    loadConfig();  // populate cfg up front so the chat gate (no-LLM banner) is correct
  </script>
</body>
</html>
