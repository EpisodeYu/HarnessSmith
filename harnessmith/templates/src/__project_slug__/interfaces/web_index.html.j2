<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ display_name }} — web</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Apply the saved theme BEFORE first paint so there is no flash of the wrong
    // theme. `hf_theme` is "light" (default) or "dark".
    (function () {
      try {
        document.documentElement.classList.toggle(
          "dark", localStorage.getItem("hf_theme") === "dark"
        );
      } catch (e) {}
    })();
  </script>
  <style>
    /* Dark theme: a contained override of the (limited) light palette this page
       uses via the Tailwind CDN. Toggling `dark` on <html> repaints the few
       surface / text / border tokens below — no per-element dark: classes needed. */
    html.dark { color-scheme: dark; }
    html.dark body { background-color: #0f172a; color: #e2e8f0; }
    html.dark .bg-white { background-color: #1e293b !important; }
    html.dark .bg-slate-50 { background-color: #0f172a !important; }
    html.dark .bg-slate-100 { background-color: #334155 !important; }
    html.dark .bg-slate-200 { background-color: #475569 !important; }
    html.dark .hover\:bg-slate-50:hover { background-color: #1e293b !important; }
    html.dark .hover\:bg-slate-100:hover { background-color: #334155 !important; }
    /* Default + slate borders go neutral-dark; accent borders are kept below. */
    html.dark *, html.dark ::before, html.dark ::after { border-color: #334155; }
    html.dark .border-slate-800 { border-color: #e2e8f0 !important; }
    html.dark .text-slate-900 { color: #f1f5f9 !important; }
    html.dark .text-slate-800 { color: #e2e8f0 !important; }
    html.dark .text-slate-700 { color: #cbd5e1 !important; }
    html.dark .text-slate-600 { color: #cbd5e1 !important; }
    html.dark .text-slate-500 { color: #94a3b8 !important; }
    html.dark .text-slate-400 { color: #94a3b8 !important; }
    html.dark .text-gray-500 { color: #94a3b8 !important; }
    html.dark input, html.dark select, html.dark textarea {
      background-color: #0f172a; color: #e2e8f0; border-color: #475569;
    }
    html.dark input::placeholder, html.dark textarea::placeholder { color: #64748b; }
    /* Tinted accent surfaces -> dark tints + lightened accent text. */
    html.dark .bg-amber-50 { background-color: #3f2d0b !important; }
    html.dark .bg-indigo-50 { background-color: #26264f !important; }
    html.dark .bg-red-50 { background-color: #3f1d1d !important; }
    html.dark .bg-red-100 { background-color: #4a1414 !important; }
    html.dark .bg-emerald-100 { background-color: #0c3b30 !important; }
    html.dark .text-amber-800 { color: #fde68a !important; }
    html.dark .text-amber-700 { color: #fcd34d !important; }
    html.dark .text-amber-600 { color: #fbbf24 !important; }
    html.dark .text-indigo-700 { color: #c7d2fe !important; }
    html.dark .text-red-700 { color: #fca5a5 !important; }
    html.dark .text-emerald-700 { color: #6ee7b7 !important; }
    html.dark .text-emerald-600 { color: #34d399 !important; }
    html.dark .border-amber-300 { border-color: #b45309 !important; }
    html.dark .border-indigo-300 { border-color: #6366f1 !important; }
    html.dark .border-red-300 { border-color: #b91c1c !important; }
    html.dark .border-red-500 { border-color: #ef4444 !important; }

    /* Collapsible reasoning / tool blocks: hide the native triangle, drive a small
       chevron that rotates open. Used by the chat's thinking box + tool-call cards. */
    details.hf-block > summary { list-style: none; }
    details.hf-block > summary::-webkit-details-marker { display: none; }
    .hf-chevron { display: inline-block; transition: transform .15s ease; }
    details.hf-block[open] > summary .hf-chevron { transform: rotate(90deg); }
    /* Animated "…" for the live "thinking" indicator (three blinking dots). */
    .hf-dots span { animation: hf-blink 1.2s infinite both; }
    .hf-dots span:nth-child(2) { animation-delay: .2s; }
    .hf-dots span:nth-child(3) { animation-delay: .4s; }
    @keyframes hf-blink { 0%, 80%, 100% { opacity: .2; } 40% { opacity: 1; } }
  </style>
</head>
<body class="h-screen overflow-hidden bg-slate-50 text-slate-800">
  <div class="flex h-screen">
    <aside class="flex w-64 shrink-0 flex-col border-r border-slate-200 bg-white">
      <div class="px-3 py-3">
        <h1 class="truncate text-base font-semibold" title="{{ display_name }}">{{ display_name }}</h1>
      </div>
      <div class="px-3 pb-2">
        <button id="chat-new" type="button" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-left text-sm hover:bg-slate-50" data-i18n="chat_new">+ New chat</button>
      </div>
      <div id="session-list" class="flex-1 space-y-0.5 overflow-y-auto px-2 pb-2 text-sm"></div>
      <div class="flex items-center gap-2 border-t border-slate-200 px-3 py-2 text-sm">
        <span class="flex-1 rounded-lg px-2 py-1 text-left text-slate-600">🎨 <span data-i18n="theme_label">Theme</span></span>
        <div id="theme-toggle" class="flex items-center gap-0.5 rounded-lg border border-slate-300 p-0.5">
          <button type="button" data-theme="light" class="rounded px-1.5 py-0.5 text-xs" data-i18n-title="theme_light" title="Light">☀</button>
          <button type="button" data-theme="dark" class="rounded px-1.5 py-0.5 text-xs" data-i18n-title="theme_dark" title="Dark">🌙</button>
        </div>
      </div>
      <div class="flex items-center gap-2 border-t border-slate-200 px-3 py-2 text-sm">
        <button id="tab-chat" type="button" class="hidden" data-i18n="nav_chat">Chat</button>
        <button id="tab-config" type="button" class="flex-1 cursor-pointer rounded-lg px-2 py-1 text-left text-slate-600">⚙ <span data-i18n="nav_config">Config</span></button>
      </div>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex items-center gap-2 border-b border-slate-200 bg-white px-6 py-3">
        <h2 id="main-title" class="truncate text-sm font-medium text-slate-700"></h2>
      </div>

      <section id="view-chat" class="flex min-h-0 flex-1 flex-col">
        <div id="no-llm" class="m-4 hidden rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800">
          <span data-i18n="no_llm">Please configure an LLM first.</span>
          <button id="no-llm-link" type="button" class="ml-1 underline" data-i18n="no_llm_link">Go to Config → LLM</button>
        </div>
        <div id="log" class="flex-1 space-y-2 overflow-y-auto px-6 py-4 text-sm"></div>
        <form id="chat-form" class="flex flex-col gap-2 border-t border-slate-200 bg-white px-6 py-3">
          <div class="flex items-center gap-2">
            <input id="msg" class="flex-1 rounded-lg border px-3 py-2" data-i18n-ph="chat_placeholder" placeholder="Ask something…" autocomplete="off" />
            <div class="relative shrink-0">
              <button id="ctx-meter" type="button" class="inline-flex h-9 w-9 items-center justify-center" data-i18n-title="ctx_meter_title" title="Context usage">
                <svg viewBox="0 0 36 36" class="h-8 w-8 -rotate-90">
                  <circle cx="18" cy="18" r="15.5" fill="none" stroke="#e2e8f0" stroke-width="3.5"></circle>
                  <circle id="ctx-meter-arc" cx="18" cy="18" r="15.5" fill="none" stroke="#94a3b8" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="97.39" stroke-dashoffset="97.39"></circle>
                </svg>
                <span id="ctx-meter-label" class="absolute inset-0 flex items-center justify-center text-[9px] font-medium text-slate-600"></span>
              </button>
              <div id="ctx-meter-pop" class="absolute bottom-full right-0 mb-2 hidden whitespace-nowrap rounded-lg bg-slate-800 px-2.5 py-1.5 text-xs text-white shadow-lg"></div>
            </div>
            <button id="chat-send" class="rounded-lg bg-slate-800 px-4 py-2 text-white" data-i18n="chat_send">Send</button>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <select id="mode" class="rounded-lg border px-2 py-1 text-sm" data-i18n-title="chat_mode_title" title="Loop paradigm"></select>
            <select id="gen-llm" class="rounded-lg border px-2 py-1 text-sm" data-i18n-title="chat_gen_title" title="Generator LLM (generation role)"></select>
            <label class="flex min-w-0 flex-1 items-center gap-1">
              <span class="shrink-0" data-i18n="chat_cwd_label">Folder</span>
              <input id="cwd" class="min-w-0 flex-1 rounded-lg border px-2 py-1 text-sm" data-i18n-ph="chat_cwd_ph" placeholder="Working directory (optional)" autocomplete="off" />
              <button id="cwd-browse" type="button" class="shrink-0 rounded-lg border px-2 py-1 text-xs" data-i18n="chat_cwd_browse" title="Browse folders">Browse</button>
              <button id="cwd-clear" type="button" class="shrink-0 rounded-lg border px-2 py-1 text-xs text-slate-500" data-i18n="chat_cwd_clear" title="Clear folder">Clear</button>
            </label>
          </div>
        </form>
      </section>

      <div id="fs-modal" class="fixed inset-0 z-20 hidden items-center justify-center bg-black/40 p-4">
        <div class="flex max-h-[80vh] w-full max-w-lg flex-col rounded-xl bg-white shadow-xl dark:bg-slate-800">
          <div class="border-b border-slate-200 px-4 py-3 dark:border-slate-700">
            <h3 class="text-sm font-medium" data-i18n="fs_title">Choose a working directory</h3>
            <p id="fs-path" class="mt-1 truncate font-mono text-xs text-slate-500"></p>
          </div>
          <div class="flex items-center gap-2 border-b border-slate-200 px-4 py-2 dark:border-slate-700">
            <button id="fs-up" type="button" class="rounded-lg border px-2 py-1 text-xs" data-i18n="fs_up">↑ Up</button>
            <span id="fs-status" class="text-xs text-slate-400"></span>
          </div>
          <div id="fs-list" class="min-h-0 flex-1 overflow-y-auto px-2 py-2 text-sm"></div>
          <div class="flex items-center justify-end gap-2 border-t border-slate-200 px-4 py-3 dark:border-slate-700">
            <button id="fs-cancel" type="button" class="rounded-lg border px-3 py-1 text-sm" data-i18n="fs_cancel">Cancel</button>
            <button id="fs-use" type="button" class="rounded-lg bg-slate-800 px-3 py-1 text-sm text-white" data-i18n="fs_use">Use this folder</button>
          </div>
        </div>
      </div>

      <section id="view-config" class="hidden flex-1 space-y-4 overflow-y-auto px-6 py-4">
      <nav id="cfg-tabs" class="flex flex-wrap gap-1 border-b text-sm"></nav>

      <div data-cfg="llm" class="space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="text-sm font-medium" data-i18n="profiles_label">LLM profiles</h4>
          <button id="cfg-add-profile" type="button" class="rounded-lg border px-3 py-1 text-sm" data-i18n="profile_add">+ Add profile</button>
        </div>
        <div id="cfg-profiles" class="space-y-3"></div>
        <div class="border-t pt-3">
          <h4 class="text-sm font-medium" data-i18n="roles_label">Roles</h4>
          <div id="cfg-roles" class="mt-2 space-y-2"></div>
        </div>
      </div>

      <div data-cfg="context" class="hidden space-y-3">
        <label class="block text-sm"><span data-i18n="ctx_strategy_label">Strategy</span>
          <select id="cfg-ctx-strategy" class="mt-1 block rounded-lg border px-3 py-2"></select></label>
        <label class="block text-sm"><span data-i18n="ctx_keep_label">keep_last_turns</span>
          <input id="cfg-ctx-keep" type="number" min="1" class="mt-1 block w-40 rounded-lg border px-3 py-2" /></label>
        <label class="block text-sm"><span data-i18n="ctx_toolcap_label">max_tool_result_chars</span>
          <input id="cfg-ctx-toolcap" type="number" min="0" class="mt-1 block w-40 rounded-lg border px-3 py-2" />
          <span class="block text-xs text-gray-500" data-i18n="ctx_toolcap_hint">Cap one tool result (0 = off).</span></label>
        <div>
          <p class="text-sm" data-i18n="ctx_triggers_label">Triggers (threshold; blank = off)</p>
          <p class="text-xs text-gray-500" data-i18n="ctx_triggers_hint">Blank = off. window_pct compacts at a fraction of a profile's context_window.</p>
          <div id="cfg-ctx-triggers" class="mt-1 space-y-2"></div>
          <label class="mt-2 block text-sm"><span data-i18n="ctx_combine_label">Trigger combine (or/and)</span>
            <select id="cfg-ctx-combine" class="mt-1 block rounded-lg border px-3 py-2">
              <option value="or">or</option><option value="and">and</option>
            </select></label>
        </div>
        <p class="text-xs text-gray-500" data-i18n="ctx_extend_hint">Register @register_strategy / @register_condition in harness/context.py; they appear here once imported. See AGENTS.md.</p>
      </div>

      <div data-cfg="budget" class="hidden space-y-3">
        <p class="text-xs text-gray-500" data-i18n="bud_hint">Accrued cost per LLM, computed from the prices you enter. Set a limit to stop an LLM once its cost reaches it; Clear resets a counter. Usage persists across runs.</p>
        <div id="cfg-bud-rows" class="space-y-3"></div>
        <button id="cfg-bud-clearall" type="button" class="rounded-lg border px-3 py-1 text-sm text-red-600" data-i18n="bud_clear_all">Clear all usage</button>
      </div>

      <div data-cfg="tools" class="hidden space-y-2">
        <div class="flex items-start justify-end gap-2">
{% if spec.mcp.enabled %}          <div class="flex items-center gap-2 whitespace-nowrap">
            <span id="cfg-mcp-status" class="text-xs text-slate-500"></span>
            <button id="cfg-mcp-scan" type="button" class="rounded-lg border px-2 py-1 text-xs" data-i18n="tools_scan">Scan MCP</button>
          </div>
{% endif %}        </div>
        <div id="cfg-tools" class="space-y-1"></div>
        <p class="text-xs text-gray-500" data-i18n="tools_extend_hint">Custom tools: register with @registry.tool in harness/tools.py and list the name under tools: in config.yaml. MCP tools are discovered from your servers (Scan); tick one to add it to the allowlist. Toggling applies live. See AGENTS.md.</p>
      </div>
{% if spec.mcp.enabled %}
      <div data-cfg="mcp" class="hidden space-y-3">
        <div class="flex items-start justify-end gap-2">
          <div class="flex items-center gap-2 whitespace-nowrap">
            <span id="cfg-mcp-msg" class="text-xs text-slate-500"></span>
            <button id="cfg-mcp-reconnect" type="button" class="rounded-lg border px-2 py-1 text-xs" data-i18n="mcp_reconnect_all">Reconnect all</button>
          </div>
        </div>
        <div id="cfg-mcp-list" class="space-y-2"></div>
        <button id="cfg-mcp-add" type="button" class="rounded-lg border px-3 py-1 text-sm" data-i18n="mcp_add">+ Add server</button>
      </div>
{% endif %}
      <div data-cfg="hooks" class="hidden space-y-4">
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-medium" data-i18n="hooks_label">Hooks</h4>
            <button id="cfg-hook-add" type="button" class="rounded-lg border px-2 py-1 text-xs" data-i18n="sys_hooks_add">+ Add hook</button>
          </div>
          <p class="text-xs text-slate-500" data-i18n="sys_hooks_hint">Hooks classes (package.module:ClassName) for logging / guardrails / tool policy / redaction. Run in listed order; config is JSON passed to the constructor.</p>
          <div id="cfg-hooks" class="space-y-2"></div>
        </div>
        <div class="space-y-1 border-t pt-3">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-medium" data-i18n="hooklog_label">Hooks execution log</h4>
            <div class="flex items-center gap-2">
              <button id="cfg-hooklog-refresh" type="button" class="rounded-lg border px-2 py-1 text-xs" data-i18n="hooklog_refresh">Refresh</button>
              <button id="cfg-hooklog-clear" type="button" class="rounded-lg border px-2 py-1 text-xs text-red-600" data-i18n="hooklog_clear">Clear</button>
            </div>
          </div>
          <p class="text-xs text-slate-500" data-i18n="hooklog_hint">When each mounted hook fired during a run (names, methods, timings — never arguments or results). Kept in this server process only.</p>
          <div id="cfg-hooklog" class="max-h-72 overflow-auto rounded-lg border"></div>
        </div>
      </div>
      <div data-cfg="prompts" class="hidden space-y-3">
        <label class="block text-sm"><span data-i18n="prompts_system">system</span>
          <textarea id="cfg-p-system" rows="3" class="mt-1 block w-full rounded-lg border px-3 py-2"></textarea></label>
        <div>
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium" data-i18n="prompts_rules">Rule files (always-on)</span>
            <button id="cfg-rule-add" type="button" class="rounded-lg border px-2 py-1 text-xs" data-i18n="rule_add">+ Add rule file</button>
          </div>
          <p class="mt-1 text-xs text-gray-500" data-i18n="rules_hint">Markdown files you own (the AGENTS.md / CLAUDE.md pattern), injected verbatim into every system prompt. Edit the content here; Save writes the files and the active list.</p>
          <div id="cfg-rules" class="mt-2 space-y-2"></div>
        </div>
      </div>

      <div data-cfg="paradigms" class="hidden space-y-3">
        <p class="text-sm" data-i18n="paradigms_enabled">Enabled paradigms</p>
        <div id="cfg-par-list" class="space-y-1"></div>
        <label class="block text-sm"><span data-i18n="paradigms_default">default</span>
          <select id="cfg-par-default" class="mt-1 block w-48 rounded-lg border px-3 py-2 font-mono"></select></label>
        <p class="text-xs text-gray-500" data-i18n="par_extend_hint">Register @register_paradigm in harness/paradigms/; it appears here once imported. See AGENTS.md.</p>
      </div>

{% if spec.memory.enabled %}      <div data-cfg="memory" class="hidden space-y-3">
        <p class="text-xs text-gray-500" data-i18n="mem_hint">A small note the agent keeps across sessions, injected into every system prompt. The agent curates it with the memory tools; you can edit it here too.</p>
        <label class="flex items-center gap-2 text-sm"><input id="cfg-mem-readonly" type="checkbox" /> <span data-i18n="mem_readonly">read-only (the agent can read memory but not write it)</span></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block text-sm"><span data-i18n="mem_backend">backend</span>
            <select id="cfg-mem-backend" class="mt-1 block w-full rounded-lg border px-3 py-2 font-mono"></select></label>
          <label class="block text-sm"><span data-i18n="mem_capacity">capacity (inject_max_chars)</span>
            <input id="cfg-mem-capacity" type="number" min="1" class="mt-1 block w-full rounded-lg border px-3 py-2" /></label>
        </div>
        <label class="flex items-center gap-2 text-sm"><input id="cfg-mem-auto" type="checkbox" /> <span data-i18n="mem_auto">auto-consolidate at session end when oversized (uses the memory-role model)</span></label>
        <label class="block text-sm"><span data-i18n="mem_policy">memory policy (what/when to remember)</span>
          <textarea id="cfg-mem-policy" rows="2" class="mt-1 block w-full rounded-lg border px-3 py-2" data-i18n-ph="mem_policy_ph" placeholder="e.g. Remember durable user preferences, decisions, and project facts; don't store transient chit-chat."></textarea></label>
        <div class="border-t pt-3">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium" data-i18n="mem_note">Current memory note</span>
            <span id="cfg-mem-size" class="text-xs text-slate-500"></span>
          </div>
          <p id="cfg-mem-oversized" class="mt-1 hidden text-xs text-amber-600" data-i18n="mem_oversized">The note exceeds the injection cap; older notes aren't recalled. Consolidate to condense it.</p>
          <textarea id="cfg-mem-content" rows="6" class="mt-1 block w-full rounded-lg border px-3 py-2 font-mono text-xs"></textarea>
          <div class="mt-2 flex items-center gap-2">
            <button id="cfg-mem-save" type="button" class="rounded-lg border px-3 py-1 text-sm" data-i18n="mem_save_note">Save note</button>
            <button id="cfg-mem-consolidate" type="button" class="rounded-lg border px-3 py-1 text-sm" data-i18n="mem_consolidate">Consolidate</button>
            <button id="cfg-mem-clear" type="button" class="rounded-lg border px-3 py-1 text-sm text-red-600" data-i18n="mem_clear">Clear</button>
            <span id="cfg-mem-status" class="text-xs text-slate-500"></span>
          </div>
        </div>
        <p class="text-xs text-gray-500" data-i18n="mem_extend_hint">Register @register_memory in harness/memory.py; it appears in the backend list once imported. See AGENTS.md.</p>
      </div>

{% endif %}      <div data-cfg="observability" class="hidden space-y-3">
        <label class="flex items-center gap-2 text-sm"><input id="cfg-obs-trace" type="checkbox" /> <span data-i18n="obs_trace">write JSONL trace</span></label>
        <label class="block text-sm"><span data-i18n="obs_tracedir">trace_dir</span>
          <input id="cfg-obs-tracedir" class="mt-1 block w-48 rounded-lg border px-3 py-2 font-mono" /></label>
        <label class="flex items-center gap-2 text-sm"><input id="cfg-obs-debug" type="checkbox" /> <span data-i18n="obs_debug">write local debug log</span></label>
        <label class="block text-sm"><span data-i18n="obs_debugdir">debug log dir</span>
          <input id="cfg-obs-debugdir" class="mt-1 block w-48 rounded-lg border px-3 py-2 font-mono" /></label>
        <p class="text-xs text-slate-500" data-i18n="obs_debug_note">Records step and tool names, counts, and durations; never message content or tool arguments.</p>
      </div>

      <div data-cfg="system" class="hidden space-y-4">
        <div class="space-y-1">
          <h4 class="text-sm font-medium" data-i18n="sys_lang_label">Language</h4>
          <select id="sys-lang" class="rounded-lg border px-3 py-2 text-sm">
            <option value="en">English</option>
            <option value="zh">中文</option>
          </select>
        </div>
        <div class="space-y-1 border-t pt-3">
          <h4 class="text-sm font-medium" data-i18n="sys_stream_label">Streaming</h4>
          <p class="text-xs text-slate-500" data-i18n="sys_stream_hint">Stream the assistant's reply token by token.</p>
          <div id="sys-stream-toggle" class="inline-flex items-center gap-0.5 rounded-lg border border-slate-300 p-0.5">
            <button type="button" data-stream="1" class="rounded px-3 py-0.5 text-sm" data-i18n="sys_stream_on">Enable</button>
            <button type="button" data-stream="0" class="rounded px-3 py-0.5 text-sm" data-i18n="sys_stream_off">Disable</button>
          </div>
        </div>
