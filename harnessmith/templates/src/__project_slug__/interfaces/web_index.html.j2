        mcp_url: "url", mcp_authenv: "auth 环境变量名", mcp_desc: "描述",
        mcp_safe_tools: "只读工具(逗号分隔,不带前缀)",
        mcp_loading: "加载中…", mcp_reconnecting: "重连中…", mcp_saved: "已保存",
        mcp_reconnect_all: "全部重连", mcp_connecting: "连接中…",
        mcp_connected: "已连接", mcp_unreachable: "不可达", mcp_tools_word: "工具",
{% endif %}        prompts_system: "系统提示", prompts_rules: "规则",
        rule_add: "+ 添加规则文件", rule_path_ph: "路径,如 RULES.md",
        rule_auto: "自动", rule_auto_hint: "在项目根目录自动识别(如 CLAUDE.md),无需列出即会注入。可在此编辑正文,保存即写入文件。",
        rules_hint: "每轮原文注入系统提示。在此编辑正文,保存会写入文件及生效列表。",
        paradigms_enabled: "启用的范式", paradigms_default: "默认范式",
        par_extend_hint: "在 harness/paradigms/ 用 @register_paradigm 注册自定义范式,import 后在此出现。详见 AGENTS.md。",
{% if spec.memory.enabled %}        mem_hint: "一份 agent 跨会话维护的简短笔记,每轮注入系统提示。agent 用记忆工具自行维护,你也可在此编辑。",
        mem_readonly: "只读(agent 只能读记忆,不能写)",
        mem_backend: "后端", mem_capacity: "容量(注入上限 inject_max_chars)",
        mem_auto: "会话结束时若超出容量自动整理(用 memory 角色模型)",
        mem_policy: "记忆策略(记什么 / 何时写)",
        mem_policy_ph: "例如:记住稳定的用户偏好、决策、项目事实;不要记临时闲聊。",
        mem_note: "当前记忆笔记", mem_oversized: "笔记已超过注入上限,较早的内容不会再被召回。整理可精简笔记。",
        mem_save_note: "保存笔记", mem_consolidate: "整理", mem_clear: "清空",
        mem_saved: "已保存", mem_cleared: "已清空", mem_consolidating: "整理中…",
        mem_consolidated: "已整理", mem_consolidate_noop: "无需整理",
        mem_chars: "字符",
        mem_extend_hint: "在 harness/memory.py 用 @register_memory 注册自定义后端,import 后出现在后端列表。详见 AGENTS.md。",
{% endif %}        obs_trace: "写 JSONL trace", obs_tracedir: "trace 目录",
        obs_debug: "写本地 debug 日志", obs_debugdir: "debug 日志目录",
        obs_debug_note: "只记录步骤与工具名、计数和耗时,不记录消息内容与工具参数。",
      },
    };
    let lang = localStorage.getItem("hf_lang") || "{{ language }}";
    const t = (k) => (I18N[lang] && I18N[lang][k]) || k;

    function applyI18n() {
      document.documentElement.lang = lang;
      const _sysLang = $("sys-lang");
      if (_sysLang) _sysLang.value = lang;
      document.querySelectorAll("[data-i18n]").forEach((el) => { el.textContent = t(el.dataset.i18n); });
      document.querySelectorAll("[data-i18n-ph]").forEach((el) => { el.placeholder = t(el.dataset.i18nPh); });
      document.querySelectorAll("[data-i18n-title]").forEach((el) => { el.title = t(el.dataset.i18nTitle); });
      buildCfgTabs();
      renderSessionList();
      updateMainTitle();
      refreshSendButton();  // restore "Stop" if the active conversation is mid-turn
    }
    // Language is chosen on the System tab (#sys-lang); see its handler below.

    // ---- chat -----------------------------------------------------------
    // Every transcript element is appended to a VIEW's own container (see the
    // sessions section): conversations render independently, so several can
    // stream at once and switching views can't mix their output. The page only
    // auto-scrolls for the view that is actually on screen.
    function scrollChat(view) {
      if (view === activeView) log.scrollTop = log.scrollHeight;
    }

    function line(view, text, cls) {
      const el = document.createElement("div");
      el.className = cls || "text-slate-700";
      el.textContent = text;
      view.container.appendChild(el);
      scrollChat(view);
      return el;
    }

    const prettyJSON = (s) => {
      if (!s) return "";
      try { return JSON.stringify(JSON.parse(s), null, 2); } catch (e) { return s; }
    };

    // A collapsible reasoning ("thinking") block: dim and small, secondary to the
    // answer. Live, it streams the model's reasoning and shows an animated
    // "Thinking…"; when the answer begins it collapses to "Thought for Ns" (click
    // to reread). On reload it renders collapsed as "Reasoning". Appended to the
    // log on creation.
    function reasoningBox(view) {
      const box = document.createElement("details");
      box.className = "hf-block rounded-md border border-slate-200 bg-slate-50 px-2 py-1";
      box.open = true;
      const summary = document.createElement("summary");
      summary.className = "flex cursor-pointer select-none items-center gap-1 text-xs text-slate-400";
      const chevron = document.createElement("span");
      chevron.className = "hf-chevron"; chevron.textContent = "▸";
      const label = document.createElement("span");
      label.textContent = t("reasoning_thinking");
      const dots = document.createElement("span");
      dots.className = "hf-dots"; dots.innerHTML = "<span>.</span><span>.</span><span>.</span>";
      summary.append(chevron, label, dots);
      const body = document.createElement("div");
      body.className = "mt-1 max-h-48 overflow-y-auto whitespace-pre-wrap text-xs leading-relaxed text-slate-400";
      box.append(summary, body);
      view.container.appendChild(box);
      scrollChat(view);
      const started = Date.now();
      let hasText = false;
      return {
        el: box,
        hasText: () => hasText,
        append(text) {
          if (!text) return;
          hasText = true;
          body.textContent += text;
          body.scrollTop = body.scrollHeight;
          scrollChat(view);
        },
        // End of a live thinking phase: swap the animated label for the elapsed
        // time and collapse (the body stays behind the chevron).
        finishLive() {
          const sec = Math.max(1, Math.round((Date.now() - started) / 1000));
          dots.remove();
          label.textContent = t("reasoning_prefix") + " " + sec + t("reasoning_sec");
          box.open = false;
        },
        // Reload: a static collapsed box (no duration was persisted).
        finishReload() { dots.remove(); label.textContent = t("reasoning_label"); box.open = false; },
        remove() { box.remove(); },
      };
    }

    // A collapsible tool-call block: one summary line (status dot + tool name +
    // a one-line arg/command preview), expandable to full arguments + result.
    // Dim/secondary to the answer, matching Cursor/Claude/Zed tool rendering.
    function toolBlock(view, name, argsStr) {
      const box = document.createElement("details");
      box.className = "hf-block rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs";
      const summary = document.createElement("summary");
      summary.className = "flex cursor-pointer select-none items-center gap-1.5 text-slate-500";
      const chevron = document.createElement("span");
      chevron.className = "hf-chevron text-slate-400"; chevron.textContent = "▸";
      const dot = document.createElement("span");
      dot.className = "text-amber-600 animate-pulse"; dot.textContent = "●";  // running
      const nm = document.createElement("span");
      nm.className = "font-mono text-slate-600"; nm.textContent = name;
      const preview = document.createElement("span");
      preview.className = "min-w-0 flex-1 truncate text-slate-400";
      preview.textContent = (argsStr || "").replace(/\s+/g, " ").trim();
      summary.append(chevron, dot, nm, preview);
      const wrap = document.createElement("div");
      wrap.className = "mt-1 space-y-1";
      const section = (key) => {
        const cap = document.createElement("div");
        cap.className = "text-[10px] uppercase tracking-wide text-slate-400";
        cap.textContent = t(key);
        const pre = document.createElement("pre");
        pre.className = "whitespace-pre-wrap break-all text-xs text-slate-500";
        return { cap, pre };
      };
      const argsSec = section("tool_args_label");
      argsSec.pre.textContent = prettyJSON(argsStr);
      const resSec = section("tool_result_label");
      resSec.cap.classList.add("hidden"); resSec.pre.classList.add("hidden");
      wrap.append(argsSec.cap, argsSec.pre, resSec.cap, resSec.pre);
      box.append(summary, wrap);
      view.container.appendChild(box);
      scrollChat(view);
      return {
        el: box,
        setResult(result) {
          const isErr = typeof result === "string" && result.startsWith("ERROR");
          dot.className = isErr ? "text-red-700" : "text-emerald-600";
          resSec.cap.classList.remove("hidden");
          resSec.pre.classList.remove("hidden");
          resSec.pre.textContent = result;
          if (isErr) resSec.pre.classList.add("text-red-700");
          scrollChat(view);
        },
      };
    }

    // Render the inline interaction card for an `event: ask` (a model
    // ask_question, or — later — HITL tool confirmation). The answer is POSTed
    // back to /chat/{run_id}/respond, which unblocks the waiting loop. Themed and
    // inline (no native browser dialogs).
    function renderAskCard(view, data) {
      const runId = view.runId;
      const isApproval = data.kind === "approval";
      const card = document.createElement("div");
      // Approval (HITL confirmation) gets an amber "action needed" tint; a model
      // question keeps the indigo card.
      card.className = "ask-card rounded-lg border p-3 space-y-2 " +
        (isApproval ? "border-amber-300 bg-amber-50" : "border-indigo-300 bg-indigo-50");
      const prompt = document.createElement("div");
      prompt.className = "font-medium text-slate-800 whitespace-pre-wrap";
      prompt.textContent = data.prompt;
      card.appendChild(prompt);
      if (isApproval && data.context && data.context.tool) {
        const ctx = document.createElement("div");
        ctx.className = "text-xs space-y-1";
        const head = document.createElement("div");
        head.className = "flex items-center gap-2";
        const toolName = document.createElement("code");
        toolName.className = "rounded bg-slate-200 px-1 text-slate-800";
        toolName.textContent = data.context.tool;
        head.appendChild(toolName);
        const risk = (data.context.risk || "").toLowerCase();
        if (risk) {
          const pill = document.createElement("span");
          const high = risk === "high";
          pill.className = "rounded px-1.5 text-[10px] font-medium " +
            (high ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700");
          pill.textContent = risk;
          head.appendChild(pill);
        }
        ctx.appendChild(head);
        if (data.context.arguments) {
          const args = document.createElement("div");
          args.className = "text-slate-500 whitespace-pre-wrap break-all";
          args.textContent = data.context.arguments;
          ctx.appendChild(args);
        }
        card.appendChild(ctx);
      }

      let answered = false;
      const submit = (optionIds, text) => {
        if (answered) return;
        answered = true;
        // Collapse the interactive card into a compact transcript line so it reads
        // as part of the conversation and scrolls/flows with it (no lingering
        // widget pinned at the bottom).
        const picked = (data.options || [])
          .filter((o) => (optionIds || []).includes(o.id))
          .map((o) => o.label);
        let summary = picked.join(", ");
        if (text) summary = summary ? (summary + " · " + text) : text;
        if (!summary) summary = t("ask_skip");
        card.className = "whitespace-pre-wrap text-sm " +
          (isApproval ? "text-amber-700" : "text-indigo-700");
        card.textContent = (isApproval ? "🔒 " : "❓ ") + data.prompt + " → " + summary;
        scrollChat(view);
        view.pendingAsk = false;  // the sidebar's amber "waiting for you" dot clears
        renderSessionList();
        fetch("/chat/" + encodeURIComponent(runId) + "/respond", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            request_id: data.request_id, option_ids: optionIds || [],
            text: (text == null || text === "") ? null : text,
          }),
        }).catch(() => {});
      };

      if (isApproval) {
        const bar = document.createElement("div");
        bar.className = "flex flex-wrap gap-2";
        (data.options || []).forEach((o) => {
          const b = document.createElement("button");
          b.type = "button";
          // Highlight "allow for session" as the recommended default; reject is
          // styled as the cautious choice; the rest are neutral.
          const tone = o.id === "allow_session"
            ? "bg-indigo-600 text-white"
            : (o.id === "reject" ? "bg-white text-red-700 border border-red-300" : "bg-slate-700 text-white");
          b.className = "rounded px-3 py-1 text-xs " + tone;
          b.textContent = o.label;
          b.addEventListener("click", () => submit([o.id], null));
          bar.appendChild(b);
        });
        card.appendChild(bar);
      } else {
        const inputs = [];  // the real-option radios/checkboxes (not "Other")
        const hasOptions = !!(data.options && data.options.length);
        // The free-text box. With options it's a Cursor-style "Other": hidden until
        // the last "Other…" entry is picked; a pure free-text question shows it now.
        let ta = null;
        if (data.allow_text) {
          ta = document.createElement("textarea");
          ta.className = "w-full rounded border px-2 py-1 text-sm";
          ta.rows = 2;
          ta.placeholder = t("ask_other_ph");
        }
        const showText = () => { if (ta) { ta.classList.remove("hidden"); ta.focus(); } };
        const hideText = () => { if (ta) ta.classList.add("hidden"); };

        let other = null;  // the synthetic "Other" radio/checkbox
        if (hasOptions) {
          const list = document.createElement("div");
          list.className = "space-y-1";
          data.options.forEach((o) => {
            const lbl = document.createElement("label");
            lbl.className = "flex items-center gap-2 text-sm";
            const inp = document.createElement("input");
            inp.type = data.allow_multiple ? "checkbox" : "radio";
            inp.name = "ask_" + data.request_id;
            inp.value = o.id;
            inputs.push(inp);
            // single-select: picking a real option puts the custom box away
            inp.addEventListener("change", () => { if (!data.allow_multiple) hideText(); });
            const span = document.createElement("span");
            span.textContent = o.label;
            lbl.append(inp, span);
            list.appendChild(lbl);
          });
          if (data.allow_text) {
            const lbl = document.createElement("label");
            lbl.className = "flex items-center gap-2 text-sm";
            other = document.createElement("input");
            other.type = data.allow_multiple ? "checkbox" : "radio";
            other.name = "ask_" + data.request_id;
            other.value = "__other__";
            other.addEventListener("change", () => { other.checked ? showText() : hideText(); });
            const span = document.createElement("span");
            span.textContent = t("ask_other");
            lbl.append(other, span);
            list.appendChild(lbl);
          }
          card.appendChild(list);
        }
        if (ta) {
          if (hasOptions) ta.classList.add("hidden");  // revealed by "Other"
          card.appendChild(ta);
        }

        const bar = document.createElement("div");
        bar.className = "flex items-center gap-2";
        const send = document.createElement("button");
        send.type = "button";
        send.className = "rounded bg-indigo-600 px-3 py-1 text-xs text-white";
        send.textContent = t("ask_submit");
        send.addEventListener("click", () => {
          const ids = inputs.filter((i) => i.checked).map((i) => i.value);
          // free text counts for a pure free-text question, or when "Other" is picked
          const wantsText = !hasOptions || (other && other.checked);
          submit(ids, (ta && wantsText) ? ta.value.trim() : null);
        });
        const skip = document.createElement("button");
        skip.type = "button";
        skip.className = "px-2 py-1 text-xs text-slate-500";
        skip.textContent = t("ask_skip");
        skip.addEventListener("click", () => submit([], null));
        bar.append(send, skip);
        card.appendChild(bar);
      }
      view.container.appendChild(card);
      scrollChat(view);
      view.pendingAsk = true;  // amber dot in the sidebar while an answer is awaited
      renderSessionList();
    }

    async function loadParadigms() {
      try {
        const data = await (await fetch("/paradigms")).json();
        $("mode").innerHTML = "";
        for (const name of data.enabled) {
          const opt = document.createElement("option");
          opt.value = name; opt.textContent = name;
          if (name === data.default) opt.selected = true;
          $("mode").appendChild(opt);
        }
      } catch (err) { /* dropdown stays empty; chat still works with the default */ }
    }
    loadParadigms();

    // The generator dropdown mirrors the GLOBAL generation role (config.roles.
    // generation), so picking one here is the same as setting it on Config → LLM.
    // Options are the configured profiles; the blank option = "(first profile)",
    // matching the runtime fallback when the role is unset. Filled from `cfg`, so
    // it's only meaningful after loadConfig() has run.
    function populateGenerator() {
      const sel = $("gen-llm");
      if (!sel) return;
      const llms = (cfg && cfg.llms) || [];
      const current = (cfg && cfg.roles && cfg.roles.generation) || "";
      sel.innerHTML = "";
      const first = document.createElement("option");
      first.value = ""; first.textContent = t("role_use_first");
      sel.appendChild(first);
      llms.forEach((p) => {
        if (!p || !p.name) return;
        const o = document.createElement("option");
        o.value = p.name; o.textContent = p.name;
        sel.appendChild(o);
      });
      sel.value = current;
    }
    // Changing the generator writes the generation role back globally (POST
    // /config replaces only the roles key + persists to config.yaml), updates the
    // local cfg, and refreshes the Config page Roles dropdowns when they're shown
    // and have no unsaved edits (so the two stay in sync both directions).
    $("gen-llm").addEventListener("change", async () => {
      const value = $("gen-llm").value;
      const roles = Object.assign({}, (cfg && cfg.roles) || {});
      if (value) roles.generation = value; else delete roles.generation;
      try {
        const resp = await fetch("/config", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roles }),
        });
        if (resp.ok) {
          cfg = await resp.json();
          populateGenerator();
          if (!$("view-config").classList.contains("hidden") && !dirty) {
            buildRoles(); markSaved();
          }
        }
      } catch (e) { /* keep the previous selection on failure */ }
    });

    // ---- chat sessions (AI-Studio-style left sidebar) ------------------
    // Each conversation owns a VIEW: its own DOM container plus its run state
    // (EventSource, run id, streaming flag, context-meter figures). #log is just
    // the viewport the active container is mounted in, so several conversations
    // can stream in parallel — switching views re-mounts a container, it never
    // touches another conversation's run. The map holds the active view plus any
    // streaming ones; idle views are dropped on switch and re-fetched from the
    // server on reopen (disk is authoritative — each step is checkpointed there).
    let viewSeq = 0;
    const views = new Map();     // key -> view (key = session id, or draft-N until minted)
    let activeView = null;       // the view mounted in #log
    let sessionsCache = [];      // last /sessions payload (relabel on lang switch)
    let editingId = null;        // row being inline-renamed
    let confirmingId = null;     // row showing the inline delete confirmation

    function makeView(sessionId) {
      const container = document.createElement("div");
      container.className = "space-y-2";
      const view = {
        key: sessionId || ("draft-" + (++viewSeq)),
        sessionId: sessionId || null,  // null until the server mints one (session event)
        container,
        title: "",
        preview: "",       // first sent message (labels a not-yet-saved live row)
        es: null,          // open EventSource while streaming
        runId: null,       // in-flight run id (for POST /chat/{id}/stop|respond)
        streaming: false,
        pendingAsk: false, // an ask card awaits the user (sidebar dot turns amber)
        ctxWindow: null,   // context-meter figures, per conversation
        ctxUsed: 0,
        cwd: "",           // working-directory hint, per conversation (prefilled on open)
      };
      views.set(view.key, view);
      return view;
    }

    function viewFor(sessionId) {
      for (const v of views.values()) if (v.sessionId === sessionId) return v;
      return null;
    }

    // Mount a view in the viewport and repaint everything that reflects it (title,
    // context meter, Send/Stop button, sidebar highlight). Idle views other than
    // the mounted one are dropped — their sessions reload from disk on reopen.
    function showView(view) {
      activeView = view;
      if (view.container.parentNode !== log) {
        log.innerHTML = "";  // detach the previous container (it lives on in its view)
        log.appendChild(view.container);
      }
      for (const [key, v] of views) {
        if (v !== view && !v.streaming) views.delete(key);
      }
      log.scrollTop = log.scrollHeight;
      refreshSendButton();
      updateCtxMeter(view.ctxUsed);
      $("cwd").value = view.cwd || "";  // prefill this conversation's working-dir hint
      show("chat");
      renderSessionList();
      updateMainTitle();
    }

    function chatIsEmpty() {
      return activeView && !activeView.sessionId && !activeView.streaming
        && activeView.container.children.length === 0;
    }

    // Compact token count: 940 -> "940", 12500 -> "12K", 1000000 -> "1M".
    function fmtTok(n) {
      n = Math.max(0, Math.round(Number(n) || 0));
      if (n < 1000) return String(n);
      if (n < 1e6) return +(n / 1000).toFixed(n < 10000 ? 1 : 0) + "K";
      return +(n / 1e6).toFixed(1) + "M";
    }

    // Paint the ring + center label from used prompt_tokens vs the window. With a
    // window we show a filled fraction + "NN%" (amber past 85%, red past 95% — the
    // window_pct compaction zone); without one, a flat ring + the raw token count.
    const CTX_C = 97.39;  // 2·π·15.5 (the SVG circle's circumference)
    function updateCtxMeter(used) {
      const arc = $("ctx-meter-arc"), label = $("ctx-meter-label"), pop = $("ctx-meter-pop");
      if (!arc) return;
      const win = activeView ? activeView.ctxWindow : null;
      used = Math.max(0, Math.round(Number(used) || 0));
      if (win && win > 0) {
        const ratio = used / win;
        const clamped = Math.min(1, Math.max(0, ratio));
        arc.style.strokeDashoffset = (CTX_C * (1 - clamped)).toFixed(2);
        arc.style.stroke = ratio >= 0.95 ? "#dc2626" : ratio >= 0.85 ? "#d97706" : "#0f172a";
        label.textContent = used ? Math.round(ratio * 100) + "%" : "";
        pop.textContent = fmtTok(used) + "/" + fmtTok(win) + " token (" + Math.round(ratio * 100) + "%)";
      } else {
        arc.style.strokeDashoffset = CTX_C.toFixed(2);  // flat ring: no window to fill against
        arc.style.stroke = "#94a3b8";
        label.textContent = used ? fmtTok(used) : "";
        pop.textContent = used ? (fmtTok(used) + " token · " + t("ctx_meter_nowin")) : t("ctx_meter_empty");
      }
    }

    function updateMainTitle() {
      const inConfig = !$("view-config").classList.contains("hidden");
      const title = activeView ? activeView.title : "";
      $("main-title").textContent = inConfig ? t("nav_config") : (title || t("chat_untitled"));
    }

    // The pulsing "this conversation has a run in flight" dot; amber while an ask
    // card is waiting for the user, emerald while the agent is just working.
    function liveDot(view) {
      const dot = document.createElement("span");
      dot.className = "shrink-0 animate-pulse text-[10px] "
        + (view.pendingAsk ? "text-amber-600" : "text-emerald-600");
      dot.textContent = "●";
      return dot;
    }

    function renderSessionList() {
      const box = $("session-list");
      box.innerHTML = "";
      // Streaming conversations not on disk yet (a draft's first turn hasn't
      // checkpointed) still get a row, so a backgrounded run is always reachable.
      const cachedIds = new Set(sessionsCache.map((s) => s.id));
      for (const v of views.values()) {
        if (!v.streaming || (v.sessionId && cachedIds.has(v.sessionId))) continue;
        const row = document.createElement("div");
        row.className = "flex items-center gap-1 rounded-lg px-1 "
          + (v === activeView ? "bg-slate-200" : "hover:bg-slate-100");
        const open = document.createElement("button");
        open.type = "button";
        open.className = "min-w-0 flex-1 truncate px-1 py-1.5 text-left"
          + (v === activeView ? " font-medium" : "");
        open.textContent = v.title || v.preview || t("chat_untitled");
        open.addEventListener("click", () => showView(v));
        row.append(liveDot(v), open);
        box.appendChild(row);
      }
      if (!sessionsCache.length) {
        if (!box.children.length) {
          const empty = document.createElement("p");
          empty.className = "px-2 py-2 text-xs text-slate-400";
          empty.textContent = t("chat_sessions_empty");
          box.appendChild(empty);
        }
        return;
      }
      for (const s of sessionsCache) {
        const row = document.createElement("div");
        box.appendChild(row);

        // Inline rename: the row's label becomes a text input (Enter / blur save,
        // Esc cancels) — themed in-page editing, not a browser dialog.
        if (s.id === editingId) {
          row.className = "flex items-center rounded-lg bg-slate-50 px-1";
          const input = document.createElement("input");
          input.className = "w-full rounded border px-1 py-1 text-sm";
          input.value = s.title || "";
          input.addEventListener("keydown", (e) => {
            if (e.key === "Enter") { e.preventDefault(); commitRename(s, input.value); }
            else if (e.key === "Escape") { e.preventDefault(); editingId = null; renderSessionList(); }
          });
          input.addEventListener("blur", () => commitRename(s, input.value));
          row.appendChild(input);
          setTimeout(() => { input.focus(); input.select(); }, 0);
          continue;
        }

        // Inline delete confirmation: the row shows Delete / Cancel in place —
        // themed in-page confirm, not a browser dialog.
        if (s.id === confirmingId) {
          row.className = "flex items-center gap-1 rounded-lg bg-red-50 px-1";
          const name = document.createElement("span");
          name.className = "min-w-0 flex-1 truncate px-1 py-1.5 text-slate-600";
          name.textContent = s.title || s.preview || t("chat_untitled");
          const del = document.createElement("button");
          del.type = "button";
          del.className = "shrink-0 rounded bg-red-600 px-1.5 py-0.5 text-xs text-white hover:bg-red-700";
          del.textContent = t("session_delete");
          del.addEventListener("click", () => commitDelete(s));
          const cancel = document.createElement("button");
          cancel.type = "button";
          cancel.className = "shrink-0 px-1.5 py-0.5 text-xs text-slate-500 hover:text-slate-800";
          cancel.textContent = t("session_cancel");
          cancel.addEventListener("click", () => { confirmingId = null; renderSessionList(); });
          row.append(name, del, cancel);
          continue;
        }

        const active = !!(activeView && s.id === activeView.sessionId);
        row.className = "flex items-center gap-0.5 rounded-lg px-1 "
          + (active ? "bg-slate-200" : "hover:bg-slate-100");
        const live = viewFor(s.id);
        if (live && live.streaming) row.appendChild(liveDot(live));
        const label = s.title || s.preview || t("chat_untitled");
        const open = document.createElement("button");
        open.type = "button";
        open.className = "min-w-0 flex-1 truncate px-1 py-1.5 text-left" + (active ? " font-medium" : "");
        open.textContent = label;
        open.title = label;
        open.addEventListener("click", () => openSession(s.id));
        const ren = document.createElement("button");
        ren.type = "button";
        ren.className = "shrink-0 px-1 text-xs text-slate-400 hover:text-slate-700";
        ren.textContent = "✎";
        ren.title = t("session_rename");
        ren.addEventListener("click", (e) => { e.stopPropagation(); renameSession(s); });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "shrink-0 px-1 text-xs text-slate-400 hover:text-red-600";
        del.textContent = "🗑";
        del.title = t("session_delete");
        del.addEventListener("click", (e) => { e.stopPropagation(); deleteSession(s); });
        row.append(open, ren, del);
      }
    }

    // Enter inline edit / confirm modes (one at a time).
    function renameSession(s) { editingId = s.id; confirmingId = null; renderSessionList(); }
    function deleteSession(s) { confirmingId = s.id; editingId = null; renderSessionList(); }

    async function commitRename(s, value) {
      if (editingId !== s.id) return;  // guard the blur+Enter / Esc race
      editingId = null;
      const next = (value || "").trim();
      if (next && next !== s.title) {
        try {
          const resp = await fetch("/sessions/" + encodeURIComponent(s.id), {
            method: "PATCH", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title: next }),
          });
          if (resp.ok) {
            s.title = next;
            const v = viewFor(s.id);
            if (v) v.title = next;
            updateMainTitle();
          }
        } catch (err) { /* keep the old title on failure */ }
      }
      renderSessionList();
    }

    async function commitDelete(s) {
      confirmingId = null;
      try {
        const resp = await fetch("/sessions/" + encodeURIComponent(s.id), { method: "DELETE" });
        if (!resp.ok) { renderSessionList(); return; }
      } catch (err) { renderSessionList(); return; }
      sessionsCache = sessionsCache.filter((x) => x.id !== s.id);
      const v = viewFor(s.id);
      if (v) {
        // Deleting a conversation with a run in flight stops the run too.
        if (v.streaming) { stopRun(v); endStream(v); }
        views.delete(v.key);
        if (v === activeView) { showView(makeView(null)); return; }
      }
      renderSessionList();
    }

    async function loadSessions() {
      try {
        const data = await (await fetch("/sessions")).json();
        sessionsCache = data.sessions || [];
      } catch (err) { sessionsCache = []; }
      renderSessionList();
    }

    // A replayed user message + an inline "edit" control (re-ask). `turn` is the
    // user-turn ordinal; clicking edit turns the line into a textarea, then an
    // in-page confirm ("discards the rest"), then regenerates from that turn.
    function addUserLine(view, text, turn) {
      const row = document.createElement("div");
      row.className = "flex items-start gap-2 font-semibold";
      const span = document.createElement("div");
      span.className = "min-w-0 flex-1 whitespace-pre-wrap";
      span.textContent = "you: " + text;
      row.appendChild(span);
      if (view.sessionId && turn >= 0 && !view.streaming) {
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "shrink-0 text-xs font-normal text-slate-400 hover:text-slate-700";
        edit.textContent = "✎";
        edit.title = t("reask_edit");
        edit.addEventListener("click", () => beginReask(view, row, turn, text));
        row.appendChild(edit);
      }
      view.container.appendChild(row);
      scrollChat(view);
      return row;
    }

    // Replay a stored conversation body. Mirrors the live rendering: a stored
    // assistant reasoning carrier (reasoning_content on a tool-calling turn,
    // reasoning_display on the final answer) becomes a collapsed reasoning box,
    // and each tool call becomes a collapsed tool block whose result is filled in
    // from the matching `tool` message (by tool_call_id).
    function renderHistory(view, messages) {
      view.container.innerHTML = "";
      let turn = -1;
      const toolMap = {};  // tool_call_id -> tool block awaiting its result
      for (const m of messages || []) {
        if (m.role === "user") { turn += 1; addUserLine(view, m.content || "", turn); }
        else if (m.role === "assistant") {
          const reasoning = m.reasoning_content || m.reasoning_display;
          if (reasoning) { const rb = reasoningBox(view); rb.append(reasoning); rb.finishReload(); }
          if (m.content) line(view, m.content, "text-slate-900 whitespace-pre-wrap");
          for (const call of m.tool_calls || []) {
            const fn = call.function || {};
            if (fn.name === "ask_question") continue;  // shown inline, not as a tool block
            toolMap[call.id] = toolBlock(view, fn.name || "", fn.arguments || "");
          }
        } else if (m.role === "tool") {
          const tb = toolMap[m.tool_call_id];
          if (tb) tb.setResult(m.content || "");
          else line(view, "← " + (m.content || ""), "text-emerald-700");
        }
      }
    }

    // Re-ask: edit a historical question, confirm in-page, then regenerate from
    // that turn (the server truncates everything after it — destructive, not a fork).
    function beginReask(view, row, turn, text) {
      if (view.streaming) return;
      row.innerHTML = "";
      row.className = "rounded-lg border border-slate-300 bg-white p-2 space-y-2";
      const ta = document.createElement("textarea");
      ta.className = "w-full rounded border px-2 py-1 text-sm";
      ta.rows = 2; ta.value = text;
      const bar = document.createElement("div");
      bar.className = "flex items-center gap-2";
      const send = document.createElement("button");
      send.type = "button";
      send.className = "rounded bg-slate-800 px-3 py-1 text-xs text-white";
      send.textContent = t("reask_send");
      send.addEventListener("click", () => confirmReask(view, row, turn, ta.value));
      const cancel = document.createElement("button");
      cancel.type = "button";
      cancel.className = "px-2 py-1 text-xs text-slate-500";
      cancel.textContent = t("session_cancel");
      cancel.addEventListener("click", () => { if (view.sessionId) openSession(view.sessionId); });
      bar.append(send, cancel);
      row.append(ta, bar);
      ta.focus();
    }

    function confirmReask(view, row, turn, newText) {
      const trimmed = (newText || "").trim();
      if (!trimmed) return;
      const bar = document.createElement("div");
      bar.className = "flex items-center gap-2 rounded bg-amber-50 p-2 text-xs text-amber-800";
      const warn = document.createElement("span");
      warn.className = "flex-1"; warn.textContent = t("reask_warn");
      const ok = document.createElement("button");
      ok.type = "button"; ok.className = "shrink-0 rounded bg-amber-600 px-2 py-0.5 text-white";
      ok.textContent = t("reask_confirm");
      ok.addEventListener("click", () => commitReask(view, turn, trimmed));
      const no = document.createElement("button");
      no.type = "button"; no.className = "shrink-0 px-2 py-0.5 text-slate-500";
      no.textContent = t("session_cancel");
      no.addEventListener("click", () => bar.remove());
      bar.append(warn, ok, no);
      row.appendChild(bar);
    }

    // Reload the authoritative history, cut it at this user turn, replay it, then
    // regenerate by sending the edited question with edit_turn (the server saves
    // the truncated+new body over the old one).
    async function commitReask(view, turn, text) {
      if (!view.sessionId || view.streaming) return;
      try {
        const data = await (await fetch("/sessions/" + encodeURIComponent(view.sessionId))).json();
        const msgs = data.messages || [];
        let count = -1, cut = msgs.length;
        for (let i = 0; i < msgs.length; i++) {
          if (msgs[i].role === "user") { count += 1; if (count === turn) { cut = i; break; } }
        }
        renderHistory(view, msgs.slice(0, cut));
      } catch (err) { /* fall back to whatever's on screen */ }
      startChat(text, { editTurn: turn });
    }

    // Open a session: a streaming view is re-mounted live (its run kept going in
    // the background); an idle one is re-fetched from disk (authoritative,
    // including turns checkpointed while it ran unwatched).
    async function openSession(id) {
      if (!id) return;
      const live = viewFor(id);
      if (live && live.streaming) { showView(live); return; }
      if (live) views.delete(live.key);
      try {
        const data = await (await fetch("/sessions/" + encodeURIComponent(id))).json();
        const view = makeView(id);
        const meta = sessionsCache.find((s) => s.id === id);
        view.title = meta ? (meta.title || "") : "";
        view.cwd = meta ? (meta.cwd || "") : "";  // prefill the stored working-dir hint
        renderHistory(view, data.messages);
        showView(view);  // context size is unknown until its next turn (meter resets)
      } catch (err) {
        if (activeView) line(activeView, "error loading session", "text-red-600");
      }
    }

    // A fresh empty draft — clicking "New chat" again is a no-op, an empty draft
    // is never persisted (the server only saves on a completed turn), and a
    // conversation left mid-stream keeps running in the background (live dot).
    $("chat-new").addEventListener("click", () => {
      if (chatIsEmpty()) { show("chat"); return; }
      showView(makeView(null));
    });

    // Context meter: click toggles a popover with the exact used/window figures;
    // a click anywhere else dismisses it.
    $("ctx-meter").addEventListener("click", (e) => {
      e.stopPropagation();
      $("ctx-meter-pop").classList.toggle("hidden");
    });
    document.addEventListener("click", () => $("ctx-meter-pop").classList.add("hidden"));

    showView(makeView(null));  // start on a fresh empty draft
    loadSessions();

    // The Send button reflects the ACTIVE conversation only: it becomes Stop while
    // that conversation's turn is in flight (background runs keep their own state).
    function refreshSendButton() {
      const on = !!(activeView && activeView.streaming);
      const btn = $("chat-send");
      btn.textContent = on ? t("chat_stop") : t("chat_send");
      btn.classList.toggle("bg-red-600", on);
      btn.classList.toggle("bg-slate-800", !on);
    }
    // A view's run is over (final / stopped / error): close its stream, clear its
    // run state, and repaint whatever reflects it (button, sidebar live dot).
    function endStream(view) {
      if (view.es) view.es.close();
      view.es = null;
      view.runId = null;
      view.streaming = false;
      view.pendingAsk = false;
      refreshSendButton();
      renderSessionList();
    }
    // Stop a view's running turn: the server sets the cancel token, the loop ends
    // at the next boundary, emits `stopped`, and saves the partial conversation
    // (resumable).
    function stopRun(view) {
      if (!view.runId) return;
      fetch("/chat/" + encodeURIComponent(view.runId) + "/stop", { method: "POST" }).catch(() => {});
    }

    // Run one turn over SSE. `opts.editTurn` (re-ask) regenerates from a past user
    // turn; `opts.mode` overrides the dropdown (used internally). Reused by the
    // form submit and by re-ask.
    function startChat(message, opts) {
      opts = opts || {};
      const view = activeView;  // every handler below binds to THIS conversation
      if (!view || view.streaming) return;
      const mode = (opts.mode != null) ? opts.mode : $("mode").value;
      const stream = streamEnabled();  // System tab toggle (default enabled)
      line(view, "you" + (mode ? " (" + mode + ")" : "") + ": " + message, "font-semibold");
      if (!view.preview) view.preview = message;  // labels a not-yet-saved live row

      let answer = null;        // the live answer text element (null until first token)
      let thinkBox = null;      // the live reasoning box for the current thinking phase
      const toolQueue = [];     // tool blocks awaiting their result (FIFO; calls run sequentially)
      const cwd = $("cwd").value.trim();  // working-directory hint (blank = none)
      if (cwd) view.cwd = cwd;            // remember it on the view for resume/relabel
      let url = "/chat?message=" + encodeURIComponent(message) + "&stream=" + stream;
      if (mode) url += "&mode=" + encodeURIComponent(mode);
      if (view.sessionId) url += "&session=" + encodeURIComponent(view.sessionId);
      if (opts.editTurn != null) url += "&edit_turn=" + encodeURIComponent(opts.editTurn);
      if (cwd) url += "&cwd=" + encodeURIComponent(cwd);
      const es = new EventSource(url);
      view.es = es;
      view.streaming = true;
      refreshSendButton();
      renderSessionList();  // the live dot appears
      // Immediate "thinking …" so the page reacts the instant you send — before the
      // first event arrives. It becomes the live reasoning box if the model streams
      // reasoning, or is dropped (empty) the moment real output begins.
      thinkBox = reasoningBox(view);

      // End the current thinking phase: collapse it to "Thought for Ns" if it
      // streamed anything, else drop the empty placeholder. Called when real output
      // (answer text / tool call / ask / end) begins.
      function closeThinking() {
        if (!thinkBox) return;
        if (thinkBox.hasText()) thinkBox.finishLive(); else thinkBox.remove();
        thinkBox = null;
      }

      // The run is over (final / stopped / error). A finished BACKGROUND view is
      // dropped: its next open re-fetches the authoritative history from disk.
      function finishStream() {
        endStream(view);
        if (view !== activeView) views.delete(view.key);
      }

      es.addEventListener("run", (ev) => {
        const d = JSON.parse(ev.data);
        view.runId = d.run_id;  // enable Stop for this run
        view.ctxWindow = d.context_window || null;  // generation profile's window (may be unset)
      });
      es.addEventListener("step", (ev) => {
        const d = JSON.parse(ev.data);  // real prompt_tokens of the context just sent
        if (d.prompt_tokens != null) {
          view.ctxUsed = d.prompt_tokens;
          if (view === activeView) updateCtxMeter(view.ctxUsed);
        }
      });
      es.addEventListener("session", (ev) => {
        const id = JSON.parse(ev.data).id;  // remember it so the next turn resumes
        if (view.sessionId !== id) {
          views.delete(view.key);  // re-key the draft under its minted session id
          view.sessionId = id;
          view.key = id;
          views.set(id, view);
        }
      });
      es.addEventListener("title", (ev) => {
        const d = JSON.parse(ev.data);
        view.title = d.title || "";
        if (view === activeView) updateMainTitle();
        const meta = sessionsCache.find((s) => s.id === d.id);
        if (meta) meta.title = view.title;
        renderSessionList();
      });
      // Thinking channel: reasoning streams into a dim, collapsible box (one per
      // thinking phase). A phase after a tool result opens a fresh box.
      es.addEventListener("thinking", (ev) => {
        if (!thinkBox) thinkBox = reasoningBox(view);
        thinkBox.append(JSON.parse(ev.data).text);
      });
      es.addEventListener("token", (ev) => {
        closeThinking();  // the answer has begun -> collapse the reasoning box
        if (answer === null) answer = line(view, "", "text-slate-900 whitespace-pre-wrap");
        answer.textContent += JSON.parse(ev.data).text;
        scrollChat(view);
      });
      es.addEventListener("ask", (ev) => {
        closeThinking();
        answer = null;  // a later text run starts a NEW line BELOW the card
        renderAskCard(view, JSON.parse(ev.data));  // inline card; answer POSTs to /respond
      });
      es.addEventListener("tool_call", (ev) => {
        closeThinking();
        const d = JSON.parse(ev.data);
        answer = null;  // close the current text run so the next one lands below this
        if (d.name === "ask_question") return;  // shown as the ask card instead
        toolQueue.push(toolBlock(view, d.name, d.arguments));
      });
      es.addEventListener("tool_result", (ev) => {
        const d = JSON.parse(ev.data);
        answer = null;  // next streamed text gets a fresh line below the tool block
        if (d.name === "ask_question") return;  // the answer is already on the card
        const tb = toolQueue.shift();
        if (tb) tb.setResult(d.result);
        else line(view, "← " + d.name + ": " + d.result, "text-emerald-700");
      });
      es.addEventListener("error", (ev) => {
        closeThinking();
        if (ev.data) line(view, "error: " + ev.data, "text-red-600");
        finishStream();
      });
      es.addEventListener("stopped", (ev) => {
        closeThinking();
        const d = JSON.parse(ev.data);
        line(view, t("chat_stopped") + " · steps=" + d.steps, "text-xs text-amber-600");
        finishStream();
        loadSessions();  // the partial turn is saved — refresh the picker
      });
      es.addEventListener("final", (ev) => {
        closeThinking();
        const d = JSON.parse(ev.data);
        if (answer === null) line(view, d.answer, "text-slate-900 whitespace-pre-wrap");
        line(view, "[" + d.mode + "] [" + d.stop_reason + "] steps=" + d.steps + " tokens=" + d.tokens + " cost=" + d.cost_usd, "text-xs text-slate-400");
        finishStream();
        loadSessions();  // refresh the picker (new session appears / preview updates)
      });
    }

    $("chat-form").addEventListener("submit", (e) => {
      e.preventDefault();
      // The button is "Stop" while the ACTIVE conversation has a turn in flight.
      if (activeView && activeView.streaming) { stopRun(activeView); return; }
      if (!hasLLM()) { show("config"); showCfg("llm"); return; }
      const message = $("msg").value.trim();
      if (!message) return;
      $("msg").value = "";
      startChat(message, {});
    });

    // Typing/clearing the working-dir input keeps the active view's hint in step,
    // so switching conversations and back doesn't lose an un-sent path.
    $("cwd").addEventListener("input", () => { if (activeView) activeView.cwd = $("cwd").value.trim(); });
    $("cwd-clear").addEventListener("click", () => {
      $("cwd").value = "";
      if (activeView) activeView.cwd = "";
    });

    // ---- working-directory browser (server-side, dir-names only) --------
    // A local, trusted-user control: GET /fs/list returns a folder's child
    // directory names (never file contents). Click a folder to drill in, ↑ Up to
    // go to the parent, "Use this folder" to set the chat working-dir hint.
    let fsCurrent = "";  // the path currently shown in the modal
    function openFsModal() {
      $("fs-modal").classList.remove("hidden");
      $("fs-modal").classList.add("flex");
      loadFsDir($("cwd").value.trim() || "");
    }
    function closeFsModal() {
      $("fs-modal").classList.add("hidden");
      $("fs-modal").classList.remove("flex");
    }
    async function loadFsDir(path) {
      const list = $("fs-list"), status = $("fs-status");
      list.innerHTML = "";
      status.textContent = t("fs_loading");
      try {
        const url = "/fs/list" + (path ? "?path=" + encodeURIComponent(path) : "");
        const data = await (await fetch(url)).json();
        fsCurrent = data.path || "";
        $("fs-path").textContent = fsCurrent;
        $("fs-up").dataset.parent = data.parent || "";
        status.textContent = "";
        const dirs = data.dirs || [];
        if (!dirs.length) {
          const empty = document.createElement("p");
          empty.className = "px-2 py-2 text-xs text-slate-400";
          empty.textContent = t("fs_empty");
          list.appendChild(empty);
          return;
        }
        dirs.forEach((name) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "block w-full truncate rounded px-2 py-1.5 text-left hover:bg-slate-100 dark:hover:bg-slate-700";
          btn.textContent = "📁 " + name;
          btn.addEventListener("click", () => loadFsDir(joinFsPath(fsCurrent, name)));
          list.appendChild(btn);
        });
      } catch (err) {
        status.textContent = t("fs_error");
      }
    }
    // Join a child onto the shown path, picking the separator the server used so
    // Windows ("\") and POSIX ("/") both work without a path library client-side.
    function joinFsPath(base, name) {
      if (!base) return name;
      const sep = base.indexOf("\\") >= 0 && base.indexOf("/") < 0 ? "\\" : "/";
      return base.replace(/[\\/]$/, "") + sep + name;
    }
    $("cwd-browse").addEventListener("click", openFsModal);
    $("fs-cancel").addEventListener("click", closeFsModal);
    $("fs-up").addEventListener("click", () => {
      const parent = $("fs-up").dataset.parent || "";
      if (parent && parent !== fsCurrent) loadFsDir(parent);
    });
    $("fs-use").addEventListener("click", () => {
      if (fsCurrent) {
        $("cwd").value = fsCurrent;
        if (activeView) activeView.cwd = fsCurrent;
      }
      closeFsModal();
    });
    $("fs-modal").addEventListener("click", (e) => { if (e.target === $("fs-modal")) closeFsModal(); });

    // ---- config: functional sub-tabs ------------------------------------
    const CFG_TABS = ["llm", "context", "tools",{% if spec.mcp.enabled %} "mcp",{% endif %} "hooks", "paradigms", "prompts", "budget",{% if spec.memory.enabled %} "memory",{% endif %} "observability", "system"];
    let cfgTab = "llm";
    let cfg = {};
    // {NAME: bool} from GET /env-status — whether each configured api_key/base_url
    // env-var currently resolves to a value. Used to mask an already-set key/url
    // with a placeholder; the VALUE itself is never fetched (write-only).
    let envStatus = {};
    // Tracks unsaved edits in the config view. Edits live only in the DOM until
    // Save (POST /config); this flag drives the "unsaved" marker, the leave/reload
    // guards, and stops a tab switch back to Config from reloading over the edits.
    let dirty = false;
    // Serialized form of everything the config view persists (the config patch +
    // the rule-file editor contents) as of the last load/Save. "unsaved" means
    // the view no longer matches this baseline. We compare against it rather than
    // trust raw input/change events because a programmatic rebuild (renderConfig)
    // tears down focused fields, and the browser fires DEFERRED blur/change on
    // them that can land AFTER a Save resets the flag — those events don't change
    // the serialized form, so a recompare keeps the view correctly "saved".
    let savedSnapshot = "";
    // Rule files from GET /rules: [{path, content, exists, auto}]. `auto` = an
    // auto-recognized convention file (root CLAUDE.md) shown read-only, editable in
    // place but not added to the explicit rules_files list. Save writes contents
    // back via POST /rules.
    let ruleFiles = [];
    // What's registered in code (GET /registries): the universe the Context +
    // Paradigms dropdowns are built from. A configured name missing here is flagged.
    let reg = { paradigms: [], strategies: [], conditions: [], extensions: [], hooks: []{% if spec.memory.enabled %}, memory: [] {% endif %} };
    // Per-LLM accrued usage from GET /usage ([{name, model, prompt_tokens, ...,
    // cost, limit, over}]); drives the Budget tab's used-tokens + derived cost.
    let usageRows = [];
    const UNREG = " \u26a0";  // appended to a name selected in config but not registered

    function buildCfgTabs() {
      const nav = $("cfg-tabs");
      if (!nav) return;
      nav.innerHTML = "";
      for (const name of CFG_TABS) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = t("subtab_" + name);
        b.className = "px-3 py-2 " + (name === cfgTab ? "border-b-2 border-slate-800 font-semibold" : "text-slate-500");
        b.addEventListener("click", () => showCfg(name));
        nav.appendChild(b);
      }
    }
    function showCfg(name) {
      cfgTab = name;
      document.querySelectorAll("[data-cfg]").forEach((p) => p.classList.toggle("hidden", p.dataset.cfg !== name));
      buildCfgTabs();
      // Refresh accrued usage each time the Budget tab opens (a run since the last
      // view may have spent more); preserves the price/limit inputs being edited.
      if (name === "budget") loadUsage().then(buildBudget);
{% if spec.mcp.enabled %}      // Auto-discover MCP tools the first time the Tools tab opens (cached after).
      if (name === "tools" && (mcpDiscovered === null || mcpDiscovered.pending)) discoverMcp();
      // Refresh live server status every time the MCP tab opens ("refresh promptly").
      if (name === "mcp") loadMcp();
{% endif %}      // Pull the hook-execution log each time the Hooks tab opens.
      if (name === "hooks") loadHookLog();
    }

    const numOrNull = (v) => { v = (v ?? "").toString().trim(); return v === "" ? null : Number(v); };
    const esc = (v) => (v == null ? "" : String(v).replace(/'/g, "&#39;"));
    const escNum = (v) => (v ? esc(v) : "");  // hide 0 / null behind the placeholder
    // A fixed-length dot placeholder shown for an env-var that's already set in
    // .env (same length for key and url so the two rows line up). It's a sentinel,
    // never a real value, and is skipped on write (see the .p-setkey/.p-seturl handler).
    const ENV_MASK = "\u2022".repeat(12);
    const envSet = (name) => !!(name && envStatus[name]);

    // One LLM profile card: name/model + API key + base_url always visible;
    // sampling knobs under "Advanced", per-1M prices under "Pricing". `isNew` (a
    // just-added, never-saved card) never masks its key/url: the masked dots imply
    // "already set in .env", which is misleading on a fresh profile that defaults
    // to a shared env-var name — show the boxes empty until it's saved + reloaded.
    function profileCard(p, isNew) {
      p = p || {};
      const reasoning = p.reasoning_effort || "";
      const reOpt = (v, label) =>
        "<option value='" + v + "'" + (reasoning === v ? " selected" : "") + ">" + (label || v) + "</option>";
      const stopVal = Array.isArray(p.stop) ? p.stop.join(", ") : (p.stop || "");
      const extraVal = (p.extra_body && Object.keys(p.extra_body).length) ? JSON.stringify(p.extra_body) : "";
      const provider = p.provider || "openai";
      const provOpt = (v) => "<option value='" + v + "'" + (provider === v ? " selected" : "") + ">" + v + "</option>";
      const div = document.createElement("div");
      div.className = "profile rounded-lg border p-3 space-y-2";
      div.innerHTML =
        "<div class='flex items-start justify-between gap-2'>" +
          "<div class='grid grid-cols-3 gap-2 flex-1'>" +
            "<label class='text-xs'>" + t("profile_name") + "<input class='p-name mt-1 w-full rounded border px-2 py-1' value='" + esc(p.name) + "'/></label>" +
            "<label class='text-xs'>" + t("profile_model") + "<input class='p-model mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc(p.model) + "'/></label>" +
            "<label class='text-xs'>" + t("profile_provider") + "<select class='p-provider mt-1 w-full rounded border px-2 py-1'>" + provOpt("openai") + provOpt("anthropic") + "</select></label>" +
          "</div>" +
          "<button type='button' class='p-remove text-xs text-red-600'>" + t("profile_remove") + "</button>" +
        "</div>" +
        keyRow("profile_key_section", "p-key", esc(p.api_key_env || "OPENAI_API_KEY"), "p-keyval", "p-setkey", "p-keystatus", t("set_key_ph"), t("set_key_btn"), "password", !isNew && envSet(p.api_key_env || "OPENAI_API_KEY")) +
        keyRow("profile_url_section", "p-baseurl", esc(p.base_url_env || "OPENAI_BASE_URL"), "p-urlval", "p-seturl", "p-urlstatus", t("set_url_ph"), t("set_url_btn"), "text", !isNew && envSet(p.base_url_env || "OPENAI_BASE_URL")) +
        "<div class='flex items-center gap-2'>" +
          "<button type='button' class='p-test rounded border px-3 py-1 text-xs'>" + t("test_btn") + "</button>" +
          "<span class='p-teststatus text-xs'></span>" +
        "</div>" +
        "<details class='text-xs'><summary class='cursor-pointer text-slate-600'>" + t("adv_section") + "</summary>" +
          "<div class='mt-2 grid grid-cols-3 gap-2'>" +
            "<label>" + t("profile_temp") + "<input class='p-temp mt-1 w-full rounded border px-2 py-1' placeholder='" + t("temp_ph") + "' value='" + escNum(p.temperature) + "'/></label>" +
            "<label>" + t("profile_maxtok") + "<input class='p-maxtok mt-1 w-full rounded border px-2 py-1' value='" + escNum(p.max_tokens) + "'/></label>" +
            "<label>" + t("profile_reasoning") + "<select class='p-reasoning mt-1 w-full rounded border px-2 py-1'>" +
              reOpt("", t("reasoning_default")) + reOpt("none") + reOpt("minimal") + reOpt("low") + reOpt("medium") + reOpt("high") + reOpt("xhigh") +
            "</select></label>" +
            "<label>" + t("profile_top_p") + "<input class='p-topp mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + escNum(p.top_p) + "'/></label>" +
            "<label>" + t("profile_freq_pen") + "<input class='p-freqpen mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + escNum(p.frequency_penalty) + "'/></label>" +
            "<label>" + t("profile_pres_pen") + "<input class='p-prespen mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + escNum(p.presence_penalty) + "'/></label>" +
            "<label>" + t("profile_seed") + "<input class='p-seed mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + escNum(p.seed) + "'/></label>" +
            "<label>" + t("profile_stop") + "<input class='p-stop mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + esc(stopVal) + "'/></label>" +
            "<label>" + t("profile_ctxwin") + "<input class='p-ctxwin mt-1 w-full rounded border px-2 py-1' placeholder='" + t("ctxwin_ph") + "' value='" + escNum(p.context_window) + "'/></label>" +
            "<label>" + t("profile_timeout") + "<input class='p-timeout mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + escNum(p.timeout_seconds) + "'/></label>" +
            "<label>" + t("profile_retries") + "<input class='p-retries mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + escNum(p.max_retries) + "'/></label>" +
            "<label>" + t("profile_fallback") + "<input class='p-fallback mt-1 w-full rounded border px-2 py-1' placeholder='\u2014' value='" + esc(p.fallback || "") + "'/></label>" +
          "</div>" +
          "<label class='mt-2 block'>" + t("profile_extra") + "<textarea class='p-extra mt-1 w-full rounded border px-2 py-1 font-mono' rows='2' placeholder='" + t("extra_ph") + "'>" + esc(extraVal) + "</textarea></label>" +
        "</details>";
      return div;
    }
    // An env-var row: NAME input + write-only VALUE input that posts to /env.
    // When `isSet`, the value box shows a masked placeholder (the value is already
    // in .env) tagged data-masked — focusing clears it to type a new one, and a
    // still-masked box is skipped on write so the placeholder is never stored.
    function keyRow(sectionKey, nameCls, nameVal, valCls, btnCls, statusCls, ph, btnLabel, valType, isSet) {
      const masked = isSet ? (" value='" + ENV_MASK + "' data-masked='1'") : "";
      return "<div><div class='text-xs text-slate-500'>" + t(sectionKey) + "</div>" +
        "<div class='mt-1 flex items-center gap-2'>" +
          "<input class='" + nameCls + " w-44 rounded border px-2 py-1 font-mono text-xs' title='" + t("profile_varname") + "' value='" + nameVal + "'/>" +
          "<input type='" + valType + "' class='" + valCls + " flex-1 rounded border px-2 py-1' placeholder='" + ph + "'" + masked + "/>" +
          "<button type='button' class='" + btnCls + " rounded border px-2 py-1 text-xs whitespace-nowrap'>" + btnLabel + "</button>" +
          "<span class='" + statusCls + " text-xs text-emerald-700'></span>" +
        "</div></div>";
    }

    // Build a profile object from one card's live inputs (used by Save + Test).
    function cardToProfile(w) {
      const g = (cls) => { const el = w.querySelector("." + cls); return el ? el.value.trim() : ""; };
      const o = { name: g("p-name"), model: g("p-model") };
      o.provider = g("p-provider") || "openai";
      if (g("p-key")) o.api_key_env = g("p-key");
      if (g("p-baseurl")) o.base_url_env = g("p-baseurl");
      const temp = numOrNull(g("p-temp")); if (temp != null) o.temperature = temp;
      const mt = numOrNull(g("p-maxtok")); if (mt != null) o.max_tokens = mt;
      const re = g("p-reasoning"); if (re) o.reasoning_effort = re;
      const tp = numOrNull(g("p-topp")); if (tp != null) o.top_p = tp;
      const fp = numOrNull(g("p-freqpen")); if (fp != null) o.frequency_penalty = fp;
      const pp = numOrNull(g("p-prespen")); if (pp != null) o.presence_penalty = pp;
      const sd = numOrNull(g("p-seed")); if (sd != null) o.seed = sd;
      const st = g("p-stop"); if (st) o.stop = st;
      const cw = numOrNull(g("p-ctxwin")); if (cw != null) o.context_window = cw;
      const to = numOrNull(g("p-timeout")); if (to != null) o.timeout_seconds = to;
      const mr = numOrNull(g("p-retries")); if (mr != null) o.max_retries = mr;
      const fb = g("p-fallback"); if (fb) o.fallback = fb;
      // extra_body: a JSON object of non-standard provider params (top_k, ...).
      // Invalid / non-object JSON is dropped silently (the field is flagged red live).
      const ex = g("p-extra");
      if (ex) { try { const v = JSON.parse(ex); if (v && typeof v === "object" && !Array.isArray(v)) o.extra_body = v; } catch (e) {} }
      // Pricing + cost_limit are edited on the Budget tab and merged into the llms
      // patch by name in collectConfig (so they survive a Save from any tab).
      return o;
    }
    // Options come from the LIVE profile-name inputs (so renaming/adding a profile
    // is reflected at once). Every named profile is listed — duplicates included.
    function roleOptions(selected) {
      let html = "";
      document.querySelectorAll("#cfg-profiles .p-name").forEach((inp) => {
        const name = inp.value.trim();
        if (!name) return;
        html += "<option value='" + esc(name) + "'" + (selected === name ? " selected" : "") + ">" + esc(name) + "</option>";
      });
      return html;
    }
    // generation + compaction are always shown; any extra configured role is kept.
    // Both default to the empty "(first profile)" option — that mirrors the runtime
    // fallback (an unset role resolves to the first profile, NOT to generation).
    function buildRoles() {
      const rc = $("cfg-roles");
      const prev = {};  // preserve current picks across a live rebuild
      rc.querySelectorAll(".role-target").forEach((el) => { prev[el.dataset.role] = el.value; });
      rc.innerHTML = "";
      const roles = cfg.roles || {};
      const names = ["generation", "compaction", "title"{% if spec.memory.enabled %}, "memory"{% endif %}];
      Object.keys(roles).forEach((r) => { if (!names.includes(r)) names.push(r); });
      names.forEach((role) => {
        const selected = (role in prev) ? prev[role] : (roles[role] || "");
        const known = t("role_" + role);
        const label = known === ("role_" + role) ? role : known;
        rc.insertAdjacentHTML("beforeend",
          "<label class='flex items-center gap-2 text-sm'><span class='w-44 font-mono'>" + label + "</span>" +
          "<select class='role-target rounded border px-2 py-1' data-role='" + role + "'>" +
            "<option value=''>" + t("role_use_first") + "</option>" + roleOptions(selected) +
          "</select></label>");
      });
    }

    // "Configured" means at least one profile names a model. A profile that only
    // carries env-var names (the generated scaffold) doesn't count — chat stays
    // gated until you fill in a model, so a half-set-up product can't silently
    // call the API with an empty/guessed model.
    const hasLLM = () => !!(cfg.llms && cfg.llms.some((p) => p && (p.model || "").trim()));
    function gateChat() {
      const none = !hasLLM();
      $("no-llm").classList.toggle("hidden", !none);
      ["msg", "mode", "chat-send", "gen-llm", "cwd", "cwd-browse", "cwd-clear"].forEach((id) => { $(id).disabled = none; });
    }

    // Build the Context tab from the registries: the strategy dropdown lists every
    // registered strategy, and there's one threshold input per registered condition
    // (built-ins + anything you @register and import). A configured name that isn't
    // registered is still shown, flagged, so it round-trips instead of vanishing.
    function buildContext() {
      const ctx = cfg.context || {};
      const sel = $("cfg-ctx-strategy"); sel.innerHTML = "";
      const strategies = reg.strategies.slice();
      if (ctx.strategy && !strategies.includes(ctx.strategy)) strategies.push(ctx.strategy);
      strategies.forEach((name) => {
        const ok = reg.strategies.includes(name);
        const o = document.createElement("option");
        o.value = name; o.textContent = name + (ok ? "" : UNREG);
        if (!ok) o.title = t("cfg_unregistered");
        sel.appendChild(o);
      });
      sel.value = ctx.strategy || "summarize";
      $("cfg-ctx-keep").value = ctx.keep_last_turns ?? 6;
      $("cfg-ctx-combine").value = ctx.combine || "or";
      $("cfg-ctx-toolcap").value = ctx.max_tool_result_chars ?? 100000;
      const trig = ctx.triggers || {};
      const names = reg.conditions.slice();
      Object.keys(trig).forEach((n) => { if (!names.includes(n)) names.push(n); });
      // window_pct is the usage-driven default — list it first among the conditions.
      const wp = names.indexOf("window_pct");
      if (wp > 0) { names.splice(wp, 1); names.unshift("window_pct"); }
      const box = $("cfg-ctx-triggers"); box.innerHTML = "";
      names.forEach((name) => {
        const ok = reg.conditions.includes(name);
        const label = document.createElement("label");
        label.className = "flex items-center gap-2 text-sm";
        const span = document.createElement("span");
        span.className = "w-44 font-mono"; span.textContent = name + (ok ? "" : UNREG);
        if (!ok) span.title = t("cfg_unregistered");
        const inp = document.createElement("input");
        // step "any" + no min so a 0–1 fraction (window_pct) and absolute token
        // counts (max_tokens / max_turns) share one input.
        inp.type = "number"; inp.step = "any"; inp.min = "0"; inp.placeholder = "\u2014";
        inp.className = "cfg-trigger w-40 rounded border px-2 py-1";
        inp.dataset.cond = name;
        inp.value = trig[name] ?? "";
        label.appendChild(span); label.appendChild(inp);
        box.appendChild(label);
      });
    }

    // Build the Budget tab: one card per CURRENT LLM profile (aligned with the LLM
    // tab, by profile name). Each card edits the per-1M prices + a cost limit (saved
    // into the llms config on Save) and shows the accrued tokens + derived cost from
    // GET /usage (recomputed live as you edit a price). Clear resets one counter.
    // Price/limit inputs are preserved across a rebuild (e.g. after a Clear) so an
    // unsaved edit isn't lost.
    function buildBudget() {
      const box = $("cfg-bud-rows");
      const prev = {};
      box.querySelectorAll(".bud-row").forEach((r) => {
        prev[r.dataset.name] = {
          input: r.querySelector(".b-input").value,
          output: r.querySelector(".b-output").value,
          cached: r.querySelector(".b-cached").value,
          limit: r.querySelector(".b-limit").value,
        };
      });
      box.innerHTML = "";
      const profiles = cfg.llms || [];
      if (!profiles.length) {
        box.innerHTML = "<p class='text-sm text-slate-500'>" + t("bud_none") + "</p>";
        return;
      }
      profiles.forEach((p) => {
        const pv = prev[p.name] || {};
        const div = document.createElement("div");
        div.className = "bud-row rounded-lg border p-3 space-y-2";
        div.dataset.name = p.name;
        div.innerHTML =
          "<div class='flex items-center justify-between gap-2'>" +
            "<div class='text-sm'><span class='font-medium'>" + esc(p.name) + "</span> " +
              "<span class='font-mono text-xs text-slate-500'>" + esc(p.model || "") + "</span></div>" +
            "<button type='button' class='b-clear text-xs text-red-600'>" + t("bud_clear") + "</button>" +
          "</div>" +
          "<div class='b-cost text-3xl font-bold tracking-tight'></div>" +
          "<div class='b-used flex flex-wrap gap-x-4 gap-y-1 text-lg text-slate-600'></div>" +
          "<div class='grid grid-cols-4 gap-2 text-xs pt-1'>" +
            "<label>" + t("profile_input_cost") + "<input class='b-input mt-1 w-full rounded border px-2 py-1' placeholder='" + t("cost_ph") + "' value='" + escNum(pv.input != null ? pv.input : p.input_cost_per_million) + "'/></label>" +
            "<label>" + t("profile_output_cost") + "<input class='b-output mt-1 w-full rounded border px-2 py-1' placeholder='" + t("cost_ph") + "' value='" + escNum(pv.output != null ? pv.output : p.output_cost_per_million) + "'/></label>" +
            "<label>" + t("profile_cached_cost") + "<input class='b-cached mt-1 w-full rounded border px-2 py-1' placeholder='" + t("cost_ph") + "' value='" + escNum(pv.cached != null ? pv.cached : p.cached_input_cost_per_million) + "'/></label>" +
            "<label>" + t("bud_limit") + "<input class='b-limit mt-1 w-full rounded border px-2 py-1' placeholder='" + t("bud_no_limit") + "' value='" + escNum(pv.limit != null ? pv.limit : p.cost_limit) + "'/></label>" +
          "</div>";
        box.appendChild(div);
        updateBudCost(div);
      });
    }

    // Recompute one budget card's used-tokens line + derived cost (and the
    // limit-reached flag) from its current price inputs and the cached usage.
    function updateBudCost(div) {
      const u = usageRows.find((x) => x.name === div.dataset.name) ||
        { prompt_tokens: 0, completion_tokens: 0, cached_prompt_tokens: 0 };
      const num = (cls) => Number(div.querySelector(cls).value) || 0;
      const inp = num(".b-input"), out = num(".b-output"), cached = num(".b-cached"), limit = num(".b-limit");
      const cachedPrice = cached || inp;
      const fresh = Math.max(0, (u.prompt_tokens || 0) - (u.cached_prompt_tokens || 0));
      const cost = fresh / 1e6 * inp + (u.cached_prompt_tokens || 0) / 1e6 * cachedPrice +
        (u.completion_tokens || 0) / 1e6 * out;
      const over = limit > 0 && cost >= limit;
      // 已用 输入 N 输出 N 缓存 N — separate spans so the line wraps cleanly.
      const pair = (label, val) =>
        "<span><span class='text-slate-400'>" + label + "</span> " + val + "</span>";
      div.querySelector(".b-used").innerHTML =
        "<span class='font-medium text-slate-700'>" + t("bud_used") + "</span>" +
        pair(t("bud_in"), u.prompt_tokens || 0) +
        pair(t("bud_out"), u.completion_tokens || 0) +
        pair(t("bud_cached"), u.cached_prompt_tokens || 0);
      const c = div.querySelector(".b-cost");
      c.textContent = t("bud_cost") + " " + cost.toFixed(4) + (over ? "  \u26a0 " + t("bud_over") : "");
      c.className = "b-cost text-3xl font-bold tracking-tight" + (over ? " text-red-600" : "");
    }

    // The default dropdown only offers currently-checked paradigms.
    function parDefaultOptions() {
      const sel = $("cfg-par-default");
      const prev = sel.value;
      const checked = Array.from(document.querySelectorAll(".cfg-par-cb"))
        .filter((c) => c.checked).map((c) => c.dataset.name);
      sel.innerHTML = "";
      checked.forEach((name) => {
        const o = document.createElement("option"); o.value = name; o.textContent = name; sel.appendChild(o);
      });
      if (checked.includes(prev)) sel.value = prev;
    }

    // Build the Paradigms tab: a checkbox per registered paradigm (checked = in
    // config.paradigms.enabled). A newly @register_paradigm'd one shows up here as
    // an unchecked item to enable; an enabled-but-unregistered name is flagged.
    function buildParadigms() {
      const par = cfg.paradigms || {};
      const enabled = par.enabled || [];
      const names = reg.paradigms.slice();
      enabled.forEach((n) => { if (!names.includes(n)) names.push(n); });
      const box = $("cfg-par-list"); box.innerHTML = "";
      names.forEach((name) => {
        const ok = reg.paradigms.includes(name);
        const label = document.createElement("label");
        label.className = "flex items-center gap-2 text-sm";
        const cb = document.createElement("input");
        cb.type = "checkbox"; cb.className = "cfg-par-cb"; cb.dataset.name = name;
        cb.checked = enabled.includes(name);
        cb.addEventListener("change", parDefaultOptions);
        const span = document.createElement("span");
        span.className = "font-mono"; span.textContent = name + (ok ? "" : UNREG);
        if (!ok) span.title = t("cfg_unregistered");
        label.appendChild(cb); label.appendChild(span);
        box.appendChild(label);
      });
      parDefaultOptions();
      if (par.default && Array.from($("cfg-par-default").options).some((o) => o.value === par.default)) {
        $("cfg-par-default").value = par.default;
      }
    }

    // The in-process tools this product ships in harness/tools.py (+ read_skill
    // from skills.py when enabled). Any other name without "__" is one YOU
    // registered — those sort to the very top. Only affects grouping, never
    // behavior; keep in sync if you rename a built-in.
    const BUILTIN_TOOLS = new Set(["get_current_time", "calculator", "ask_question"{% if spec.skills.enabled %}, "read_skill"{% endif %}{% if spec.memory.enabled %}, "memory_read", "memory_append", "memory_write"{% endif %}]);
    // Tools discovered from MCP servers (GET /mcp/discover), cached per page load so
    // a server's tools can be offered without hand-writing the allowlist. null =
    // not scanned yet; buildTools then falls back to whatever's already in config.
    let mcpDiscovered = null;

    // One tool checkbox. data-name + data-listed drive the save: a listed tool
    // round-trips (unchecking just disables it), a discovered-but-unlisted tool is
    // written only when you tick it (so config isn't bloated with every MCP tool).
    function toolRow(name, short, enabled, listed) {
      return "<label class='flex items-center gap-2 text-sm'>" +
        "<input type='checkbox' class='tool-en' data-name='" + esc(name) + "' data-listed='" + (listed ? "1" : "0") + "' " +
        (enabled ? "checked" : "") + "/> <span class='font-mono'>" + short + "</span></label>";
    }

    // Tools is a flat allowlist in config, grouped here for legibility: tools you
    // registered first, then the built-ins, then each MCP server's tools folded
    // into a collapsed group. With a scan, a server shows its FULL tool set (tick
    // to allowlist); without one, it falls back to the listed entries.
    function buildTools() {
      const box = $("cfg-tools");
      box.innerHTML = "";
      const listedEnabled = new Map();  // full name -> enabled (from config allowlist)
      const wildServers = new Set();  // servers with an enabled `<server>__*` wildcard (all tools on)
      (cfg.tools || []).forEach((tl) => {
        if (tl.name.endsWith("__*")) { if (tl.enabled) wildServers.add(tl.name.slice(0, -3)); return; }
        listedEnabled.set(tl.name, !!tl.enabled);
      });

      const custom = [], builtin = [];
      (cfg.tools || []).forEach((tl) => {
        if (tl.name.indexOf("__") > 0) return;  // MCP handled below
        (BUILTIN_TOOLS.has(tl.name) ? builtin : custom).push(tl);
      });
      const localSection = (titleKey, items) => {
        if (!items.length) return;
        box.insertAdjacentHTML("beforeend",
          "<p class='text-xs font-medium text-slate-500'>" + t(titleKey) + "</p>" +
          "<div class='mb-1 space-y-1 pl-1'>" +
          items.map((tl) => toolRow(tl.name, tl.name, tl.enabled, true)).join("") + "</div>");
      };
      localSection("tools_group_custom", custom);
      localSection("tools_group_builtin", builtin);

      const groups = new Map();  // server -> [{name, short, enabled, listed}]
      const errors = new Map();
      const connecting = new Set();  // servers still connecting (tools may arrive later)
      const seen = new Set();
      if (mcpDiscovered) {
        (mcpDiscovered.servers || []).forEach((s) => {
          if (!groups.has(s.name)) groups.set(s.name, []);
          if (s.error) errors.set(s.name, s.error);
          if (s.connecting) connecting.add(s.name);
          (s.tools || []).forEach((tl) => {
            groups.get(s.name).push({
              name: tl.name, short: tl.short,
              enabled: listedEnabled.get(tl.name) || wildServers.has(s.name) || false,
              listed: listedEnabled.has(tl.name),
            });
            seen.add(tl.name);
          });
        });
      }
      (cfg.tools || []).forEach((tl) => {  // listed MCP tools not covered by a scan
        const sep = tl.name.indexOf("__");
        if (sep <= 0 || seen.has(tl.name) || tl.name.endsWith("__*")) return;  // wildcard isn't a row
        const server = tl.name.slice(0, sep);
        if (!groups.has(server)) groups.set(server, []);
        groups.get(server).push({ name: tl.name, short: tl.name.slice(sep + 2), enabled: tl.enabled, listed: true });
      });
      // One collapsed <details> per MCP server (collapsed = the noisy tools stay
      // out of the way); the summary shows a master checkbox (the "big checkbox"
      // total switch for all the server's tools), enabled/total, + any connect error.
      for (const [server, items] of groups) {
        const en = items.filter((e) => e.enabled).length;
        const err = errors.get(server);
        // A server still connecting shows a live "connecting…" tag; its tools fill in
        // on the next poll the moment IT settles (not blocked by other servers).
        const conn = connecting.has(server)
          ? "<span class='text-xs text-amber-600 animate-pulse'>" + t("mcp_connecting") + "</span>"
          : "";
        const body = items.length
          ? items.map((e) => toolRow(e.name, e.short, e.enabled, e.listed)).join("")
          : "<p class='text-xs text-slate-400'>" + (connecting.has(server) ? t("mcp_connecting") : t("tools_none")) + "</p>";
        box.insertAdjacentHTML("beforeend",
          "<details class='rounded border'><summary class='flex cursor-pointer items-center gap-2 px-2 py-1 text-sm'>" +
          "<input type='checkbox' class='mcp-master' data-server='" + esc(server) + "' title='" + t("tools_group_mcp_all") + "' onclick='event.stopPropagation()'/>" +
          "<span class='font-medium'>" + t("tools_group_mcp") + " · " + esc(server) + "</span> " +
          "<span class='text-xs text-slate-500'>(" + en + "/" + items.length + ")</span>" +
          conn +
          (err ? "<span class='text-xs text-red-600'>" + esc(err) + "</span>" : "") +
          "</summary><div class='space-y-1 px-2 pb-2 pl-4'>" + body + "</div></details>");
      }
      // Reflect each group's aggregate on its master checkbox: checked = all on,
      // indeterminate = some on. The master is not a .tool-en, so it never enters
      // the saved allowlist itself.
      box.querySelectorAll(".mcp-master").forEach((m) => {
        const cbs = m.closest("details").querySelectorAll(".tool-en");
        const on = Array.from(cbs).filter((c) => c.checked).length;
        m.checked = cbs.length > 0 && on === cbs.length;
        m.indeterminate = on > 0 && on < cbs.length;
      });
    }
{% if spec.mcp.enabled %}
    // Scan configured MCP servers for their tools and re-render (cached per page
    // load). Async: the panel shows the listed tools immediately, then fills in the
    // full discovered set when the scan returns.
    let toolsPollTimer = null;
    let mcpDiscSig = "";  // skip rebuilds when nothing changed (don't clobber edits)
    async function discoverMcp() {
      const status = $("cfg-mcp-status");
      const btn = $("cfg-mcp-scan");
      status.className = "text-xs text-slate-500";
      if (!mcpDiscovered) status.textContent = t("tools_scanning");
      if (btn) btn.disabled = true;
      try {
        const data = await (await fetch("/mcp/discover")).json();
        mcpDiscovered = data;
        // Rebuild only when the discovered/connecting set changed, so a poll while
        // tools stream in doesn't wipe a checkbox you're mid-toggle on.
        const sig = JSON.stringify((data.servers || []).map(
          (s) => [s.name, (s.tools || []).length, !!s.connecting, s.error || ""]));
        if (sig !== mcpDiscSig) { mcpDiscSig = sig; buildTools(); }
        const n = (data.servers || []).reduce((a, s) => a + (s.tools || []).length, 0);
        status.textContent = data.pending
          ? t("tools_scanning") + " (" + n + ")"
          : t("tools_scanned") + " (" + n + ")";
      } catch (e) {
        status.className = "text-xs text-red-600";
        status.textContent = String(e);
      } finally {
        if (btn) btn.disabled = false;
      }
      // Keep polling while any server is still connecting AND the Tools tab is open,
      // so each server's tools appear the moment it settles (not blocked by a slow one).
      if (toolsPollTimer) { clearTimeout(toolsPollTimer); toolsPollTimer = null; }
      if (mcpDiscovered && mcpDiscovered.pending && cfgTab === "tools") {
        toolsPollTimer = setTimeout(discoverMcp, 1500);
      }
    }

    // ---- MCP management tab (server list + status + add/edit/delete) --------
    let mcpServers = null;  // last GET /mcp/status payload

    // One server card: a live status dot + editable transport/command/url/env
    // (env-var NAMES only, never secret values) + Save (POST /mcp/servers, which
    // hot-reconnects) + Remove. `isNew` makes the name editable; an existing
    // server keeps its name as the key (rename = remove + add).
    function mcpServerCard(s, isNew) {
      s = s || {}; const c = s.config || {};
      const sel = c.transport || "";
      const opt = (v, label) => "<option value='" + v + "'" + (sel === v ? " selected" : "") + ">" + label + "</option>";
      // Three-state dot: green connected / amber connecting (e.g. a uvx/npx
      // cold-download in flight) / red unreachable — so a slow start never looks dead.
      // The amber dot breathes (animate-pulse) so an in-flight connect reads as "working", not frozen.
      const dotColor = s.connecting ? "text-amber-500 animate-pulse" : (s.connected ? "text-emerald-600" : "text-red-600");
      const dotTitle = s.connecting ? t("mcp_connecting") : (s.connected ? t("mcp_connected") : t("mcp_unreachable"));
      const dot = isNew ? "" : "<span class='" + dotColor + "' title='" + esc(dotTitle) + "'>\u25cf</span> ";
      // While connecting (amber), show live progress (elapsed + the latest stderr
      // line, e.g. the npx/uvx fetch) so a slow first-run download never looks dead.
      const elapsed = (s.connecting_seconds != null) ? " " + Math.round(s.connecting_seconds) + "s" : "";
      const connMeta = "<span class='text-xs text-amber-600'>" + t("mcp_connecting") + elapsed + "</span>" +
        (s.log_tail ? " <span class='text-xs font-mono text-slate-400' title='" + esc(s.log_tail) + "'>" + esc(s.log_tail.slice(-72)) + "</span>" : "");
      const idleMeta = "<span class='text-xs text-slate-500'>[" + esc(s.transport) + "] " + s.enabled_count + "/" + s.tool_count + " " + t("mcp_tools_word") + "</span>";
      const meta = isNew ? "" :
        (s.connecting ? connMeta : idleMeta) +
        (s.error ? " <span class='text-xs text-red-600'>" + esc(s.error) + "</span>" : "");
      const div = document.createElement("div");
      div.className = "mcp-srv rounded-lg border p-3 space-y-2";
      div.innerHTML =
        "<div class='flex items-center justify-between gap-2'>" +
          "<div class='flex items-center gap-2'>" + dot +
            "<input class='m-name rounded border px-2 py-1 font-mono text-sm' placeholder='" + t("mcp_name") + "' value='" + esc(c.name) + "'" + (isNew ? "" : " readonly") + "/>" +
            "<select class='m-transport rounded border px-2 py-1 text-xs'>" +
              opt("", t("mcp_transport_auto")) + opt("stdio", "stdio") + opt("http", "http") + opt("sse", "sse") +
            "</select>" +
          "</div>" + meta +
        "</div>" +
        "<div class='grid grid-cols-2 gap-2 text-xs'>" +
          "<label>" + t("mcp_command") + "<input class='m-command mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc(c.command) + "'/></label>" +
          "<label>" + t("mcp_args") + "<input class='m-args mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc((c.args || []).join(" ")) + "'/></label>" +
          "<label>" + t("mcp_url") + "<input class='m-url mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc(c.url) + "'/></label>" +
          "<label>" + t("mcp_authenv") + "<input class='m-authenv mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc(c.auth_env) + "'/></label>" +
          "<label>" + t("mcp_env") + "<input class='m-env mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc((c.env || []).join(", ")) + "'/></label>" +
          "<label>" + t("mcp_safe_tools") + "<input class='m-safe mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc((c.safe_tools || []).join(", ")) + "'/></label>" +
        "</div>" +
        "<div class='flex items-center gap-2'>" +
          (isNew ? "" : "<button type='button' class='m-reconnect rounded border px-3 py-1 text-xs'>" + t("mcp_reconnect") + "</button>") +
          "<button type='button' class='m-save rounded border px-3 py-1 text-xs'>" + t("mcp_save") + "</button>" +
          "<button type='button' class='m-remove rounded border px-3 py-1 text-xs text-red-600'>" + t("mcp_remove") + "</button>" +
          "<span class='m-status text-xs'></span>" +
        "</div>";
      return div;
    }
    // Read one card's inputs into a server config (env-var NAMES only).
    function cardToServer(w) {
      const g = (cls) => { const el = w.querySelector("." + cls); return el ? el.value.trim() : ""; };
      const o = { name: g("m-name") };
      const tr = g("m-transport"); if (tr) o.transport = tr;
      const cmd = g("m-command"); if (cmd) o.command = cmd;
      const args = g("m-args"); if (args) o.args = args.split(/\s+/).filter(Boolean);
      const url = g("m-url"); if (url) o.url = url;
      const authenv = g("m-authenv"); if (authenv) o.auth_env = authenv;
      const env = g("m-env"); if (env) o.env = env.split(",").map((x) => x.trim()).filter(Boolean);
      const safe = g("m-safe"); if (safe) o.safe_tools = safe.split(",").map((x) => x.trim()).filter(Boolean);
      return o;
    }
    function buildMcp() {
      const box = $("cfg-mcp-list");
      box.innerHTML = "";
      ((mcpServers && mcpServers.servers) || []).forEach((s) => box.appendChild(mcpServerCard(s, false)));
    }
    // Pull live status (GET /mcp/status) and rebuild the list. Called each time the
    // MCP tab opens so the connection dots refresh promptly.
    async function loadMcp() {
      const msg = $("cfg-mcp-msg");
      msg.className = "text-xs text-slate-500"; msg.textContent = t("mcp_loading");
      try {
        mcpServers = await (await fetch("/mcp/status")).json();
        buildMcp(); msg.textContent = ""; scheduleMcpPoll();
      } catch (e) { msg.className = "text-xs text-red-600"; msg.textContent = String(e); }
    }
    // While any server is still connecting (e.g. a uvx/npx cold-download), re-poll
    // /mcp/status so the amber dots flip to green/red on their own — but only while
    // the MCP tab is showing, so we don't poll a hidden panel forever.
    let mcpPollTimer = null;
    function scheduleMcpPoll() {
      if (mcpPollTimer) { clearTimeout(mcpPollTimer); mcpPollTimer = null; }
      const anyConnecting = ((mcpServers && mcpServers.servers) || []).some((s) => s.connecting);
      if (anyConnecting && cfgTab === "mcp") mcpPollTimer = setTimeout(loadMcp, 1500);
    }
