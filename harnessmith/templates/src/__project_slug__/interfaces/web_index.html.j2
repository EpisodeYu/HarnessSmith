    $("cfg-bud-rows").addEventListener("click", async (e) => {
      const btn = e.target.closest(".b-clear");
      if (!btn) return;
      const div = btn.closest(".bud-row");
      await fetch("/usage/clear", {
        method: "POST", headers: { "Content-Type": "application/json" },
