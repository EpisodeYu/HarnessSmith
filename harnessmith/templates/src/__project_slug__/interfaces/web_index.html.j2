{% if spec.memory.enabled %}    // The note body (markdown file) from GET /memory — separate from cfg.memory
    // (the config knobs). Editing the note has its own Save/Clear/Consolidate
    // buttons and is NOT part of the main config Save.
    let memInfo = { content: "", read_only: false, size: 0, oversized: false };
    async function loadMemory() {
      try { memInfo = await (await fetch("/memory")).json(); }
      catch (e) { memInfo = { content: "", read_only: false, size: 0, oversized: false }; }
    }
    // Build the Memory tab: read-only switch + backend dropdown (from /registries)
    // + capacity + auto-consolidate + policy, then the note body with its own
    // action buttons. A configured backend that isn't registered is still shown,
    // flagged, so it round-trips instead of vanishing.
    function buildMemory() {
      const mem = cfg.memory || {};
      $("cfg-mem-readonly").checked = !!mem.read_only;
      const sel = $("cfg-mem-backend"); sel.innerHTML = "";
      const backends = (reg.memory || []).slice();
      const current = mem.backend || "file";
      if (!backends.includes(current)) backends.push(current);
      backends.forEach((name) => {
        const ok = (reg.memory || []).includes(name);
        const o = document.createElement("option");
        o.value = name; o.textContent = name + (ok ? "" : UNREG);
        if (!ok) o.title = t("cfg_unregistered");
        sel.appendChild(o);
      });
      sel.value = current;
      $("cfg-mem-capacity").value = mem.inject_max_chars ?? 4000;
      $("cfg-mem-auto").checked = !!mem.auto_consolidate;
      $("cfg-mem-policy").value = mem.policy || "";
      // The note body lives outside the dirty/Save flow — stop its edits bubbling
      // to the view-config "unsaved" marker (it has its own Save note button).
      const note = $("cfg-mem-content");
      note.value = memInfo.content || "";
      note.oninput = (e) => e.stopPropagation();
      note.onchange = (e) => e.stopPropagation();
      $("cfg-mem-size").textContent = (memInfo.size || 0) + " / " + (memInfo.inject_max_chars ?? mem.inject_max_chars ?? 4000) + " " + t("mem_chars");
      $("cfg-mem-oversized").classList.toggle("hidden", !memInfo.oversized);
      $("cfg-mem-status").textContent = "";
    }
