                        sessions_cfg.dir,
                        mode=mode or config.paradigms.default,
                        status="complete",
                        cwd=resolved,
                    )
                typer.secho(f"working directory (hint): {resolved}", fg=typer.colors.GREEN)
                continue
            if not prompt.strip():
                continue
{% if spec.skills.enabled %}            prompt = _expand_skill(config, prompt)
{% endif %}            state["printed"] = False
            state["thinking_shown"] = False
            working_dir = _chat_working_dir()
            chat_turn["last_body"] = list(history)
            try:
                with _interruptible(on_stop=_save_interrupted) as cancel, using_asker(
                    asker
                ), using_confirmer(confirmer):
                    chat_turn["cancel"] = cancel
                    result = run_loop(
                        prompt,
                        mode=mode,
                        client_for=router.client_for,
                        config=config,
                        role=role,
                        hooks=hooks,
                        on_delta=_on_delta if stream else None,
                        on_thinking=_on_thinking if stream else None,
                        history=history,
                        cancel=cancel,
                        checkpoint=_checkpoint,
                        working_dir=working_dir,
                    )
            except KeyboardInterrupt:
                # Hard second Ctrl-C: persist interrupted, then leave the REPL.
                _save_interrupted()
                typer.echo("")
                break
            except Exception as exc:  # one bad turn shouldn't end the whole session
                if state["printed"]:
                    typer.echo("")
                typer.secho(f"run failed: {exc}", fg=typer.colors.RED, err=True)
