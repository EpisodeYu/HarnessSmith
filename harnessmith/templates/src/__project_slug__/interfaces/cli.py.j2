def _resolve_cli_working_dir(
    cwd_opt: Path | None,
    session_id: str | None,
    sessions_dir: str | None,
) -> str:
    """Absolute path injected into the system prompt as a hint (not a sandbox).

    ``--cwd`` wins; else a resumed session's stored ``cwd``; else the process cwd.
    """
    from ..harness import session as session_store

    if cwd_opt is not None:
        return str(Path(cwd_opt).expanduser().resolve())
    if session_id and sessions_dir:
        stored = session_store.cwd_of(session_id, sessions_dir)
        if stored.strip():
            return str(Path(stored).expanduser().resolve())
    return str(Path.cwd().resolve())


