@mcp_app.command("status")
def mcp_status(
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """Health-check every configured MCP server: connectivity + tool counts.

    Connects each server once and lists its tools; an unreachable server is shown
    in red with its error (e.g. a uvx/npx server needs uv/Node on PATH). Read-only
    — it changes nothing. This is the CLI view of the web MCP management page.
    """
    from ..harness.mcp import McpManager, auth_blocked, missing_secrets

    config = load_config(config_path)
    if not config.mcp.servers:
        typer.secho(
            "no MCP servers configured (add them under mcp.servers in config.yaml).",
            fg=typer.colors.YELLOW,
        )
        return
    enabled = config.enabled_tool_names()
    server_by_name = {s.name: s for s in config.mcp.servers}
    manager = McpManager(config.mcp)
    try:
        manager.start()  # connects every server (failures isolated into .status())
        rows = manager.status()
    finally:
        manager.close()

    hint_runtime = False
    for row in rows:
        name = row["name"]
        server = server_by_name.get(name)
        miss = missing_secrets(server) if server else []
        blocked = auth_blocked(server) if server else False
        # A `<server>__*` wildcard enables every discovered tool.
        if f"{name}__*" in enabled:
            en = row["tool_count"]
        else:
            en = sum(1 for n in enabled if n.startswith(name + "__"))
        dot_color = typer.colors.GREEN if row["connected"] else typer.colors.RED
        typer.secho("  ● ", fg=dot_color, nl=False)
        if row["connected"]:
            typer.echo(
                f"{name}  [{row['transport']}]  "
                f"tools: {en} enabled / {row['tool_count']} available"
            )
        else:
            err = str(row["error"] or "unknown error")
            typer.echo(f"{name}  [{row['transport']}]  unreachable: {err}")
            if any(tok in err.lower() for tok in ("npx", "node", "uvx", "no such file")):
                hint_runtime = True
        # Auth is a SEPARATE axis from the dot. A remote server with an unset required
        # bearer is "connected" (green) but 401s every call, so its tools are WITHHELD
        # from the model — name the var to set. Other declared-but-unset secrets are
        # surfaced as a softer note (the server may still work without them).
        if blocked:
            typer.secho(
                f"      needs auth — set: {', '.join(miss)} (tools withheld until set)",
                fg=typer.colors.YELLOW,
            )
        elif miss:
            typer.secho(
                f"      note: secret(s) not set: {', '.join(miss)}",
                fg=typer.colors.YELLOW,
            )
    if hint_runtime:
        typer.secho(
            "  hint: a server's launcher isn't on PATH — install Node.js (npx) / uv "
            "(uvx) to use it.",
            fg=typer.colors.BRIGHT_BLACK,
        )


@mcp_app.command("warm")
def mcp_warm(
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """Pre-download Node/uv based MCP server packages (npx/uvx) so the first real
    connection is fast.

    Picks a reachable registry + the system proxy automatically (the same way a
    live connect does); an unreachable registry is reported here, up front, instead
    of surfacing later as a connect timeout. Read-only — it only populates caches.
    """
    import sys

    from ..harness.mcp import warm_once

    config = load_config(config_path)
    if not any(s.kind == "stdio" for s in config.mcp.servers):
        typer.secho("no stdio MCP servers to warm.", fg=typer.colors.YELLOW)
        return
    typer.echo("Warming MCP server packages (first run can take a minute) ...")
    # force=True: warm even if the sentinel says it's done, and refresh the sentinel
    # so the next serve/chat skips its own warm.
    results = warm_once(config.mcp, log=sys.stderr, force=True)
    if not results:
        typer.secho("nothing to warm (no npx/uvx servers).", fg=typer.colors.YELLOW)
        return
    failed = False
    for name, ok, detail in results:
        typer.secho("  ● ", fg=typer.colors.GREEN if ok else typer.colors.RED, nl=False)
        typer.echo(f"{name}: {detail}")
        failed = failed or not ok
    if failed:
        raise typer.Exit(code=1)
