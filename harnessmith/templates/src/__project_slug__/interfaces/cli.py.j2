@contextlib.contextmanager
def _interruptible(on_stop=None):
    """Make a turn stoppable with Ctrl-C, yielding a cooperative cancel predicate.

    The first SIGINT sets the cancel token: the loop stops at the next boundary
    (mid-token for a streaming turn) and the partial conversation is saved so you
    can resume. A second SIGINT restores the default handler and exits hard. Off
    the main thread (where signals can't be trapped) it yields a never-cancel
    predicate, so the call still works — it just won't be interruptible.

    ``on_stop`` (best-effort, called once on the first SIGINT) lets the caller
    persist an ``interrupted`` status to disk *synchronously in the handler* —
    before ``uv run`` can kill the child (exit 130) ahead of the normal post-run
    save, which would otherwise leave a misleading ``running`` checkpoint.
    """
    event = threading.Event()

    def _handler(signum, frame) -> None:
        if event.is_set():  # second Ctrl-C: stop waiting and quit hard
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            raise KeyboardInterrupt
        event.set()
        if on_stop is not None:
            try:
                on_stop()
            except Exception:
                log.debug("interrupt on_stop save failed", exc_info=True)
        typer.secho(
            "\nstopping after this step… (Ctrl-C again to force quit)",
            fg=typer.colors.YELLOW,
            err=True,
        )

    try:
        previous = signal.signal(signal.SIGINT, _handler)
    except ValueError:  # not the main thread -> can't install a SIGINT handler
        yield (lambda: False)
        return
    try:
        yield event.is_set
    finally:
        signal.signal(signal.SIGINT, previous)


class CliAsker:
    """Ask the user on the terminal: print the prompt + numbered options, read one
    line. This is the CLI side of the shared interaction channel (used by the
    ``ask_question`` tool, and HITL tool confirmation later).

    A blank reply skips a question; digit(s) pick option(s) (comma-separated when
    ``allow_multiple``); any other text is taken as a free-text answer when
    allowed. If stdin is exhausted (EOF) it degrades like a non-interactive run
    rather than crashing the turn.
    """

    def ask(self, req: AskRequest) -> AskResponse:
        typer.echo("")
        typer.secho(req.prompt, fg=typer.colors.CYAN, err=True)
        for i, opt in enumerate(req.options, 1):
            typer.secho(f"  [{i}] {opt.label}", err=True)
        # Cursor-style: when free text is allowed alongside options, the last entry
        # is an explicit "Other" — picking it asks for a custom answer. (A typed,
        # non-numeric reply is still accepted directly too.)
        other_n = len(req.options) + 1 if (req.options and req.allow_text) else None
        if other_n is not None:
            typer.secho(f"  [{other_n}] Other (type your own answer)", err=True)
        parts = []
        if req.options:
            parts.append("number" + ("(s, comma-separated)" if req.allow_multiple else ""))
        if req.allow_text and not req.options:
            parts.append("type a reply")
        hint = "Your answer" + (f" ({' / '.join(parts)})" if parts else "")
        raw = self._read(hint)
        if raw is None:  # EOF / Ctrl-C during the ask: degrade instead of crash.
            return NonInteractiveAsker().ask(req)
        raw = raw.strip()
        if not raw:
            return AskResponse()
        tokens = [tok.strip() for tok in raw.split(",")] if req.allow_multiple else [raw]
        if req.options and tokens and all(tok.isdigit() for tok in tokens):
            ids, wants_other = [], False
            for tok in tokens:
                idx = int(tok)
                if other_n is not None and idx == other_n:
                    wants_other = True
                elif 0 < idx <= len(req.options):
                    ids.append(req.options[idx - 1].id)
            if wants_other:  # "Other" picked -> ask for the custom text
                text = self._read("Your answer")
                return AskResponse(option_ids=ids, text=(text or "").strip() or None)
            if ids:
                return AskResponse(option_ids=ids)
        if req.allow_text:
            return AskResponse(text=raw)
        return AskResponse()

    @staticmethod
    def _read(prompt: str) -> str | None:
        """Read one line; ``None`` on EOF / Ctrl-C so the caller can degrade."""
        try:
            return typer.prompt(prompt, default="", show_default=False)
        except (EOFError, KeyboardInterrupt, typer.Abort):
            return None


def _cli_asker(mock: bool):
    """Pick the asker for this turn: the interactive terminal asker on a real TTY,
    else the non-interactive degrade.

    A piped/redirected stdin (CI, ``--mock`` smoke, Docker) has no human to answer,
    so a question proceeds on the model's best judgment instead of blocking a
    one-shot ``run``.
    """
    import sys

    if mock or not sys.stdin.isatty():
        return NonInteractiveAsker()
    return CliAsker()


def _build_confirmer(config, config_path):
    """Build the HITL tool-confirmation gate from ``config.confirm``, or ``None``
    when confirmation is off (zero overhead — the default).

    The in-memory session allow-set lives for this command (so ``allow_session``
    sticks across a ``chat`` REPL's turns). ``allow_always`` persists by rewriting
    the ``confirm:`` line in config.yaml (comment-safe) and applying it in-process.
    """
    from ..harness.interaction import ToolConfirmer
    from ..harness.tools import registry as tool_registry

    needs = tool_registry.confirm_names(config.confirm)
    if not needs:
        return None

    def _persist(remaining: set[str]) -> None:
        from ..harness.config import persist_confirm

        policy = sorted(remaining)
        config.confirm = policy  # apply in-process so a later turn agrees
        try:
            persist_confirm(policy, config_path)
        except Exception as exc:  # in-process allow still holds; persistence is best-effort
            typer.secho(
                f"warning: could not persist confirm policy: {exc}",
                fg=typer.colors.YELLOW,
                err=True,
            )

    return ToolConfirmer(needs, persist=_persist)


def _profile_preflight(profile: LLMProfileConfig) -> str | None:
    """Offline sanity check for an LLM profile; returns an error message or None.

    Catches the two traps that otherwise surface as a confusing provider error:
    no model, and no resolvable API key (with no custom base_url). Run before any
    network call so ``run`` / ``test-llm`` can point you at the fix.
    """
    if not profile.model.strip():
        return "model is required (set it under llms: in config.yaml)"
    if not resolve_env(profile.api_key_env) and not resolve_env(profile.base_url_env):
        return (
            f"no API key: env var {profile.api_key_env} is not set in .env or the "
            f"environment — run `set-key {profile.api_key_env}` first "
            "(or configure a custom base_url)"
        )
    return None


def _validate_role(role: str, config) -> None:
    """Reject an unknown ``--role`` up front (symmetric with an unknown ``--mode``).

    ``generation`` is always valid (the default, falls back to the first profile);
    any other name must be mapped under ``roles:`` in config.yaml. A typo would
    otherwise silently fall back to the default profile.
    """
    if role != "generation" and role not in config.roles:
        known = sorted({"generation", *config.roles})
        typer.secho(
            f"unknown role {role!r}; known roles: {known} "
            "(use --role generation, or add it under roles: in config.yaml)",
            fg=typer.colors.RED,
            err=True,
        )
        raise typer.Exit(code=2)


def _prepare_runtime(config):
    """Import config.extensions, surface config diagnostics, and build hooks.

    Fail-fast (exit 2) on hard config errors (a role's profile, a paradigm, or the
    context strategy that doesn't resolve); warn (yellow) on soft ones (a context
    condition or memory backend name that isn't registered — skipped at runtime —
    or a cost_limit with no prices). Returns the Hooks instance named in
    ``config.hooks`` (default no-op).
    """
    from ..harness.config import ConfigError
    from ..harness.extensions import check_config, import_extensions, load_hooks

    try:
        import_extensions(config)
        errors, warnings = check_config(config)
        hooks = load_hooks(config)
    except ConfigError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    for message in warnings:
        typer.secho(f"warning: {message}", fg=typer.colors.YELLOW, err=True)
    if errors:
        for message in errors:
            typer.secho(f"error: {message}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    return hooks

{% if spec.mcp.enabled %}
def _start_mcp(config):
    """Launch MCP servers that have at least one enabled tool; return the manager.

    Only servers with an allowlisted (enabled) tool are launched, so a
    predefined-but-off server (e.g. Desktop Commander) stays dormant. Returns
    ``None`` when nothing needs launching; the caller must ``.close()`` the
    manager when done (``serve`` lets it live for the process lifetime).
    """
    from ..harness.mcp import McpManager, register_mcp_tools, sync_mcp_tools

    active = {n.split("__", 1)[0] for n in config.enabled_tool_names() if "__" in n}
    servers = [s for s in config.mcp.servers if s.name in active]
    if not servers:
        return None
    # on_connected: re-sync the registry on each (re)connect so a server that
    # auto-heals later in the session still gets its tools to the model.
    manager = McpManager(
        config.mcp.model_copy(update={"servers": servers}),
        on_connected=lambda m: sync_mcp_tools(config, m),
    )
    manager.start()
    register_mcp_tools(config, manager)
    return manager
{% endif %}{% if spec.skills.enabled %}
def _expand_skill(config, prompt: str) -> str:
    """``/skill-name rest...`` -> the skill's full instructions + rest.

    Lets you manually load a skill (including ones marked
    ``disable-model-invocation`` that aren't auto-injected). A non-``/`` prompt or
    an unknown skill is returned unchanged (with a warning for the latter).
    """
    if not prompt.startswith("/"):
        return prompt
    from ..harness.skills import load_skill_body

    skill_name, _, rest = prompt[1:].partition(" ")
    body = load_skill_body(config, skill_name)
    if body.startswith("ERROR"):
        typer.secho(body, fg=typer.colors.YELLOW, err=True)
        return prompt
    return f"{body}\n\n{rest}".strip()
{% endif %}{% if spec.memory.enabled %}
def _setup_memory(config) -> None:
    """Register the configured memory backend's tools so the loop can offer them."""
    from ..harness.memory import register_memory_tools

    register_memory_tools(config)
{% endif %}{% if spec.subagents.enabled %}
def _setup_subagents(config, mock: bool) -> None:
    """Register the `subagents` tool so the supervisor can delegate to subagents."""
    from ..harness.subagents import register_subagent_tools

    register_subagent_tools(config, mock=mock)
