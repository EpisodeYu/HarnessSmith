@app.command()
def run(
    prompt: str = typer.Argument(
        None, help="Your message. Omit to be prompted interactively."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    role: str = typer.Option("generation", "--role", help="LLM role to use."),
    mode: str = typer.Option(
        None,
        "--mode",
        help="Loop paradigm to use (default: config.paradigms.default).",
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
    stream: bool = typer.Option(
        False, "--stream/--no-stream", help="Stream the answer token-by-token."
    ),
    continue_session: bool = typer.Option(
        False, "--continue", help="Resume the most recent saved session."
    ),
    resume: str = typer.Option(
        None, "--resume", help="Resume a specific session by id."
    ),
    cwd: Path | None = typer.Option(
        None,
        "--cwd",
        help="Working directory hint for the model (resolved to absolute; default: "
        "stored session cwd or process cwd). Not a sandbox.",
    ),
) -> None:
    """Run one turn of the agent loop."""
    from ..harness.config import ConfigError
    from ..harness import session as session_store

    config = load_config(config_path)
    log.debug(
        "cli run: mode=%s role=%s mock=%s stream=%s continue=%s resume=%s cwd=%s",
        mode or config.paradigms.default, role, mock, stream, continue_session, resume,
        str(cwd) if cwd else None,
    )
    _validate_role(role, config)
    hooks = _prepare_runtime(config)
    # Fail fast with an actionable hint instead of a provider traceback when the
    # LLM isn't usable yet (no profile, no model, or no key). The mock path needs
    # neither. `test-llm` does the same checks plus a live probe.
    if not mock:
        try:
            error = _profile_preflight(config.profile_for(role))
        except ConfigError as exc:
            error = f"{exc} — add a profile under llms: in {config_path}"
        if error:
            typer.secho(error, fg=typer.colors.RED, err=True)
            raise typer.Exit(code=2)
    if prompt is None:
        prompt = typer.prompt("You")
{% if spec.skills.enabled %}    prompt = _expand_skill(config, prompt)
{% endif %}{% if spec.mcp.enabled %}    mcp_manager = _start_mcp(config)
{% endif %}{% if spec.memory.enabled %}    _setup_memory(config)
{% endif %}{% if spec.subagents.enabled %}    _setup_subagents(config, mock)
{% endif %}    # Resolve the session to resume (or mint a new one) and load its history.
    sessions_cfg = config.sessions
    session_id, history = (
        session_store.resolve(
            continue_=continue_session, resume_id=resume, sessions_dir=sessions_cfg.dir
        )
        if sessions_cfg.enabled
        else (None, None)
    )
    working_dir = _resolve_cli_working_dir(
        cwd, session_id, sessions_cfg.dir if sessions_cfg.enabled else None
    )
    router = ClientRouter(config, mock=mock)

    printed = False
    thinking_shown = False

    def _on_delta(text: str) -> None:
        nonlocal printed
        printed = True
        typer.echo(text, nl=False)

    def _on_thinking(_text: str) -> None:
        # One dim pulse per turn: reasoning models sit silent before the first
        # token — show life instead of a dead wait. Goes to stderr so the answer
        # on stdout stays pipe-clean. The thinking text itself is not printed.
        nonlocal thinking_shown
        if not thinking_shown:
            thinking_shown = True
            typer.secho("· thinking …", fg=typer.colors.BRIGHT_BLACK, err=True)

    # Latest checkpointed body + live cancel predicate, so an interrupt can persist
    # the right status from the SIGINT handler (B2: beat the uv-run kill race).
    _last_body: list[dict] = list(history or [])
    _cancel = {"fn": (lambda: False)}

    def _save_interrupted() -> None:
        if sessions_cfg.enabled and session_id is not None:
            session_store.save(
                session_id,
                _last_body,
                sessions_cfg.dir,
                mode=(mode or config.paradigms.default),
                status="interrupted",
                cwd=working_dir,
            )

    def _checkpoint(body: list[dict]) -> None:
        # Write-ahead each completed step so a crash mid-turn still leaves a
        # resumable session on disk. Once a Stop is in flight, label it
        # "interrupted" (not "running") so a uv-run SIGINT that kills the process
        # before the post-run save still leaves the correct status on disk.
        nonlocal _last_body
        _last_body = body
        if sessions_cfg.enabled and session_id is not None:
            session_store.save(
                session_id,
                body,
                sessions_cfg.dir,
                mode=(mode or config.paradigms.default),
                status="interrupted" if _cancel["fn"]() else "running",
                cwd=working_dir,
            )

    try:
        with _interruptible(on_stop=_save_interrupted) as cancel, using_asker(
            _cli_asker(mock)
        ), using_confirmer(_build_confirmer(config, config_path)):
            _cancel["fn"] = cancel
            result = run_loop(
                prompt,
                mode=mode,
                client_for=router.client_for,
                config=config,
                role=role,
                hooks=hooks,
                on_delta=_on_delta if stream else None,
                on_thinking=_on_thinking if stream else None,
                history=history,
                cancel=cancel,
                checkpoint=_checkpoint,
                working_dir=working_dir,
            )
    except KeyboardInterrupt:
        # Hard second Ctrl-C: persist the interrupted status before exiting 130.
        _save_interrupted()
        raise typer.Exit(code=130)
    except ValueError as exc:  # bad --mode / invalid config value
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    except Exception as exc:  # LLM / network / tool failure — show it, not a traceback
        # The traceback lands in the debug log (when enabled) for diagnosis.
        log.debug("cli run: FAILED", exc_info=True)
        if printed:
            typer.echo("")  # close any half-streamed line
        typer.secho(f"run failed: {exc}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    else:
        if printed:
            typer.echo("")  # finish the streamed line
        elif result.answer:
            typer.echo(result.answer)  # non-stream, or an llm-budget stop notice
        if sessions_cfg.enabled and session_id is not None:
            status = "interrupted" if result.stop_reason == "interrupted" else "complete"
            session_store.save(
                session_id,
                result.messages,
                sessions_cfg.dir,
                mode=result.mode,
                status=status,
                cwd=working_dir,
            )
{% if spec.memory.enabled %}        from ..harness.memory import record_turn

        record_turn(config, result.messages)
{% endif %}        summary = (
            f"[{result.mode}] [{result.stop_reason}] steps={result.steps} "
            f"tokens={result.trace.total_tokens} cost=${result.trace.cost_usd:.4f}"
        )
        if session_id is not None:
            summary += f" session={session_id}  (resume: run --resume {session_id})"
        typer.secho(summary, fg=typer.colors.BRIGHT_BLACK)
        if result.stop_reason == "interrupted":
            typer.secho(
                "stopped — send again, or `run --continue` / `--resume <id>`, to pick up "
                "where you left off (the model sees what was already done).",
                fg=typer.colors.YELLOW,
            )
{% if spec.mcp.enabled %}    finally:
        # Release MCP stdio subprocesses on EVERY exit path (success, error, or a
        # Ctrl-C that raises) — mirror of `chat`'s finally — so an interrupted or
        # failed turn never orphans a server that then needs a manual kill.
        if mcp_manager is not None:
            mcp_manager.close()
{% endif %}
@app.command()
def chat(
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    role: str = typer.Option("generation", "--role", help="LLM role to use."),
    mode: str = typer.Option(
        None, "--mode", help="Loop paradigm to use (default: config.paradigms.default)."
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
    stream: bool = typer.Option(
        True, "--stream/--no-stream", help="Stream answers token-by-token."
    ),
    continue_session: bool = typer.Option(
        False, "--continue", help="Resume the most recent saved session."
    ),
    resume: str = typer.Option(
        None, "--resume", help="Resume a specific session by id."
    ),
    cwd: Path | None = typer.Option(
        None,
        "--cwd",
        help="Working directory hint (resolved absolute; default: session cwd or "
        "process cwd). Not a sandbox. Use `/cwd <path>` in the REPL to change.",
    ),
) -> None:
    from ..harness.config import ConfigError
    from ..harness import session as session_store

    config = load_config(config_path)
    log.debug("cli chat: role=%s mock=%s", role, mock)
    _validate_role(role, config)
    hooks = _prepare_runtime(config)
    if not mock:
        try:
            error = _profile_preflight(config.profile_for(role))
        except ConfigError as exc:
            error = f"{exc} — add a profile under llms: in {config_path}"
        if error:
            typer.secho(error, fg=typer.colors.RED, err=True)
            raise typer.Exit(code=2)

    sessions_cfg = config.sessions
    if sessions_cfg.enabled:
        session_id, history = session_store.resolve(
            continue_=continue_session, resume_id=resume, sessions_dir=sessions_cfg.dir
        )
    else:
        session_id, history = session_store.new_id(), []
    history = list(history)
{% if spec.mcp.enabled %}    # First run only: pre-fetch stdio MCP packages (npx/uvx) with live progress
    # before the blocking connect below, so a cold download finishes once here (and
    # shows progress + a heartbeat) instead of timing the connect out. A sentinel
    # skips it on later launches. (Only the interactive `chat`/`serve` paths warm —
    # the one-shot `run` stays lean for scripting/Docker.)
    import sys as _warm_sys

    from ..harness.mcp import warm_once

    warm_once(config.mcp, log=_warm_sys.stderr)
    mcp_manager = _start_mcp(config)
{% endif %}{% if spec.memory.enabled %}    _setup_memory(config)
{% endif %}{% if spec.subagents.enabled %}    _setup_subagents(config, mock)
{% endif %}    router = ClientRouter(config, mock=mock)
    asker = _cli_asker(mock)
    # One confirmer for the whole REPL so an "allow for session" sticks across turns.
    confirmer = _build_confirmer(config, config_path)
    state = {"printed": False, "thinking_shown": False}
    # REPL override for `/cwd` (absolute path after resolve); None = use --cwd / session / cwd.
    repl_wd: list[str | None] = [None]

    def _chat_working_dir() -> str:
        if repl_wd[0] is not None:
            return repl_wd[0]
        return _resolve_cli_working_dir(
            cwd, session_id, sessions_cfg.dir if sessions_cfg.enabled else None
        )

    def _on_delta(text: str) -> None:
        state["printed"] = True
        typer.echo(text, nl=False)

    def _on_thinking(_text: str) -> None:
        # One dim pulse per turn (see `run`): life sign during the silent
        # reasoning phase; the thinking text itself is not printed.
        if not state["thinking_shown"]:
            state["thinking_shown"] = True
            typer.secho("· thinking …", fg=typer.colors.BRIGHT_BLACK, err=True)

    # Latest checkpointed body + live cancel predicate (reset each turn below), so an
    # interrupt can persist the right status from the SIGINT handler (B2).
    chat_turn = {"last_body": list(history), "cancel": (lambda: False)}

    def _save_interrupted() -> None:
        if sessions_cfg.enabled:
            session_store.save(
                session_id,
                chat_turn["last_body"],
                sessions_cfg.dir,
                mode=(mode or config.paradigms.default),
                status="interrupted",
                cwd=_chat_working_dir(),
            )

    def _checkpoint(body: list[dict]) -> None:
        # Write-ahead each completed step (crash safety): the chat session is
        # always saved on disk, so a kill mid-turn leaves a resumable conversation.
        # Once a Stop is in flight, label it "interrupted" (not "running") so a
        # uv-run SIGINT killing the process before the post-turn save still lands the
        # correct status on disk.
        chat_turn["last_body"] = body
        if sessions_cfg.enabled:
            session_store.save(
                session_id,
                body,
                sessions_cfg.dir,
                mode=(mode or config.paradigms.default),
                status="interrupted" if chat_turn["cancel"]() else "running",
                cwd=_chat_working_dir(),
            )

    typer.secho(
        f"Chat session {session_id} — Ctrl-D or /exit to quit.", fg=typer.colors.GREEN
    )
    if history:
        typer.secho(
            f"  resumed {len(history)} prior message(s).", fg=typer.colors.BRIGHT_BLACK
        )
    try:
        while True:
            try:
                prompt = typer.prompt("You")
            except (EOFError, typer.Abort):
                typer.echo("")
                break
            if prompt.strip() in {"/exit", "/quit"}:
                break
            if prompt.strip() == "/cwd":
                typer.echo(_chat_working_dir())
                continue
            if prompt.strip().startswith("/cwd "):
                rest = prompt.strip()[5:].strip()
