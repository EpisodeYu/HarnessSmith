@app.command(name="set-key")
def set_key(
    name: str = typer.Argument(
        ..., help="The env-var NAME to set (e.g. OPENAI_API_KEY)."
    ),
) -> None:
    """Store a secret VALUE in the local .env (write-only; never printed/committed).

    config.yaml only ever holds the env-var NAME; this fills in its value in .env
    (gitignored) so you don't have to set OS environment variables by hand.
    """
    from ..harness.config import ConfigError, set_env_value, validate_env_name

    try:
        # Validate before constructing the prompt: if a real token was pasted as
        # NAME, even the terminal prompt/error must not repeat it.
        validate_env_name(name)
    except ConfigError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    value = typer.prompt(f"Value for {name}", hide_input=True)
    try:
        set_env_value(name, value)
    except ConfigError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    typer.secho(
        f"Saved {name} to .env (gitignored). It is never printed or committed.",
        fg=typer.colors.GREEN,
    )


@app.command(name="test-llm")
def test_llm(
    role: str = typer.Option(
        "generation", "--role", help="Test the profile bound to this role."
    ),
    profile: str = typer.Option(
        None, "--profile", help="Test this profile by name (overrides --role)."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """Probe an LLM profile with a real one-shot call — is the key/endpoint live?

    Same checks as the web LLM tab's "Test" button: a profile with no model or no
    resolvable key (and no custom base_url) fails fast without a network call; the
    key is read from .env / the environment and never printed. Uses the same
    client path as the loop, so PASSED means a real turn would connect too.
    """
    from ..harness.config import ConfigError
    from ..harness.llm import _client_for_profile

    config = load_config(config_path)
    try:
        if profile is not None:
            matches = [p for p in config.llms if p.name == profile]
            if not matches:
                raise ConfigError(f"no LLM profile named {profile!r} in config.yaml")
            target = matches[0]
        else:
            target = config.profile_for(role)
    except ConfigError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)

    typer.echo(f"Testing profile {target.name!r} (model {target.model!r}) ...")
    error = _profile_preflight(target)
    if error:
        typer.secho(error, fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    try:
        _client_for_profile(target).complete([{"role": "user", "content": "ping"}], None)
    except Exception as exc:  # network / auth / model error — report cleanly
        typer.secho(f"FAILED: {exc}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    typer.secho("PASSED — the endpoint responded.", fg=typer.colors.GREEN)


@app.command()
def info(
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """List the registered extension points vs what config.yaml selects.

    Paradigms / context strategies / context conditions registered in code,
    alongside what's currently selected. A name your config selects but that isn't
    registered is flagged — usually a typo, or a module you forgot to import so its
    ``@register_*`` never ran.
    """
    from ..harness.config import ConfigError
    from ..harness.context import CONDITIONS, STRATEGIES
    from ..harness.extensions import import_extensions
    from ..harness.paradigms import PARADIGMS

    config = load_config(config_path)
    # Best-effort: import config.extensions so custom @register_* show up below.
    # info is diagnostic, so a bad module is a warning here, never fatal.
    imported: list[str] = []
    try:
        imported = import_extensions(config)
    except ConfigError as exc:
        typer.secho(f"warning: {exc}", fg=typer.colors.YELLOW, err=True)

    def _section(label: str, registered: list[str], selected: set[str]) -> None:
        typer.secho(label, fg=typer.colors.CYAN)
        for name in registered:
            mark = "  (selected)" if name in selected else ""
            typer.echo(f"  - {name}{mark}")
        for name in sorted(s for s in selected if s and s not in registered):
            typer.secho(
                f"  ! {name} — selected but NOT registered (import its module?)",
                fg=typer.colors.YELLOW,
            )

    from ..harness.tools import in_allowlist
    from ..harness.tools import registry as tool_registry
{% if spec.memory.enabled %}    # Memory tools register at runtime (run/chat/serve/web call register_memory_tools),
    # NOT via MCP. Register them here too so `info` reports them as enabled instead
    # of misfiling them under the "MCP registers at runtime; else a typo" notice.
    from ..harness.memory import register_memory_tools

    register_memory_tools(config)
{% endif %}{% if spec.subagents.enabled %}    # The `subagents` tool also registers at runtime; register it here so
    # `info` reports it as enabled rather than as an unloaded allowlist entry.
    from ..harness.subagents import register_subagent_tools

    register_subagent_tools(config)
{% endif %}
    enabled = config.enabled_tool_names()
    typer.secho("tools (registered):", fg=typer.colors.CYAN)
    for name in sorted(tool_registry.names()):
        state = "enabled" if in_allowlist(name, enabled) else "off"
        typer.echo(f"  - {name}  risk={tool_registry.risk_of(name)}  ({state})")
    # Allowlisted names with no registered tool right now: MCP `<server>__*` tools
    # register only when their server connects at runtime, so this is expected here
    # (info starts no MCP manager) — or, for a plain name, a typo worth checking.
    registered = set(tool_registry.names())
    unloaded = sorted(n for n in enabled if n and n not in registered)
    if unloaded:
        typer.secho(
            "  allowlisted, not loaded now (MCP registers at runtime; else check a typo):",
            fg=typer.colors.YELLOW,
        )
        for name in unloaded:
            typer.echo(f"    · {name}")

    _section("paradigms (registered):", list(PARADIGMS), set(config.paradigms.enabled))
    typer.echo(f"  default: {config.paradigms.default}")
    _section("context strategies (registered):", list(STRATEGIES), {config.context.strategy})
    _section("context conditions (registered):", list(CONDITIONS), set(config.context.triggers))
    typer.echo(f"  combine: {config.context.combine}  triggers: {config.context.triggers}")
{% if spec.memory.enabled %}    from ..harness.memory import BACKENDS as MEMORY_BACKENDS

    _section("memory backends (registered):", list(MEMORY_BACKENDS), {config.memory.backend})
{% endif %}
    # Extension wiring: which standalone modules were imported (so their
    # @register_* ran) and which Hooks are mounted (logging / guardrails / tool
    # policy / redaction). A bad path was already warned about above / surfaces at
    # run; here we just list what config.yaml asks for.
    from ..harness.extensions import mounted_hook_names

    typer.secho("extensions (imported modules):", fg=typer.colors.CYAN)
    for name in imported:
        typer.echo(f"  - {name}")
    if not imported:
        typer.echo("  (none)")
    typer.secho("hooks (mounted):", fg=typer.colors.CYAN)
    mounted = mounted_hook_names(config)
    for name in mounted:
        typer.echo(f"  - {name}")
    if not mounted:
        typer.echo("  (none)")


@app.command()
def usage(
    action: str = typer.Argument(
        "show", help="show | clear — list per-LLM accrued cost, or reset it."
    ),
    name: str = typer.Option(
        None, "--name", "-n", help="With `clear`: the LLM to reset (omit = all)."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """Show or reset per-LLM accrued cost (the persistent usage ledger).

    ``show`` lists each LLM's accumulated tokens + cost (derived from its prices in
    config.yaml) and its cost_limit; ``clear`` resets one (``--name``) or all of
    them. Usage accrues across runs in .harness/usage.json and only resets when you
    clear it here (or on the web Budget page).
    """
    from ..harness.usage import UsageLedger

    config = load_config(config_path)
    ledger = UsageLedger()
    if action == "clear":
        if name:
            ledger.clear(name)
            typer.secho(f"cleared usage for {name!r}.", fg=typer.colors.GREEN)
        else:
            ledger.clear_all()
            typer.secho("cleared usage for all LLMs.", fg=typer.colors.GREEN)
        return
    if action != "show":
        typer.secho(
            f"unknown action {action!r} (use: show | clear)", fg=typer.colors.RED, err=True
        )
        raise typer.Exit(code=2)
    rows = ledger.snapshot(config)
    if not rows:
        typer.secho("no LLM profiles configured.", fg=typer.colors.YELLOW)
        return
    for row in rows:
        limit = f"limit {row['limit']:.4f}" if row["limit"] else "no limit"
        used = (
            f"in {row['prompt_tokens']} / out {row['completion_tokens']} "
            f"/ cached {row['cached_prompt_tokens']}"
        )
        line = (
            f"  {row['name']}  ({row['model']})  cost {row['cost']:.4f}  {limit}  [{used}]"
        )
        if row["over"]:
            typer.secho(line + "  reached", fg=typer.colors.RED)
        else:
            typer.echo(line)


