"""Runtime extension loading + config self-checks — the user-extension entry point.

The single place the CLI / web call right after ``load_config`` to:

- **import your extension modules** so their ``@register_*`` decorators run
  (``config.extensions`` — the documented spot for tools / paradigms / context
  conditions / memory backends that live OUTSIDE the built-in files);
- **mount a Hooks subclass** named in ``config.hooks`` (logging / guardrails /
  redaction / human-in-the-loop) without editing ``cli.py`` / ``web.py``;
- **diagnose config names** that don't resolve: hard errors for references that
  MUST resolve (a role's profile, a paradigm, the context strategy) and soft
  warnings for the open registries where an unknown name might just be a
  not-yet-imported custom extension (context conditions, memory backend).

Thin and dependency-free — plain ``importlib`` over the same registries
``{{ project_slug }} info`` already prints.
"""

from __future__ import annotations

import importlib

from .config import Config, ConfigError, HookConfig
from .hooks import CompositeHooks, Hooks


def import_extensions(config: Config) -> list[str]:
    """Import every module in ``config.extensions`` so its registrations run.

    Returns the imported module names. A bad module name surfaces as a clean
    ``ConfigError`` (not a traceback) so a typo in ``extensions:`` is actionable.
    """
    imported: list[str] = []
    for module in config.extensions:
        try:
            importlib.import_module(module)
        except Exception as exc:  # ImportError, or an error raised AT import time
            raise ConfigError(
                f"failed to import extension module {module!r} "
                f"(config.extensions): {exc}"
            ) from exc
        imported.append(module)
    return imported


def _normalize_hooks(config: Config) -> list[HookConfig]:
    """Coerce ``config.hooks`` (``None`` | ``str`` | list of str/HookConfig) into a
    uniform list of :class:`HookConfig`. The legacy single-string form becomes a
    one-element list; bare strings inside the list become unconfigured entries.
    """
    spec = config.hooks
    if not spec:
        return []
    if isinstance(spec, str):
        return [HookConfig(class_path=spec.strip())] if spec.strip() else []
    out: list[HookConfig] = []
    for item in spec:
        if isinstance(item, str):
            if item.strip():
                out.append(HookConfig(class_path=item.strip()))
        else:  # pydantic already coerced a dict entry into a HookConfig at load
            out.append(item)
    return out


def _instantiate_hook(entry: HookConfig) -> Hooks:
    """Import + construct one hook from its ``HookConfig``; clean ``ConfigError`` on
    any problem. ``config`` (if any) is passed as keyword args to the constructor."""
    spec = entry.class_path.strip()
    module_name, sep, class_name = spec.partition(":")
    if not sep or not class_name.strip():
        raise ConfigError(
            f"invalid hooks entry {spec!r}: use the form 'package.module:ClassName'"
        )
    try:
        module = importlib.import_module(module_name)
        cls = getattr(module, class_name)
        instance = cls(**entry.config) if entry.config else cls()
    except Exception as exc:
        raise ConfigError(f"failed to load hooks {spec!r}: {exc}") from exc
    if not isinstance(instance, Hooks):
        raise ConfigError(f"hooks {spec!r} is not a Hooks subclass")
    return instance


def build_hook_instances(config: Config) -> list[tuple[str, Hooks]]:
    """The ``(dotted_path, instance)`` pairs for each ENABLED hook in ``config.hooks``.

    Shared by :func:`load_hooks` and any caller that needs the individual instances
    (e.g. the web's execution-log recorder, which wraps each hook to attribute a
    call to its class). A bad entry is a clean ``ConfigError``.
    """
    return [
        (entry.class_path.strip(), _instantiate_hook(entry))
        for entry in _normalize_hooks(config)
        if entry.enabled
    ]


def load_hooks(config: Config) -> Hooks:
    """Instantiate and compose the hooks named in ``config.hooks``.

    Accepts the legacy single string (``"pkg.mod:Class"``) or the list form
    (compose several, each optionally parameterized via its ``config`` and toggled
    by ``enabled``). Returns a plain no-op ``Hooks()`` when none are enabled, the
    single instance when exactly one is mounted, or a :class:`CompositeHooks`
    fanning out to all of them in listed order. A bad entry is a clean
    ``ConfigError`` (not a traceback) so a typo in ``hooks:`` is actionable.
    """
    instances = [inst for _, inst in build_hook_instances(config)]
    if not instances:
        return Hooks()
    if len(instances) == 1:
        return instances[0]
    return CompositeHooks(instances)


def mounted_hook_names(config: Config) -> list[str]:
    """Dotted paths of the ENABLED hooks in ``config.hooks`` — for ``info`` /
    ``GET /registries`` discoverability. Pure inspection: imports nothing and
    instantiates nothing (a bad path surfaces when :func:`load_hooks` runs)."""
    return [entry.class_path.strip() for entry in _normalize_hooks(config) if entry.enabled]


def check_config(config: Config) -> tuple[list[str], list[str]]:
    """Return ``(errors, warnings)`` for config names that don't resolve.

    Call AFTER :func:`import_extensions` so custom registrations are visible.
    *errors* are references that MUST resolve (fail-fast); *warnings* are the open
    registries where an unknown name might be a custom extension you forgot to
    import (fail-open at runtime — the context condition is simply skipped, memory
    injects nothing).
    """
    from .context import CONDITIONS, STRATEGIES
    from .paradigms import PARADIGMS

    errors: list[str] = []
    warnings: list[str] = []

    profile_names = {p.name for p in config.llms}
    for role, target in config.roles.items():
        if target not in profile_names:
            errors.append(
                f"roles.{role} points at unknown profile {target!r}; "
                f"known profiles: {sorted(profile_names)}"
            )

    for name in sorted(set(config.paradigms.enabled) | {config.paradigms.default}):
        if name not in PARADIGMS:
            errors.append(
                f"paradigm {name!r} is not registered; registered: {sorted(PARADIGMS)} "
                "(import its module via extensions?)"
            )

    if config.context.strategy not in STRATEGIES:
        errors.append(
            f"context.strategy {config.context.strategy!r} is not registered; "
            f"registered: {sorted(STRATEGIES)}"
        )

    for name in config.context.triggers:
        if name not in CONDITIONS:
            warnings.append(
                f"context trigger {name!r} is not registered — it will be skipped "
                "(typo, or import its module via extensions?)"
            )

    # A per-LLM cost_limit set on a profile with no per-token prices can never fire
    # (cost stays 0) — easy to misconfigure, so flag it.
    for profile in config.llms:
        if profile.cost_limit and not (
            profile.input_cost_per_million or profile.output_cost_per_million
        ):
            warnings.append(
                f"llm {profile.name!r} sets cost_limit but has no "
                "input_cost_per_million / output_cost_per_million, so its cost stays "
                "0 and the limit never triggers (set prices on the Budget page)"
            )
{% if spec.memory.enabled %}
    from .memory import BACKENDS as _MEMORY_BACKENDS

    if config.memory.backend not in _MEMORY_BACKENDS:
        warnings.append(
            f"memory.backend {config.memory.backend!r} is not registered — memory "
            "will inject nothing (typo, or import its module via extensions?)"
        )
{% endif %}
    return errors, warnings
