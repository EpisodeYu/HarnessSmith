"""Optional MCP tool bridge (generated only when ``mcp.enabled``).

MCP tools register into the SAME :class:`~{{ project_slug }}.harness.tools.Registry`
as built-in tools and run through the SAME loop/trace — ``loop.py`` is untouched.
*Which* servers to connect to and *which* tools to allowlist are runtime
``config.yaml`` knobs; transport is chosen per server by shape (``command`` ->
stdio subprocess, ``url`` -> remote Streamable HTTP).

The MCP SDK is asyncio; all of it hides behind a synchronous ``McpManager.call``.
One background thread owns one event loop; each server gets its OWN task that
enters, USES, and exits that server's session (anyio requires a session be
entered, used, and exited in the *same* task — so each server's ``call_tool`` runs
in that task, with the dispatcher only routing requests to it). Servers connect
concurrently, so startup costs ``max`` per-server connect time, not the sum.
``begin()`` starts that without blocking (so a UI can show a live "connecting"
state); ``reconnect_server()`` restarts just one server in place. stdio servers
launched via ``uvx``/``npx`` fetch their package through a reachable registry +
the system proxy, auto-resolved by probing (official, else a domestic mirror;
directly or via proxy) so they work behind the GFW or a corporate proxy; a missing
launcher fails with an actionable message instead of a raw ``WinError 2``.
"""

from __future__ import annotations

import asyncio
import concurrent.futures
import threading
import time
from contextlib import AsyncExitStack
from typing import TYPE_CHECKING, Any

from .debuglog import log
from .tools import HIGH, SAFE, Registry, Tool
from .tools import registry as default_registry

if TYPE_CHECKING:
    from .config import Config, McpConfig, McpServerConfig


def _bearer_headers(server: McpServerConfig) -> dict[str, str]:
    """Build request headers for a remote server, resolving the token by NAME."""
    from .config import resolve_env

    token = resolve_env(server.auth_env) if server.auth_env else None
    return {"Authorization": f"Bearer {token}"} if token else {}


_WINDOWS_CMD_SHIMS = {"npx", "npm", "yarn", "pnpm"}
_PYPI_OFFICIAL = "https://pypi.org/simple"
_PYPI_MIRROR = "https://pypi.tuna.tsinghua.edu.cn/simple"
_NPM_OFFICIAL = "https://registry.npmjs.org"
_NPM_MIRROR = "https://registry.npmmirror.com"


def _missing_launcher_message(command: str) -> str:
    if command.lower().removesuffix(".cmd").removesuffix(".bat") in _WINDOWS_CMD_SHIMS:
        return (
            f"MCP stdio launcher {command!r} was not found on PATH. "
            "Install Node.js (which provides npx/npm) or edit config.yaml to use "
            "a launcher that exists on this machine."
        )
    if command.lower() == "uvx":
        return (
            "MCP stdio launcher 'uvx' was not found on PATH. Install uv or edit "
            "config.yaml to use a launcher that exists on this machine."
        )
    return f"MCP stdio launcher {command!r} was not found on PATH."


def _windows_cmd_exe() -> str:
    import os
    import shutil

    return os.environ.get("COMSPEC") or shutil.which("cmd.exe") or "cmd.exe"


def _windows_stdio_command(command: str, args: list[str]) -> tuple[str, list[str]]:
    """Make a stdio command launchable on Windows.

    ``npx`` (and ``npm``/``yarn``/``pnpm``) are usually ``.cmd`` batch shims;
    Windows ``CreateProcess`` — which the asyncio subprocess used by the MCP SDK
    calls — cannot execute a ``.cmd``/``.bat`` directly (it fails with
    ``WinError 2``), even when the file is on PATH. Hand those to ``cmd.exe``,
    which knows how to run them. Real ``.exe`` commands (``uvx``, ``python``, …)
    are launched directly and left untouched. If the launcher is missing, fail
    before entering the MCP transport so status pages show an actionable message
    instead of a raw ``WinError 2``.
    """
    import shutil
    import sys

    if sys.platform != "win32":
        return command, args
    resolved = shutil.which(command)
    if not resolved:
        raise FileNotFoundError(_missing_launcher_message(command))
    if resolved.lower().endswith((".cmd", ".bat")):
        return _windows_cmd_exe(), ["/d", "/c", resolved, *args]
    return command, args


def _base_command(command: str | None) -> str:
    """The bare command name, lower-cased and stripped of a Windows shim suffix."""
    import os

    return os.path.basename(command or "").lower().removesuffix(".cmd").removesuffix(".exe")


def _url_ok(url: str, proxy: str | None = None, timeout: float = 3.0) -> bool:
    """True if a quick HEAD to ``url`` (optionally through ``proxy``) gets ANY HTTP
    response; only a connection failure / timeout counts as unreachable. Unlike a
    raw TCP probe this honors the proxy and is bounded by a single timeout."""
    import urllib.error
    import urllib.request

    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({"http": proxy, "https": proxy} if proxy else {})
    )
    try:
        with opener.open(urllib.request.Request(url, method="HEAD"), timeout=timeout):
            return True
    except urllib.error.HTTPError:
        return True
    except (urllib.error.URLError, OSError):
        return False


def _discover_proxy(config: "McpConfig | None") -> str | None:
    """The proxy to try for package fetches: an explicit ``mcp.proxy`` if set, else
    the system proxy (env vars + Windows/macOS settings, via ``getproxies()``)."""
    import urllib.request

    if config is not None and getattr(config, "proxy", None):
        return config.proxy
    proxies = urllib.request.getproxies()
    return proxies.get("https") or proxies.get("http")


def _pick_source(values, proxy, probe) -> tuple[str, str | None] | None:
    """First reachable ``(url, proxy_or_none)`` among ``values`` (an ordered list of
    candidate registry/index URLs: override, official, mirror). Each is tried
    directly first, then through ``proxy``. ``probe(url, proxy) -> bool`` is the
    reachability test (injected so tests need no network)."""
    for url in values:
        if not url:
            continue
        if probe(url, None):
            return url, None
        if proxy and probe(url, proxy):
            return url, proxy
    return None


def _apply_proxy(out: dict[str, str], proxy: str) -> None:
    out["HTTP_PROXY"] = out["HTTPS_PROXY"] = proxy
    out["http_proxy"] = out["https_proxy"] = proxy
    out["npm_config_proxy"] = out["npm_config_https-proxy"] = proxy


def _stdio_net_env(servers: list[McpServerConfig], config: "McpConfig | None" = None) -> dict[str, str]:
    """Network env injected into stdio children so ``npx``/``uvx`` can fetch their
    package on ANY network: pick a reachable registry/index (an explicit override,
    else the official source, else a domestic mirror), tried directly or through the
    system/configured proxy. NEVER overrides a registry/index/proxy the user set.
    Probes the two package managers concurrently (startup waits on the slower one)."""
    import concurrent.futures
    import os

    cmds = {_base_command(s.command) for s in servers if s.kind == "stdio"}
    proxy = _discover_proxy(config)
    npm_override = getattr(config, "npm_registry", None)
    pip_override = getattr(config, "pip_index", None)

    def _npm():
        if not ({"npx", "npm", "node"} & cmds):
            return None
        if os.environ.get("npm_config_registry") or os.environ.get("NPM_CONFIG_REGISTRY"):
            return None
        return _pick_source([npm_override, _NPM_OFFICIAL, _NPM_MIRROR], proxy, _url_ok)

    def _pip():
        if not ({"uvx", "uv"} & cmds):
            return None
        if os.environ.get("UV_DEFAULT_INDEX") or os.environ.get("UV_INDEX"):
            return None
        return _pick_source([pip_override, _PYPI_OFFICIAL, _PYPI_MIRROR], proxy, _url_ok)

    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        npm_fut, pip_fut = pool.submit(_npm), pool.submit(_pip)
        npm_res, pip_res = npm_fut.result(), pip_fut.result()

    out: dict[str, str] = {}
    if npm_res:
        reg, prox = npm_res
        out["npm_config_registry"] = reg
        out["npm_config_fetch_retries"] = "2"
        if prox:
            _apply_proxy(out, prox)
    if pip_res:
        idx, prox = pip_res
        out["UV_DEFAULT_INDEX"] = idx
        if prox:
            _apply_proxy(out, prox)
    return out


def _source_status(server: McpServerConfig, net_env: dict[str, str]) -> tuple[bool, str]:
    """``(source_configured, family)`` for a stdio server's package fetch: whether a
    registry/index is set (user env or the resolved ``net_env``) and which family
    (``npm``/``uv``); ``("" family)`` for launchers that don't fetch a package."""
    import os

    cmd = _base_command(server.command)
    if cmd in {"npx", "npm", "node"}:
        configured = bool(
            os.environ.get("npm_config_registry")
            or os.environ.get("NPM_CONFIG_REGISTRY")
            or net_env.get("npm_config_registry")
        )
        return configured, "npm"
    if cmd in {"uvx", "uv"}:
        configured = bool(
            os.environ.get("UV_DEFAULT_INDEX")
            or os.environ.get("UV_INDEX")
            or net_env.get("UV_DEFAULT_INDEX")
        )
        return configured, "uv"
    return True, ""


def _unreachable_advice(family: str) -> str:
    where = "an npm registry" if family == "npm" else "a PyPI index"
    knob = "mcp.npm_registry" if family == "npm" else "mcp.pip_index"
    return (
        f"couldn't reach {where} (official or mirror, directly or via proxy). Set "
        f"mcp.proxy or {knob} in config.yaml, pre-install the package, or remove "
        "this server."
    )


def _connect_error(server: McpServerConfig, exc: BaseException, net_env: dict[str, str]) -> str:
    """A connect failure as a readable message: drill the ExceptionGroup leaf, then
    for a stdio npx/uvx server add WHY a package fetch likely failed."""
    msg = _format_exception(exc)
    if server.kind != "stdio":
        return msg
    configured, family = _source_status(server, net_env)
    if family and not configured:
        return f"{msg} — {_unreachable_advice(family)}"
    if family and "timeout" in msg.lower():
        return (
            f"{msg} — the package may still be cold-downloading; run `mcp warm` "
            "first, or raise mcp.connect_timeout_seconds in config.yaml."
        )
    return msg


def _open_streams(server: McpServerConfig, net_env: dict[str, str] | None = None, errlog=None):
    """Return the (read, write) stream context manager for ``server``'s transport.

    Transport is ``server.kind`` (explicit ``transport`` or inferred from shape):
    ``stdio`` launches a subprocess; ``http`` is the modern Streamable HTTP;
    ``sse`` is the legacy HTTP+SSE transport for older remote servers. ``errlog``
    (a writable file) captures the child's stderr — the npx/uvx fetch progress the
    management page surfaces while a server is connecting.
    """
    from .config import resolve_env

    kind = server.kind
    if kind == "stdio":
        import os

        from mcp import StdioServerParameters
        from mcp.client.stdio import stdio_client

        env = dict(os.environ)
        for name in server.env:  # inject named secrets from .env into the child
            value = resolve_env(name)
            if value is not None:
                env[name] = value
        for key, value in (net_env or {}).items():  # resolved registry/proxy; user's setting wins
            env.setdefault(key, value)
        command, args = _windows_stdio_command(server.command, server.args)
        params = StdioServerParameters(command=command, args=args, env=env)
        return stdio_client(params, errlog) if errlog is not None else stdio_client(params)

    headers = _bearer_headers(server)
    if kind == "sse":  # legacy HTTP+SSE transport (older servers)
        from mcp.client.sse import sse_client

        return sse_client(server.url, headers=headers)

    from mcp.client import streamable_http as sh

    if hasattr(sh, "streamablehttp_client"):  # SDK <2.x
        return sh.streamablehttp_client(server.url, headers=headers)
    import httpx  # SDK >=2.x: headers go on a pre-built client

    return sh.streamable_http_client(server.url, http_client=httpx.AsyncClient(headers=headers))


def _result_text(result: Any) -> str:
    """Flatten an MCP CallToolResult's content blocks into a plain string."""
    parts = [getattr(b, "text", "") for b in (getattr(result, "content", None) or [])]
    text = "\n".join(p for p in parts if p)
    return f"ERROR: {text}" if getattr(result, "isError", False) else text


def _format_exception(exc: BaseException) -> str:
    """Show useful leaves from Python 3.11 ExceptionGroup/anyio TaskGroup errors.

    A stdio spawn failure / connect timeout surfaces from the MCP SDK as 'unhandled
    errors in a TaskGroup' — noise; the leaf (e.g. ``FileNotFoundError: [WinError 2]
    ...``) is the actionable part shown in the panel.
    """
    if isinstance(exc, BaseExceptionGroup):
        leaves: list[str] = []

        def _walk(group: BaseExceptionGroup) -> None:
            for inner in group.exceptions:
                if isinstance(inner, BaseExceptionGroup):
                    _walk(inner)
                else:
                    message = str(inner) or type(inner).__name__
                    leaves.append(f"{type(inner).__name__}: {message}")

        _walk(exc)
        if leaves:
            return f"{exc} ({'; '.join(leaves)})"
    return str(exc) or type(exc).__name__


class McpManager:
    """Owns one background event loop + the full MCP session lifecycle.

    Each configured server gets its OWN task that connects CONCURRENTLY and then
    owns that server's session AND its tool-call execution for the whole run —
    anyio requires a session be entered, used, and exited in the SAME task, so the
    dispatcher only routes a call to the owning task. Per-server failure is isolated
    into ``errors`` (a server that won't start is skipped, not fatal). ``begin()``
    starts connecting WITHOUT blocking so ``status()`` can report a live
    ``connecting`` state; ``start()`` also waits for the first round to settle (for
    a one-shot CLI run that needs tools up front). ``reconnect_server()`` restarts
    one server in place; ``call()`` is synchronous + thread-safe; ``close()`` shuts
    everything down cleanly.
    """

    def __init__(self, config: McpConfig) -> None:
        self._config = config
        self._loop = asyncio.new_event_loop()
        self._thread = threading.Thread(target=self._thread_main, daemon=True)
        self._ready: concurrent.futures.Future = concurrent.futures.Future()
        self._inbox: asyncio.Queue | None = None
        self._closing: asyncio.Event | None = None
        self._net_env: dict[str, str] = {}
        self._servers: dict[str, McpServerConfig] = {s.name: s for s in config.servers}
        self._tasks: dict[str, asyncio.Task] = {}
        self._settled: dict[str, asyncio.Event] = {}
        self._server_inboxes: dict[str, asyncio.Queue] = {}
        self._sessions: dict[str, Any] = {}
        self._connect_started: dict[str, float] = {}  # monotonic start, for live elapsed
        self._logpaths: dict[str, str] = {}  # per-server stderr capture (npx/uvx fetch log)
        self.discovered: dict[str, list] = {}
        self.errors: dict[str, str] = {}

    def _thread_main(self) -> None:
        asyncio.set_event_loop(self._loop)
        self._net_env = _stdio_net_env(list(self._config.servers), self._config)  # probe off the loop
        try:
            self._loop.run_until_complete(self._main())
        except Exception as exc:  # surface startup failures to start()
            if not self._ready.done():
                self._ready.set_exception(exc)
        finally:
            self._loop.close()

    async def _main(self) -> None:
        self._inbox = asyncio.Queue()
        self._closing = asyncio.Event()
        for server in self._config.servers:
            self._spawn(server)
        # Ready once every server's first connect attempt has settled (connected or
        # failed) — start()/wait_ready() block on this; begin() does not.
        await asyncio.gather(*(ev.wait() for ev in list(self._settled.values())))
        self._ready.set_result(True)
        await self._serve()
        self._closing.set()
        for inbox in list(self._server_inboxes.values()):  # stop each server's loop
            await inbox.put(None)
        if self._tasks:
            await asyncio.gather(*self._tasks.values(), return_exceptions=True)

    def _spawn(self, server: McpServerConfig) -> None:
        """Create one server's settled event + its lifecycle task (on the loop)."""
        name = server.name
        self._servers[name] = server
        self._sessions.pop(name, None)
        self.errors.pop(name, None)
        self.discovered.pop(name, None)
        self._server_inboxes.pop(name, None)
        self._connect_started.pop(name, None)
        self._settled[name] = asyncio.Event()
        self._tasks[name] = asyncio.create_task(self._run_server(server))

    async def _run_server(self, server: McpServerConfig) -> None:
        """Own ONE server's session AND its tool calls for the whole run, in a
        single task.

        Connect (open transport + ``initialize`` + ``list_tools``) under the timeout,
        signal ``settled`` (so startup can proceed), then loop on this server's own
        inbox running each ``call_tool`` HERE — never from the dispatcher task, since
        anyio requires a session be used in the same task it was entered. A ``None``
        stops the loop (shutdown or a reconnect); a connect failure/timeout is
        isolated into ``errors`` and never aborts the other servers.
        """
        name = server.name
        settled = self._settled[name]
        self._connect_started[name] = time.monotonic()
        errlog = self._open_log(name)
        try:
            async with AsyncExitStack() as stack:
                if errlog is not None:
                    stack.callback(self._close_log, name, errlog)
                # `asyncio.wait_for(coro)` wraps `coro` in another Task; anyio's MCP
                # transports must be entered and exited in the SAME task, so use
                # `asyncio.timeout()` here instead.
                async with asyncio.timeout(self._config.connect_timeout_seconds):
                    await self._connect(stack, server, errlog)
                inbox: asyncio.Queue = asyncio.Queue()
                self._server_inboxes[name] = inbox
                log.debug(
                    "mcp %s: connected in %.1fs (%d tools)",
                    name, time.monotonic() - self._connect_started[name],
                    len(self.discovered.get(name, [])),
                )
                settled.set()
                while True:
                    req = await inbox.get()
                    if req is None:
                        return  # shutdown or reconnect: tear the session down in this task
                    tool, arguments, fut = req
                    try:
                        # Bound each call: a hung server fails this ONE call with a
                        # timeout ERROR the model can react to, instead of wedging
                        # the turn (and Stop) forever.
                        async with asyncio.timeout(self._config.call_timeout_seconds):
                            fut.set_result(
                                _result_text(await self._sessions[name].call_tool(tool, arguments))
                            )
                    except TimeoutError:
                        fut.set_exception(TimeoutError(
                            f"MCP tool {name}__{tool} timed out after "
                            f"{self._config.call_timeout_seconds:.0f}s "
                            "(mcp.call_timeout_seconds in config.yaml)"
                        ))
                    except Exception as exc:
                        fut.set_exception(exc)
        except Exception as exc:  # connect failure/timeout: isolate, never fatal
            self.errors[name] = _connect_error(server, exc, self._net_env)
            log.debug("mcp %s: connect FAILED: %s", name, self.errors[name])
            self._sessions.pop(name, None)
            self._server_inboxes.pop(name, None)
            if not settled.is_set():
                settled.set()

    def _open_log(self, name: str):
        """A per-server file that captures the child's stderr (npx/uvx fetch output);
        ``status()`` tails it while connecting. Best-effort: ``None`` on failure (the
        connect then just uses the default stderr — never blocked by logging)."""
        import os
        import tempfile

        try:
            path = os.path.join(tempfile.gettempdir(), f"mcp-{name}-{id(self):x}.log")
            self._logpaths[name] = path
            return open(path, "w", encoding="utf-8", buffering=1)
        except OSError:
            self._logpaths.pop(name, None)
            return None

    def _close_log(self, name: str, handle) -> None:
        import contextlib
        import os

        with contextlib.suppress(Exception):
            handle.close()
        path = self._logpaths.pop(name, None)
        if path:
            with contextlib.suppress(OSError):
                os.unlink(path)

    def _log_tail(self, name: str) -> str:
        """The last meaningful stderr line of ``name`` (npx/uvx progress), or ''."""
        path = self._logpaths.get(name)
        if not path:
            return ""
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                lines = [ln.strip() for ln in fh.read().splitlines() if ln.strip()]
        except OSError:
            return ""
        return lines[-1] if lines else ""

    async def _connect(self, stack: AsyncExitStack, server: McpServerConfig, errlog=None) -> None:
        """Open one server's session and list its tools (under a startup timeout)."""
        from mcp import ClientSession

        streams = await stack.enter_async_context(_open_streams(server, self._net_env, errlog))
        session = await stack.enter_async_context(ClientSession(streams[0], streams[1]))
        await session.initialize()
        self._sessions[server.name] = session
        self.discovered[server.name] = list((await session.list_tools()).tools)

    async def _serve(self) -> None:
        """Dispatcher: route each synchronous ``call()`` to its server's own task."""
        assert self._inbox is not None
        while True:
            req = await self._inbox.get()
            if req is None:
                return
            server, tool, arguments, fut = req
            inbox = self._server_inboxes.get(server)
            if inbox is None:
                fut.set_exception(
                    RuntimeError(
                        f"MCP server {server!r} is not connected: "
                        f"{self.errors.get(server) or 'not discovered'}"
                    )
                )
                continue
            await inbox.put((tool, arguments, fut))

    async def _restart(self, name: str) -> None:
        """Tear down one server (in its own task) and spawn a fresh one — in place."""
        server = self._servers.get(name)
        if server is None:
            return
        task = self._tasks.get(name)
        if task is not None and not task.done():
            # Drop the inbox first so the dispatcher fails fast (instead of routing
            # to a loop that's about to exit) for the brief reconnect window.
            inbox = self._server_inboxes.pop(name, None)
            if inbox is not None:
                await inbox.put(None)  # graceful: loop returns, session torn down in its task
            else:
                task.cancel()  # still connecting (no inbox yet)
            try:
                await task
            except (asyncio.CancelledError, Exception):
                pass
        self._spawn(server)

    def begin(self) -> None:
        """Start connecting WITHOUT blocking (``status()`` then reports live progress)."""
        if not self._thread.is_alive():
            self._thread.start()

    def start(self) -> None:
        """Start and block until the first connect round settles (CLI one-shot)."""
        self.begin()
        self._ready.result()  # block until every server is connected (or skipped)

    def wait_ready(self, timeout: float | None = None) -> None:
        """Block until the initial connect round has settled (connected or failed)."""
        self._ready.result(timeout)

    def wait_server_ready(self, name: str, timeout: float | None = None) -> None:
        """Block until ONE server's current attempt settles (after a reconnect)."""
        ev = self._settled.get(name)
        if ev is None or self._loop.is_closed():
            return
        try:
            asyncio.run_coroutine_threadsafe(ev.wait(), self._loop).result(timeout)
        except (concurrent.futures.TimeoutError, RuntimeError):
            pass

    def reconnect_server(self, name: str) -> None:
        """Restart ONE server in place (others untouched); returns once it's been
        re-spawned and is (re)connecting — poll ``status()`` for the outcome."""
        if name not in self._servers or self._loop.is_closed():
            return
        asyncio.run_coroutine_threadsafe(self._restart(name), self._loop).result()

    def call(self, server: str, tool: str, arguments: dict) -> str:
        fut: concurrent.futures.Future = concurrent.futures.Future()
        self._loop.call_soon_threadsafe(self._inbox.put_nowait, (server, tool, arguments, fut))
        # The server task bounds the call (call_timeout_seconds); the grace here
        # only covers a wedged event loop, so call() can never hang its caller.
        try:
            return fut.result(timeout=self._config.call_timeout_seconds + 10)
        except TimeoutError:
            # concurrent.futures.TimeoutError IS builtin TimeoutError (3.11+), so a
            # done future means the server task's own timeout — keep its message.
            if fut.done():
                raise
            raise TimeoutError(
                f"MCP tool {server}__{tool} timed out (manager unresponsive)"
            ) from None

    def close(self) -> None:
        if self._loop.is_closed() or self._inbox is None:
            return
        self._loop.call_soon_threadsafe(self._inbox.put_nowait, None)
        self._thread.join(timeout=10)

    def status(self) -> list[dict]:
        """Per-server health — the source of truth for the management page /
        ``mcp status``: each configured server's transport, live connection state
        (``connected`` / ``connecting`` / errored), discovered tool count, and
        connect error (if any). ``connecting`` is true while a server's first (or a
        reconnect's) attempt is still in flight — the UI shows it amber, not red."""
        out: list[dict] = []
        for server in self._config.servers:
            name = server.name
            tools = self.discovered.get(name)
            connected = name in self._sessions
            error = self.errors.get(name)
            connecting = self._thread.is_alive() and not connected and error is None
            started = self._connect_started.get(name)
            out.append(
                {
                    "name": name,
                    "transport": server.kind,
                    "connected": connected,
                    "connecting": connecting,
                    # Live feedback while a (possibly slow) connect/fetch is in flight:
                    # how long it's been trying + the latest stderr line (npx/uvx output).
                    "connecting_seconds": round(time.monotonic() - started, 1) if (connecting and started) else None,
                    "log_tail": self._log_tail(name) if connecting else "",
                    "error": error,
                    "tool_count": len(tools) if tools is not None else 0,
                }
            )
        return out


def rebuild_manager(old: "McpManager | None", config: McpConfig) -> McpManager:
    """Reconnect: start a fresh manager for ``config``, then close the old one.

    The new manager is fully started (every server connected or failure-isolated)
    BEFORE the old one is closed, so a hot-reconnect never leaves a window with no
    sessions. The caller keeps the returned manager and re-syncs the registry.
    """
    manager = McpManager(config)
    manager.start()
    if old is not None:
        old.close()
    return manager


def _warm_argv(server: McpServerConfig) -> tuple[str, list[str]] | None:
    """A 'fetch the package into the cache, then exit' command for an npx/uvx server
    (so warming doesn't start the long-lived server), or ``None`` when the launcher
    isn't a package fetch. ``npx`` installs the package then runs a no-op ``node``;
    ``uvx`` resolves the tool env then runs a no-op ``python``."""
    pkg = next((a for a in server.args if not a.startswith("-")), None)
    if pkg is None:
        return None
    cmd = _base_command(server.command)
    if cmd == "npx":
        return server.command, ["-y", "--package", pkg, "--", "node", "-e", "0"]
    if cmd == "uvx":
        return server.command, ["--from", pkg, "python", "-c", ""]
    return None


def prewarm_stdio_packages(
    config: "McpConfig", *, log=None, timeout: float | None = None
) -> list[tuple[str, bool, str]]:
    """Pre-download each npx/uvx server's package (into the launcher's cache) using
    the resolved registry/proxy, so the FIRST real connect is fast and an
    unreachable registry surfaces here (a readable error) instead of later as a
    connect ``TimeoutError``. Fetch-only (a no-op command after install), so it
    exits promptly without starting the server. Returns ``(name, ok, detail)`` per
    server; best-effort (never raises).
    """
    import os
    import subprocess

    def _say(msg: str) -> None:
        if log is not None:
            log.write(msg + "\n")
            log.flush()

    net_env = _stdio_net_env(list(config.servers), config)
    env = dict(os.environ)
    for key, value in net_env.items():
        env.setdefault(key, value)
    warm_timeout = timeout or max(120.0, config.connect_timeout_seconds)
    results: list[tuple[str, bool, str]] = []
    for server in config.servers:
        if server.kind != "stdio":
            continue
        warm = _warm_argv(server)
        if warm is None:  # a local script / non-npx-uvx launcher — nothing to fetch
            continue
        configured, family = _source_status(server, net_env)
        if not configured:  # no reachable registry found — don't hang, report it
            advice = _unreachable_advice(family)
            results.append((server.name, False, advice))
            _say(f"[{server.name}] FAILED: {advice}")
            continue
        try:
            command, args = _windows_stdio_command(warm[0], warm[1])
        except FileNotFoundError as exc:
            results.append((server.name, False, str(exc)))
            _say(f"[{server.name}] FAILED: {exc}")
            continue
        _say(f"[{server.name}] warming: {server.command} {' '.join(server.args)} ...")
        try:
            proc = subprocess.run(  # noqa: S603 — config-defined launcher, fixed argv
                [command, *args],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                env=env,
                timeout=warm_timeout,
                text=True,
            )
            ok = proc.returncode == 0
            detail = "fetched" if ok else f"launcher exited {proc.returncode}: {(proc.stdout or '').strip()[-300:]}"
        except subprocess.TimeoutExpired:
            ok, detail = True, f"still fetching after {int(warm_timeout)}s (will finish on first connect)"
        except Exception as exc:  # spawn failure (missing launcher, etc.)
            ok, detail = False, _format_exception(exc)
        results.append((server.name, ok, detail))
        _say(f"[{server.name}] {'ok' if ok else 'FAILED'}: {detail}")
    return results


def sync_mcp_tools(
    config: "Config", manager: McpManager, registry: Registry | None = None
) -> list[str]:
    """Re-sync the registry's MCP tools to ``config`` + ``manager.discovered``.

    Unlike :func:`register_mcp_tools` (append-only, for a one-shot CLI run), this
    first DROPS every existing ``<server>__<tool>`` entry, then re-registers the
    currently-allowlisted discovered tools — so a long-lived process (the web
    server) stays consistent across runtime allowlist/server edits: what's
    registered (hence offered to the model) always matches the panel's view.
    """
    registry = registry or default_registry
    registry.remove_where(lambda name: "__" in name)
    return register_mcp_tools(config, manager, registry)


def register_mcp_tools(
    config: "Config", manager: McpManager, registry: Registry | None = None
) -> list[str]:
    """Register allowlisted MCP tools into ``registry`` (default: the shared one).

    Only tools allowlisted in ``config.tools`` are registered — by exact
    ``{server}__{tool}`` name or by a ``{server}__*`` wildcard that enables the
    server's whole toolset (see :func:`~{{ project_slug }}.harness.tools.in_allowlist`);
    a non-allowlisted MCP tool is never connected to the model. Risk is per-tool: a
    tool listed in its server's ``safe_tools`` registers as ``risk=safe`` (read-only;
    offered to plan/ask); every other tool defaults to ``risk=high`` (mutating/
    external; agent-only, opt in deliberately).
    """
    from .tools import in_allowlist

    registry = registry or default_registry
    allowed = config.enabled_tool_names()
    safe_by_server = {s.name: set(s.safe_tools) for s in config.mcp.servers}
    registered: list[str] = []
    for server, tools in manager.discovered.items():
        safe = safe_by_server.get(server, set())
        for tool in tools:
            name = f"{server}__{tool.name}"
            if not in_allowlist(name, allowed):
                continue
            registry.register(
                Tool(
                    name=name,
                    description=tool.description or "",
                    parameters=tool.inputSchema or {"type": "object", "properties": {}},
                    func=_make_caller(manager, server, tool.name),
                    risk=SAFE if tool.name in safe else HIGH,
                )
            )
            registered.append(name)
    return registered


def _make_caller(manager: McpManager, server: str, tool: str):
    def _call(**kwargs: Any) -> str:
        return manager.call(server, tool, kwargs)

    return _call
