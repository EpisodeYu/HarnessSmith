"""Ask paradigm (read-only): answer questions, never make changes.

Like Plan mode it offers only **read-only / low-risk tools** (high-risk tools are
not exposed, and one the model hallucinates anyway is refused at the execution
boundary, so a run stays read-only even off-script), but its intent is to *answer
the user's question* rather than produce a plan. Use it for "explain / what /
where" questions where you want zero side effects.

Self-contained: it owns its loop and imports no other paradigm; "read-only" is
the ``allow_high_risk=False`` tool filter below, enforced at offer time AND
execution time (a model-A guardrail you own).
"""

from __future__ import annotations

from collections.abc import Callable

from ..config import Config
from ..context import fit as fit_context, make_summarizer
from ..hooks import Hooks
from ..llm import LLMClient
from ..prompts import build_system_prompt
from ..tools import Registry
from ..tools import registry as default_registry
from ..trace import Trace
from ..usage import LLMBudgetExceeded, UsageLedger
from . import (
    RunResult,
    assistant_message,
    final_assistant_message,
    generate,
    register_paradigm,
    run_tool,
)

MODE = "ask"

_ASK_INSTRUCTION = (
    "You are in ASK mode. Answer the user's question directly and concisely. You "
    "may use the available read-only tools to gather information, but do NOT make "
    "any changes, run any commands, or take any irreversible action."
)


@register_paradigm(MODE)
def run(
    user_input: str,
    *,
    client: LLMClient | None = None,
    client_for: Callable[[str], LLMClient] | None = None,
    config: Config,
    role: str = "generation",
    registry: Registry = default_registry,
    hooks: Hooks | None = None,
    trace: Trace | None = None,
    on_delta: Callable[[str], None] | None = None,
    on_thinking: Callable[[str], None] | None = None,
    history: list[dict] | None = None,
    cancel: Callable[[], bool] | None = None,
    checkpoint: Callable[[list[dict]], None] | None = None,
    working_dir: str | None = None,
) -> RunResult:
    """Run one read-only question-answering turn (low-risk tools only).

    ``history`` is prior conversation messages (no system prompt) to resume from;
    the returned ``RunResult.messages`` is the full body after this turn. ``cancel``
    stops the turn at a clean boundary (Stop / Ctrl-C, ``stop_reason="interrupted"``);
    ``checkpoint`` write-aheads the body after each step for crash safety."""
    hooks = hooks or Hooks()
    if client is None:
        if client_for is None:
            raise ValueError("run() needs either `client` or `client_for`")
        client = client_for(role)
    profile = config.profile_for(role)
    if trace is None:
        obs = config.observability
        trace = Trace(
            trace_dir=obs.trace_dir if obs.trace else None,
            enabled=obs.trace,
            redact=obs.redact_trace,
        )
    # Attach the persistent per-LLM cost ledger (cross-run spend + cost limits)
    # unless a caller already wired one (e.g. a test injecting an isolated ledger).
    if trace.ledger is None:
        trace.ledger = UsageLedger()

    context_cfg = config.context
    # Summarization usage is recorded to the trace (and counts toward the budget).
    summarizer = make_summarizer(client_for, config, context_cfg, trace)
    # Real prompt-token usage from the previous response drives compaction (the
    # char estimate is only a first-call fallback); the window bounds window_pct.
    last_prompt_tokens = 0
    context_window = profile.context_window

    # Read-only: high-risk tools are never offered, and ``run_tool`` refuses any
    # call outside this ``active`` set, so the model cannot mutate even off-script.
    active = registry.active_names(config.enabled_tool_names(), allow_high_risk=False)
    tool_schemas = registry.schemas(active)

    system = build_system_prompt(config, working_dir=working_dir) + "\n\n" + _ASK_INSTRUCTION
    messages: list[dict] = [
        {"role": "system", "content": system},
        *(history or []),
        {"role": "user", "content": user_input},
    ]
    trace.event("run_start", mode=MODE, role=role, model=profile.model, tools=active)

    step = 0
    stop_reason = "final"
    answer = ""
    final_reasoning: str | None = None  # the thinking behind the final answer (display-only)
    while True:
        # Cooperative cancel at the step boundary: a Stop / Ctrl-C between steps
        # ends the turn cleanly here, leaving messages on a legal boundary (last
        # tool result / user message).
        if cancel is not None and cancel():
            stop_reason = "interrupted"
            break

        # Hard step ceiling (safety valve): stop a looping / runaway model even when
        # no cost_limit is set (the default product prices LLMs at 0, so cost_limit
        # alone is no guard). Counts completed tool-rounds; 0 = unlimited. The stop is
        # clean here at the step boundary — continue the session to run past it.
        if config.max_steps and step >= config.max_steps:
            stop_reason = "max_steps"
            answer = (
                f"Stopped after reaching max_steps ({config.max_steps}). Raise "
                "max_steps in config.yaml or continue the session to keep going."
            )
            break

        # Per-LLM cost limit (block_stop): refuse to call an over-budget LLM and
        # stop cleanly with a notice naming it. The generation profile is checked
        # here; the compaction profile is checked inside the summarizer, which
        # raises the same exception from fit_context — so either LLM crossing its
        # cost_limit ends the turn. Accrued cost drives it, so a stop lands at the
        # start of the next step (off by one, like any post-hoc count).
        try:
            if trace.ledger is not None:
                trace.ledger.ensure_within(profile)
            messages = fit_context(
                messages, context_cfg, summarizer=summarizer,
                last_prompt_tokens=last_prompt_tokens, context_window=context_window, config=config,
            )
        except LLMBudgetExceeded as exc:
            stop_reason, answer = "llm_budget", exc.message()
            break
        hooks.before_step(step, messages)
        try:
            # One call with context-overflow auto-rescue + optional profile fallback
            # (shared plumbing); messages may come back compacted by an overflow rescue.
            response, messages = generate(
                client, messages, tool_schemas or None,
                on_delta=on_delta, on_thinking=on_thinking, cancel=cancel,
                context_cfg=context_cfg, summarizer=summarizer,
                last_prompt_tokens=last_prompt_tokens, context_window=context_window,
                config=config, fallback_name=profile.fallback,
            )
        except LLMBudgetExceeded as exc:
            # An overflow rescue's compaction hit the compaction LLM's cost limit.
            stop_reason, answer = "llm_budget", exc.message()
            break
        except Exception as exc:
            hooks.on_error("llm", exc)
            trace.event("error", where="llm", error=str(exc))
            trace.close()
            raise

        # Cancelled mid-generation: drop the half-streamed response (it was never
        # appended) and stop on the prior clean boundary.
        if cancel is not None and cancel():
            stop_reason = "interrupted"
            break

        cost = trace.add_usage(response.usage, profile)
        last_prompt_tokens = response.usage.prompt_tokens  # feed the next compaction check
        trace.event(
            "llm_response",
            step=step,
            has_tool_calls=bool(response.tool_calls),
            prompt_tokens=response.usage.prompt_tokens,
            completion_tokens=response.usage.completion_tokens,
            cached_prompt_tokens=response.usage.cached_prompt_tokens,
            reasoning_tokens=response.usage.reasoning_tokens,
            step_cost_usd=cost,
        )
        hooks.after_step(step, response)

        if not response.tool_calls:
            answer, stop_reason = response.content or "", "final"
            final_reasoning = response.reasoning  # kept for display on reload, never re-sent
            break

        messages.append(assistant_message(response))
        for call in response.tool_calls:
            # A Stop during the batch: remaining calls are not run — they get the
            # same synthetic result crash-repair writes, so the sequence stays
            # legal and the step-boundary check above ends the turn cleanly.
            if cancel is not None and cancel():
                result = "ERROR: interrupted before this tool ran"
            else:
                result = run_tool(
                    registry, call, hooks, trace, allowed=set(active),
                    max_result_chars=context_cfg.max_tool_result_chars,
                    result_strategy=context_cfg.tool_result_strategy, cancel=cancel,
                )
            messages.append(
                {"role": "tool", "tool_call_id": call.id, "content": result}
            )
        step += 1
        # Write-ahead the completed step (body only): a crash now still leaves a
        # legal, resumable conversation on disk.
        if checkpoint is not None:
            checkpoint(messages[1:])

    trace.event(
        "run_end",
        mode=MODE,
        stop_reason=stop_reason,
        steps=step,
        total_tokens=trace.total_tokens,
        cost_usd=trace.cost_usd,
    )
    trace.close()
    # Record the final answer in the body so a resumed session sees this reply.
    # Budget-stop notices are synthetic, so they stay out of the saved history.
    if stop_reason == "final" and answer:
        messages.append(final_assistant_message(answer, final_reasoning))
    return RunResult(
        answer=answer,
        steps=step,
        stop_reason=stop_reason,
        trace=trace,
        mode=MODE,
        messages=messages[1:],
    )
