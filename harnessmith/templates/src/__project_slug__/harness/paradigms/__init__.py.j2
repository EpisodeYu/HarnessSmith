@dataclass
class RunResult:
    answer: str
    steps: int
    # "final" (the model answered), "interrupted" (Stop / Ctrl-C / disconnect),
    # "max_steps" (hit the config.max_steps step ceiling — a runaway guard), or
    # "llm_budget" (an LLM hit its per-LLM cost_limit, so the loop stopped using it
    # — see harness/usage.py).
    stop_reason: str
    trace: Trace
    mode: str = "agent"  # which paradigm produced this result
    # The conversation body after this turn (every message EXCEPT the system
    # prompt). A session store persists this so a later run can resume by
    # passing it back as ``history`` — the system prompt is always rebuilt from
    # config, so prompt/rules edits take effect on resume.
    messages: list[dict] = field(default_factory=list)


class Paradigm(Protocol):
    """The contract every paradigm satisfies: same shape as ``loop.run`` (minus
    ``mode``), returning a :class:`RunResult`. Keyword args beyond what a given
    paradigm uses may be ignored (accept ``**kwargs``)."""

    def __call__(self, user_input: str, *, config, **kwargs) -> RunResult: ...


PARADIGMS: dict[str, Paradigm] = {}


def register_paradigm(name: str) -> Callable[[Paradigm], Paradigm]:
    """Decorator: register ``func`` as the paradigm called ``name``."""

    def decorator(func: Paradigm) -> Paradigm:
        PARADIGMS[name] = func
        return func

    return decorator


def get_paradigm(name: str) -> Paradigm:
    if name not in PARADIGMS:
        raise ValueError(
            f"unknown paradigm {name!r}; registered: {sorted(PARADIGMS)}"
        )
    return PARADIGMS[name]


# --- Shared loop plumbing (paradigm-agnostic; kept here so paradigms stay thin
#     and never import one another) ------------------------------------------


def assistant_message(response: LLMResponse) -> dict:
    """The OpenAI-shaped assistant message carrying any requested tool calls.

    When a thinking model reasoned before calling tools, that reasoning rides
    back under the neutral ``reasoning_content`` key (plus ``reasoning_signature``
    for native Anthropic, whose thinking blocks must round-trip unchanged). This
    matters ONLY on tool-calling turns: reasoning endpoints (MiMo / DeepSeek
    thinking / Qwen / Kimi) reject the next request if the reasoning that
    accompanied a tool call is missing from history. Each client maps this carrier
    to its own wire shape and strips it for endpoints that didn't produce it, so a
    plain model's history is byte-for-byte unchanged.
    """
    message = {
        "role": "assistant",
        "content": response.content or "",
        "tool_calls": [
            {
                "id": call.id,
                "type": "function",
                "function": {"name": call.name, "arguments": call.arguments},
            }
            for call in response.tool_calls
        ],
    }
    if response.tool_calls and response.reasoning:
        message["reasoning_content"] = response.reasoning
        if response.reasoning_signature:
            message["reasoning_signature"] = response.reasoning_signature
    return message


def final_assistant_message(answer: str, reasoning: str | None = None) -> dict:
    """The final answer message saved to the conversation body.

    A thinking model's reasoning for THIS answer rides under a display-only key
    (``reasoning_display``) so a reloaded session can show the thinking that led to
    the answer (the live UI streamed it; this is what survives a reload). Unlike a
    tool-calling turn's ``reasoning_content``, it is NEVER echoed back to the model
    (the turn is over): each client strips ``reasoning_display`` from the wire, so a
    reasoning endpoint can't 400 on it and a plain model never sees it. Empty
    reasoning ⇒ a byte-identical ``{"role","content"}`` message (no new key).
    """
    message = {"role": "assistant", "content": answer}
    if reasoning:
        message["reasoning_display"] = reasoning
    return message


def _truncate_result(result: str, max_chars: int | None) -> str:
    """Cap one tool result so a single huge observation can't blow the window.

    The tail is replaced with a ``[truncated N chars]`` marker so the model knows
    to narrow its query / paginate. ``max_chars`` of 0 or None means no cap.
    """
    if not max_chars or len(result) <= max_chars:
        return result
    dropped = len(result) - max_chars
    return result[:max_chars] + f"\n\n[truncated {dropped} chars]"


class ToolInterrupted(Exception):
    """A Stop arrived while a tool was still running: the loop stops WAITING and
    ends the turn. The tool itself cannot be safely killed, so it finishes on its
    daemon thread and its result is discarded (same contract as closing the tab —
    side effects already started may still complete)."""


# How often the waiting side rechecks ``cancel`` while a tool runs — the upper
# bound on how long a Stop takes to be felt mid-tool.
_CANCEL_POLL_SECONDS = 0.2


def _call_abortable(registry: Registry, name: str, arguments: str, cancel) -> str:
    """``registry.call`` on a daemon thread, polling ``cancel`` while waiting.

    Makes Stop responsive DURING tool execution — a hung tool (e.g. a wedged MCP
    server) no longer blocks the turn until the process dies. Raises
    :class:`ToolInterrupted` when cancelled; without a ``cancel`` predicate this
    is a plain synchronous call (no extra thread).
    """
    if cancel is None:
        return registry.call(name, arguments)
    box: dict = {}

    def target() -> None:
        try:
            box["result"] = registry.call(name, arguments)
        except Exception as exc:  # re-raised on the waiting side below
            box["error"] = exc

    # Carry the caller's ContextVars (the interaction asker/confirmer) into the
    # tool thread — ask_question must still reach the user from there.
    ctx = contextvars.copy_context()
    thread = threading.Thread(target=lambda: ctx.run(target), daemon=True, name=f"tool-{name}")
    thread.start()
    while True:
        thread.join(timeout=_CANCEL_POLL_SECONDS)
        if not thread.is_alive():
            break
        if cancel():
            raise ToolInterrupted(
                f"interrupted while tool {name!r} was running (side effects "
                "already started may still complete in the background)"
            )
    if "error" in box:
        raise box["error"]
    return box["result"]


def run_tool(
    registry: Registry,
    call: ToolCall,
    hooks: Hooks,
    trace: Trace,
    allowed: set[str] | None = None,
    max_result_chars: int | None = None,
    cancel: Callable[[], bool] | None = None,
) -> str:
    """Execute one tool call; tool errors are captured, never crash the loop.

    ``allowed`` is the set of tool names this paradigm offered. When given, a call
    to a tool OUTSIDE it (e.g. a high-risk tool a read-only paradigm never offered,
    that the model hallucinated anyway) is refused HERE, at the execution boundary
    — not merely left out of the schema. The refusal is returned as an ERROR
    observation so the model can self-correct, keeping the read-only contract true
    even if the model goes off-script.

    HITL tool confirmation also lives at this boundary: ``confirm_tool`` consults
    the current confirmer (set via ``interaction.using_confirmer`` at the entry
    point) and, for a tool the ``confirm`` policy flagged, asks the user to allow
    or reject it. A rejection comes back as an ERROR observation (the model adapts,
    the loop never crashes); with no confirmer set (confirmation off) it is a no-op.

    ``max_result_chars`` caps the result the model sees (A1): a too-large result is
    truncated with a marker. The trace/hooks still receive the full result.

    ``cancel`` makes the wait abortable: a Stop while the tool runs abandons the
    wait within ~0.2s (the tool finishes on a daemon thread, discarded) and this
    call's observation becomes an interrupted ERROR — see :class:`ToolInterrupted`.

    Hooks are also the thin tool-POLICY layer: ``before_tool`` may RETURN a string
    to refuse the call before it runs (a code-level gate, checked before HITL so an
    auto-refusal doesn't prompt the user; allowlist still narrows on top, so a hook
    can only refuse — never grant — a tool); ``after_tool`` may RETURN a string to
    rewrite/redact the result the model AND the trace then see (e.g. scrub a secret
    that came back in output). Returning ``None`` from either is the pure-observer
    behavior.
    """
    # before_tool is observer + optional policy gate: a returned string refuses the
    # call (checked before allowlist/HITL so a guard fires uniformly and an
    # auto-refusal never bothers the user). The SSE/observer side still sees every
    # attempt because this is always called, symmetric with after_tool below.
    policy_refusal = hooks.before_tool(call)
    trace.event("tool_call", name=call.name, arguments=call.arguments)
    started = time.monotonic()
    outcome = "ok"
    if policy_refusal is not None:
        result = policy_refusal
        outcome = "refused (policy)"
    elif allowed is not None and call.name not in allowed:
        result = f"ERROR: tool {call.name!r} is not available in this mode"
        outcome = "refused (not offered in this mode)"
    else:
        refusal = confirm_tool(call.name, call.arguments, registry.risk_of(call.name))
        if refusal is not None:  # HITL: user rejected (or non-interactive fail-closed)
            result = refusal
            outcome = "refused (HITL)"
        else:
            try:
                result = _call_abortable(registry, call.name, call.arguments, cancel)
            except ToolInterrupted as exc:
                # A Stop mid-tool: not an error (no on_error hook) — the turn ends
                # as "interrupted" and this call's observation records why.
                result = f"ERROR: {exc}"
                outcome = "interrupted"
            except Exception as exc:
                hooks.on_error("tool", exc)
                result = f"ERROR: {exc}"
                # Only the error CLASS goes to the debug log — its message may
                # embed the tool's arguments, which the log never records.
                outcome = f"error ({type(exc).__name__})"
    # after_tool may redact/rewrite the result; the rewritten value is what both the
    # model and the trace record (so a secret can be scrubbed here, not just masked).
    rewritten = hooks.after_tool(call, result)
    if rewritten is not None:
        result = rewritten
    log.debug("tool %s -> %s in %.2fs", call.name, outcome, time.monotonic() - started)
    trace.event("tool_result", name=call.name, result=result)
    truncated = _truncate_result(result, max_result_chars)
    if truncated is not result:
        # A capped observation is a context-pressure signal — record the sizes (chars
        # only, never the content) so a tool that floods the window is easy to spot.
        log.debug(
            "tool %s result truncated: %d -> %d chars (context.max_tool_result_chars)",
            call.name, len(result), max_result_chars,
        )
    return truncated


def generate(
    client: LLMClient,
    messages: list[dict],
    tools: list[dict] | None,
    *,
    on_delta: Callable[[str], None] | None = None,
    on_thinking: Callable[[str], None] | None = None,
    cancel: Callable[[], bool] | None = None,
    context_cfg=None,
    summarizer: LLMClient | None = None,
    last_prompt_tokens: int = 0,
    context_window: int | None = None,
    config=None,
    fallback_name: str | None = None,
) -> tuple[LLMResponse, list[dict]]:
    """One LLM call with two safety nets, shared by every paradigm.

    Returns ``(response, messages)`` — ``messages`` MAY differ from the input when
    an overflow rescue compacted it, so the caller should adopt the returned list.

    - **B2 context-overflow auto-rescue**: if the request is rejected for being
      over-long, force one compaction and retry the same step once (a second
      failure propagates — bounded, no loop).
    - **B3 fallback**: on any other error, if nothing has streamed yet and the
      profile names a ``fallback``, retry the step once with that profile's client.
      A mid-stream break is never retried (its partial output already showed).

    Streaming is chosen when ``on_delta`` / ``on_thinking`` is given.
    """
    from ..context import fit as fit_context
    from ..llm import client_for_profile_name, is_context_overflow

    streaming = on_delta is not None or on_thinking is not None
    emitted = {"v": False}

    def _delta(text: str) -> None:
        emitted["v"] = True
        if on_delta is not None:
            on_delta(text)

    def _call(active: LLMClient, msgs: list[dict]) -> LLMResponse:
        if streaming:
            return active.stream(msgs, tools, on_delta=_delta, on_thinking=on_thinking, cancel=cancel)
        return active.complete(msgs, tools, cancel=cancel)

    try:
        return _call(client, messages), messages
    except Exception as exc:
        if context_cfg is not None and is_context_overflow(exc):
            compacted = fit_context(
                messages, context_cfg, summarizer=summarizer,
                last_prompt_tokens=last_prompt_tokens, context_window=context_window,
                force=True, config=config,
            )
            log.debug(
                "context overflow -> force-compacted %d -> %d msgs, retrying step",
                len(messages), len(compacted),
            )
            return _call(client, compacted), compacted  # one retry; re-raises if it fails again
        if not emitted["v"] and fallback_name and config is not None:
            log.debug("llm error (%s) -> retrying step on fallback profile %r",
                      type(exc).__name__, fallback_name)
            return _call(client_for_profile_name(config, fallback_name), messages), messages
        raise


