"""Session persistence: save / resume a conversation across runs.

A *session* is one ongoing conversation, possibly spanning many ``run`` calls
(or a whole ``chat`` REPL / web session). Each session is one JSON file under
``<dir>/<id>.json`` holding the message **body** — every message except the
system prompt. The system prompt is rebuilt from ``config`` on each turn, so
prompt / rules / sampling edits take effect when you resume (the saved body is
just the user/assistant/tool turns).

No secrets are ever written: API keys live only in ``.env`` and never enter the
message stream, so the session file carries conversation text only. This is
plain ``json`` + ``pathlib`` — zero extra dependencies. Read it, edit it, delete
a file to forget a conversation.
"""

from __future__ import annotations

import json
import os
import time
import uuid
from pathlib import Path

from .debuglog import log


def new_id() -> str:
    """A short, unique session id (same shape as a trace run id)."""
    return uuid.uuid4().hex[:12]


def _path(session_id: str, sessions_dir: str) -> Path:
    # ``.name`` strips any path components so an id like ``../x`` can't escape the
    # sessions dir (ids are normally uuid hex, but the web takes them from URLs).
    return Path(sessions_dir) / f"{Path(session_id).name}.json"


def _atomic_write(path: Path, text: str) -> None:
    """Write ``text`` to ``path`` atomically (temp file + ``os.replace``).

    A hard crash (kill -9 / power loss / OOM) mid-write can't leave a half-written,
    corrupt session file: we write a sibling ``.<name>.tmp`` and ``os.replace`` it
    into place, which is atomic on the same filesystem. The reader therefore always
    sees either the old file or the complete new one — never a truncated mix.
    """
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def _read(session_id: str, sessions_dir: str) -> dict:
    path = _path(session_id, sessions_dir)
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}


def repair_orphan_tool_results(messages: list[dict]) -> list[dict]:
    """Make a (possibly crash-interrupted) history legal for the chat API again.

    A hard crash *during* a tool batch can persist an assistant message that
    requested tool calls without all of their ``tool`` results — an "orphan
    tool_use". The chat API rejects such a sequence, so on resume we inject a
    synthetic error ``tool`` result for every requested ``tool_call_id`` that has
    no matching result, right after the assistant message. Clean histories are
    returned unchanged (same dicts), so this is a safe no-op normally.
    """
    satisfied = {
        m.get("tool_call_id")
        for m in messages
        if m.get("role") == "tool" and m.get("tool_call_id")
    }
    out: list[dict] = []
    for message in messages:
        out.append(message)
        if message.get("role") == "assistant" and message.get("tool_calls"):
            for call in message["tool_calls"]:
                call_id = call.get("id")
                if call_id and call_id not in satisfied:
                    out.append(
                        {
                            "role": "tool",
                            "tool_call_id": call_id,
                            "content": "ERROR: interrupted before this tool ran",
                        }
                    )
                    satisfied.add(call_id)
    return out


def load(session_id: str, sessions_dir: str) -> list[dict]:
    """Return the stored message body for ``session_id`` (``[]`` if unknown).

    If the session wasn't cleanly finished (``status != "complete"``, e.g. it was
    stopped or the process was killed) or a dangling ``tool_use`` is detected, the
    body is repaired (:func:`repair_orphan_tool_results`) so a resumed turn is
    legal for the chat API. Clean sessions are returned verbatim.
    """
    data = _read(session_id, sessions_dir)
    messages = data.get("messages", [])
    log.debug(
        "session %s: load (%d messages, status=%s)",
        session_id, len(messages), data.get("status", "complete"),
    )
    if data.get("status", "complete") != "complete":
        return repair_orphan_tool_results(messages)
    repaired = repair_orphan_tool_results(messages)
    return repaired if repaired != messages else messages


def status_of(session_id: str, sessions_dir: str) -> str:
    """The session's stored ``status`` (``"complete"`` if none / unknown).

    ``"running"`` means a turn was checkpointed but never cleanly finished (a hard
    crash, or a Ctrl-C under ``uv run`` that killed the process before the
    interrupt-time save landed); ``"interrupted"`` means it was stopped on purpose
    (Stop / Ctrl-C). Both are resumable — :func:`load` repairs any non-``complete``
    session — so treat a persisted ``"running"`` as interrupted-equivalent, not live.
    """
    return _read(session_id, sessions_dir).get("status", "complete")


def title_of(session_id: str, sessions_dir: str) -> str:
    """The session's stored title (``""`` if none yet / unknown session)."""
    return _read(session_id, sessions_dir).get("title", "")


def cwd_of(session_id: str, sessions_dir: str) -> str:
    """The session's stored working-directory hint (absolute path), or ``""``.

    Older session files without a ``cwd`` key are treated as unset (no error).
    """
    return str(_read(session_id, sessions_dir).get("cwd", "") or "").strip()


def save(
    session_id: str,
    messages: list[dict],
    sessions_dir: str,
    *,
    mode: str = "agent",
    title: str | None = None,
    status: str = "complete",
    cwd: str | None = None,
) -> None:
    """Persist the conversation body for ``session_id`` (creating the dir).

    Stores only the message body (no system prompt) and never a secret — keys
    stay in ``.env`` and never reach ``messages``. ``created`` and any existing
    ``title`` are preserved across updates (pass ``title`` to set/replace it);
    ``cwd`` is the optional per-session working-directory hint for prompts (pass
    ``cwd`` to set/replace it; ``None`` keeps the prior value on update). ``updated``
    is refreshed each save. ``status`` records how the turn ended:
    ``"complete"`` (clean), ``"interrupted"`` (stopped on purpose), or
    ``"running"`` (a mid-turn write-ahead checkpoint — see :func:`checkpoint`).
    The write is atomic, so a crash can't corrupt the file.
    """
    directory = Path(sessions_dir)
    directory.mkdir(parents=True, exist_ok=True)
    existing = _read(session_id, sessions_dir)
    if cwd is None:
        cwd_out = str(existing.get("cwd", "") or "").strip()
    else:
        cwd_out = str(cwd).strip() if cwd else ""
    record = {
        "id": session_id,
        "created": existing.get("created", time.time()),
        "updated": time.time(),
        "mode": mode,
        "title": title or existing.get("title", ""),
        "cwd": cwd_out,
        "status": status,
        "messages": messages,
    }
    _atomic_write(
        _path(session_id, sessions_dir),
        json.dumps(record, ensure_ascii=False, indent=2),
    )
    log.debug(
        "session %s: saved (%d messages, status=%s)", session_id, len(messages), status
    )


def checkpoint(
    session_id: str,
    messages: list[dict],
    sessions_dir: str,
    *,
    mode: str = "agent",
    cwd: str | None = None,
) -> None:
    """Write-ahead the in-progress conversation after a completed step.

    Called once per loop step so a hard crash mid-turn still leaves the work so
    far on disk (status ``"running"``). On resume, :func:`load` notices the
    non-``complete`` status and repairs any dangling ``tool_use``. This is just a
    ``save`` with ``status="running"`` (same atomic single-file write).
    """
    save(session_id, messages, sessions_dir, mode=mode, status="running", cwd=cwd)


def set_title(session_id: str, title: str, sessions_dir: str) -> bool:
    """Rename a session (replace its title), preserving its messages. Returns
    ``False`` if the session is unknown."""
    data = _read(session_id, sessions_dir)
    if not data:
        return False
    data["title"] = title
    if "cwd" not in data:
        data["cwd"] = ""
    data["updated"] = time.time()
    _atomic_write(
        _path(session_id, sessions_dir),
        json.dumps(data, ensure_ascii=False, indent=2),
    )
    return True


def turns(messages: list[dict]) -> list[dict]:
    """The user-turn boundaries in a body: ``{index, message_index, preview}`` per
    user message. Lets a UI offer "edit this question" controls (the web re-ask),
    where ``index`` is the turn ordinal passed to :func:`truncate_to_turn`."""
    out: list[dict] = []
    for message_index, message in enumerate(messages):
        if message.get("role") == "user":
            out.append(
                {
                    "index": len(out),
                    "message_index": message_index,
                    "preview": (message.get("content") or "")[:80],
                }
            )
    return out


def truncate_to_turn(messages: list[dict], n: int) -> list[dict]:
    """Return the body up to (but excluding) the ``n``-th user turn (0-based).

    Used by the web re-ask: drop everything from the edited question onward, then
    re-run from there. ``n`` out of range returns a copy of the whole body.
    """
    user_indices = [i for i, m in enumerate(messages) if m.get("role") == "user"]
    if n < 0 or n >= len(user_indices):
        return list(messages)
    return messages[: user_indices[n]]


def delete(session_id: str, sessions_dir: str) -> bool:
    """Delete a session file. Returns ``True`` if it existed (idempotent)."""
    path = _path(session_id, sessions_dir)
    if not path.is_file():
        return False
    path.unlink()
    return True


def latest(sessions_dir: str) -> str | None:
    """The id of the most recently updated session, or ``None`` if there are none."""
    directory = Path(sessions_dir)
    if not directory.is_dir():
        return None
    files = sorted(
        directory.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True
    )
    return files[0].stem if files else None


def resolve(
    *, continue_: bool, resume_id: str | None, sessions_dir: str
) -> tuple[str, list[dict]]:
    """Pick the session id + prior history for this run.

    ``--resume <id>`` targets a specific session; ``--continue`` picks the most
    recent one; otherwise a brand-new session id is minted with empty history.
    A resume/continue against a missing session just starts it fresh.
    """
    if resume_id:
        return resume_id, load(resume_id, sessions_dir)
    if continue_:
        prev = latest(sessions_dir)
        if prev is not None:
            return prev, load(prev, sessions_dir)
    return new_id(), []


def summaries(sessions_dir: str) -> list[dict]:
    """List sessions (most recent first) for a picker: id, updated, mode, preview."""
    directory = Path(sessions_dir)
    if not directory.is_dir():
        return []
    out: list[dict] = []
    for path in sorted(
        directory.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True
    ):
        data = _read(path.stem, sessions_dir)
        if not data:
            continue
        preview = ""
        for message in data.get("messages", []):
            if message.get("role") == "user":
                preview = (message.get("content") or "")[:80]
                break
        out.append(
            {
                "id": data.get("id", path.stem),
                "updated": data.get("updated", path.stat().st_mtime),
                "mode": data.get("mode", ""),
                "title": data.get("title", ""),
                "cwd": str(data.get("cwd", "") or ""),
                "preview": preview,
            }
        )
    return out
