"""Assemble the system prompt from config (system + rules{% if spec.memory.enabled %} + memory{% endif %}{% if spec.subagents.enabled %} + subagents{% endif %}{% if spec.skills.enabled %} + skills{% endif %}{% if spec.mcp.enabled %} + environment{% endif %})."""

from __future__ import annotations

from datetime import datetime
from pathlib import Path

from .config import Config
{% if spec.skills.enabled %}from .skills import activate_skills, build_skills_prompt
{% endif %}
# Used only when config.yaml leaves prompts.system empty. Kept byte-identical to
# the seed baked into config.yaml so behavior is the same whether or not the
# field is set. Intentionally thin and general (not coding-specific): project- or
# domain-specific guidance belongs in rule files (prompts.rules_files), not here.
_DEFAULT_SYSTEM = """You are a capable AI assistant. You operate in an agent loop: you can call the tools available to you, observe the results, and keep going until the user's request is resolved.

- Use the available tools when they help; don't guess at anything you can look up or verify with a tool.
- Be honest and accurate. If you're unsure or can't determine something, say so; never fabricate facts, code, file contents, command output, or URLs.
- See the task through, then stop and briefly report what you did and any next steps.
- Be concise and direct: lead with the result, skip filler and unnecessary preamble, and don't use emojis unless asked.
- Do what was asked: prefer the simplest correct approach and avoid unrequested scope or complexity.

When project-specific rules are provided to you, follow them; they take precedence over these defaults."""

# Conventional always-apply rule files auto-discovered at the project root (the
# open CLAUDE.md pattern) even when not listed in prompts.rules_files — drop a
# CLAUDE.md in and it's picked up. NOTE: AGENTS.md is intentionally NOT here. In a
# generated harness AGENTS.md is the "how to extend me" developer guide, not a
# runtime rule; list it explicitly in rules_files if you really want it injected.
_CONVENTION_RULE_FILES = ("CLAUDE.md",)


def _load_rules(config: Config) -> str:
    """Read the always-apply project rule files and join them into one section.

    This is the open AGENTS.md / CLAUDE.md / .cursor-rules pattern: every file in
    ``config.prompts.rules_files`` (explicit) plus any conventional root file in
    ``_CONVENTION_RULE_FILES`` (e.g. a CLAUDE.md you dropped in) is read and
    injected into the system prompt verbatim — deduplicated, in that order. A path
    that doesn't exist (or is empty) is skipped, so a rule file you haven't written
    yet is a no-op rather than an error. Add or edit files and list them in
    ``config.yaml`` — no regeneration needed.
    """
    seen: set[str] = set()
    sections: list[str] = []
    for path in [*config.prompts.rules_files, *_CONVENTION_RULE_FILES]:
        candidate = Path(path)
        key = str(candidate)
        if key in seen:
            continue
        seen.add(key)
        if candidate.is_file():
            text = candidate.read_text(encoding="utf-8").strip()
            if text:
                sections.append(text)
    if not sections:
        return ""
    return "Project rules (always follow):\n\n" + "\n\n".join(sections)

{% if spec.mcp.enabled %}
def _environment_note(config: Config) -> str:
    """Tell the model its OS/shell and surface installed-but-disabled capabilities.

    Shell commands are OS-specific, so the model is told the host platform; and any
    configured MCP server with no enabled tool (e.g. a high-risk shell/file server
    kept off by default) is named with a hint to enable it — so a capability is
    never silently missing and the model can guide the user to turn it on.
    """
    if not config.mcp.servers:
        return ""
    import platform

    system = platform.system() or "an unknown OS"
    shell = "PowerShell or cmd" if system == "Windows" else "a POSIX shell (sh/bash)"
    lines = [
        f"Environment: the host OS is {system}; shell commands (if any tool runs "
        f"them) use {shell}, so write commands for that shell."
    ]
    active = {n.split("__", 1)[0] for n in config.enabled_tool_names() if "__" in n}
    dormant = [s for s in config.mcp.servers if s.name not in active]
    if dormant:
        lines.append(
            "These capabilities are installed but currently disabled (off by "
            "default — typically shell/file writes). If a task needs one, tell the "
            "user to enable its tools in config.yaml (e.g. `<server>__<tool>: true`)"
            "{% if interfaces.web %} or on the web UI's Config → Tools page{% endif %}:"
        )
        for server in dormant:
            desc = f" — {server.description}" if server.description else ""
            lines.append(f"- {server.name}{desc}")
    return "\n".join(lines)


{% endif %}def _working_dir_note(working_dir: str | None) -> str:
    """Optional anchor for file-oriented tools: absolute path, hint-only (not a fence)."""
    if not working_dir or not str(working_dir).strip():
        return ""
    path = str(working_dir).strip()
    return (
        f"Working directory (for reference): {path}. Prefer reading/searching files "
        "relative to it. This is a hint, NOT a restriction — you may access paths "
        "outside it when the task calls for it."
    )


def _now() -> datetime:
    """Indirection over the wall clock so tests can freeze "now"."""
    return datetime.now().astimezone()


def _datetime_note() -> str:
    """Anchor the model to today's real date/time.

    Models have a training cutoff and a strong date prior, so without this they
    hallucinate "today" — and may even ignore a clock tool's result. Injected every
    turn in the host's local timezone; get_current_time still returns UTC for a
    precise re-check during a long task."""
    now = _now()
    return (
        f"Today's date is {now:%Y-%m-%d} ({now:%A}). The current local time is "
        f"{now:%H:%M} (UTC{now:%z}). Treat this as the current date/time; call the "
        "get_current_time tool (returns UTC) if you need to re-check it."
    )


def build_system_prompt(config: Config, working_dir: str | None = None) -> str:
    prompts = config.prompts
    parts = [prompts.system or _DEFAULT_SYSTEM]
    # Right after the base prompt so the date is a prominent anchor (always on).
    parts.append(_datetime_note())
    rules = _load_rules(config)
    if rules:
        parts.append(rules)
{% if spec.memory.enabled %}    # Cross-session long-term memory: recalled notes the agent saved earlier,
    # injected as reference material (see harness/memory.py). Empty = no-op.
    from .memory import memory_section

    memory = memory_section(config)
    if memory:
        parts.append(memory)
{% endif %}{% if spec.subagents.enabled %}    # Multi-agent: tell the supervisor it can delegate to worker subagents via the
    # `dispatch` tool (see harness/subagents.py). Empty when no subagents configured.
    from .subagents import subagents_section

    subagents = subagents_section(config)
    if subagents:
        parts.append(subagents)
{% endif %}{% if spec.skills.enabled %}    # Standard Agent Skills (L1): inject available skills' name+description so the
    # model knows they exist and can read the full SKILL.md on demand.
    activate_skills(config)
    skills_section = build_skills_prompt(config)
    if skills_section:
        parts.append(skills_section)
{% endif %}    wd = _working_dir_note(working_dir)
    if wd:
        parts.append(wd)
{% if spec.mcp.enabled %}    environment = _environment_note(config)
    if environment:
        parts.append(environment)
{% endif %}    return "\n\n".join(parts)
