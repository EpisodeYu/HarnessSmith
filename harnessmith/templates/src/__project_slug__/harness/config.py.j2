"""Runtime configuration: load ``config.yaml`` + ``.env`` and validate it.

Secrets are NEVER stored in ``config.yaml`` — it only holds env-var *names*
(``api_key_env`` / ``base_url_env``). Real values live in ``.env`` (gitignored)
or the process environment, and are resolved lazily here. This is the single
entry point for configuration; edit freely.
"""

from __future__ import annotations

import os
import re
from pathlib import Path
from typing import Any, Literal

import yaml
from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

DEFAULT_CONFIG_PATH = "config.yaml"
DEFAULT_ENV_FILE = ".env"


class ConfigError(Exception):
    """Raised when configuration is missing or invalid."""


class _EnvFile(BaseSettings):
    """Loads every key in ``.env`` so secret env-vars resolve by name."""

    model_config = SettingsConfigDict(
        env_file=DEFAULT_ENV_FILE, env_file_encoding="utf-8", extra="allow"
    )


class LLMProfileConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    name: str
    model: str
    # Which API spec this profile speaks. "openai" (default) is the
    # provider-agnostic Chat Completions path via base_url; "anthropic" is the
    # native Anthropic Messages API (first-class thinking/effort). The anthropic
    # path needs harness/llm_anthropic.py + the `anthropic` dependency — both are
    # generated when a spec profile opts in (provider: anthropic).
    provider: Literal["openai", "anthropic"] = "openai"
    api_key_env: str = "OPENAI_API_KEY"
    base_url_env: str | None = None
    # Optional sampling knobs — only sent to the API when set (None = omit, so the
    # provider applies its own default, ~1.0 for chat models). Leave temperature
    # UNSET for reasoning models (GPT-5.x / o-series): they reject any temperature
    # and only accept it omitted.
    temperature: float | None = None
    max_tokens: int | None = Field(default=None, gt=0)
    # Reasoning depth for reasoning models (Chat Completions ``reasoning_effort``):
    # one of none/minimal/low/medium/high/xhigh (model-dependent). Only sent when
    # set; leave unset for non-reasoning models (they reject the parameter).
    reasoning_effort: str | None = None
    # More optional sampling knobs (all sent ONLY when set — unset = the provider's
    # own default). ``top_p`` is nucleus sampling (alter this OR temperature, not
    # both). ``frequency_penalty`` / ``presence_penalty`` (-2..2) curb repetition.
    # ``seed`` asks for more deterministic sampling. ``stop`` is up to a few stop
    # strings. Reasoning models / thinking mode ignore or reject most of these, so
    # leave them unset there.
    top_p: float | None = None
    frequency_penalty: float | None = None
    presence_penalty: float | None = None
    seed: int | None = None
    stop: str | list[str] | None = None
    # Escape hatch for NON-standard params your provider takes that aren't fields
    # above — e.g. Qwen/DashScope ``top_k`` / ``enable_thinking`` / ``thinking_budget``.
    # Merged verbatim into the request (OpenAI SDK ``extra_body`` / Anthropic
    # ``extra_body``). Values only — NEVER put secrets here (keys belong in .env).
    extra_body: dict[str, Any] = Field(default_factory=dict)
    # How a thinking model's reasoning is echoed back in history. Reasoning
    # endpoints that return reasoning alongside tool calls (MiMo / DeepSeek
    # thinking / Qwen / Kimi) REQUIRE that reasoning present on later turns or they
    # 400 — so the loop re-attaches it to tool-calling assistant messages under
    # this field name. Default ``reasoning_content`` fits those endpoints; some
    # vLLM builds want ``reasoning``. Set "" to disable passback for an endpoint
    # that rejects the field. An endpoint that emits no reasoning never gets it
    # back, so this is a no-op for plain (non-thinking) models. (Native Anthropic
    # profiles ignore this — they round-trip thinking blocks with their signature.)
    reasoning_history_field: str = "reasoning_content"
    # Cost accounting (price per 1,000,000 tokens, in your own currency — fill in
    # your local price). These drive the per-LLM spend shown on the Budget page and
    # the ``cost_limit`` stop; left 0 cost stays 0. ``cached_input_cost_per_million``
    # prices provider-cached (prompt-prefix) input tokens, usually much cheaper; left
    # 0 those tokens are billed at the full input price (no spurious discount).
    input_cost_per_million: float = 0.0
    output_cost_per_million: float = 0.0
    cached_input_cost_per_million: float = 0.0
    # Per-LLM cost ceiling (same currency as the prices above; 0 = no limit). Once
    # this profile's accrued cost across runs (see harness/usage.py — generation +
    # compaction) reaches it, the loop stops USING this LLM and tells the user to
    # clear its usage or raise the limit on the Budget page. Usage persists in
    # ``.harness/usage.json`` and only resets when you clear it by hand.
    cost_limit: float = Field(default=0.0, ge=0)
    # The model's total context window (input+output budget) in tokens. Optional:
    # set it to enable accurate ``window_pct`` compaction (compact at a fraction of
    # the window — see ``ContextConfig``). Left unset, percentage compaction is
    # skipped and the loop leans on overflow auto-rescue, so a large-window model is
    # never compacted too early. There is no reliable cross-provider way to
    # auto-detect this, so it stays a manual knob (you know your model).
    context_window: int | None = Field(default=None, gt=0)
    # Per-call reliability, passed straight to the SDK client. ``timeout_seconds``
    # caps a single request; ``max_retries`` retries transient 429/5xx with backoff
    # (None = the SDK's own default). ``fallback`` names ANOTHER profile to retry a
    # step with if the call errors before any output streamed — a thin failover;
    # a mid-stream break is not retried (its half-output already showed).
    timeout_seconds: float | None = Field(default=None, gt=0)
    max_retries: int | None = Field(default=None, ge=0)
    fallback: str | None = None


class PromptsConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    system: str | None = None
    # Always-apply project rules (the open AGENTS.md / CLAUDE.md / .cursor rules
    # pattern). Paths to markdown files whose text is injected into every system
    # prompt; a missing file is skipped. Runtime knob — edit without regenerating.
    rules_files: list[str] = Field(default_factory=list)


class ToolConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    name: str
    enabled: bool = True


class ContextConfig(BaseModel):
    """How to keep the message history within the model's context window.

    Runtime-only (lives here + in config.yaml, not in the spec). Two thin,
    extensible registries drive it (see ``harness/context.py``): *conditions*
    decide WHEN to compact, *strategies* decide HOW.

    - ``triggers`` maps a registered condition name to its threshold; ``combine``
      ("or"/"and") says whether ANY or ALL must fire. Built-in conditions:
      ``window_pct`` (real last-response prompt tokens as a FRACTION of the active
      profile's ``context_window`` — the accurate, usage-driven default; inactive
      until that profile sets a ``context_window``), ``max_tokens`` (an absolute
      token count — real usage when known, else a rough char estimate), and
      ``max_turns`` (user turns). Empty ``triggers`` = never compact (a plain loop).
    - ``strategy`` is a registered strategy name: ``truncate`` (keep system +
      recent turns), ``summarize`` (fold older turns via the ``compaction``
      role), or ``none`` (off). ``keep_last_turns`` = how many recent turns the
      strategy keeps; ``keep_last_steps`` additionally caps how many recent
      tool-rounds (one assistant tool-call + its results) survive, so a single long
      agentic turn can't grow the history without bound inside one user turn (the
      more aggressive of the two floors wins).
    - ``max_tool_result_chars`` caps a single tool result before it enters the
      history (the first gate against one huge observation blowing the window);
      the overflow is replaced with a ``[truncated N chars]`` marker so the model
      can narrow its query. 0 disables the cap.

    Add your own condition / strategy with ``@register_condition`` /
    ``@register_strategy`` and reference it by name here.
    """

    model_config = ConfigDict(extra="forbid")

    strategy: str = "summarize"  # registered strategy name, or "none"
    keep_last_turns: int = Field(default=6, ge=1)
    # Sub-turn floor: when compacting, also keep at most this many recent tool-rounds
    # (one assistant tool-call message + its tool results = one round). It decouples
    # compaction from the user-turn boundary so a single long agentic turn (one user
    # message, many tool rounds) can be folded mid-turn — without it the overflow
    # rescue is a guaranteed no-op inside one turn and the keep floor can sit above a
    # low token threshold forever. The more aggressive of the two floors wins.
    keep_last_steps: int = Field(default=8, ge=1)
    combine: Literal["or", "and"] = "or"
    # Thresholds are floats so window_pct (a 0–1 fraction) and absolute token counts
    # share one map. The default is usage-driven: compact at 85% of the model's
    # window — but only once a profile declares its context_window (else it's a
    # no-op and overflow auto-rescue is the safety net).
    triggers: dict[str, float] = Field(default_factory=lambda: {"window_pct": 0.85})
    max_tool_result_chars: int = Field(default=100_000, ge=0)  # ~25k tokens; 0 = off


class ObservabilityConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    trace: bool = True
    trace_dir: str = "traces"
    # Opt-in trace redaction (default off — full fidelity). When true, the JSONL
    # trace masks a tool call's ``arguments`` and a tool result's ``result`` with a
    # ``[redacted N chars]`` marker, so a secret passed as a tool argument (or echoed
    # in a result) never lands in ``traces/*.jsonl``. Tool names, counts, and timings
    # are kept. Turn it on for shared/retained traces; leave off for local debugging.
    redact_trace: bool = False
    # Opt-in local debug log (see ``harness/debuglog.py``): step/tool/LLM/config
    # lifecycle for troubleshooting. Local-only — never uploaded, and it records
    # names/counts/durations/error types, never message content or tool
    # arguments. Toggleable at runtime from the web /config Observability page.
    debug: bool = False
    debug_dir: str = "logs"


class SessionsConfig(BaseModel):
    """Where to persist resumable conversations (``run --continue`` / ``chat`` /
    web ``?session=``). Runtime-only (no spec field).

    When ``enabled`` (default), each run saves the conversation body to
    ``<dir>/<id>.json`` so a later ``--continue`` / ``--resume`` / web session
    picks it up. Only message text is stored — never secrets (keys stay in
    ``.env``). ``false`` = no persistence; runs stay single-shot.

    ``auto_title`` (web only): on a session's first turn, summarize the first
    message into a short title via the ``title`` role (falls back to
    ``generation``) for the web sidebar. The CLI never auto-titles.
    """

    model_config = ConfigDict(extra="forbid")

    enabled: bool = True
    dir: str = ".harness/sessions"
    auto_title: bool = True


class ParadigmsConfig(BaseModel):
    """Which loop paradigms are selectable at runtime, and which is the default.

    Runtime-only (lives here + config.yaml). ``enabled`` may list any registered
    paradigm — the built-ins generated into ``harness/paradigms/`` plus any you
    add yourself with ``@register_paradigm``. ``default`` is used when no
    ``--mode`` / dropdown choice is made and must be one of ``enabled``. You can
    only narrow within what was generated (you can't enable a paradigm whose file
    wasn't rendered) — that ceiling is set at generation time by ``spec.paradigms``.
    """

    model_config = ConfigDict(extra="forbid")

    enabled: list[str] = Field(default_factory=lambda: ["agent"])
    default: str = "agent"

    @model_validator(mode="before")
    @classmethod
    def _seed_default(cls, data: Any) -> Any:
        # If `default` is omitted, fall back to the first enabled paradigm.
        if isinstance(data, dict) and not data.get("default"):
            enabled = data.get("enabled") or ["agent"]
            if enabled:
                data = {**data, "default": enabled[0]}
        return data

    @model_validator(mode="after")
    def _default_in_enabled(self) -> "ParadigmsConfig":
        if not self.enabled:
            raise ValueError("paradigms.enabled must list at least one paradigm")
        if self.default not in self.enabled:
            raise ValueError(
                f"paradigms.default {self.default!r} must be one of enabled {self.enabled}"
            )
        return self


{% if spec.mcp.enabled %}
class McpServerConfig(BaseModel):
    """One MCP server. Set exactly one transport: ``command`` (stdio) or ``url``.

    Runtime-only (this slice adds no spec fields). Secrets are referenced by
    env-var NAME (``env`` / ``auth_env``), never stored as values.

    ``transport`` is optional and disambiguates a ``url`` server: ``http`` (the
    modern Streamable HTTP, default for a ``url``) or ``sse`` (the older HTTP+SSE
    transport — use it for servers that don't speak Streamable HTTP yet). When
    left unset it is inferred from shape (``command`` -> stdio, ``url`` -> http).
    """

    model_config = ConfigDict(extra="forbid")

    name: str
    description: str = ""  # human/agent-readable capability summary (for prompts/UX)
    # Transport selector (optional; inferred from shape when unset). ``sse`` is the
    # legacy HTTP+SSE transport kept for older remote servers.
    transport: Literal["stdio", "http", "sse"] | None = None
    # stdio transport (launched as a subprocess):
    command: str | None = None
    args: list[str] = Field(default_factory=list)
    env: list[str] = Field(default_factory=list)  # env-var NAMES to inject
    # remote (Streamable HTTP / SSE) transport:
    url: str | None = None
    auth_env: str | None = None  # env-var NAME holding a bearer token
    # Read-only / low-risk tool names (unprefixed). Tools listed here register as
    # risk="safe" (offered even to read-only paradigms like plan/ask); every other
    # discovered tool defaults to risk="high" (mutating; agent-only, opt-in).
    safe_tools: list[str] = Field(default_factory=list)

    @model_validator(mode="after")
    def _one_transport(self) -> "McpServerConfig":
        if bool(self.command) == bool(self.url):
            raise ValueError(
                f"mcp server {self.name!r} must set exactly one of "
                "`command` (stdio) or `url` (remote HTTP/SSE)"
            )
        if self.transport == "stdio" and not self.command:
            raise ValueError(f"mcp server {self.name!r}: transport 'stdio' requires `command`")
        if self.transport in ("http", "sse") and not self.url:
            raise ValueError(
                f"mcp server {self.name!r}: transport {self.transport!r} requires `url`"
            )
        return self

    @property
    def kind(self) -> str:
        """Resolved transport: explicit ``transport`` or inferred from shape."""
        return self.transport or ("stdio" if self.command else "http")


class McpConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    servers: list[McpServerConfig] = Field(default_factory=list)
    # Per-server startup timeout: a server that doesn't connect in time is skipped
    # (failure-isolated), so a slow/missing server never hangs a run. Generous by
    # default because a uvx/npx server's first launch can cold-download its package
    # (slow on Windows / behind the GFW).
    connect_timeout_seconds: float = Field(default=120.0, gt=0)
    # Per-CALL timeout: a single tool call that doesn't return in time fails with
    # a timeout ERROR the model can react to, instead of wedging the turn forever
    # (a hung server otherwise blocks Stop until the process is killed). Raise it
    # if a server's tools legitimately run longer.
    call_timeout_seconds: float = Field(default=120.0, gt=0)
    # How stdio servers that fetch their package (npx/uvx) reach the network. Left
    # empty, the harness auto-resolves: it reuses the system proxy and probes for a
    # reachable registry (official, else a domestic mirror). Set any of these to
    # override that choice (e.g. a corporate proxy / an internal registry mirror) —
    # values only, never secrets.
    proxy: str | None = None  # e.g. http://host:8080 ; default: the system proxy
    npm_registry: str | None = None  # npx/npm registry URL (default: auto)
    pip_index: str | None = None  # uvx/uv index URL, a PEP 503 simple index (default: auto)


