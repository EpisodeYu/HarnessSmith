{% endif %}{% if spec.memory.enabled %}class MemoryConfig(BaseModel):
    """Cross-session long-term memory (opt-in): a small self-maintained note the
    agent injects into every system prompt + read/write tools it calls.

    Runtime knobs (this slice's only spec field is ``memory.enabled``).
    ``backend`` names a registered backend (built-in: ``file`` — see
    ``harness/memory.py``; add your own with ``@register_memory``). ``path`` is the
    file backend's note (kept under ``.harness/``, gitignored, never holds
    secrets). ``inject_max_chars`` caps how much of the note is injected so memory
    stays thin (it is also the "oversized" mark for consolidation). ``read_only``
    offers only the read tool (the agent can't write).

    ``policy`` is an optional instruction (what/when to remember) injected with the
    memory section to shape HOW the agent curates memory — without editing the main
    system prompt. ``auto_consolidate`` (off by default) condenses an oversized note
    at a session boundary (CLI ``chat`` exit) via the ``memory`` role (the memory
    manager — see ``roles`` below, falls back to the first profile) — never in the
    reply hot path, so a quick reply or a weak generation model isn't affected.
    """

    model_config = ConfigDict(extra="forbid")

    backend: str = "file"
    path: str = ".harness/memory.md"
    inject_max_chars: int = Field(default=4000, gt=0)
    read_only: bool = False
    policy: str | None = None
    auto_consolidate: bool = False


{% endif %}
class HookConfig(BaseModel):
    """One mounted Hooks subclass — the list form of ``config.hooks``.

    ``class`` is the dotted ``package.module:ClassName`` path; ``enabled: false``
    keeps an entry in the file but skips mounting it; ``config`` is handed to the
    class constructor as ``ClassName(**config)`` so a hook can be parameterized
    from config.yaml (redact patterns, verbosity, ...). A hook that takes config
    must accept those keywords in ``__init__``. See ``harness/extensions.py``.
    """

    model_config = ConfigDict(extra="forbid", populate_by_name=True)

    class_path: str = Field(alias="class")
    enabled: bool = True
    config: dict[str, Any] = Field(default_factory=dict)


class Config(BaseModel):
    model_config = ConfigDict(extra="forbid")

    version: str = "0.1"
    project_slug: str = "agent_harness"
    llms: list[LLMProfileConfig] = Field(default_factory=list)
    roles: dict[str, str] = Field(default_factory=dict)
    prompts: PromptsConfig = Field(default_factory=PromptsConfig)
    tools: list[ToolConfig] = Field(default_factory=list)
    context: ContextConfig = Field(default_factory=ContextConfig)
    paradigms: ParadigmsConfig = Field(default_factory=ParadigmsConfig)
    observability: ObservabilityConfig = Field(default_factory=ObservabilityConfig)
    sessions: SessionsConfig = Field(default_factory=SessionsConfig)
    # Runtime extension points (no spec field). ``extensions`` lists dotted module
    # paths imported at startup so their ``@register_*`` run (custom tools /
    # paradigms / context conditions / memory backends living outside the
    # built-in files). ``hooks`` mounts one or more Hooks subclasses the CLI/web
    # apply automatically — logging / guardrails / tool gating / redaction / HITL
    # without editing the loop. Two shapes, both accepted:
    #   hooks: "package.module:ClassName"          # single, legacy string form
    #   hooks:                                      # list form (compose several)
    #     - class: "package.module:AuditHooks"
    #       enabled: true
    #       config: {redact_args: true}            # passed as ClassName(**config)
    #     - "package.module:MetricsHooks"          # a bare string also works
    # Listed hooks run in order; see ``harness/extensions.py`` / ``harness/hooks.py``.
    extensions: list[str] = Field(default_factory=list)
    hooks: str | list[str | HookConfig] | None = None
    # HITL tool confirmation (opt-in guardrail; default off). Which tools must
    # pause for the user's OK before they run: ``"none"`` (default — confirm
    # nothing, so the golden path is untouched), ``"high"`` (only ``risk="high"``
    # tools — shell / file-writes / other mutating tools), ``"all"`` (every tool,
    # read-only included), or an explicit list of tool names. A GUARDRAIL (a
    # trusted user fat-fingering a dangerous tool), NOT a security boundary — code
    # you own can bypass it; real isolation is Docker / not compiling a capability
    # in. Non-interactive runs (pipe / CI / ``--mock``) and a stopped/disconnected
    # web run reject by default (fail-closed). See ``harness/interaction.py``.
    confirm: str | list[str] = "none"
    # Agent-loop safety valve: a hard ceiling on tool-call steps (completed
    # tool-rounds) within a SINGLE turn, independent of cost. The default product
    # prices LLMs at 0, so ``cost_limit`` alone is no guard against a looping /
    # runaway model — once a turn reaches this many steps the loop stops cleanly at
    # the step boundary with a ``max_steps`` stop reason (continue the session to run
    # past it). 0 = unlimited (rely on ``cost_limit`` / Stop instead).
    max_steps: int = Field(default=50, ge=0)
{% if spec.mcp.enabled %}    mcp: McpConfig = Field(default_factory=McpConfig)
{% endif %}{% if spec.skills.enabled %}    skills: SkillsConfig = Field(default_factory=SkillsConfig)
{% endif %}{% if spec.memory.enabled %}    memory: MemoryConfig = Field(default_factory=MemoryConfig)
{% endif %}
    # Forward-compatible passthrough — declared so a richer spec still loads,
    # but not interpreted in this slice.
    rag: dict[str, Any] | None = None
    secrets: dict[str, Any] | None = None

    @model_validator(mode="before")
    @classmethod
    def _empty_sections_to_defaults(cls, data: Any) -> Any:
        if isinstance(data, dict):
            empties: dict[str, Any] = {
                "llms": [], "roles": {}, "tools": [],
                "prompts": {}, "context": {}, "paradigms": {},
                "observability": {}, "sessions": {},
                "extensions": [],
            }
            for key, default in empties.items():
                if key in data and data[key] is None:
                    data[key] = default
        return data

    @field_validator("confirm", mode="before")
    @classmethod
    def _check_confirm(cls, value: Any) -> Any:
        """Accept the keyword policies (``none``/``high``/``all``) or a list of tool
        names; coerce empty (``confirm:`` with no value) to ``"none"``. A bare
        string that isn't a keyword is rejected with a hint (use a list for a single
        tool name) so a typo can't silently disable confirmation."""
        if value is None:
            return "none"
        if isinstance(value, str):
            if value not in {"none", "high", "all"}:
                raise ValueError(
                    f"confirm must be 'none', 'high', 'all', or a list of tool "
                    f"names (got {value!r}; for one tool use a list: [{value!r}])"
                )
            return value
        if isinstance(value, (list, tuple)):
            return [str(x) for x in value]
        raise ValueError("confirm must be a keyword (none/high/all) or a list of tool names")

    def profile_for(self, role: str = "generation") -> LLMProfileConfig:
        """Return the LLM profile bound to ``role`` (single profile in Slice 1)."""
        name = self.roles.get(role)
        if name is None:
            if self.llms:
                return self.llms[0]
            raise ConfigError(f"no LLM profile configured for role {role!r}")
        for profile in self.llms:
            if profile.name == name:
                return profile
        raise ConfigError(f"role {role!r} points at unknown profile {name!r}")

    def enabled_tool_names(self) -> set[str]:
        """The allowlist: only these tools are offered to the model."""
        return {tool.name for tool in self.tools if tool.enabled}


def _env_file_values() -> dict[str, str]:
    try:
        return {key.upper(): str(value) for key, value in _EnvFile().model_dump().items()}
    except Exception:
        return {}


def resolve_env(name: str | None) -> str | None:
    """Resolve an env-var by NAME from the process env, then ``.env``."""
    if not name:
        return None
    if name in os.environ:
        return os.environ[name]
    return _env_file_values().get(name.upper())


_ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def set_env_value(name: str, value: str, env_path: str | Path = DEFAULT_ENV_FILE) -> None:
    """Write/update ``NAME=value`` in the local ``.env`` (gitignored).

    This is *write-only* secret storage: the value lives only in the local
    ``.env`` (never in ``config.yaml``, the trace, git, or any API response).
    Callers must never echo the value back. ``config.yaml`` keeps only the env-var
    NAME; this fills in its value so you don't have to set OS environment
    variables by hand (handy on Windows). One line, no newline injection.
    """
    if not _ENV_NAME_RE.match(name):
        raise ConfigError(
            f"invalid env-var name {name!r} (use letters, digits, underscores)"
        )
    value = value.replace("\r", "").replace("\n", "")
    path = Path(env_path)
    lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    prefix = f"{name}="
    for i, line in enumerate(lines):
        if line.startswith(prefix):
            lines[i] = f"{name}={value}"
            break
    else:
        lines.append(f"{name}={value}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def load_config(path: str | Path = DEFAULT_CONFIG_PATH) -> Config:
    """Load and validate ``config.yaml``.

    Also the single choke point that arms the opt-in local debug log from
    ``observability.debug`` — every entry point (CLI, web, your own scripts
    using ``load_config``) gets it without extra wiring.
    """
    from .debuglog import log, setup as setup_debug_log

    path = Path(path)
    if not path.exists():
        raise ConfigError(f"config file not found: {path}")
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        raise ConfigError("config.yaml must be a YAML mapping at the top level")
    config = Config.model_validate(data)
    obs = config.observability
    setup_debug_log(obs.debug, obs.debug_dir)
    log.debug(
        "config loaded from %s (profiles=%s roles=%s paradigms=%s tools=%d)",
        path, [p.name for p in config.llms], config.roles,
        config.paradigms.enabled, len(config.tools),
    )
{% if spec.mcp.enabled %}    log.debug("mcp servers configured: %s", [s.name for s in config.mcp.servers])
{% endif %}    return config


_CONFIRM_KEY_RE = re.compile(r"^confirm\s*:")


def persist_confirm(policy: str | list[str], path: str | Path = DEFAULT_CONFIG_PATH) -> bool:
    """Rewrite the top-level ``confirm:`` HITL policy in ``config.yaml`` in place.

    Used by an "always allow" decision to write a tool out of the confirmation
    policy. Stdlib-only and comment-safe (no ruamel needed, so it also works in
    CLI-only builds that don't ship the web extra): only the ``confirm:`` value
    line — plus any indented block-style continuation — is replaced; every comment
    and other key is left untouched. A list is written inline (``[a, b]``); a
    keyword is written as-is. Returns ``False`` (no write) when ``path`` is missing
    or has no ``confirm:`` key, so an in-memory-only config never spawns a file.
    """
    path = Path(path)
    if not path.exists():
        return False
    lines = path.read_text(encoding="utf-8").splitlines()
    start = next((i for i, ln in enumerate(lines) if _CONFIRM_KEY_RE.match(ln)), None)
    if start is None:
        return False
    # Drop the confirm: line plus any indented continuation (a block list/scalar).
    end = start + 1
    while end < len(lines) and lines[end][:1] in (" ", "\t"):
        end += 1
    rendered = policy if isinstance(policy, str) else "[" + ", ".join(policy) + "]"
    lines[start:end] = [f"confirm: {rendered}"]
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return True
{% if interfaces.web %}

def _deep_merge_into(target: Any, source: dict) -> None:
    """Update ``target`` (a ruamel round-trip mapping) in place from ``source``.

    Recurses into nested mappings so a scalar tweak keeps its neighbours' inline
    comments; lists and scalars are replaced wholesale (a list's leading comment
    stays, but per-item inline comments on a rewritten list are not preserved).
    """
    for key, value in source.items():
        if key in target and isinstance(value, dict) and hasattr(target[key], "items"):
            _deep_merge_into(target[key], value)
        else:
            target[key] = value


def save_config(updates: dict, path: str | Path = DEFAULT_CONFIG_PATH) -> bool:
    """Write ``updates`` (a subset of config fields) back to ``config.yaml``.

    Used by the web ``/config`` panel so a Save persists to disk instead of only
    living in the running process. Uses a comment-preserving YAML round-trip
    (``ruamel.yaml``): the file's comments and the commented-out example knobs are
    kept; only the given top-level keys are merged in. ``updates`` must hold no
    secrets — the panel passes only env-var NAMES (never key values). Returns
    ``False`` (no write) when ``path`` doesn't exist, so callers given an
    in-memory-only config (e.g. tests) never create a stray file. The import is
    local because ``ruamel.yaml`` ships only with the web interface.
    """
    path = Path(path)
    if not path.exists():
        return False
    from ruamel.yaml import YAML

    yaml_rt = YAML()
    yaml_rt.preserve_quotes = True
    data = yaml_rt.load(path.read_text(encoding="utf-8")) or {}
    _deep_merge_into(data, updates)
    with path.open("w", encoding="utf-8") as handle:
        yaml_rt.dump(data, handle)
    return True
{% endif %}
