"""Standard Agent Skills support (generated only when ``skills.enabled``).

Implements the open **Agent Skills** standard (``SKILL.md`` + progressive
disclosure) — the same ``skills/<name>/SKILL.md`` works with Claude, Cursor, and
other Agent Skills tools. No framework: it is prompt text + a file read.

- **L1 discover + inject**: scan the configured dirs for ``*/SKILL.md``, parse
  the YAML frontmatter (``name`` / ``description`` / optional
  ``disable-model-invocation``), and inject each model-invocable skill's
  name + description into the system prompt (~100 tokens each) via ``prompts.py``.
- **L2 load body**: the model reads the full ``SKILL.md`` on demand — with a file
  tool (e.g. the MCP baseline) or the built-in :func:`read_skill` tool here.
- **L3 scripts/resources**: the model runs ``scripts/`` and reads
  ``references/``/``assets/`` with shell/file tools (no harness code); scripts are
  high-risk and off by default.
"""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
from typing import TYPE_CHECKING

import yaml

from .tools import SAFE, registry

if TYPE_CHECKING:
    from .config import Config

SKILL_FILE = "SKILL.md"

# The config of the current run; set by ``activate_skills`` so the registered
# read_skill tool (a plain function) can honor the configured skill dirs.
_ACTIVE_CONFIG: "Config | None" = None


@dataclass
class Skill:
    name: str
    description: str
    path: Path  # the SKILL.md file
    model_invocable: bool = True


def _parse_frontmatter(text: str) -> tuple[dict, str]:
    """Split a SKILL.md into ``(frontmatter, body)``; tolerate a missing header."""
    if text.startswith("---"):
        parts = text.split("---", 2)
        if len(parts) == 3:
            meta = yaml.safe_load(parts[1]) or {}
            return (meta if isinstance(meta, dict) else {}), parts[2].lstrip("\n")
    return {}, text


def discover_skills(config: "Config") -> list[Skill]:
    """Find every ``<dir>/<name>/SKILL.md`` under the configured skill dirs."""
    skills: list[Skill] = []
    seen: set[str] = set()
    for directory in config.skills.dirs:
        base = Path(directory)
        if not base.is_dir():
            continue
        for skill_md in sorted(base.glob("*/" + SKILL_FILE)):
            meta, _ = _parse_frontmatter(skill_md.read_text(encoding="utf-8"))
            name = str(meta.get("name") or skill_md.parent.name)
            if name in seen:
                continue
            seen.add(name)
            skills.append(
                Skill(
                    name=name,
                    description=str(meta.get("description") or "").strip(),
                    path=skill_md,
                    model_invocable=not bool(meta.get("disable-model-invocation", False)),
                )
            )
    return skills


def build_skills_prompt(config: "Config") -> str:
    """L1 system-prompt section: list model-invocable skills + how to load them."""
    skills = [s for s in discover_skills(config) if s.model_invocable]
    if not skills:
        return ""
    lines = [
        "You have access to these Skills. When one is relevant, first read its "
        "full instructions with the read_skill tool (or a file tool), then follow "
        "them:"
    ]
    lines += [f"- {s.name}: {s.description}" for s in skills]
    return "\n".join(lines)


def load_skill_body(config: "Config", name: str) -> str:
    """Return the ``SKILL.md`` body for ``name`` (used by read_skill and /name)."""
    for skill in discover_skills(config):
        if skill.name == name:
            _, body = _parse_frontmatter(skill.path.read_text(encoding="utf-8"))
            return body
    return f"ERROR: no skill named {name!r}"


def activate_skills(config: "Config") -> None:
    """Remember the run's config so read_skill can resolve the skill dirs."""
    global _ACTIVE_CONFIG
    _ACTIVE_CONFIG = config


@registry.tool(
    name="read_skill",
    description="Read the full instructions (SKILL.md body) of an available skill by name.",
    parameters={
        "type": "object",
        "properties": {"name": {"type": "string", "description": "The skill name."}},
        "required": ["name"],
        "additionalProperties": False,
    },
    risk=SAFE,
)
def read_skill(name: str) -> str:
    if _ACTIVE_CONFIG is None:
        return "ERROR: skills are not initialized for this run"
    return load_skill_body(_ACTIVE_CONFIG, name)
