"""Context-window management: keep the message history within budget.

Applied before each LLM call. Two thin name->function registries drive it (the
same shape as tools / paradigms — a written-out dispatch, not an engine):

- a *condition* decides WHEN to compact. ``config.yaml``'s ``triggers`` maps a
  registered condition name to its threshold; ``combine`` ("or"/"and") says
  whether ANY or ALL of them must fire. Built-ins: ``max_tokens`` (estimated
  prompt tokens) and ``max_turns`` (user turns).
- a *strategy* decides HOW to compact. ``truncate`` keeps the system message
  plus the last ``keep_last_turns`` turns; ``summarize`` folds the older turns
  into a ``compaction``-role summary; ``none`` is off.

Add your own with ``@register_condition`` / ``@register_strategy`` and reference
it by name in ``config.yaml``. With ``strategy: none`` or empty ``triggers`` it
is a no-op, so the default matches a plain loop. Cheap and editable — no
tokenizer dep.
"""

from __future__ import annotations

import inspect
from collections.abc import Callable
from dataclasses import dataclass
from typing import TYPE_CHECKING

from .config import ContextConfig
from .debuglog import log
from .llm import LLMClient

if TYPE_CHECKING:
    from .config import Config
    from .llm import LLMResponse
    from .trace import Trace

_SUMMARY_PROMPT = (
    "Summarize the earlier conversation below concisely, preserving facts, "
    "decisions, and any open tasks. If an existing summary is included, merge it "
    "with the newer messages into a SINGLE cohesive summary. Output only the summary."
)

# A compaction summary note is a system message starting with this marker. Tagging
# it lets a later compaction find the prior note and fold it into ONE merged note
# instead of stacking a fresh note every time (which would grow without bound).
_SUMMARY_NOTE_PREFIX = "Summary of earlier conversation:"


def _is_summary_note(message: dict) -> bool:
    """Whether ``message`` is a compaction summary note (so it can be merged, not
    stacked, on the next compaction)."""
    return message.get("role") == "system" and str(
        message.get("content") or ""
    ).startswith(_SUMMARY_NOTE_PREFIX)


@dataclass
class ContextInfo:
    """Live signals a condition may consult beyond the raw messages.

    ``last_prompt_tokens`` is the prompt-token count the provider reported on the
    PREVIOUS response — the exact, usage-driven number (0 before the first call,
    where a char estimate fills in). ``context_window`` is the active generation
    profile's total window, when it declared one (else ``None``).
    """

    last_prompt_tokens: int = 0
    context_window: int | None = None


# A condition answers "should we compact now?". Built-ins take ``(messages,
# threshold, info)`` to use real usage; an older 2-arg ``(messages, threshold)``
# custom condition still works (the dispatcher only passes ``info`` when accepted),
# so the extension contract stays backward-compatible. A strategy rewrites the
# messages to fit (and may use the optional summarizer client).
Condition = Callable[..., bool]
Strategy = Callable[..., list[dict]]

CONDITIONS: dict[str, Condition] = {}
STRATEGIES: dict[str, Strategy] = {}


def register_condition(name: str) -> Callable[[Condition], Condition]:
    """Register a trigger condition under ``name`` (referenced in `triggers`)."""

    def decorator(fn: Condition) -> Condition:
        CONDITIONS[name] = fn
        return fn

    return decorator


def register_strategy(name: str) -> Callable[[Strategy], Strategy]:
    """Register a compaction strategy under ``name`` (referenced by `strategy`)."""

    def decorator(fn: Strategy) -> Strategy:
        STRATEGIES[name] = fn
        return fn

    return decorator


def estimate_tokens(messages: list[dict]) -> int:
    """Rough token estimate (~4 chars/token) — good enough to trigger trimming."""
    total = 0
    for message in messages:
        total += len(str(message.get("content") or "")) // 4 + 4
        # A tool-calling assistant's reasoning rides in history (reasoning models
        # require it echoed back) and counts toward the prompt size.
        total += len(str(message.get("reasoning_content") or "")) // 4
        for call in message.get("tool_calls") or []:
            args = call.get("function", {}).get("arguments") or ""
            total += len(str(args)) // 4
    return total


def count_turns(messages: list[dict]) -> int:
    """Number of user turns in the history (system messages don't count)."""
    return sum(1 for m in messages if m.get("role") == "user")


@register_condition("max_tokens")
def _cond_max_tokens(messages: list[dict], threshold: float, info: ContextInfo | None = None) -> bool:
    """Absolute token trigger — the provider's real last prompt_tokens when known,
    a char estimate only as a first-call fallback."""
    tokens = info.last_prompt_tokens if (info and info.last_prompt_tokens) else estimate_tokens(messages)
    return tokens > threshold


@register_condition("window_pct")
def _cond_window_pct(messages: list[dict], threshold: float, info: ContextInfo | None = None) -> bool:
    """Usage-driven trigger: compact when the prompt fills ``threshold`` (0–1) of
    the model's context window. Inactive (never fires) until the active profile
    declares a ``context_window`` — so a large-window model is never compacted too
    early. Uses real prompt_tokens once known, a char estimate on the first call."""
    if not info or not info.context_window:
        return False
    tokens = info.last_prompt_tokens or estimate_tokens(messages)
    return tokens / info.context_window >= threshold


@register_condition("max_turns")
def _cond_max_turns(messages: list[dict], threshold: float) -> bool:
    return count_turns(messages) > threshold


def _round_start_indices(rest: list[dict]) -> list[int]:
    """Indices in ``rest`` of each assistant message that OPENS a tool-round (it has
    ``tool_calls``); its tool results follow until the next such message. These are
    the legal sub-turn cut points — cutting here never separates a tool result from
    the assistant tool_calls it answers."""
    return [
        i
        for i, m in enumerate(rest)
        if m.get("role") == "assistant" and m.get("tool_calls")
    ]


def _split_for_compaction(messages: list[dict], keep_last_turns: int, keep_last_steps: int):
    """Split into (system, dropped, kept), keeping the most recent tail bounded by
    BOTH floors — at most ``keep_last_turns`` user turns AND at most
    ``keep_last_steps`` tool-rounds — whichever cuts MORE.

    The round floor decouples compaction from the user-turn boundary: a single long
    agentic turn (one user message, many tool rounds) can be folded mid-turn, so the
    overflow rescue's ``force`` pass is never a guaranteed no-op and the keep floor
    can't sit above a low token threshold forever.

    Kept messages are the same dict objects (never rebuilt), so a tool-calling
    assistant keeps its ``reasoning_content`` carrier — reasoning endpoints 400 if
    that is stripped from a surviving tool-call message. The cut always lands on a
    legal boundary (a user message or an assistant that opens a round); any orphan
    leading tool result is dropped so a tool result never precedes its tool_calls.
    """
    system = [m for m in messages if m.get("role") == "system"]
    rest = [m for m in messages if m.get("role") != "system"]

    # Turn floor: start of the last `keep_last_turns` user turns (lower index keeps
    # more); 0 when there aren't that many turns.
    seen = 0
    turn_cut = 0
    for i in range(len(rest) - 1, -1, -1):
        if rest[i].get("role") == "user":
            seen += 1
            if seen >= keep_last_turns:
                turn_cut = i
                break

    # Round floor: start of the last `keep_last_steps` tool-rounds; 0 when fewer.
    rounds = _round_start_indices(rest)
    step_cut = rounds[-keep_last_steps] if len(rounds) > keep_last_steps else 0

    cut = max(turn_cut, step_cut)  # the more recent boundary => the smaller tail
    kept = rest[cut:]
    # Never open the kept block on an orphan tool result (its tool_calls were dropped).
    while kept and kept[0].get("role") == "tool":
        kept = kept[1:]
    dropped = rest[: len(rest) - len(kept)]
    return system, dropped, kept


@register_strategy("none")
def _strategy_none(
    messages: list[dict], ctx: ContextConfig, *, summarizer: LLMClient | None = None
) -> list[dict]:
    return messages


@register_strategy("truncate")
def _strategy_truncate(
    messages: list[dict], ctx: ContextConfig, *, summarizer: LLMClient | None = None
) -> list[dict]:
    system, dropped, kept = _split_for_compaction(
        messages, ctx.keep_last_turns, ctx.keep_last_steps
    )
    if not dropped:
        return messages
    return system + kept


@register_strategy("summarize")
def _strategy_summarize(
    messages: list[dict], ctx: ContextConfig, *, summarizer: LLMClient | None = None
) -> list[dict]:
    system, dropped, kept = _split_for_compaction(
        messages, ctx.keep_last_turns, ctx.keep_last_steps
    )
    if not dropped:
        return messages
    if summarizer is None:  # no compaction client wired -> fall back to truncate
        return system + kept
    # Fold any EXISTING summary note(s) together with the newly dropped messages into
    # ONE merged note, so the summary stack stays O(1) instead of growing one note
    # per compaction (an old note otherwise survives in `system` and accrues forever).
    real_system = [m for m in system if not _is_summary_note(m)]
    prior_notes = [m for m in system if _is_summary_note(m)]
    convo = [{"role": "system", "content": _SUMMARY_PROMPT}]
    convo += [{"role": "user", "content": m["content"]} for m in prior_notes]
    convo += dropped
    summary = summarizer.complete(convo, None).content or ""
    note = {"role": "system", "content": f"{_SUMMARY_NOTE_PREFIX}\n{summary}"}
    return real_system + [note] + kept


class _AccountingSummarizer:
    """Wrap the compaction client so its summary call lands in the trace + budget.

    Context summarization is a real LLM call; without this its tokens/cost would
    escape the run totals (and any token / cost budget). Each call's usage is
    recorded to the trace under the compaction profile and a ``compaction`` event
    is emitted, then the response is returned unchanged.
    """

    def __init__(self, client: LLMClient, trace: "Trace", profile) -> None:
        self._client = client
        self._trace = trace
        self._profile = profile

    def _account(self, response: "LLMResponse") -> "LLMResponse":
        if self._trace is not None and self._profile is not None:
            self._trace.add_usage(response.usage, self._profile)
            self._trace.event(
                "compaction",
                prompt_tokens=response.usage.prompt_tokens,
                completion_tokens=response.usage.completion_tokens,
            )
        return response

    def _check_budget(self) -> None:
        # Per-LLM cost limit: refuse to compact with an over-budget compaction LLM.
        # Raises LLMBudgetExceeded (the paradigm turns it into a clean llm_budget
        # stop) — same gate the generation profile gets before its own call.
        ledger = getattr(self._trace, "ledger", None) if self._trace is not None else None
        if ledger is not None and self._profile is not None:
            ledger.ensure_within(self._profile)

    def complete(self, messages: list[dict], tools: list[dict] | None = None) -> "LLMResponse":
        self._check_budget()
        return self._account(self._client.complete(messages, tools))

    def stream(self, messages, tools=None, *, on_delta=None) -> "LLMResponse":
        self._check_budget()
        return self._account(self._client.stream(messages, tools, on_delta=on_delta))


def make_summarizer(
    client_for: Callable[[str], LLMClient] | None,
    config: "Config",
    ctx: ContextConfig,
    trace: "Trace | None" = None,
) -> LLMClient | None:
    """Build the compaction client for ``summarize`` (``None`` for other strategies).

    Its usage is recorded to ``trace`` under the ``compaction`` profile, so a
    summarize call shows up in the trace and counts toward the token / cost budget.
    With no ``compaction`` role configured it falls back to the generation profile
    (it summarizes with that model) — same client either way.
    """
    if client_for is None or ctx.strategy != "summarize":
        return None
    client = client_for("compaction")
    if trace is None:
        return client
    return _AccountingSummarizer(client, trace, config.profile_for("compaction"))


def _accepts_info(fn: Condition) -> bool:
    """Whether a condition takes the ``info`` arg (3rd positional, named ``info``,
    or ``*args``/``**kwargs``). Older 2-arg conditions are called without it, so the
    extension contract stays backward-compatible."""
    try:
        params = inspect.signature(fn).parameters
    except (TypeError, ValueError):
        return False
    if "info" in params:
        return True
    positional = 0
    for param in params.values():
        if param.kind in (param.VAR_POSITIONAL, param.VAR_KEYWORD):
            return True
        if param.kind in (param.POSITIONAL_ONLY, param.POSITIONAL_OR_KEYWORD):
            positional += 1
    return positional >= 3


def should_compact(
    messages: list[dict], ctx: ContextConfig, *, info: ContextInfo | None = None
) -> bool:
    """Evaluate the configured trigger conditions, combined by ``ctx.combine``.

    ``info`` carries the real last-response usage + the model's context window for
    usage-driven conditions (built-ins use it; legacy 2-arg conditions don't).
    Unknown condition names (a typo, or a custom one not imported) are skipped.
    With no recognized triggers this is ``False`` (never compact).
    """
    info = info or ContextInfo()
    hits: list[bool] = []
    for name, threshold in ctx.triggers.items():
        fn = CONDITIONS.get(name)
        if fn is None:
            continue
        hits.append(fn(messages, threshold, info) if _accepts_info(fn) else fn(messages, threshold))
    if not hits:
        return False
    return all(hits) if ctx.combine == "and" else any(hits)


def fit(
    messages: list[dict],
    ctx: ContextConfig,
    *,
    summarizer: LLMClient | None = None,
    last_prompt_tokens: int = 0,
    context_window: int | None = None,
    force: bool = False,
    config=None,
) -> list[dict]:
    """Return ``messages`` compacted to fit ``ctx`` (no-op unless triggered).

    ``last_prompt_tokens`` / ``context_window`` feed the usage-driven conditions
    (the real prompt size from the previous response + the model's window).
    ``force`` skips the trigger check and compacts now — used by the overflow
    auto-rescue after the API rejected an over-long request.
    """
    strategy = STRATEGIES.get(ctx.strategy)
    if ctx.strategy == "none" or strategy is None:
        return messages
    info = ContextInfo(last_prompt_tokens=last_prompt_tokens, context_window=context_window)
    if not force and not should_compact(messages, ctx, info=info):
        return messages
{% if spec.memory.enabled %}    # Let long-term memory rescue insight from the turns about to be dropped,
    # before the strategy discards/summarizes them (no-op unless a backend hooks it).
    if config is not None:
        _, dropped, _ = _split_for_compaction(messages, ctx.keep_last_turns, ctx.keep_last_steps)
        if dropped:
            from .memory import compact_rescue

            compact_rescue(config, dropped)
{% endif %}    fitted = strategy(messages, ctx, summarizer=summarizer)
    # A pass that didn't shrink the estimated size is a true no-op: the history is
    # already at the keep floor (nothing older than keep_last_turns / keep_last_steps
    # to drop). Outside the forced overflow rescue, return the original untouched and
    # stay quiet, so a trigger threshold sitting below the keep floor can't spin the
    # loop on pointless "N -> N" compactions every step. The forced path always adopts
    # what it produced — it is the last resort before re-raising an overflow.
    if not force and estimate_tokens(fitted) >= estimate_tokens(messages):
        return messages
    if fitted is not messages:
        log.debug(
            "context: %s compacted %d -> %d messages", ctx.strategy, len(messages), len(fitted)
        )
    return fitted
