"""Tool registry: register a function, expose it to the model — no loop changes.

A tool = a Python function + a JSON-schema description + a risk level. Adding a
tool is ``@registry.tool(...)`` over a function; the loop discovers it
automatically. Risky tools (shell, file writes) are NEVER on by default: a tool
is only offered to the model if it is enabled in ``config.yaml`` (the allowlist).
The two built-ins below are safe and read-only.
"""

from __future__ import annotations

import json
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Any, Callable

SAFE = "safe"
HIGH = "high"


def in_allowlist(name: str, enabled: set[str]) -> bool:
    """Whether ``name`` is allowlisted, honoring ``<server>__*`` MCP wildcards.

    A wildcard entry (e.g. ``git__*``) enables EVERY tool from that MCP server, so
    a server's full toolset is offered without listing each tool by name (and newly
    discovered tools are picked up automatically). Plain names match exactly.
    """
    if name in enabled:
        return True
    server, sep, _ = name.partition("__")
    return bool(sep) and f"{server}__*" in enabled


class ToolError(Exception):
    """Raised for unknown tools or bad arguments."""


@dataclass
class Tool:
    name: str
    description: str
    parameters: dict
    func: Callable[..., Any]
    risk: str = SAFE

    def schema(self) -> dict:
        """OpenAI ``tools`` entry for this tool."""
        return {
            "type": "function",
            "function": {
                "name": self.name,
                "description": self.description,
                "parameters": self.parameters,
            },
        }


class Registry:
    def __init__(self) -> None:
        self._tools: dict[str, Tool] = {}

    def register(self, tool: Tool) -> None:
        self._tools[tool.name] = tool

    def unregister(self, name: str) -> None:
        """Drop a tool by name if present (no error if it isn't)."""
        self._tools.pop(name, None)

    def remove_where(self, predicate: Callable[[str], bool]) -> None:
        """Drop every registered tool whose name matches ``predicate``.

        Used to re-sync a dynamic tool source (e.g. MCP) into the registry: clear
        its previous entries, then re-register the current set.
        """
        for name in [n for n in self._tools if predicate(n)]:
            del self._tools[name]

    def tool(
        self,
        *,
        name: str | None = None,
        description: str = "",
        parameters: dict | None = None,
        risk: str = SAFE,
    ) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
        """Decorator that registers the wrapped function as a tool."""

        def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
            self.register(
                Tool(
                    name=name or func.__name__,
                    description=description or (func.__doc__ or "").strip(),
                    parameters=parameters or {"type": "object", "properties": {}},
                    func=func,
                    risk=risk,
                )
            )
            return func

        return decorator

    def names(self) -> list[str]:
        """Every registered tool name (built-ins + extensions). MCP tools appear
        only after their server connects at runtime, so a diagnostic like ``info``
        that starts no manager won't see them here."""
        return list(self._tools)

    def get(self, name: str) -> Tool:
        if name not in self._tools:
            raise ToolError(f"unknown tool: {name}")
        return self._tools[name]

    def active_names(self, enabled: set[str], *, allow_high_risk: bool = True) -> list[str]:
        """Tools offered to the model: registered AND allowlisted in config.

        With ``allow_high_risk=False`` (used by read-only paradigms like plan/ask)
        any tool marked ``risk="high"`` is dropped, so the model is never even
        offered a mutating tool.
        """
        return [
            name
            for name, tool in self._tools.items()
            if in_allowlist(name, enabled) and (allow_high_risk or tool.risk != HIGH)
        ]

    def schemas(self, names: list[str]) -> list[dict]:
        return [self._tools[name].schema() for name in names if name in self._tools]

    def risk_of(self, name: str) -> str:
        """The tool's risk level (``HIGH`` for an unknown name — the safe default)."""
        tool = self._tools.get(name)
        return tool.risk if tool is not None else HIGH

    def confirm_names(self, policy: str | list[str] | None) -> set[str]:
        """Tool names that need HITL confirmation under ``policy`` (``config.confirm``).

        Fail-closed by allowlist, not by per-call risk scoring: ``"none"`` / empty
        confirms nothing (default); ``"all"`` confirms every registered tool
        (read-only included); ``"high"`` confirms ``risk="high"`` tools (shell /
        file-writes / other mutating tools); a list confirms exactly the named tools.
        The execution boundary (``run_tool``) consults this set, so a tool not
        offered in the current mode never reaches confirmation anyway.
        """
        if not policy or policy == "none":
            return set()
        if policy == "all":
            return set(self._tools)
        if policy == "high":
            return {n for n, t in self._tools.items() if t.risk == HIGH}
        if isinstance(policy, (list, tuple, set)):
            wanted = {str(x) for x in policy}
            return {n for n in self._tools if n in wanted}
        return set()

    def call(self, name: str, arguments: str) -> str:
        """Execute a tool by name with JSON-encoded arguments; return a string."""
        tool = self.get(name)
        try:
            kwargs = json.loads(arguments) if arguments else {}
        except json.JSONDecodeError as exc:
            raise ToolError(f"invalid JSON arguments for {name!r}: {exc}") from exc
        result = tool.func(**kwargs)
        return result if isinstance(result, str) else json.dumps(result)


registry = Registry()


@registry.tool(
    name="get_current_time",
    description="Return the current UTC date and time in ISO 8601 format.",
    parameters={"type": "object", "properties": {}, "additionalProperties": False},
)
def get_current_time() -> str:
    return datetime.now(timezone.utc).isoformat()


@registry.tool(
    name="calculator",
    description="Evaluate a basic arithmetic expression, e.g. '2 * (3 + 4)'.",
    parameters={
        "type": "object",
        "properties": {
            "expression": {"type": "string", "description": "Arithmetic expression."}
        },
        "required": ["expression"],
        "additionalProperties": False,
    },
)
def calculator(expression: str) -> str:
    import ast
    import operator

    ops = {
        ast.Add: operator.add,
        ast.Sub: operator.sub,
        ast.Mult: operator.mul,
        ast.Div: operator.truediv,
        ast.Pow: operator.pow,
        ast.Mod: operator.mod,
        ast.USub: operator.neg,
        ast.UAdd: operator.pos,
    }

    def evaluate(node: ast.AST) -> float:
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in ops:
            return ops[type(node.op)](evaluate(node.left), evaluate(node.right))
        if isinstance(node, ast.UnaryOp) and type(node.op) in ops:
            return ops[type(node.op)](evaluate(node.operand))
        raise ToolError(f"unsupported expression: {expression!r}")

    return str(evaluate(ast.parse(expression, mode="eval").body))


@registry.tool(
    name="ask_question",
    description=(
        "Pause and ask the END USER a clarifying question, then return their "
        "answer. Use this when the request is ambiguous or a decision is genuinely "
        "the user's to make (which option, which file, confirm an assumption) — "
        "prefer it over guessing on consequential choices. Do NOT use it for things "
        "you can determine yourself. Offer `options` for a multiple-choice question "
        "(set allow_multiple to let them pick several), or omit them for a free-text "
        "one. The user can ALWAYS type a custom answer (an 'Other' free-text choice "
        "is offered automatically), so do NOT add your own 'Other'/'something else' "
        "option. If no interactive user is available the answer says so and you "
        "should proceed on your best judgment."
    ),
    parameters={
        "type": "object",
        "properties": {
            "question": {
                "type": "string",
                "description": "The question to put to the user.",
            },
            "options": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Optional choices to offer. Omit for a free-text question.",
            },
            "allow_multiple": {
                "type": "boolean",
                "description": "Allow selecting more than one option.",
            },
        },
        "required": ["question"],
        "additionalProperties": False,
    },
    risk=SAFE,
)
def ask_question(
    question: str,
    options: list | None = None,
    allow_multiple: bool = False,
) -> str:
    """Ask the user via the shared interaction channel; format their reply for the
    model. The actual UI (terminal prompt / web card) is whatever asker the entry
    point bound for this turn; with none (pipe / CI / --mock) it degrades to a
    "no user available" answer so the loop never hangs.

    Free text is always allowed (a Cursor-style "Other" escape), so the user is
    never trapped into picking only from ``options``."""
    from .interaction import AskRequest, Option, ask

    labels = [str(opt) for opt in (options or [])]
    offered = [Option(id=str(i), label=label) for i, label in enumerate(labels)]
    response = ask(
        AskRequest(
            kind="question",
            prompt=question,
            options=offered,
            allow_text=True,
            allow_multiple=bool(allow_multiple),
        )
    )
    by_id = {opt.id: opt.label for opt in offered}
    if response.option_ids:
        chosen = ", ".join(by_id.get(i, i) for i in response.option_ids)
        result = f"User selected: {chosen}"
        if response.text:
            result += f"\nUser also said: {response.text}"
        return result
    if response.text:
        return f"User answered: {response.text}"
    return "User skipped the question (no answer given)."


_TODO_MARKS = {"pending": "[ ]", "in_progress": "[~]", "completed": "[x]"}


@registry.tool(
    name="write_todos",
    description=(
        "Lay out and update your task list for a multi-step request, then get it "
        "back rendered. Pass the FULL list every call (it REPLACES the previous "
        "one). Plan a non-trivial task up front, then keep the list current as you "
        "work: keep exactly ONE item in_progress, flip it to completed the moment "
        "it's done, and add follow-ups you discover. Skip it for a trivial one-step "
        "request. This is a scratchpad that keeps you on track over a long task — it "
        "has no side effects."
    ),
    parameters={
        "type": "object",
        "properties": {
            "todos": {
                "type": "array",
                "description": "The complete task list (replaces any earlier one).",
                "items": {
                    "type": "object",
                    "properties": {
                        "content": {
                            "type": "string",
                            "description": "What the step is, as a short imperative.",
                        },
                        "status": {
                            "type": "string",
                            "enum": ["pending", "in_progress", "completed"],
                            "description": "Current state of the step.",
                        },
                    },
                    "required": ["content", "status"],
                    "additionalProperties": False,
                },
            }
        },
        "required": ["todos"],
        "additionalProperties": False,
    },
    risk=SAFE,
)
def write_todos(todos: list | None = None) -> str:
    """Validate + render the task list the model passed, then echo it back.

    Stateless on purpose: the list lives in the conversation itself (this call's
    arguments + result), which is exactly where the model re-reads it next step.
    So it survives a resume, never leaks between concurrent web sessions, and
    needs no storage — a thin "attention control" scratchpad, not a workflow
    engine. An unknown status degrades to ``pending`` rather than erroring."""
    items = list(todos or [])
    if not items:
        return "Todo list cleared (no items)."
    counts = {"pending": 0, "in_progress": 0, "completed": 0}
    lines: list[str] = []
    for item in items:
        content = str((item or {}).get("content", "")).strip()
        status = str((item or {}).get("status", "pending")).strip()
        if status not in _TODO_MARKS:
            status = "pending"
        counts[status] += 1
        lines.append(f"{_TODO_MARKS[status]} {content}")
    header = f"Todo list ({counts['completed']}/{len(items)} done"
    if counts["in_progress"]:
        header += f", {counts['in_progress']} in progress"
    header += "):"
    return header + "\n" + "\n".join(lines)
