"""LLM client: OpenAI SDK over Chat Completions (provider-agnostic via base_url).

The loop talks to a tiny provider-neutral interface (``LLMClient``) returning
plain dataclasses, so the same loop runs against any OpenAI-compatible endpoint
— or the built-in ``MockLLM`` for offline tests and smoke runs. Chat Completions
+ ``tools`` is deliberate: it is the API third-party / local endpoints actually
implement (vLLM, together, groq, ...).
"""

from __future__ import annotations

import time
from collections.abc import Callable
from dataclasses import dataclass, field
from typing import Any, Protocol

from .config import Config, LLMProfileConfig, resolve_env
from .debuglog import log


@dataclass
class Usage:
    prompt_tokens: int = 0
    completion_tokens: int = 0
    total_tokens: int = 0
    # Optional breakdowns some providers report (0 when not sent): how many prompt
    # tokens were served from the provider's prompt cache (billed cheaper), and how
    # many completion tokens the model spent on hidden reasoning. Used for billing
    # accuracy (cached) and visibility (reasoning); never required by the loop.
    cached_prompt_tokens: int = 0
    reasoning_tokens: int = 0


@dataclass
class ToolCall:
    id: str
    name: str
    arguments: str  # raw JSON string as returned by the model


@dataclass
class LLMResponse:
    content: str | None = None
    tool_calls: list[ToolCall] = field(default_factory=list)
    usage: Usage = field(default_factory=Usage)
    # The model's reasoning / chain-of-thought when a thinking model produced one
    # (OpenAI-compatible ``reasoning_content``; native Anthropic thinking block).
    # It is NOT answer text — UIs show it via the thinking channel, never in
    # ``content``. It is carried so it can be echoed back on later turns: reasoning
    # endpoints (MiMo / DeepSeek thinking / Qwen / Kimi) REQUIRE the reasoning that
    # accompanied a tool call to be present in history or they reject the next
    # request. ``reasoning_signature`` is the opaque token native Anthropic returns
    # on a thinking block (it must round-trip unchanged with the block); empty for
    # OpenAI-compatible endpoints. Both stay None when the endpoint emits nothing.
    reasoning: str | None = None
    reasoning_signature: str | None = None


def _usage_from_openai(raw: Any) -> Usage:
    """Map an OpenAI-shaped ``usage`` object onto the neutral Usage.

    Reads the optional ``prompt_tokens_details.cached_tokens`` /
    ``completion_tokens_details.reasoning_tokens`` breakdowns when the provider
    sends them (many OpenAI-compatible endpoints do; the SDK leaves them off its
    typed shape, hence getattr). Missing fields stay 0.
    """
    if raw is None:
        return Usage()
    prompt_details = getattr(raw, "prompt_tokens_details", None)
    completion_details = getattr(raw, "completion_tokens_details", None)
    return Usage(
        prompt_tokens=raw.prompt_tokens or 0,
        completion_tokens=raw.completion_tokens or 0,
        total_tokens=raw.total_tokens or 0,
        cached_prompt_tokens=int(getattr(prompt_details, "cached_tokens", 0) or 0),
        reasoning_tokens=int(getattr(completion_details, "reasoning_tokens", 0) or 0),
    )


class LLMClient(Protocol):
    """Anything that can turn messages (+tool schemas) into an LLMResponse.

    ``stream`` does the same thing but also forwards text tokens to ``on_delta``
    as they arrive (for live UIs); it still returns the fully assembled response.

    ``on_thinking`` is the *thinking* channel, separate from ``on_delta`` (which
    only ever carries final-answer text): reasoning models can sit silent for
    seconds before the first token, so a client forwards any reasoning increments
    here and the UI shows "thinking …" instead of a dead wait. The chunk may be
    ``""`` (the model is reasoning but its content is hidden). Provider-neutral:
    native Anthropic thinking blocks and a compatible endpoint's
    ``reasoning_content`` both land on this one callback; models without a
    visible thinking phase simply never call it.

    ``cancel`` is an optional cooperative cancel predicate: ``stream`` checks it
    each chunk and stops (closing the stream) the moment it returns ``True``, so a
    Stop button / Ctrl-C can cut model generation mid-token. ``complete`` can't
    interrupt its single blocking call, but accepts ``cancel`` for a uniform
    signature (the caller re-checks it at the next step boundary).
    """

    def complete(
        self,
        messages: list[dict],
        tools: list[dict] | None,
        *,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        ...

    def stream(
        self,
        messages: list[dict],
        tools: list[dict] | None,
        *,
        on_delta: Callable[[str], None] | None = None,
        on_thinking: Callable[[str], None] | None = None,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        ...


class OpenAIClient:
    """Thin adapter over the OpenAI SDK's Chat Completions endpoint."""

    def __init__(self, profile: LLMProfileConfig) -> None:
        from openai import OpenAI

        api_key = resolve_env(profile.api_key_env) or "missing-api-key"
        base_url = resolve_env(profile.base_url_env)
        # Per-call reliability is sent to the SDK only when set (else its defaults).
        client_kwargs: dict[str, Any] = {"api_key": api_key, "base_url": base_url}
        if profile.timeout_seconds is not None:
            client_kwargs["timeout"] = profile.timeout_seconds
        if profile.max_retries is not None:
            client_kwargs["max_retries"] = profile.max_retries
        self._client = OpenAI(**client_kwargs)
        self.model = profile.model
        self.temperature = profile.temperature
        self.max_tokens = profile.max_tokens
        self.reasoning_effort = profile.reasoning_effort
        self.top_p = profile.top_p
        self.frequency_penalty = profile.frequency_penalty
        self.presence_penalty = profile.presence_penalty
        self.seed = profile.seed
        self.stop = profile.stop
        self.extra_body = profile.extra_body
        self.reasoning_history_field = profile.reasoning_history_field

    def _wire_messages(self, messages: list[dict]) -> list[dict]:
        """Map the neutral reasoning carrier on assistant messages to this
        endpoint's wire shape, leaving everything else untouched.

        The loop stores a tool-calling assistant's reasoning under the neutral
        ``reasoning_content`` key (plus an Anthropic-only ``reasoning_signature``).
        Here we re-emit that text under ``reasoning_history_field`` — default
        ``reasoning_content`` (what MiMo / DeepSeek thinking / Qwen / Kimi want;
        some vLLM builds want ``reasoning``), or ``""`` to disable passback for an
        endpoint that rejects the field — and drop the Anthropic-only signature so
        it never leaks to an OpenAI-compatible endpoint. Only what the endpoint
        itself produced is echoed, so plain (non-reasoning) models never see it.

        ``reasoning_display`` (a final answer's thinking, kept only so a reloaded
        session can show it) is always dropped here: the turn is over, so it must
        never be re-sent — echoing it back could trip a reasoning endpoint's 400.
        """
        field_name = self.reasoning_history_field
        carrier_keys = ("reasoning_content", "reasoning_signature", "reasoning_display")
        out: list[dict] = []
        for message in messages:
            if message.get("role") == "assistant" and any(k in message for k in carrier_keys):
                reasoning = message.get("reasoning_content")
                message = {k: v for k, v in message.items() if k not in carrier_keys}
                if field_name and reasoning:
                    message[field_name] = reasoning
            out.append(message)
        return out

    def _request_kwargs(self, messages: list[dict], tools: list[dict] | None) -> dict[str, Any]:
        kwargs: dict[str, Any] = {"model": self.model, "messages": self._wire_messages(messages)}
        if tools:
            kwargs["tools"] = tools
            kwargs["tool_choice"] = "auto"
        # Sampling knobs are sent ONLY when set. Reasoning models (GPT-5.x /
        # o-series) reject `temperature`; non-reasoning models reject
        # `reasoning_effort`. Leaving the irrelevant one unset keeps the same
        # client provider-agnostic across both kinds.
        if self.temperature is not None:
            kwargs["temperature"] = self.temperature
        if self.max_tokens is not None:
            kwargs["max_tokens"] = self.max_tokens
        if self.reasoning_effort is not None:
            kwargs["reasoning_effort"] = self.reasoning_effort
        if self.top_p is not None:
            kwargs["top_p"] = self.top_p
        if self.frequency_penalty is not None:
            kwargs["frequency_penalty"] = self.frequency_penalty
        if self.presence_penalty is not None:
            kwargs["presence_penalty"] = self.presence_penalty
        if self.seed is not None:
            kwargs["seed"] = self.seed
        if self.stop is not None:
            kwargs["stop"] = self.stop
        # Non-standard provider params (top_k, enable_thinking, ...) ride along in
        # extra_body, which the OpenAI SDK forwards verbatim into the request body.
        if self.extra_body:
            kwargs["extra_body"] = dict(self.extra_body)
        return kwargs

    def complete(
        self,
        messages: list[dict],
        tools: list[dict] | None = None,
        *,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        # A single non-streaming call can't be interrupted mid-flight; ``cancel``
        # is accepted for a uniform signature and takes effect at the next step
        # boundary (the loop re-checks it). Web chat defaults to streaming, where
        # cancellation IS mid-token (see ``stream``).
        log.debug(
            "llm complete: model=%s messages=%d tools=%d",
            self.model, len(messages), len(tools or []),
        )
        started = time.monotonic()
        try:
            resp = self._client.chat.completions.create(**self._request_kwargs(messages, tools))
        except Exception as exc:
            log.debug(
                "llm complete FAILED after %.1fs: %s: %s",
                time.monotonic() - started, type(exc).__name__, exc,
            )
            raise
        log.debug("llm complete: response in %.1fs", time.monotonic() - started)
        message = resp.choices[0].message
        calls = [
            ToolCall(id=tc.id, name=tc.function.name, arguments=tc.function.arguments)
            for tc in (message.tool_calls or [])
        ]
        usage = _usage_from_openai(resp.usage)
        # Thinking models put their chain-of-thought on a non-standard field
        # (``reasoning_content`` on MiMo / DeepSeek / Qwen / Kimi; ``reasoning`` on
        # some vLLM builds). Captured so it can be echoed back when this turn calls
        # tools — those endpoints 400 on the next request if it is missing.
        reasoning = getattr(message, "reasoning_content", None) or getattr(message, "reasoning", None)
        return LLMResponse(content=message.content, tool_calls=calls, usage=usage, reasoning=reasoning)

    def stream(
        self,
        messages: list[dict],
        tools: list[dict] | None = None,
        *,
        on_delta: Callable[[str], None] | None = None,
        on_thinking: Callable[[str], None] | None = None,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        """Stream a Chat Completions response, assembling the same LLMResponse.

        Text deltas are pushed to ``on_delta`` as they arrive; reasoning deltas
        (the ``reasoning_content`` field some compatible endpoints emit for
        thinking models) go to ``on_thinking`` — they are progress, not answer
        text, and never enter the assembled response. Tool-call and
        usage deltas are accumulated across chunks. ``include_usage`` asks for a
        final usage chunk; providers that ignore it leave usage at 0 (so a
        cost/token budget can't trigger — same caveat as a profile without prices).

        ``cancel`` is checked each chunk: when it returns ``True`` the underlying
        HTTP stream is closed and we stop reading, returning the half-assembled
        response (the loop discards it at the next boundary). This is how a Stop
        button cuts the model off mid-generation without waiting for it to finish.
        """
        kwargs = self._request_kwargs(messages, tools)
        kwargs["stream"] = True
        kwargs["stream_options"] = {"include_usage": True}

        log.debug(
            "llm stream: model=%s messages=%d tools=%d",
            self.model, len(messages), len(tools or []),
        )
        started = time.monotonic()
        content: list[str] = []
        reasoning_parts: list[str] = []
        calls: dict[int, dict[str, str]] = {}
        usage = Usage()
        try:
            stream_obj = self._client.chat.completions.create(**kwargs)
        except Exception as exc:
            log.debug(
                "llm stream FAILED after %.1fs: %s: %s",
                time.monotonic() - started, type(exc).__name__, exc,
            )
            raise
        for chunk in stream_obj:
            if cancel is not None and cancel():
                stream_obj.close()  # stop the model: close the HTTP stream and bail
                break
            if chunk.usage is not None:
                usage = _usage_from_openai(chunk.usage)
            if not chunk.choices:
                continue
            delta = chunk.choices[0].delta
            # Non-standard but common on OpenAI-compatible reasoning endpoints
            # (DeepSeek-R1 style): the model's reasoning streams here before any
            # content. Not part of the SDK's typed delta, hence getattr. It is also
            # accumulated (not just surfaced live) so a tool-calling turn can echo
            # it back next request — required by MiMo / DeepSeek / Qwen / Kimi.
            reasoning = getattr(delta, "reasoning_content", None) or getattr(delta, "reasoning", None)
            if reasoning:
                reasoning_parts.append(reasoning)
                if on_thinking is not None:
                    on_thinking(reasoning)
            if delta.content:
                content.append(delta.content)
                if on_delta is not None:
                    on_delta(delta.content)
            for tc in delta.tool_calls or []:
                slot = calls.setdefault(tc.index, {"id": "", "name": "", "arguments": ""})
                if tc.id:
                    slot["id"] = tc.id
                if tc.function and tc.function.name:
                    slot["name"] = tc.function.name
                if tc.function and tc.function.arguments:
                    slot["arguments"] += tc.function.arguments
        tool_calls = [
            ToolCall(id=calls[i]["id"], name=calls[i]["name"], arguments=calls[i]["arguments"])
            for i in sorted(calls)
        ]
        log.debug(
            "llm stream: done in %.1fs (tool_calls=%d)",
            time.monotonic() - started, len(tool_calls),
        )
        return LLMResponse(
            content="".join(content) or None,
            tool_calls=tool_calls,
            usage=usage,
            reasoning="".join(reasoning_parts) or None,
        )


def _client_for_profile(profile: LLMProfileConfig) -> LLMClient:
    """Pick the client implementation for a profile by its ``provider``.

    The anthropic module is imported lazily so openai-only runs never load the
    anthropic SDK; an ImportError here means the dependency was stripped.
    """
    if profile.provider == "anthropic":
        try:
            from .llm_anthropic import AnthropicClient
        except ImportError as exc:
            raise RuntimeError(
                f"profile {profile.name!r} sets provider: anthropic, but the "
                "`anthropic` package is not installed — run `uv sync` (it is a "
                "default dependency of this repo)."
            ) from exc
        return AnthropicClient(profile)
    return OpenAIClient(profile)


def make_client(config: Config, role: str = "generation", *, mock: bool = False) -> LLMClient:
    """Build a single LLM client for ``role``; ``mock=True`` returns an offline one."""
    if mock:
        from .mock import MockLLM

        return MockLLM()
    return _client_for_profile(config.profile_for(role))


def client_for_profile_name(config: Config, name: str) -> LLMClient:
    """Build a client for the profile literally named ``name`` (used by per-profile
    ``fallback`` failover — a profile name, not a role)."""
    for profile in config.llms:
        if profile.name == name:
            return _client_for_profile(profile)
    raise ValueError(f"fallback profile {name!r} is not configured")


def is_context_overflow(exc: Exception) -> bool:
    """Heuristic: did this LLM error come from an over-long request (the context
    window was exceeded)? Providers word it differently, so match the common
    signals; a transient 5xx / timeout is NOT treated as overflow (so it can fail
    over instead of pointlessly compacting)."""
    status = getattr(exc, "status_code", None)
    if status is not None and status not in (400, 413, 422):
        return False
    text = f"{getattr(exc, 'code', '') or ''} {exc}".lower()
    needles = (
        "context_length_exceeded", "context length", "context window",
        "maximum context", "too many tokens", "prompt is too long",
        "reduce the length", "string too long", "input is too long",
    )
    return any(needle in text for needle in needles)


class ClientRouter:
    """Resolve and cache one client per role (``generation`` / ``compaction`` / ...).

    The loop uses ``generation``; context summarization uses ``compaction``. Pass
    ``client_for`` (the bound method) into ``run()`` to route within one turn.
    """

    def __init__(self, config: Config, *, mock: bool = False) -> None:
        self._config = config
        self._mock = mock
        self._cache: dict[str, LLMClient] = {}

    def client_for(self, role: str = "generation") -> LLMClient:
        if self._mock:
            key = f"mock:{role}"
            if key not in self._cache:
                from .mock import MockLLM

                self._cache[key] = MockLLM()
            return self._cache[key]
        profile = self._config.profile_for(role)
        if profile.name not in self._cache:
            self._cache[profile.name] = _client_for_profile(profile)
        return self._cache[profile.name]
