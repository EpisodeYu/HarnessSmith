@echo off
REM One-click launcher for {{ display_name }} - generated by HarnessForge.
REM Prefers uv (auto-syncs deps on the first run); falls back to the {{ project_slug }} command.
REM {% if interfaces.web %}Starts the web UI and opens it in your browser.{% else %}Starts an interactive chat in this window.{% endif %}
setlocal
cd /d "%~dp0"

set "ACTION={% if interfaces.web %}serve --open{% else %}chat{% endif %}"

where uv >nul 2>nul
if not errorlevel 1 (
    uv run {{ project_slug }} %ACTION%
    goto :done
)
where {{ project_slug }} >nul 2>nul
if not errorlevel 1 (
    {{ project_slug }} %ACTION%
    goto :done
)
echo Could not find "uv" or "{{ project_slug }}" on your PATH.
echo Install uv ^(https://docs.astral.sh/uv/^), or run "pip install -e ." in this
echo folder to install the {{ project_slug }} command, then re-run this script.
pause
exit /b 1

:done
