def test_chat_streams_tool_call_and_final_over_sse():
    resp = _client().get("/chat", params={"message": "hello"})
    assert resp.status_code == 200
    assert resp.headers["content-type"].startswith("text/event-stream")

    body = resp.text
    assert "event: tool_call" in body
    assert "event: tool_result" in body
    assert "event: final" in body
    assert "answer" in body  # the final event carries the answer


def test_chat_streams_answer_tokens_by_default():
    body = _client().get("/chat", params={"message": "hi"}).text
    assert "event: token" in body  # token-level streaming is on by default


def test_chat_stream_false_emits_no_tokens():
    body = _client().get("/chat", params={"message": "hi", "stream": "false"}).text
    assert "event: token" not in body
    assert "event: final" in body  # still returns the answer, just not streamed


def test_chat_persists_session_and_lists_it(tmp_path):
    """A chat turn emits its session id, saves the body, and /sessions lists it;
    /sessions/<id> replays the messages so the UI can resume the conversation."""
    client = _session_client(tmp_path)
    body = client.get("/chat", params={"message": "hello", "stream": "false"}).text
    sid = _sse_session_id(body)
    assert sid

    listing = client.get("/sessions").json()["sessions"]
    assert any(s["id"] == sid for s in listing)

    detail = client.get(f"/sessions/{sid}").json()
    assert detail["id"] == sid
    assert any(
        m["role"] == "user" and m["content"] == "hello" for m in detail["messages"]
    )


def test_chat_resumes_prior_session(tmp_path):
    """?session=<id> resumes: the second turn's saved body includes the first."""
    client = _session_client(tmp_path)
    sid = _sse_session_id(
        client.get("/chat", params={"message": "first", "stream": "false"}).text
    )
    assert sid
    client.get(
        "/chat", params={"message": "second", "stream": "false", "session": sid}
    )
    users = [
        m["content"]
        for m in client.get(f"/sessions/{sid}").json()["messages"]
        if m["role"] == "user"
    ]
    assert "first" in users and "second" in users


def test_chat_disabled_sessions_emit_nothing(tmp_path):
    """sessions.enabled=false: no session event, empty listing, no files."""
    client = _session_client(tmp_path, enabled=False)
    body = client.get("/chat", params={"message": "hi", "stream": "false"}).text
    assert "event: session" not in body
    assert client.get("/sessions").json() == {"sessions": []}
    assert not (tmp_path / "sessions").exists()


def test_chat_first_turn_emits_title_and_persists(tmp_path):
    """First turn auto-titles: a `title` event is emitted (before `final`) and the
    title is stored on the session so the sidebar can name it."""
    client = _session_client(tmp_path)
    body = client.get(
        "/chat", params={"message": "what is AMF?", "stream": "false"}
    ).text
    title = _sse_event_data(body, "title")
    assert title and title["title"]  # mock returns a non-empty title
    assert body.index("event: title") < body.index("event: final")

    sid = title["id"]
    listed = {s["id"]: s for s in client.get("/sessions").json()["sessions"]}
    assert listed[sid]["title"] == title["title"]


def test_chat_no_autotitle_when_disabled(tmp_path):
    """sessions.auto_title=false: no title event, session has empty title."""
    client = _session_client(tmp_path, auto_title=False)
    body = client.get("/chat", params={"message": "hi", "stream": "false"}).text
    assert "event: title" not in body
    sid = _sse_session_id(body)
    assert sid
    assert client.get("/sessions").json()["sessions"][0]["title"] == ""


def test_chat_autotitle_skipped_when_title_already_set(tmp_path):
    """A session that already has a title is not re-titled on a later turn."""
    from {{ project_slug }}.harness import session as session_store

    sdir = str(tmp_path / "sessions")
    session_store.save("kept", [{"role": "user", "content": "old"}], sdir, title="My title")
    client = _session_client(tmp_path)
    body = client.get(
        "/chat", params={"message": "second", "stream": "false", "session": "kept"}
    ).text
    assert "event: title" not in body
    assert session_store.title_of("kept", sdir) == "My title"  # unchanged


