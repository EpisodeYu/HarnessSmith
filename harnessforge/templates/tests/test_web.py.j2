    return TestClient(create_app(config, mock=True))


def test_memory_endpoints_roundtrip(tmp_path):
    """GET/POST/DELETE /memory read, overwrite, and clear the note; /registries
    lists the registered backends."""
    client = _memory_client(tmp_path)
    got = client.get("/memory").json()
    assert got["content"] == "" and got["read_only"] is False
    assert got["size"] == 0 and got["oversized"] is False  # size/oversized surfaced

    assert client.post("/memory", json={"content": "remember this"}).json()["ok"] is True
    assert client.get("/memory").json()["content"] == "remember this"
    assert "file" in client.get("/registries").json()["memory"]

    assert client.delete("/memory").json()["ok"] is True
    assert client.get("/memory").json()["content"] == ""


def test_memory_config_is_editable(tmp_path):
