def test_session_rename_and_delete(tmp_path):
    """PATCH renames a session (kept in the listing); DELETE removes it."""
    from {{ project_slug }}.harness import session as session_store

    sdir = str(tmp_path / "sessions")
    session_store.save("s1", [{"role": "user", "content": "hi"}], sdir, title="old")
    client = _session_client(tmp_path)

    r = client.patch("/sessions/s1", json={"title": "Renamed"})
    assert r.status_code == 200 and r.json()["title"] == "Renamed"
    assert session_store.title_of("s1", sdir) == "Renamed"
    assert client.get("/sessions").json()["sessions"][0]["title"] == "Renamed"

    assert client.delete("/sessions/s1").status_code == 200
    assert client.get("/sessions").json() == {"sessions": []}

    # renaming a missing session is a clean 404 (not a crash)
    assert client.patch("/sessions/gone", json={"title": "x"}).status_code == 404


