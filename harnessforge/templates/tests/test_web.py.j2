"""Web interface tests: SSE streaming chat + the live /config panel.

Generated only when ``interfaces.web`` is enabled. They use the offline MockLLM
(no API key / network) via the app's ``mock=True`` flag. Run with ``uv run pytest``.
"""

from __future__ import annotations

import pytest
from fastapi.testclient import TestClient

from {{ project_slug }}.harness.config import Config, ConfigError, set_env_value
from {{ project_slug }}.interfaces.web import create_app


def _config():
    return Config.model_validate(
        {
            "llms": [{"name": "default", "model": "mock-model"}],
            "roles": {"generation": "default"},
            "prompts": {"system": "You are a test agent."},
            "tools": [{"name": "get_current_time", "enabled": True}],
            "observability": {"trace": False},
            "budget": {"max_steps": 4},
        }
    )


def _client():
    return TestClient(create_app(_config(), mock=True))


def test_index_is_served():
    resp = _client().get("/")
    assert resp.status_code == 200
    assert "<html" in resp.text.lower()


def test_chat_streams_tool_call_and_final_over_sse():
    resp = _client().get("/chat", params={"message": "hello"})
    assert resp.status_code == 200
    assert resp.headers["content-type"].startswith("text/event-stream")

    body = resp.text
    assert "event: tool_call" in body
    assert "event: tool_result" in body
    assert "event: final" in body
    assert "answer" in body  # the final event carries the answer


def test_chat_streams_answer_tokens_by_default():
    body = _client().get("/chat", params={"message": "hi"}).text
    assert "event: token" in body  # token-level streaming is on by default


def test_chat_stream_false_emits_no_tokens():
    body = _client().get("/chat", params={"message": "hi", "stream": "false"}).text
    assert "event: token" not in body
    assert "event: final" in body  # still returns the answer, just not streamed


def test_config_get_exposes_names_not_secrets():
    resp = _client().get("/config")
    assert resp.status_code == 200
    data = resp.json()
    assert "prompts" in data and "budget" in data
    assert data["llms"][0]["api_key_env"] == "OPENAI_API_KEY"  # env NAME only
    assert "sk-" not in resp.text  # never a secret value


def test_config_post_updates_runtime_config():
    client = _client()
    resp = client.post("/config", json={"prompts": {"system": "NEW SYSTEM PROMPT"}})
    assert resp.status_code == 200
    assert resp.json()["prompts"]["system"] == "NEW SYSTEM PROMPT"
    # the change is live for subsequent requests in the same process
    assert client.get("/config").json()["prompts"]["system"] == "NEW SYSTEM PROMPT"


def test_config_post_rejects_invalid_value():
    resp = _client().post("/config", json={"budget": {"max_steps": -1}})
    assert resp.status_code == 400
    assert "error" in resp.json()


def test_config_post_ignores_structural_and_secret_keys():
    client = _client()
    resp = client.post(
        "/config",
        json={"project_slug": "hacked", "secrets": {"OPENAI_API_KEY": "sk-leak"}},
    )
    assert resp.status_code == 200
    assert "sk-leak" not in resp.text
    # structural identity is untouched (project_slug is not an editable field)
    assert "hacked" not in resp.text


def test_set_env_value_writes_and_updates(tmp_path):
    """The write-only .env helper creates then updates a KEY=value line in place."""
    env = tmp_path / ".env"
    set_env_value("OPENAI_API_KEY", "sk-secret-1", env)
    assert "OPENAI_API_KEY=sk-secret-1" in env.read_text(encoding="utf-8")
    set_env_value("OPENAI_API_KEY", "sk-secret-2", env)
    text = env.read_text(encoding="utf-8")
    assert "OPENAI_API_KEY=sk-secret-2" in text and "sk-secret-1" not in text


def test_set_env_value_rejects_bad_name(tmp_path):
    with pytest.raises(ConfigError):
        set_env_value("bad name", "x", tmp_path / ".env")


def test_env_endpoint_writes_dotenv_without_echoing(tmp_path, monkeypatch):
    """POST /env stores the value in the local .env and never returns/echoes it."""
    monkeypatch.chdir(tmp_path)
    resp = _client().post("/env", json={"name": "OPENAI_API_KEY", "value": "sk-do-not-echo"})
    assert resp.status_code == 200
    assert "sk-do-not-echo" not in resp.text  # write-only: value never returned
    assert "OPENAI_API_KEY=sk-do-not-echo" in (tmp_path / ".env").read_text(encoding="utf-8")


def test_env_endpoint_rejects_bad_name():
    resp = _client().post("/env", json={"name": "bad name", "value": "x"})
    assert resp.status_code == 400
