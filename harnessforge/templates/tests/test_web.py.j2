def test_memory_consolidate_endpoint(tmp_path):
    """POST /memory/consolidate rewrites an oversized note via the (mock) compaction
    model; an empty note is a no-op."""
    client = _memory_client(tmp_path)
    assert client.post("/memory/consolidate").json()["ran"] is False  # empty -> no-op

    client.post("/memory", json={"content": "lots of\nold\nnotes\nhere"})
    data = client.post("/memory/consolidate").json()
    assert data["ok"] is True and data["ran"] is True
    assert data["content"]  # rewritten note returned


