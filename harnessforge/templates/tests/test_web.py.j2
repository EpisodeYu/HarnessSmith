def test_stop_interrupts_run_and_saves_resumable_partial(tmp_path):
    """A stopped run emits `event: stopped` (not `final`) and persists its partial
    conversation as interrupted, so it can be resumed."""
    import json
    import threading

    from {{ project_slug }}.interfaces.web import _chat_events
    from {{ project_slug }}.harness import session as session_store

    config = Config.model_validate({
        "llms": [{"name": "default", "model": "mock-model"}],
        "roles": {"generation": "default"},
        "tools": [{"name": "get_current_time", "enabled": True}],
        "observability": {"trace": False},
        "sessions": {"enabled": True, "dir": str(tmp_path / "sessions"), "auto_title": False},
    })
    sdir = str(tmp_path / "sessions")
    runs, lock = {}, threading.Lock()
    sid = session_store.new_id()

    gen = _chat_events(
        "hello", config, mock=True, stream=False, session_id=sid, history=[],
        runs=runs, lock=lock,
    )
    first = next(gen)  # `event: run` — the worker thread hasn't started yet
    assert "event: run" in first
    run_id = json.loads(first.split("data: ", 1)[1])["run_id"]
    runs[run_id].set()  # trip the cancel token before the loop runs
    frames = "".join(gen)  # drains: the worker starts already-cancelled

    assert "event: stopped" in frames and "event: final" not in frames
    assert session_store.status_of(sid, sdir) == "interrupted"
    msgs = session_store.load(sid, sdir)
    assert any(m["role"] == "user" and m["content"] == "hello" for m in msgs)


def test_reask_edit_turn_truncates_and_regenerates(tmp_path):
    """?edit_turn=N truncates the session to before that user turn and regenerates,
    overwriting the later conversation (destructive re-ask, not a fork)."""
    client = _session_client(tmp_path, auto_title=False)
    sid = _sse_session_id(
        client.get("/chat", params={"message": "first", "stream": "false"}).text
    )
    client.get("/chat", params={"message": "second", "stream": "false", "session": sid})
    users = [
        m["content"]
        for m in client.get(f"/sessions/{sid}").json()["messages"]
        if m["role"] == "user"
    ]
    assert users == ["first", "second"]

    # Re-ask turn 1 (the "second" question) with an edit.
    client.get(
        "/chat",
        params={"message": "second-edited", "stream": "false", "session": sid, "edit_turn": 1},
    )
    after = [
        m["content"]
        for m in client.get(f"/sessions/{sid}").json()["messages"]
        if m["role"] == "user"
    ]
    assert after == ["first", "second-edited"]  # turn 1 replaced; nothing after it


