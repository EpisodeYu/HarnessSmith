def test_rules_endpoint_writes_and_reads_within_repo(tmp_path, monkeypatch):
    """POST /rules writes a rule file's content to disk; GET /rules reads back each
    configured rules_files entry so the Prompts tab can edit the files in place."""
    monkeypatch.chdir(tmp_path)
    config = Config.model_validate({
        "llms": [{"name": "default", "model": "mock-model"}],
        "roles": {"generation": "default"},
        "prompts": {"system": "s", "rules_files": ["RULES.md"]},
        "observability": {"trace": False},
    })
    client = TestClient(create_app(config, mock=True))
    assert client.post("/rules", json={"path": "RULES.md", "content": "Be concise."}).status_code == 200
    assert (tmp_path / "RULES.md").read_text(encoding="utf-8") == "Be concise."
    assert client.get("/rules").json()["rules"] == [
        {"path": "RULES.md", "content": "Be concise.", "exists": True, "auto": False}
    ]


def test_rules_endpoint_surfaces_auto_recognized_claude_md(tmp_path, monkeypatch):
    """An auto-recognized root CLAUDE.md shows up in GET /rules (flagged auto) even
    when it isn't in rules_files, so the Prompts tab can list and edit it."""
    monkeypatch.chdir(tmp_path)
    (tmp_path / "CLAUDE.md").write_text("House rules.", encoding="utf-8")
    client = TestClient(create_app(_config(), mock=True))
    rules = client.get("/rules").json()["rules"]
    assert {"path": "CLAUDE.md", "content": "House rules.", "exists": True, "auto": True} in rules


def test_rules_endpoint_rejects_paths_outside_repo(tmp_path, monkeypatch):
    """A rule path must be relative and stay inside the project — absolute paths and
    `..` escapes are rejected, so the panel can't read or overwrite arbitrary files."""
    monkeypatch.chdir(tmp_path)
    client = TestClient(create_app(_config(), mock=True))
    assert client.post("/rules", json={"path": "../escape.md", "content": "x"}).status_code == 400
    assert client.post("/rules", json={"path": "/etc/evil", "content": "x"}).status_code == 400
    assert not (tmp_path.parent / "escape.md").exists()


