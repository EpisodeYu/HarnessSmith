"""Web interface tests: SSE streaming chat + the live /config panel.

Generated only when ``interfaces.web`` is enabled. They use the offline MockLLM
(no API key / network) via the app's ``mock=True`` flag. Run with ``uv run pytest``.
"""

from __future__ import annotations

import pytest
from fastapi.testclient import TestClient

from {{ project_slug }}.harness.config import Config, ConfigError, set_env_value
from {{ project_slug }}.interfaces.web import create_app


def _config():
    return Config.model_validate(
        {
            "llms": [{"name": "default", "model": "mock-model"}],
            "roles": {"generation": "default"},
            "prompts": {"system": "You are a test agent."},
            "tools": [{"name": "get_current_time", "enabled": True}],
            "observability": {"trace": False},
            "budget": {"conditions": {"max_steps": 4}},
        }
    )


def _client():
    return TestClient(create_app(_config(), mock=True))


def test_index_is_served():
    resp = _client().get("/")
    assert resp.status_code == 200
    assert "<html" in resp.text.lower()


def test_index_has_unsaved_config_guard():
    """The config panel ships an unsaved-edits guard so a forgotten Save doesn't
    silently drop a just-entered LLM profile (marker + leave/unload confirms)."""
    body = _client().get("/").text
    assert 'id="cfg-unsaved"' in body  # the visible "unsaved" marker
    assert "cfg_leave_confirm" in body  # confirm when switching away from Config
    assert "beforeunload" in body  # confirm on refresh/close while dirty
    assert "if (!dirty) loadConfig()" in body  # don't overwrite edits on tab return


def test_index_groups_tools_by_source():
    """The Tools tab groups the flat allowlist: your tools first, then built-ins,
    then each MCP server's tools folded into a collapsed group (named by server)."""
    body = _client().get("/").text
    assert "function buildTools()" in body
    assert "BUILTIN_TOOLS" in body and "get_current_time" in body
    assert "tools_group_custom" in body  # user-registered tools sort to the top
    assert "<details" in body and 'indexOf("__")' in body  # MCP folded by server
    assert "tools_extend_hint" in body  # footnote: register + allowlist in config.yaml
{% if spec.mcp.enabled %}
import sys
from pathlib import Path

_DUMMY = str(Path(__file__).parent / "_mcp_dummy_server.py")


def test_mcp_discover_returns_empty_without_servers():
    """Discovery returns an empty list (no connection attempted) when no MCP
    servers are configured — the Tools tab's auto-scan is then a no-op."""
    resp = _client().get("/mcp/discover")
    assert resp.status_code == 200
    assert resp.json() == {"servers": []}


def test_mcp_discover_lists_real_server_tools():
    """Against a real stdio server, /mcp/discover lists its full tool set with each
    tool's allowlist state — so the panel can offer them without hand-edited YAML.
    Here `echo` is allowlisted+enabled; `add` is discovered but unlisted."""
    config = Config.model_validate({
        "llms": [{"name": "default", "model": "mock-model"}],
        "roles": {"generation": "default"},
        "tools": [{"name": "dummy__echo", "enabled": True}],
        "observability": {"trace": False},
        "mcp": {"servers": [{"name": "dummy", "command": sys.executable, "args": [_DUMMY]}]},
    })
    data = TestClient(create_app(config, mock=True)).get("/mcp/discover").json()
    servers = {s["name"]: s for s in data["servers"]}
    assert "dummy" in servers and servers["dummy"]["error"] is None, data
    tools = {t["short"]: t for t in servers["dummy"]["tools"]}
    assert {"echo", "add"} <= set(tools)
    assert tools["echo"]["name"] == "dummy__echo"
    assert tools["echo"]["listed"] is True and tools["echo"]["enabled"] is True
    assert tools["add"]["listed"] is False  # discovered but not in the allowlist


def test_index_has_mcp_discovery_ui():
    """The Tools tab ships the scan button + discoverMcp() so a configured
    server's tools appear without hand-writing the <server>__<tool> allowlist."""
    body = _client().get("/").text
    assert "/mcp/discover" in body and "function discoverMcp()" in body
    assert 'id="cfg-mcp-scan"' in body
