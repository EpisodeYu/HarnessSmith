def test_custom_paradigm_registers_and_runs_without_touching_builtins(tmp_path):
    """Add a paradigm like you add a tool: a function + @register_paradigm, then
    list its name in config.yaml's paradigms.enabled. No built-in paradigm file
    or the registry core is edited."""

    @register_paradigm("demo")
    def demo(user_input, *, config, trace=None, **kwargs):
        t = trace or Trace(enabled=False)
        return RunResult(
            answer=f"demo:{user_input}", steps=0, stop_reason="final", trace=t, mode="demo"
        )

    try:
        config = _config(
            tmp_path, paradigms={"enabled": ["agent", "demo"], "default": "agent"}
        )
        result = run("hello", client=MockLLM(), config=config, mode="demo")
        assert result.mode == "demo"
        assert result.answer == "demo:hello"
        assert get_paradigm("demo") is demo
    finally:
        PARADIGMS.pop("demo", None)
