def test_debug_log_setup_is_idempotent_and_toggleable(tmp_path):
    import logging
    from logging.handlers import RotatingFileHandler

    from {{ project_slug }}.harness import debuglog

    try:
        assert debuglog.setup(True, str(tmp_path / "a")) is not None
        assert debuglog.setup(True, str(tmp_path / "b")) is not None  # re-points, no dup
        handlers = [
            h for h in debuglog.log.handlers if isinstance(h, RotatingFileHandler)
        ]
        assert len(handlers) == 1
    finally:
        debuglog.setup(False)
    assert not any(
        isinstance(h, RotatingFileHandler) for h in debuglog.log.handlers
    )


