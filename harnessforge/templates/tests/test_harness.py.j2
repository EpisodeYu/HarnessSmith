def test_rules_files_inject_into_system_prompt(tmp_path):
    """Always-apply project rules (AGENTS.md/CLAUDE.md pattern): every listed
    markdown file is injected into the system prompt; a missing one is skipped."""
    rules = tmp_path / "RULES.md"
    rules.write_text("Always cite your sources.", encoding="utf-8")
    config = _config(
        tmp_path,
        prompts={
            "system": "You are a test agent.",
            "rules_files": [str(rules), str(tmp_path / "does_not_exist.md")],
        },
    )
    prompt = build_system_prompt(config)
    assert "You are a test agent." in prompt
    assert "Always cite your sources." in prompt  # the rule file's text is injected


