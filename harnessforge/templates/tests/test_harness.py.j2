def test_confirm_names_resolves_each_policy():
    """The trigger is an allowlist, not per-call risk scoring: none/empty confirms
    nothing, all = every tool, high = risk=high tools (read-only exempt), a list =
    exactly the named tools."""
    registry = Registry()

    @registry.tool(name="readtool", description="read")
    def readtool() -> str:
        return "r"

    @registry.tool(name="writetool", description="write", risk="high")
    def writetool() -> str:
        return "w"

    assert registry.confirm_names("none") == set()
    assert registry.confirm_names(None) == set()
    assert registry.confirm_names("all") == {"readtool", "writetool"}
    assert registry.confirm_names("high") == {"writetool"}  # read-only is exempt
    assert registry.confirm_names(["readtool"]) == {"readtool"}


def _danger_registry():
    """A registry with one high-risk tool that records that it ran."""
