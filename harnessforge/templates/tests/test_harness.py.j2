def _write_config(tmp_path, cfg_dict):
    import yaml

    cfg_file = tmp_path / "config.yaml"
    cfg_file.write_text(yaml.safe_dump(cfg_dict), encoding="utf-8")
    return cfg_file


def _cli_text(result) -> str:
    """All captured text (stdout + stderr), across Click versions that separate or
    mix the two streams."""
    text = result.output or ""
    try:
        if result.stderr:
            text += result.stderr
    except ValueError:  # older Click mixes stderr into output already
        pass
    return text


