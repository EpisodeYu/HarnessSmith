def test_confirm_allow_once_runs_but_asks_every_time(tmp_path):
    """allow_once executes the tool but never remembers: a second call asks again.
    The approval card carries the tool name + arguments + risk for the UI."""
    from {{ project_slug }}.harness.interaction import (
        AskResponse,
        ToolConfirmer,
        using_asker,
        using_confirmer,
    )

    registry = _danger_registry()
    config = _config(tmp_path, tools=[{"name": "danger", "enabled": True}], confirm="high")
    client = MockLLM(script=[ScriptedCall("danger", {}), ScriptedCall("danger", {}), "done"])
    asker = _FakeAsker(AskResponse(option_ids=["allow_once"]))
    confirmer = ToolConfirmer(registry.confirm_names(config.confirm))
    with using_asker(asker), using_confirmer(confirmer):
        result = run("go", client=client, config=config, registry=registry)

    assert result.answer == "done"
    assert len(asker.requests) == 2  # asked both times (allow_once never remembers)
    assert asker.requests[0].kind == "approval"
    assert asker.requests[0].context == {"tool": "danger", "arguments": "{}", "risk": "high"}
    tool_msgs = [m for m in result.messages if m.get("role") == "tool"]
    assert [m["content"] for m in tool_msgs] == ["ran", "ran"]


