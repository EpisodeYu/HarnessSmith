def test_config_extensions_import_and_hooks_mount(tmp_path, monkeypatch):
    """EXT-1/EXT-2: config.extensions imports a module so its @register_* run, and
    config.hooks mounts a Hooks subclass — both without editing cli.py / web.py."""
    import sys

    from {{ project_slug }}.harness.extensions import (
        check_config,
        import_extensions,
        load_hooks,
    )
    from {{ project_slug }}.harness.paradigms import PARADIGMS

    module = tmp_path / "my_ext.py"
    module.write_text(
        "from {{ project_slug }}.harness.hooks import Hooks\n"
        "from {{ project_slug }}.harness.paradigms import register_paradigm, RunResult\n"
        "from {{ project_slug }}.harness.trace import Trace\n"
        "\n"
        "SEEN = []\n"
        "\n"
        "@register_paradigm('extmode')\n"
        "def run(user_input, *, config, trace=None, **kwargs):\n"
        "    return RunResult(answer='x', steps=0, stop_reason='final',\n"
        "                     trace=trace or Trace(enabled=False), mode='extmode')\n"
        "\n"
        "class RecordingHooks(Hooks):\n"
        "    def before_tool(self, call):\n"
        "        SEEN.append(call.name)\n",
        encoding="utf-8",
    )
    monkeypatch.syspath_prepend(str(tmp_path))
    config = _config(
        tmp_path,
        extensions=["my_ext"],
        hooks="my_ext:RecordingHooks",
        paradigms={"enabled": ["agent", "extmode"], "default": "agent"},
    )
    try:
        import_extensions(config)
        assert "extmode" in PARADIGMS  # registered via extensions, not paradigms/__init__
        assert check_config(config) == ([], [])  # every selected name resolves

        hooks = load_hooks(config)
        import my_ext

        run("hi", client=MockLLM(), config=config, hooks=hooks)
        assert my_ext.SEEN  # the configured hook fired through run_loop
    finally:
        PARADIGMS.pop("extmode", None)
        sys.modules.pop("my_ext", None)
