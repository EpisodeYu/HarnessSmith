def test_debug_log_records_tool_names_but_never_arguments(tmp_path):
    from {{ project_slug }}.harness import debuglog

    log_dir = tmp_path / "logs"
    config = _config(
        tmp_path,
        observability={"trace": False, "debug": True, "debug_dir": str(log_dir)},
    )
    debuglog.setup(config.observability.debug, config.observability.debug_dir)
    try:
        script = [ScriptedCall("calculator", {"expression": "1+ARGUMENT_MARKER"}), "FINAL_ANSWER_MARKER"]
        run("USER_INPUT_MARKER", client=MockLLM(script=script), config=config)
    finally:
        debuglog.setup(False)  # detach so other tests don't share the handler
    text = (log_dir / debuglog.LOG_FILE_NAME).read_text(encoding="utf-8")
    # The lifecycle is there (tool/llm/run events, by name) ...
    assert "calculator" in text
    assert "trace run_start" in text and "trace run_end" in text
    assert "trace tool_call" in text and "trace tool_result" in text
    # ... but tool arguments / results / message content never are.
    assert "ARGUMENT_MARKER" not in text
    assert "USER_INPUT_MARKER" not in text
    assert "FINAL_ANSWER_MARKER" not in text


