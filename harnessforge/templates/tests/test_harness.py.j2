    tracker = BudgetTracker(BudgetConfig())
    assert tracker.amount("m", 1234, None) == 1234  # no window -> running total


def test_budget_tumbling_window_resets_each_period():
    import time

    from {{ project_slug }}.harness.budget import BudgetTracker
    from {{ project_slug }}.harness.config import BudgetConfig

    tracker = BudgetTracker(BudgetConfig())
    # Pretend the run started long ago so the first window has already expired.
    tracker.started = time.monotonic() - 100.0
    # window=10s expired -> a fresh window anchors now with baseline=current, so
    # the in-window amount resets to 0 even though cumulative is 500...
    assert tracker.amount("max_tokens", 500, window=10.0) == 0.0
    # ...and subsequent growth within the same window counts from that baseline.
    assert tracker.amount("max_tokens", 800, window=10.0) == 300.0


def test_custom_budget_condition_registers_and_stops(tmp_path):
    """Add a budget condition like a tool: a function + @register_budget_condition,
    then reference its name in config.budget.conditions. No core file is edited."""
    from {{ project_slug }}.harness.budget import (
        BUDGET_CONDITIONS,
        register_budget_condition,
    )

    @register_budget_condition("max_my_steps")
    def _max_my_steps(tracker, threshold, window):
        return tracker.step >= threshold

    try:
        config = _config(tmp_path, budget={"conditions": {"max_my_steps": 1}})
        result = run("x", client=_AlwaysToolLLM(), config=config)
        assert result.stop_reason == "max_my_steps"
    finally:
        BUDGET_CONDITIONS.pop("max_my_steps", None)


