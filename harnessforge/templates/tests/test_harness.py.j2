def test_openai_client_stream_closes_on_cancel():
    """STOP-1: OpenAIClient.stream closes the HTTP stream the moment cancel trips,
    stops reading chunks, and returns the half-assembled response."""
    import types

    from {{ project_slug }}.harness.llm import OpenAIClient

    closed = {"v": False}

    def _chunk(text):
        delta = types.SimpleNamespace(content=text, tool_calls=None)
        return types.SimpleNamespace(usage=None, choices=[types.SimpleNamespace(delta=delta)])

    class _Stream:
        def __init__(self):
            self._chunks = [_chunk("a"), _chunk("b"), _chunk("c")]

        def __iter__(self):
            return iter(self._chunks)

        def close(self):
            closed["v"] = True

    client = OpenAIClient.__new__(OpenAIClient)  # bypass __init__ (no SDK / network)
    client.model = "m"
    client.temperature = client.max_tokens = client.reasoning_effort = None
    client._client = types.SimpleNamespace(
        chat=types.SimpleNamespace(
            completions=types.SimpleNamespace(create=lambda **kw: _Stream())
        )
    )

    seen = []
    n = {"c": 0}

    def cancel():
        n["c"] += 1
        return n["c"] > 1  # cancel right after the first chunk

    resp = client.stream([], None, on_delta=seen.append, cancel=cancel)
    assert closed["v"] is True  # the stream was closed, not drained
    assert seen == ["a"] and resp.content == "a"


def test_crash_recovery_via_checkpoint_is_resumable(tmp_path):
    """Tier B: a turn write-ahead checkpoints each step. Simulating a hard crash
    (only the checkpoint file remains, status != complete), load repairs+returns a
    legal body and a fresh turn resumes from it."""
    from {{ project_slug }}.harness import session as session_store

    config = _config(tmp_path)
    sdir = str(tmp_path / "s")
    sid = session_store.new_id()
    client = MockLLM(script=[ScriptedCall("get_current_time", {}), "done"])
    # The caller "crashes" before the final save — only the per-step checkpoint
    # write-ahead reaches disk.
    run(
        "go",
        client=client,
        config=config,
        checkpoint=lambda body: session_store.checkpoint(sid, body, sdir),
    )

    assert session_store.status_of(sid, sdir) == "running"  # never cleanly finished
    history = session_store.load(sid, sdir)  # repaired if needed -> legal sequence
    assert any(m["role"] == "user" and m["content"] == "go" for m in history)

    resumed = run("and now?", client=MockLLM(script=["ok"]), config=config, history=history)
    assert resumed.stop_reason == "final"
    assert any(m.get("content") == "go" for m in resumed.messages)  # prior turn carried


# --- Slice 10: interaction channel (ask_question + shared asker) ------------


class _FakeAsker:
    """Records requests and replays a canned response (the test's "user")."""

    def __init__(self, response):
        self.response = response
        self.requests = []

    def ask(self, req):
        self.requests.append(req)
        return self.response


def test_ask_resolves_via_contextvar_and_restores():
    """ask() routes to the asker bound by using_asker, and restores the prior one
    (the degrade) when the block exits — the contextvar injection spine."""
    from {{ project_slug }}.harness.interaction import (
        AskRequest,
        AskResponse,
        ask,
        using_asker,
    )

    asker = _FakeAsker(AskResponse(text="bound"))
    with using_asker(asker):
        assert ask(AskRequest(kind="question", prompt="x")).text == "bound"
    assert asker.requests and asker.requests[0].prompt == "x"
    # outside the block: back to the non-interactive degrade
    assert "no interactive user" in ask(AskRequest(kind="question", prompt="x")).text


def test_noninteractive_degrades_question_and_rejects_approval():
    """No user available: a question proceeds (use-your-judgment note, never hangs),
    an approval is rejected (fail-closed)."""
    from {{ project_slug }}.harness.interaction import (
        AskRequest,
        NonInteractiveAsker,
        Option,
    )

    asker = NonInteractiveAsker()
    q = asker.ask(AskRequest(kind="question", prompt="anything?"))
    assert q.option_ids == [] and "no interactive user" in (q.text or "")
    approval = asker.ask(
        AskRequest(
            kind="approval",
            prompt="run rm -rf?",
            options=[Option("allow_once", "Allow"), Option("reject", "Reject")],
        )
    )
    assert approval.selected == "reject"


def test_ask_question_tool_feeds_answer_back_as_tool_result(tmp_path):
    """The model calls ask_question; the user's selection comes back as the tool
    result the loop appends — exercised end to end through run()."""
    from {{ project_slug }}.harness.interaction import AskResponse, using_asker

    config = _config(tmp_path, tools=[{"name": "ask_question", "enabled": True}])
    client = MockLLM(
        script=[
            ScriptedCall(
                "ask_question", {"question": "Pick one", "options": ["Apple", "Banana"]}
            ),
            "done",
        ]
    )
    asker = _FakeAsker(AskResponse(option_ids=["1"]))  # option index 1 -> "Banana"
    with using_asker(asker):
        result = run("go", client=client, config=config)

    assert result.answer == "done"
    assert asker.requests[0].prompt == "Pick one"
    assert [o.label for o in asker.requests[0].options] == ["Apple", "Banana"]
    tool_msgs = [m for m in result.messages if m.get("role") == "tool"]
    assert tool_msgs and "User selected: Banana" in tool_msgs[0]["content"]


