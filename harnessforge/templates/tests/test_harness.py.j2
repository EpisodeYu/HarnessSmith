def test_plan_mode_is_read_only(tmp_path):
    registry = Registry()
    calls = []

    @registry.tool(name="danger_write", description="High-risk writer.", risk="high")
    def danger_write() -> str:
        calls.append("danger_write")
        return "wrote"

    @registry.tool(name="safe_read", description="Safe reader.")
    def safe_read() -> str:
        calls.append("safe_read")
        return "data"

    config = _config(
        tmp_path,
        paradigms={"enabled": ["agent", "plan"], "default": "agent"},
        tools=[
            {"name": "danger_write", "enabled": True},
            {"name": "safe_read", "enabled": True},
        ],
    )

    # agent offers the high-risk tool (registered first -> the mock calls it).
    agent = run("do it", client=MockLLM(), config=config, registry=registry, mode="agent")
    assert agent.mode == "agent" and "danger_write" in calls

    calls.clear()
    # plan must never offer/execute the high-risk tool — only the safe one.
    plan = run("plan it", client=MockLLM(), config=config, registry=registry, mode="plan")
    assert plan.mode == "plan"
    assert plan.stop_reason == "final"
    assert "danger_write" not in calls
