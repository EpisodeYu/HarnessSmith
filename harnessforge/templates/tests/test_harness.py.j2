def test_summarize_usage_is_traced_and_budgeted(tmp_path):
    """RT-2: a summarize compaction call's tokens/cost land in the trace (so they
    count toward the token/cost budget) and emit a `compaction` event — they don't
    silently escape the run totals."""
    from {{ project_slug }}.harness.context import make_summarizer

    config = _config(tmp_path)
    config.llms[0].input_cost_per_million = 1000.0
    config.llms[0].output_cost_per_million = 1000.0
    trace = Trace(trace_dir=str(tmp_path / "t"), enabled=True)
    router = ClientRouter(config, mock=True)
    ctx = ContextConfig(strategy="summarize", triggers={"max_tokens": 50}, keep_last_turns=2)
    summarizer = make_summarizer(router.client_for, config, ctx, trace)

    fitted = fit(_conversation(10), ctx, summarizer=summarizer)

    assert any("Done (mock)" in (m.get("content") or "") for m in fitted)  # summary injected
    assert trace.total_tokens > 0 and trace.cost_usd > 0  # accounted, not dropped
    events = [json.loads(line) for line in trace.path.read_text().splitlines()]
    assert any(e["event"] == "compaction" for e in events)
    trace.close()


