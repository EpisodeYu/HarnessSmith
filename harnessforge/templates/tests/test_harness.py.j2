def test_confirm_allow_always_runs_and_persists_remaining_policy(tmp_path):
    """allow_always runs the tool, stops asking this session, AND persists the tool
    out of the policy (the callback receives the remaining set to write back)."""
    from {{ project_slug }}.harness.interaction import (
        AskResponse,
        ToolConfirmer,
        using_asker,
        using_confirmer,
    )

    registry = _danger_registry()
    config = _config(tmp_path, tools=[{"name": "danger", "enabled": True}], confirm="high")
    persisted: list = []
    confirmer = ToolConfirmer(
        registry.confirm_names(config.confirm),
        persist=lambda remaining: persisted.append(sorted(remaining)),
    )
    asker = _FakeAsker(AskResponse(option_ids=["allow_always"]))
    client = MockLLM(script=[ScriptedCall("danger", {}), ScriptedCall("danger", {}), "done"])
    with using_asker(asker), using_confirmer(confirmer):
        result = run("go", client=client, config=config, registry=registry)

    assert len(asker.requests) == 1  # always-allow also stops asking this session
    assert persisted == [[]]  # danger removed -> nothing left to confirm
    tool_msgs = [m for m in result.messages if m.get("role") == "tool"]
    assert [m["content"] for m in tool_msgs] == ["ran", "ran"]


