def test_cli_asker_parses_options_and_free_text(monkeypatch):
    """CliAsker maps a typed number to the chosen option id, other text to a
    free-text answer, and a blank line to a skip (injected fake stdin)."""
    import typer

    from {{ project_slug }}.harness.interaction import AskRequest, Option
    from {{ project_slug }}.interfaces.cli import CliAsker

    req = AskRequest(
        kind="question", prompt="Pick",
        options=[Option("0", "A"), Option("1", "B")], allow_text=True,
    )

    monkeypatch.setattr(typer, "prompt", lambda *a, **k: "2")
    assert CliAsker().ask(req).option_ids == ["1"]  # "2" -> the 2nd option's id

    monkeypatch.setattr(typer, "prompt", lambda *a, **k: "a custom answer")
    typed = CliAsker().ask(req)
    assert typed.text == "a custom answer" and typed.option_ids == []

    monkeypatch.setattr(typer, "prompt", lambda *a, **k: "")
    skipped = CliAsker().ask(req)
    assert skipped.option_ids == [] and skipped.text is None


def test_cli_asker_other_option_prompts_for_custom_text(monkeypatch):
    """Cursor-style: with options + free text the last entry is 'Other'; picking it
    (here index 3) prompts again for the custom answer, returned as text."""
    import typer

    from {{ project_slug }}.harness.interaction import AskRequest, Option
    from {{ project_slug }}.interfaces.cli import CliAsker

    req = AskRequest(
        kind="question", prompt="Pick",
        options=[Option("0", "A"), Option("1", "B")], allow_text=True,
    )
    answers = iter(["3", "my own answer"])  # pick "Other" (the 3rd entry), then type
    monkeypatch.setattr(typer, "prompt", lambda *a, **k: next(answers))
    resp = CliAsker().ask(req)
    assert resp.option_ids == [] and resp.text == "my own answer"


