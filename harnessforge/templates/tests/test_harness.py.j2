def test_context_truncate_is_noop_without_limit():
    messages = _conversation(8)
    fitted = fit(messages, ContextConfig(strategy="truncate"))
    assert fitted == messages


def test_context_truncate_keeps_system_and_recent_turns():
    messages = _conversation(10)
    ctx = ContextConfig(strategy="truncate", max_context_tokens=50, keep_last_turns=2)
    fitted = fit(messages, ctx)

    assert estimate_tokens(messages) > 50
    assert fitted[0]["role"] == "system"
    assert fitted[1]["role"] == "user"  # clean turn boundary
    assert len(fitted) < len(messages)
    assert fitted[-1] is messages[-1]  # most recent message preserved


def test_context_summarize_injects_summary():
    messages = _conversation(10)
    ctx = ContextConfig(strategy="summarize", max_context_tokens=50, keep_last_turns=2)
    fitted = fit(messages, ctx, summarizer=MockLLM(final="SUMMARY TEXT"))

    assert fitted[0]["role"] == "system"
    assert any("SUMMARY TEXT" in (m.get("content") or "") for m in fitted)
    assert len(fitted) < len(messages)
