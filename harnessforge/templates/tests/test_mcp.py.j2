"""MCP bridge tests: a real stdio tool call, allowlist filtering, transport
selection. Spins up the local stdio dummy server — no network, no API key.
Generated only when ``mcp.enabled``."""

from __future__ import annotations

import json
import sys
from pathlib import Path

import pytest

from {{ project_slug }}.harness.config import Config, McpConfig, McpServerConfig
from {{ project_slug }}.harness.mcp import McpManager, _bearer_headers, register_mcp_tools
from {{ project_slug }}.harness.prompts import build_system_prompt
from {{ project_slug }}.harness.tools import HIGH, SAFE, Registry, ToolError

DUMMY = str(Path(__file__).parent / "_mcp_dummy_server.py")


def _config(tools, servers=None):
    data = {
        "llms": [{"name": "default", "model": "m"}],
        "roles": {"generation": "default"},
        "tools": tools,
        "observability": {"trace": False},
    }
    if servers is not None:
        data["mcp"] = {"servers": servers}
    return Config.model_validate(data)


@pytest.fixture
def manager():
    mgr = McpManager(
        McpConfig(servers=[McpServerConfig(name="dummy", command=sys.executable, args=[DUMMY])])
    )
    mgr.start()
    yield mgr
    mgr.close()


def test_stdio_discovers_and_calls_tool(manager):
    assert "dummy" in manager.discovered, manager.errors
    names = {tool.name for tool in manager.discovered["dummy"]}
    assert {"echo", "add"} <= names

    registry = Registry()
    registered = register_mcp_tools(_config([{"name": "dummy__echo", "enabled": True}]), manager, registry)

    assert registered == ["dummy__echo"]
    assert registry.get("dummy__echo").risk == HIGH  # MCP tools default to high-risk
    assert "hello" in registry.call("dummy__echo", json.dumps({"text": "hello"}))


def test_non_allowlisted_tool_is_not_registered(manager):
    registry = Registry()
    # `add` is discovered but not in the allowlist -> it must not be registered.
    register_mcp_tools(_config([{"name": "dummy__echo", "enabled": True}]), manager, registry)

    assert "add" in {tool.name for tool in manager.discovered["dummy"]}
    with pytest.raises(ToolError):
        registry.get("dummy__add")


def test_disabled_allowlist_entry_is_not_registered(manager):
    registry = Registry()
    registered = register_mcp_tools(_config([{"name": "dummy__echo", "enabled": False}]), manager, registry)
    assert registered == []


def test_safe_tools_grade_risk_and_read_only_paradigms_see_them(manager):
    """`safe_tools` marks read-only tools as risk=safe; everything else is high.

    Read-only paradigms (plan/ask) call active_names(allow_high_risk=False), so a
    high-risk MCP tool is dropped while a safe one is still offered.
    """
    registry = Registry()
    config = _config(
        [
            {"name": "dummy__echo", "enabled": True},
            {"name": "dummy__add", "enabled": True},
        ],
        servers=[
            {"name": "dummy", "command": sys.executable, "args": [DUMMY], "safe_tools": ["echo"]}
        ],
    )
    register_mcp_tools(config, manager, registry)

    assert registry.get("dummy__echo").risk == SAFE
    assert registry.get("dummy__add").risk == HIGH

    enabled = config.enabled_tool_names()
    read_only = registry.active_names(enabled, allow_high_risk=False)
    assert "dummy__echo" in read_only
    assert "dummy__add" not in read_only


def test_environment_note_surfaces_disabled_capabilities():
    """The system prompt names the host OS and any installed-but-disabled server,
    so a turned-off capability (e.g. shell/file write) is never silently missing."""
    config = Config.model_validate(
        {
            "llms": [{"name": "default", "model": "m"}],
            "roles": {"generation": "default"},
            "prompts": {"system": "You are a test agent."},
            "tools": [
                {"name": "git__git_status", "enabled": True},  # git is active
                {"name": "shellbox__run", "enabled": False},  # shellbox stays dormant
            ],
            "observability": {"trace": False},
            "mcp": {
                "servers": [
                    {"name": "git", "command": "uvx", "args": ["mcp-server-git"], "safe_tools": ["git_status"]},
                    {"name": "shellbox", "description": "Run shell commands.", "command": "x"},
                ]
            },
        }
    )
    prompt = build_system_prompt(config)
    assert "host OS is" in prompt  # OS/shell awareness for correct commands
    assert "- shellbox" in prompt and "Run shell commands." in prompt  # dormant surfaced
    assert "- git" not in prompt  # active server is not listed as disabled


def test_windows_wraps_cmd_shim_for_stdio(monkeypatch):
    """On Windows, .cmd/.bat shims (npx) are launched via `cmd /c`; .exe is direct.

    Windows CreateProcess cannot exec a .cmd batch shim, so a bare `npx` fails with
    WinError 2 — wrapping it in `cmd /c` is what makes it spawn.
    """
    import shutil

    from {{ project_slug }}.harness.mcp import _windows_stdio_command

    monkeypatch.setattr(sys, "platform", "win32")
    monkeypatch.setattr(
        shutil,
        "which",
        lambda c: r"C:\Program Files\nodejs\npx.cmd" if c == "npx" else r"C:\uv\uvx.exe",
    )

    assert _windows_stdio_command("npx", ["-y", "pkg"]) == ("cmd", ["/c", "npx", "-y", "pkg"])
    assert _windows_stdio_command("uvx", ["pkg"]) == ("uvx", ["pkg"])


def test_non_windows_leaves_stdio_command_untouched(monkeypatch):
    from {{ project_slug }}.harness.mcp import _windows_stdio_command

    monkeypatch.setattr(sys, "platform", "linux")
    assert _windows_stdio_command("npx", ["-y", "pkg"]) == ("npx", ["-y", "pkg"])


def test_remote_server_injects_bearer_header(monkeypatch):
    monkeypatch.setenv("MY_MCP_TOKEN", "secret-123")
    server = McpServerConfig(name="r", url="https://example.com/mcp", auth_env="MY_MCP_TOKEN")
    assert _bearer_headers(server) == {"Authorization": "Bearer secret-123"}


def test_server_requires_exactly_one_transport():
    with pytest.raises(Exception):
        McpServerConfig(name="bad")  # neither command nor url
    with pytest.raises(Exception):
        McpServerConfig(name="bad", command="x", url="https://y")  # both


def test_transport_field_selects_kind_and_validates():
    """`transport` (stdio/http/sse) is inferred from shape when unset, explicit
    otherwise — `sse` is the legacy transport for older remote servers."""
    assert McpServerConfig(name="s", command="x").kind == "stdio"
    assert McpServerConfig(name="r", url="https://x/mcp").kind == "http"
    assert McpServerConfig(name="r", url="https://x/sse", transport="sse").kind == "sse"
    assert McpServerConfig(name="r", url="https://x/mcp", transport="http").kind == "http"
    with pytest.raises(Exception):  # transport must match the shape
        McpServerConfig(name="bad", url="https://x", transport="stdio")
    with pytest.raises(Exception):
        McpServerConfig(name="bad", command="x", transport="http")


def test_status_reports_connection_and_tool_count(manager):
    """`McpManager.status()` is the source of truth the management page reads."""
    rows = {r["name"]: r for r in manager.status()}
    assert rows["dummy"]["connected"] is True
    assert rows["dummy"]["transport"] == "stdio"
    assert rows["dummy"]["error"] is None
    assert rows["dummy"]["tool_count"] >= 2


def test_sync_mcp_tools_resyncs_registry(manager):
    """sync_mcp_tools keeps the registry in lock-step with the allowlist: it drops
    every prior MCP entry, then re-registers the currently-allowlisted ones."""
    from {{ project_slug }}.harness.mcp import sync_mcp_tools

    registry = Registry()
    sync_mcp_tools(_config([{"name": "dummy__echo", "enabled": True}]), manager, registry)
    assert registry.get("dummy__echo")
    with pytest.raises(ToolError):
        registry.get("dummy__add")
    # Enable add too -> resync registers it (without dropping echo).
    sync_mcp_tools(
        _config([{"name": "dummy__echo", "enabled": True}, {"name": "dummy__add", "enabled": True}]),
        manager,
        registry,
    )
    assert registry.get("dummy__echo") and registry.get("dummy__add")
    # Disable echo -> resync removes it.
    sync_mcp_tools(_config([{"name": "dummy__add", "enabled": True}]), manager, registry)
    with pytest.raises(ToolError):
        registry.get("dummy__echo")


def test_connects_multiple_servers_concurrently():
    """Each server gets its own task and connects in parallel; all are discovered.

    Exercises the per-server-task lifecycle (>1 server) the concurrent connect path
    relies on — both sessions are usable and tear down cleanly on close().
    """
    mgr = McpManager(
        McpConfig(
            servers=[
                McpServerConfig(name="a", command=sys.executable, args=[DUMMY]),
                McpServerConfig(name="b", command=sys.executable, args=[DUMMY]),
            ]
        )
    )
    mgr.start()
    try:
        assert "a" in mgr.discovered and "b" in mgr.discovered, mgr.errors
        registry = Registry()
        register_mcp_tools(
            _config([{"name": "a__echo", "enabled": True}, {"name": "b__add", "enabled": True}]),
            mgr,
            registry,
        )
        assert "hi" in registry.call("a__echo", json.dumps({"text": "hi"}))
        assert "5" in registry.call("b__add", json.dumps({"a": 2, "b": 3}))
    finally:
        mgr.close()


def test_rebuild_manager_reconnects(manager):
    """rebuild_manager starts a fresh manager (and closes the old) for hot-reconnect."""
    from {{ project_slug }}.harness.mcp import rebuild_manager

    cfg = McpConfig(
        servers=[McpServerConfig(name="dummy", command=sys.executable, args=[DUMMY])]
    )
    new = rebuild_manager(manager, cfg)
    try:
        assert "dummy" in new.discovered
    finally:
        new.close()
