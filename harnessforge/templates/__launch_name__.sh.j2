#!/usr/bin/env bash
# One-click launcher for {{ display_name }} - generated by HarnessForge.
#
# Double-click it, or run it from a terminal. It prefers `uv` (which auto-syncs
# dependencies on the first run); if uv is missing it offers to install it
# (user-level, no root). {% if interfaces.web %}Starts the web UI and opens it in your browser.{% else %}Starts an interactive chat in this terminal.{% endif %}
set -e
echo "[{{ project_slug }}] One-click launcher (generated by HarnessForge)"
cd "$(dirname "$0")"
echo "[{{ project_slug }}] Folder: $PWD"

{% if interfaces.web %}action=(serve --open)   # web UI; opens your browser
{% else %}action=(chat)            # interactive chat in this terminal
{% endif %}echo "[{{ project_slug }}] Action: ${action[*]}"
# Behind a proxy? Export HTTP_PROXY / HTTPS_PROXY before running this and uv sync +
# npx/uvx servers inherit it. (macOS GUI-only proxy: the product reads it for npx
# itself; for uv sync set the env vars.)
{% if spec.mcp.enabled and mcp_needs_node %}
# A Node-based MCP server (e.g. desktop-commander via npx) needs Node.js. uvx
# servers ride uv, but Node has no runtime on many machines — offer a user-local
# portable Node (not bundled in the repo) and put it on PATH for this session.
ensure_node() {
  command -v node >/dev/null 2>&1 && command -v npx >/dev/null 2>&1 && return 0
  local osname arch nodeos nodearch base dir url tarball root nc
  osname="$(uname -s)"; arch="$(uname -m)"
  case "$osname" in Linux) nodeos=linux;; Darwin) nodeos=darwin;; *) return 0;; esac
  case "$arch" in x86_64|amd64) nodearch=x64;; arm64|aarch64) nodearch=arm64;; *) return 0;; esac
  root="$HOME/.local/share/{{ project_slug }}"
  dir="$root/node-{{ node_version }}-${nodeos}-${nodearch}"
  if [ -x "$dir/bin/node" ]; then export PATH="$dir/bin:$PATH"; return 0; fi
  command -v curl >/dev/null 2>&1 || { echo "[{{ project_slug }}] desktop-commander needs Node (and curl to fetch it); skipping." >&2; return 0; }
  echo "[{{ project_slug }}] A Node-based MCP tool (desktop-commander) needs Node.js, which isn't installed."
  echo "    [1] Standard - download Node from nodejs.org"
  echo "    [2] China mirror - download Node from npmmirror.com"
  echo "    [n] Skip (that tool stays off; everything else still works)"
  printf "  Choose [1/2/n]: "
  read -r nc </dev/tty 2>/dev/null || nc=1
  case "$nc" in n|N) return 0;; esac
  base="https://nodejs.org/dist"
  [ "$nc" = "2" ] && base="https://npmmirror.com/mirrors/node"
  tarball="node-{{ node_version }}-${nodeos}-${nodearch}.tar.gz"
  url="$base/{{ node_version }}/$tarball"
  echo "[{{ project_slug }}] Downloading $url (one-time setup) ..."
  mkdir -p "$root"
  if curl -fsSL "$url" -o "$root/$tarball" && tar -xzf "$root/$tarball" -C "$root"; then
    rm -f "$root/$tarball"
    if [ -x "$dir/bin/node" ]; then export PATH="$dir/bin:$PATH"; echo "[{{ project_slug }}] Node is ready: $(node -v)"; fi
  else
    echo "[{{ project_slug }}] Node download failed - desktop-commander stays off. Install Node from https://nodejs.org and re-run." >&2
  fi
  return 0
}
ensure_node
{% endif %}
find_uv() {
  if command -v uv >/dev/null 2>&1; then echo uv; return 0; fi
  [ -x "$HOME/.local/bin/uv" ] && { echo "$HOME/.local/bin/uv"; return 0; }
  return 1
}

# Auto-pick the package index: when no index is pinned and the official PyPI is
# unreachable (e.g. behind the GFW), use the Tsinghua mirror for this run so the
# first `uv sync` can still fetch deps. An explicit UV_DEFAULT_INDEX always wins;
# we only probe when curl is available.
pick_index() {
  [ -n "${UV_DEFAULT_INDEX:-}" ] && return 0
  command -v curl >/dev/null 2>&1 || return 0
  echo "[{{ project_slug }}] Checking whether PyPI is reachable ..."
  if curl -sS -m 3 -I https://pypi.org/simple/ >/dev/null 2>&1; then return 0; fi
  echo "[{{ project_slug }}] PyPI looks unreachable - using the Tsinghua mirror this run."
  export UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
}

echo "[{{ project_slug }}] Looking for uv ..."
uv_bin="$(find_uv || true)"
if [ -z "$uv_bin" ]; then
  # No uv yet: an already-installed {{ project_slug }} command works too.
  if command -v {{ project_slug }} >/dev/null 2>&1; then
    echo "[{{ project_slug }}] Found the {{ project_slug }} command; launching ..."
    exec {{ project_slug }} "${action[@]}"
  fi
  echo "[{{ project_slug }}] uv is not installed yet. How would you like to install it?"
  echo "    [1] Standard - official installer (downloads from GitHub)"
  echo "    [2] China mirror - pip + Tsinghua mirror (needs python3 already installed)"
  echo "    [n] Don't install"
  printf "  Choose [1/2/n]: "
  read -r choice </dev/tty 2>/dev/null || choice=1
  case "$choice" in
    [Nn]*) ;;
    2)
      if command -v python3 >/dev/null 2>&1; then py=python3
      elif command -v python >/dev/null 2>&1; then py=python
      else py=; fi
      if [ -n "$py" ]; then
        echo "[{{ project_slug }}] Installing uv via pip + Tsinghua mirror ..."
        "$py" -m pip install --user uv -i https://pypi.tuna.tsinghua.edu.cn/simple || true
        if "$py" -m uv --version >/dev/null 2>&1; then
          export UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
          export UV_PYTHON_PREFERENCE=only-system
          echo "[{{ project_slug }}] Launching: $py -m uv run {{ project_slug }} ${action[*]}"
          exec "$py" -m uv run {{ project_slug }} "${action[@]}"
        fi
      fi
      echo "[{{ project_slug }}] China path needs python3 first (then: pip install uv -i <Tsinghua>)." >&2
      ;;
    *)
      echo "[{{ project_slug }}] Installing uv via the official installer ..."
      curl -LsSf https://astral.sh/uv/install.sh | sh \
        || echo "[{{ project_slug }}] uv install failed; see https://docs.astral.sh/uv/" >&2 ;;
  esac
  uv_bin="$(find_uv || true)"
fi

if [ -n "$uv_bin" ]; then
  pick_index
  echo "[{{ project_slug }}] Launching: $uv_bin run {{ project_slug }} ${action[*]}"
  exec "$uv_bin" run {{ project_slug }} "${action[@]}"
fi

echo "[{{ project_slug }}] Could not find or install uv. Install it (user-level, no root):" >&2
echo "    curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
echo "    - or (China) -  pip install uv -i https://pypi.tuna.tsinghua.edu.cn/simple" >&2
echo "  then re-run this script." >&2
exit 1
