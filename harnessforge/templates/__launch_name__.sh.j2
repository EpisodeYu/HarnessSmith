#!/usr/bin/env bash
# One-click launcher for {{ display_name }} - generated by HarnessForge.
#
# Double-click it, or run it from a terminal. It prefers `uv` (which auto-syncs
# dependencies on the first run) and falls back to an installed `{{ project_slug }}`
# command.
set -e
cd "$(dirname "$0")"

{% if interfaces.web %}action=(serve --open)   # start the web UI and open it in your browser
{% else %}action=(chat)            # interactive chat in this terminal
{% endif %}
if command -v uv >/dev/null 2>&1; then
  exec uv run {{ project_slug }} "${action[@]}"
elif command -v {{ project_slug }} >/dev/null 2>&1; then
  exec {{ project_slug }} "${action[@]}"
else
  echo "Could not find 'uv' or '{{ project_slug }}' on your PATH." >&2
  echo "Install uv (https://docs.astral.sh/uv/) - recommended - then re-run this," >&2
  echo "or run 'pip install -e .' in this folder to install the {{ project_slug }} command." >&2
  exit 1
fi
