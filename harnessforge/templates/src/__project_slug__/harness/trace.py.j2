"""Per-run observability: a JSONL trace plus token / cost accounting.

Each run writes one ``.jsonl`` file under the trace dir; every line is one event
(``run_start``, ``llm_response``, ``tool_call``, ``tool_result``, ``run_end``).
Token and USD totals accumulate on the :class:`Trace` so the loop can enforce a
cost budget and the CLI can print a summary. No secrets are written — only
message roles, tool names, arguments, and counts.
"""

from __future__ import annotations

import json
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

from .config import LLMProfileConfig
from .debuglog import trace_event
from .llm import Usage


def compute_cost(usage: Usage, profile: LLMProfileConfig) -> float:
    """Cost of one response given the profile's per-1M-token prices.

    Currency-agnostic: the profile prices are whatever currency you filled in.
    Provider-cached prompt tokens bill at ``cached_input_cost_per_million`` when
    that price is set; left 0 they fall back to the full input price (so an unset
    cached price never spuriously under-counts).
    """
    cached = max(0, usage.cached_prompt_tokens)
    fresh_prompt = max(0, usage.prompt_tokens - cached)
    cached_price = profile.cached_input_cost_per_million or profile.input_cost_per_million
    return (
        fresh_prompt / 1_000_000 * profile.input_cost_per_million
        + cached / 1_000_000 * cached_price
        + usage.completion_tokens / 1_000_000 * profile.output_cost_per_million
    )


@dataclass
class Trace:
    run_id: str = field(default_factory=lambda: uuid.uuid4().hex[:12])
    trace_dir: str | None = None
    enabled: bool = True
    prompt_tokens: int = 0
    completion_tokens: int = 0
    cached_prompt_tokens: int = 0
    cost_usd: float = 0.0
    # Optional persistent per-LLM cost ledger (``harness/usage.py``). When set,
    # every ``add_usage`` also records the response's tokens under its profile
    # name so cost accrues across runs (the Budget page / cost limits read it).
    # The entry points (CLI / web) attach one; left None there's no persistence.
    ledger: Any = None
    _path: Path | None = field(default=None, init=False, repr=False)
    _fh: Any = field(default=None, init=False, repr=False)

    def __post_init__(self) -> None:
        if self.enabled and self.trace_dir:
            directory = Path(self.trace_dir)
            directory.mkdir(parents=True, exist_ok=True)
            self._path = directory / f"run-{self.run_id}.jsonl"
            self._fh = self._path.open("a", encoding="utf-8")

    @property
    def path(self) -> Path | None:
        return self._path

    @property
    def total_tokens(self) -> int:
        return self.prompt_tokens + self.completion_tokens

    def event(self, kind: str, **data: Any) -> None:
        record = {"ts": time.time(), "run_id": self.run_id, "event": kind, **data}
        if self._fh is not None:
            self._fh.write(json.dumps(record, ensure_ascii=False) + "\n")
            self._fh.flush()
        # Mirror into the opt-in debug log (content fields stripped there) even
        # when the JSONL trace itself is disabled.
        trace_event(kind, {"run_id": self.run_id, **data})

    def add_usage(self, usage: Usage, profile: LLMProfileConfig) -> float:
        """Accumulate token counts and cost; return this response's cost."""
        self.prompt_tokens += usage.prompt_tokens
        self.completion_tokens += usage.completion_tokens
        self.cached_prompt_tokens += usage.cached_prompt_tokens
        cost = compute_cost(usage, profile)
        self.cost_usd += cost
        # Persist this call's tokens under its profile so per-LLM cost accrues
        # across runs (generation + compaction both reach here). No-op when no
        # ledger is attached (e.g. a bare unit-test Trace).
        if self.ledger is not None:
            self.ledger.record(profile.name, usage)
        return cost

    def close(self) -> None:
        if self._fh is not None:
            self._fh.close()
            self._fh = None
