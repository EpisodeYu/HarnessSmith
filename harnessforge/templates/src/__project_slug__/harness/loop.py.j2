"""The agent loop: native function-calling (Think -> Act -> Observe), no framework.

One :func:`run` drives a whole turn: ask the model, execute any tool calls it
requests, feed results back, repeat until it answers or a budget/limit is hit.
Hooks fire around each step and tool; the trace records everything; budgets
(steps / seconds / cost) stop a runaway loop. This is the heart of the harness
and it is intentionally small — read it, edit it, own it.
"""

from __future__ import annotations

import time
from dataclasses import dataclass

from .config import Config
from .hooks import Hooks
from .llm import LLMClient, LLMResponse, ToolCall
from .prompts import build_system_prompt
from .tools import Registry
from .tools import registry as default_registry
from .trace import Trace


@dataclass
class RunResult:
    answer: str
    steps: int
    # "final" | "max_steps" | "max_seconds" | "max_tokens" | "max_cost"
    stop_reason: str
    trace: Trace


def run(
    user_input: str,
    *,
    client: LLMClient,
    config: Config,
    role: str = "generation",
    registry: Registry = default_registry,
    hooks: Hooks | None = None,
    trace: Trace | None = None,
) -> RunResult:
    """Run one turn of the agent loop and return the final answer + telemetry."""
    hooks = hooks or Hooks()
    profile = config.profile_for(role)
    if trace is None:
        obs = config.observability
        trace = Trace(trace_dir=obs.trace_dir if obs.trace else None, enabled=obs.trace)

    budget = config.budget
    active = registry.active_names(config.enabled_tool_names())
    tool_schemas = registry.schemas(active)

    messages: list[dict] = [
        {"role": "system", "content": build_system_prompt(config)},
        {"role": "user", "content": user_input},
    ]
    trace.event("run_start", role=role, model=profile.model, tools=active)
    started = time.monotonic()

    step = 0
    stop_reason = "final"
    answer = ""
    while True:
        if budget.max_steps is not None and step >= budget.max_steps:
            stop_reason, answer = "max_steps", _limit_message("step", budget.max_steps)
            break
        if (
            budget.max_seconds is not None
            and time.monotonic() - started >= budget.max_seconds
        ):
            stop_reason, answer = "max_seconds", _limit_message("time", budget.max_seconds)
            break

        hooks.before_step(step, messages)
        try:
            response = client.complete(messages, tool_schemas or None)
        except Exception as exc:
            hooks.on_error("llm", exc)
            trace.event("error", where="llm", error=str(exc))
            trace.close()
            raise

        cost = trace.add_usage(response.usage, profile)
        trace.event(
            "llm_response",
            step=step,
            has_tool_calls=bool(response.tool_calls),
            prompt_tokens=response.usage.prompt_tokens,
            completion_tokens=response.usage.completion_tokens,
            step_cost_usd=cost,
        )
        hooks.after_step(step, response)

        if budget.max_tokens is not None and trace.total_tokens >= budget.max_tokens:
            stop_reason, answer = "max_tokens", _limit_message("token", budget.max_tokens)
            break
        if budget.max_cost_usd is not None and trace.cost_usd >= budget.max_cost_usd:
            stop_reason, answer = "max_cost", _limit_message("cost", budget.max_cost_usd)
            break

        if not response.tool_calls:
            answer, stop_reason = response.content or "", "final"
            break

        messages.append(_assistant_message(response))
        for call in response.tool_calls:
            result = _run_tool(registry, call, hooks, trace)
            messages.append(
                {"role": "tool", "tool_call_id": call.id, "content": result}
            )
        step += 1

    trace.event(
        "run_end",
        stop_reason=stop_reason,
        steps=step,
        total_tokens=trace.total_tokens,
        cost_usd=trace.cost_usd,
    )
    trace.close()
    return RunResult(answer=answer, steps=step, stop_reason=stop_reason, trace=trace)


def _assistant_message(response: LLMResponse) -> dict:
    return {
        "role": "assistant",
        "content": response.content or "",
        "tool_calls": [
            {
                "id": call.id,
                "type": "function",
                "function": {"name": call.name, "arguments": call.arguments},
            }
            for call in response.tool_calls
        ],
    }


def _run_tool(registry: Registry, call: ToolCall, hooks: Hooks, trace: Trace) -> str:
    """Execute one tool call; tool errors are captured, never crash the loop."""
    hooks.before_tool(call)
    trace.event("tool_call", name=call.name, arguments=call.arguments)
    try:
        result = registry.call(call.name, call.arguments)
    except Exception as exc:
        hooks.on_error("tool", exc)
        result = f"ERROR: {exc}"
    trace.event("tool_result", name=call.name, result=result)
    hooks.after_tool(call, result)
    return result


def _limit_message(kind: str, limit: object) -> str:
    return f"Stopped: {kind} budget ({limit}) reached before a final answer."
