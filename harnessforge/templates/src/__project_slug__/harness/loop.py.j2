"""The loop entry point: pick a paradigm by name and run it.

Slice 5 turned the single loop into a small **paradigm registry** under
``harness/paradigms/`` (agent / plan / ask, each self-contained). This module is
now a thin dispatcher: resolve the requested ``mode`` (defaulting to
``config.paradigms.default``), check it is enabled, and hand off to the
registered paradigm. It is a written-out name->callable dispatch over a fixed,
already-registered set — not a runtime "paradigm engine".

``from .loop import run`` is the stable entry the CLI / web / tests use, and
``RunResult`` is re-exported here so existing imports keep working. The actual
loop you want to read/edit lives in ``harness/paradigms/<name>.py``.
"""

from __future__ import annotations

from collections.abc import Callable

from .config import Config
from .hooks import Hooks
from .llm import LLMClient
from .paradigms import RunResult, get_paradigm
from .tools import Registry
from .tools import registry as default_registry
from .trace import Trace

__all__ = ["run", "RunResult"]


def run(
    user_input: str,
    *,
    mode: str | None = None,
    client: LLMClient | None = None,
    client_for: Callable[[str], LLMClient] | None = None,
    config: Config,
    role: str = "generation",
    registry: Registry = default_registry,
    hooks: Hooks | None = None,
    trace: Trace | None = None,
    on_delta: Callable[[str], None] | None = None,
    history: list[dict] | None = None,
    cancel: Callable[[], bool] | None = None,
    checkpoint: Callable[[list[dict]], None] | None = None,
) -> RunResult:
    """Run one turn using paradigm ``mode`` (defaults to ``config.paradigms.default``).

    Raises ``ValueError`` if ``mode`` is not in ``config.paradigms.enabled`` or is
    not a registered paradigm. Every other argument is forwarded unchanged to the
    selected paradigm, so the call site is identical to the old single loop.
    ``history`` is prior conversation messages (no system prompt) to resume from.
    ``cancel`` is a cooperative stop predicate (checked at each step boundary and
    forwarded to the LLM stream so Stop / Ctrl-C cut generation mid-token);
    ``checkpoint`` is called with the conversation body after each completed step
    (write-ahead, so a crash mid-turn still leaves resumable work on disk).
    """
    paradigms = config.paradigms
    name = mode or paradigms.default
    if name not in paradigms.enabled:
        raise ValueError(
            f"paradigm {name!r} is not enabled; enabled paradigms: {paradigms.enabled}"
        )
    paradigm = get_paradigm(name)
    return paradigm(
        user_input,
        client=client,
        client_for=client_for,
        config=config,
        role=role,
        registry=registry,
        hooks=hooks,
        trace=trace,
        on_delta=on_delta,
        history=history,
        cancel=cancel,
        checkpoint=checkpoint,
    )
