{% endif %}
class Config(BaseModel):
    model_config = ConfigDict(extra="forbid")

    version: str = "0.1"
    project_slug: str = "agent_harness"
    llms: list[LLMProfileConfig] = Field(default_factory=list)
    roles: dict[str, str] = Field(default_factory=dict)
    prompts: PromptsConfig = Field(default_factory=PromptsConfig)
    tools: list[ToolConfig] = Field(default_factory=list)
    context: ContextConfig = Field(default_factory=ContextConfig)
    paradigms: ParadigmsConfig = Field(default_factory=ParadigmsConfig)
    observability: ObservabilityConfig = Field(default_factory=ObservabilityConfig)
    budget: BudgetConfig = Field(default_factory=BudgetConfig)
{% if spec.mcp.enabled %}    mcp: McpConfig = Field(default_factory=McpConfig)
{% endif %}{% if spec.skills.enabled %}    skills: SkillsConfig = Field(default_factory=SkillsConfig)
{% endif %}
    # Forward-compatible passthrough — declared so a richer spec still loads,
    # but not interpreted in this slice.
    rag: dict[str, Any] | None = None
    secrets: dict[str, Any] | None = None

    @model_validator(mode="before")
    @classmethod
    def _empty_sections_to_defaults(cls, data: Any) -> Any:
        if isinstance(data, dict):
            empties: dict[str, Any] = {
                "llms": [], "roles": {}, "tools": [],
                "prompts": {}, "context": {}, "paradigms": {},
                "observability": {}, "budget": {},
            }
            for key, default in empties.items():
                if key in data and data[key] is None:
                    data[key] = default
        return data

    def profile_for(self, role: str = "generation") -> LLMProfileConfig:
        """Return the LLM profile bound to ``role`` (single profile in Slice 1)."""
        name = self.roles.get(role)
        if name is None:
            if self.llms:
                return self.llms[0]
            raise ConfigError(f"no LLM profile configured for role {role!r}")
        for profile in self.llms:
            if profile.name == name:
                return profile
        raise ConfigError(f"role {role!r} points at unknown profile {name!r}")

    def enabled_tool_names(self) -> set[str]:
        """The allowlist: only these tools are offered to the model."""
        return {tool.name for tool in self.tools if tool.enabled}


def _env_file_values() -> dict[str, str]:
    try:
        return {key.upper(): str(value) for key, value in _EnvFile().model_dump().items()}
    except Exception:
        return {}


def resolve_env(name: str | None) -> str | None:
    """Resolve an env-var by NAME from the process env, then ``.env``."""
    if not name:
        return None
    if name in os.environ:
        return os.environ[name]
    return _env_file_values().get(name.upper())


def load_config(path: str | Path = DEFAULT_CONFIG_PATH) -> Config:
    """Load and validate ``config.yaml``."""
    path = Path(path)
    if not path.exists():
        raise ConfigError(f"config file not found: {path}")
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        raise ConfigError("config.yaml must be a YAML mapping at the top level")
    return Config.model_validate(data)
