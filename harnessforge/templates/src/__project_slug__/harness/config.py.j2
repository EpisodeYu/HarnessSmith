class McpServerConfig(BaseModel):
    """One MCP server. Set exactly one transport: ``command`` (stdio) or ``url``.

    Runtime-only (this slice adds no spec fields). Secrets are referenced by
    env-var NAME (``env`` / ``auth_env``), never stored as values.

    ``transport`` is optional and disambiguates a ``url`` server: ``http`` (the
    modern Streamable HTTP, default for a ``url``) or ``sse`` (the older HTTP+SSE
    transport — use it for servers that don't speak Streamable HTTP yet). When
    left unset it is inferred from shape (``command`` -> stdio, ``url`` -> http).
    """

    model_config = ConfigDict(extra="forbid")

    name: str
    description: str = ""  # human/agent-readable capability summary (for prompts/UX)
    # Transport selector (optional; inferred from shape when unset). ``sse`` is the
    # legacy HTTP+SSE transport kept for older remote servers.
    transport: Literal["stdio", "http", "sse"] | None = None
    # stdio transport (launched as a subprocess):
    command: str | None = None
    args: list[str] = Field(default_factory=list)
    env: list[str] = Field(default_factory=list)  # env-var NAMES to inject
    # remote (Streamable HTTP / SSE) transport:
    url: str | None = None
    auth_env: str | None = None  # env-var NAME holding a bearer token
    # Read-only / low-risk tool names (unprefixed). Tools listed here register as
    # risk="safe" (offered even to read-only paradigms like plan/ask); every other
    # discovered tool defaults to risk="high" (mutating; agent-only, opt-in).
    safe_tools: list[str] = Field(default_factory=list)

    @model_validator(mode="after")
    def _one_transport(self) -> "McpServerConfig":
        if bool(self.command) == bool(self.url):
            raise ValueError(
                f"mcp server {self.name!r} must set exactly one of "
                "`command` (stdio) or `url` (remote HTTP/SSE)"
            )
        if self.transport == "stdio" and not self.command:
            raise ValueError(f"mcp server {self.name!r}: transport 'stdio' requires `command`")
        if self.transport in ("http", "sse") and not self.url:
            raise ValueError(
                f"mcp server {self.name!r}: transport {self.transport!r} requires `url`"
            )
        return self

    @property
    def kind(self) -> str:
        """Resolved transport: explicit ``transport`` or inferred from shape."""
        return self.transport or ("stdio" if self.command else "http")


class McpConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    servers: list[McpServerConfig] = Field(default_factory=list)
    # Per-server startup timeout: a server that doesn't connect in time is skipped
    # (failure-isolated), so a slow/missing server never hangs a run. Generous by
    # default because a uvx/npx server's first launch can cold-download its package
    # (slow on Windows / behind the GFW).
    connect_timeout_seconds: float = Field(default=120.0, gt=0)
    # How stdio servers that fetch their package (npx/uvx) reach the network. Left
    # empty, the harness auto-resolves: it reuses the system proxy and probes for a
    # reachable registry (official, else a domestic mirror). Set any of these to
    # override that choice (e.g. a corporate proxy / an internal registry mirror) —
    # values only, never secrets.
    proxy: str | None = None  # e.g. http://host:8080 ; default: the system proxy
    npm_registry: str | None = None  # npx/npm registry URL (default: auto)
    pip_index: str | None = None  # uvx/uv index URL, a PEP 503 simple index (default: auto)


