"""Human-in-the-loop interaction: a thin "pause the loop and ask the user" channel.

A side extension point next to ``tools`` / ``hooks`` — NOT part of the core loop.
Two capabilities share this one round-trip (pause -> push a structured prompt ->
wait for the user -> resume):

- **ask_question** (a built-in tool): the model itself asks the user a clarifying
  question; the answer comes back as the tool result. See ``tools.ask_question``.
- **tool confirmation** (HITL approval, opt-in): the framework asks before running
  a tool. Same channel, ``kind="approval"``.

The asker is injected via a :class:`contextvars.ContextVar` (``using_asker``) so a
tool function — which only gets its own arguments, not the loop's locals — can
reach the user with ``from .interaction import ask`` without changing any tool
signature or ``run()`` parameter. The context manager wraps a whole turn at the
entry point (CLI / web); a web worker thread sets it itself, since a ContextVar
does not propagate across ``threading.Thread``.

Zero new runtime dependencies (``contextvars`` is stdlib). When no asker is set,
or the asker is non-interactive (a pipe / CI / ``--mock``), it degrades safely:
a question returns a "no user available, use your judgment" note (never hangs the
run) and an approval is rejected (fail-closed).
"""

from __future__ import annotations

from contextlib import contextmanager
from contextvars import ContextVar
from dataclasses import dataclass, field
from typing import Callable, Iterable, Iterator, Literal, Protocol, runtime_checkable

# A question with no user to answer it returns this, so the model proceeds on its
# own best judgment instead of the run hanging on an unanswerable prompt.
NO_USER_NOTE = "(no interactive user available; proceed using your best judgment)"

# HITL tool-confirmation decisions (the option ids the framework offers when a
# tool needs the user's OK before it runs). The four mirror Codex CLI's
# Accept once / Reject / Accept for session / add to policy:
ALLOW_ONCE = "allow_once"      # run it this once; ask again next time
REJECT = "reject"              # don't run it; feed the model an ERROR so it adapts
ALLOW_SESSION = "allow_session"  # stop asking for this tool for this conversation
ALLOW_ALWAYS = "allow_always"  # persist the allow: write the tool out of the policy


@dataclass
class Option:
    """One offered choice: ``id`` is returned in the response, ``label`` is shown."""

    id: str
    label: str


@dataclass
class AskRequest:
    """A structured prompt for the user.

    ``kind`` distinguishes who is asking and what the answer means: ``question``
    (the model wants clarification — the answer becomes a tool result) vs
    ``approval`` (the framework wants to run a tool — the answer allows/denies it).
    ``options`` are the offered choices (the model supplies them for a question;
    HITL fills fixed ones like allow/reject for an approval). ``allow_text`` lets
    the user type a free reply; ``allow_multiple`` lets them pick several.
    ``context`` carries extra display data (e.g. an approval's tool / arguments).
    """

    kind: Literal["question", "approval"]
    prompt: str
    options: list[Option] = field(default_factory=list)
    allow_text: bool = False
    allow_multiple: bool = False
    context: dict = field(default_factory=dict)


@dataclass
class AskResponse:
    """The user's reply: chosen option ids and/or a free-text answer."""

    option_ids: list[str] = field(default_factory=list)
    text: str | None = None

    @property
    def selected(self) -> str | None:
        """The first chosen option id (the single-select convenience)."""
        return self.option_ids[0] if self.option_ids else None


@runtime_checkable
class Asker(Protocol):
    """Anything that can put a request to the user and return their answer.

    Implementations: ``CliAsker`` (terminal), ``WebAsker`` (SSE card + a POST
    back), and :class:`NonInteractiveAsker` (the safe degrade). The call may block
    until the user responds.
    """

    def ask(self, req: AskRequest) -> AskResponse: ...


class NonInteractiveAsker:
    """The fail-safe used when there is no user: a pipe / CI / ``--mock`` / a
    cancelled web run. A question returns the "use your judgment" note so the
    model proceeds (never hangs); an approval is rejected (fail-closed)."""

    def ask(self, req: AskRequest) -> AskResponse:
        if req.kind == "approval":
            reject = next(
                (o.id for o in req.options if o.id in {"reject", "deny", "no"}),
                "reject",
            )
            return AskResponse(option_ids=[reject])
        return AskResponse(text=NO_USER_NOTE)


def noninteractive_response(req: AskRequest) -> AskResponse:
    """The degraded answer for ``req`` — reused when a live asker has to bail out
    (e.g. a web run is stopped while a question is pending)."""
    return NonInteractiveAsker().ask(req)


# The asker for the current turn. Default ``None`` -> ``ask`` falls back to the
# non-interactive degrade, so calling ``ask`` outside ``using_asker`` never raises.
_CURRENT: ContextVar[Asker | None] = ContextVar("current_asker", default=None)


@contextmanager
def using_asker(asker: Asker) -> Iterator[Asker]:
    """Bind ``asker`` as the current asker for the duration of the ``with`` block.

    Wrap a whole turn at the entry point (CLI ``run``/``chat``, the web worker
    thread). Restores the previous asker on exit (ContextVar token reset), so
    nested/sequential turns don't leak into one another.
    """
    token = _CURRENT.set(asker)
    try:
        yield asker
    finally:
        _CURRENT.reset(token)


def ask(req: AskRequest) -> AskResponse:
    """Put ``req`` to the current user and return their answer.

    The single entry every caller (a tool body, an approval boundary) uses. Reads
    the asker from the ContextVar; with none set it degrades via
    :class:`NonInteractiveAsker`, so a question never hangs and an approval is
    rejected.
    """
    asker = _CURRENT.get()
    if asker is None:
        asker = NonInteractiveAsker()
    return asker.ask(req)


# --- HITL tool confirmation (opt-in guardrail) -------------------------------
#
# The second capability on this shared channel: before the loop runs a tool the
# `confirm` policy flagged, pause and ask the user to allow or reject it. A
# GUARDRAIL (threat model A — a trusted user fat-fingering a dangerous tool), NOT
# a security boundary: code you own can bypass it, real isolation is Docker. It
# uses the SAME ``ask()`` round-trip (``kind="approval"``), so non-interactive
# runs and a stopped/disconnected web run reject by default (fail-closed).


def approval_options() -> list[Option]:
    """The four fixed choices shown on a tool-confirmation card."""
    return [
        Option(ALLOW_ONCE, "Allow once"),
        Option(REJECT, "Reject"),
        Option(ALLOW_SESSION, "Allow for this session"),
        Option(ALLOW_ALWAYS, "Always allow"),
    ]


class ToolConfirmer:
    """Decides whether a tool call must pause for the user's OK, and remembers
    session/persistent allows.

    ``needs`` is the set of tool names that require confirmation (derived from the
    ``confirm`` policy — see ``Registry.confirm_names``). :meth:`check` asks unless
    the tool is already allowed for this conversation (``_session``). The decision
    drives the four outcomes: allow once (run, ask again), reject (refuse with an
    ERROR the model can adapt to), allow for session (stop asking this
    conversation), always allow (also call ``persist`` with the remaining ``needs``
    so it is written out of the policy in ``config.yaml``).
    """

    def __init__(
        self,
        needs: Iterable[str],
        *,
        persist: Callable[[set[str]], None] | None = None,
        session: set[str] | None = None,
    ) -> None:
        self.needs = set(needs)
        # Called on "always allow" with the remaining set of names to confirm, so
        # the caller can write it back to config.yaml (a category policy like
        # "high" is frozen to that explicit list — a deliberate persistent choice).
        self._persist = persist
        # Names already allowed for THIS conversation (in-memory; reset on restart).
        # Shared across a chat REPL / web session so "allow for session" sticks.
        self._session = session if session is not None else set()

    def check(self, name: str, arguments: str, risk: str) -> str | None:
        """Decide whether tool ``name`` may run. Returns ``None`` to proceed, or the
        refusal string to feed back as the tool result when the user rejects it.

        A tool not in ``needs``, or already allowed for this conversation, proceeds
        without asking (so confirmation off / a prior allow has zero overhead)."""
        if name not in self.needs or name in self._session:
            return None
        response = ask(
            AskRequest(
                kind="approval",
                prompt=f"Allow the agent to run the tool `{name}`?",
                options=approval_options(),
                allow_text=False,
                context={"tool": name, "arguments": arguments, "risk": risk},
            )
        )
        decision = response.selected or REJECT  # no choice (blank / degrade) = reject
        if decision == REJECT:
            return f"ERROR: user rejected tool {name!r}"
        if decision == ALLOW_SESSION:
            self._session.add(name)
        elif decision == ALLOW_ALWAYS:
            self._session.add(name)  # don't ask again this conversation either
            self.needs.discard(name)
            if self._persist is not None:
                self._persist(set(self.needs))
        return None


# The HITL confirmer for the current turn (parallel to the asker). Default
# ``None`` -> ``confirm_tool`` proceeds, so confirmation off is truly free.
_CURRENT_CONFIRMER: ContextVar[ToolConfirmer | None] = ContextVar(
    "current_confirmer", default=None
)


@contextmanager
def using_confirmer(confirmer: ToolConfirmer | None) -> Iterator[ToolConfirmer | None]:
    """Bind ``confirmer`` as the HITL gate for the duration of the ``with`` block.

    Wrap a whole turn at the entry point (CLI ``run``/``chat``, the web worker
    thread, set inside the thread since a ContextVar doesn't cross threads). A
    ``None`` confirmer means confirmation is off. Restores the previous one on exit.
    """
    token = _CURRENT_CONFIRMER.set(confirmer)
    try:
        yield confirmer
    finally:
        _CURRENT_CONFIRMER.reset(token)


def confirm_tool(name: str, arguments: str, risk: str) -> str | None:
    """Consult the current HITL confirmer at the tool-execution boundary.

    Returns the refusal string when the user rejected the call (fed back as the
    tool result), or ``None`` to proceed — also ``None`` when no confirmer is set
    (confirmation off = run the tool). This is the single entry ``run_tool`` uses,
    mirroring how a tool body reaches the user through ``ask``.
    """
    confirmer = _CURRENT_CONFIRMER.get()
    if confirmer is None:
        return None
    return confirmer.check(name, arguments, risk)
