"""Plan paradigm (read-only): produce a plan, never make changes.

Aligned with a Cursor-style "plan" mode: the model may use **read-only / low-risk
tools** to gather context, but high-risk tools (file writes, shell, anything
marked ``risk="high"``) are not even offered — so a plan run cannot mutate
anything. It outputs a step-by-step plan; turning a plan into execution is a
deliberate, separate action (kept out of this paradigm on purpose).

Self-contained: it owns its loop and imports no other paradigm. The only thing
that makes it "read-only" is the tool filter below (``allow_high_risk=False``) —
a model-A guardrail (prevents fat-finger mutations), not an adversarial sandbox;
you own the code and can change it.
"""

from __future__ import annotations

from collections.abc import Callable

from ..budget import BudgetTracker
from ..config import Config
from ..context import fit as fit_context
from ..hooks import Hooks
from ..llm import LLMClient
from ..prompts import build_system_prompt
from ..tools import Registry
from ..tools import registry as default_registry
from ..trace import Trace
from . import (
    RunResult,
    assistant_message,
    register_paradigm,
    run_tool,
)

MODE = "plan"

_PLAN_INSTRUCTION = (
    "You are in PLAN mode. Investigate using the available read-only tools if "
    "helpful, then produce a clear, numbered, step-by-step plan to accomplish the "
    "request. Do NOT make any changes, run any commands, or take any irreversible "
    "action — output only the plan."
)


@register_paradigm(MODE)
def run(
    user_input: str,
    *,
    client: LLMClient | None = None,
    client_for: Callable[[str], LLMClient] | None = None,
    config: Config,
    role: str = "generation",
    registry: Registry = default_registry,
    hooks: Hooks | None = None,
    trace: Trace | None = None,
    on_delta: Callable[[str], None] | None = None,
    history: list[dict] | None = None,
) -> RunResult:
    """Run one read-only planning turn (low-risk tools only).

    ``history`` is prior conversation messages (no system prompt) to resume from;
    the returned ``RunResult.messages`` is the full body after this turn."""
    hooks = hooks or Hooks()
    if client is None:
        if client_for is None:
            raise ValueError("run() needs either `client` or `client_for`")
        client = client_for(role)
    profile = config.profile_for(role)
    if trace is None:
        obs = config.observability
        trace = Trace(trace_dir=obs.trace_dir if obs.trace else None, enabled=obs.trace)

    context_cfg = config.context
    summarizer: LLMClient | None = (
        client_for("compaction")
        if client_for is not None and context_cfg.strategy == "summarize"
        else None
    )

    tracker = BudgetTracker(config.budget)
    # Read-only: high-risk tools are never offered, so the model cannot mutate.
    active = registry.active_names(config.enabled_tool_names(), allow_high_risk=False)
    tool_schemas = registry.schemas(active)

    system = build_system_prompt(config) + "\n\n" + _PLAN_INSTRUCTION
    messages: list[dict] = [
        {"role": "system", "content": system},
        *(history or []),
        {"role": "user", "content": user_input},
    ]
    trace.event("run_start", mode=MODE, role=role, model=profile.model, tools=active)

    step = 0
    stop_reason = "final"
    answer = ""
    while True:
        # One budget check per step (so combine: and/or stays coherent). steps and
        # elapsed are current; tokens/cost reflect responses so far, so a
        # token/cost stop lands at the start of the next step (off by one).
        tracker.update(step=step, total_tokens=trace.total_tokens, cost_usd=trace.cost_usd)
        stop = tracker.check()
        if stop is not None:
            stop_reason, answer = stop
            break

        messages = fit_context(messages, context_cfg, summarizer=summarizer{% if spec.memory.enabled %}, config=config{% endif %})
        hooks.before_step(step, messages)
        try:
            if on_delta is not None:
                response = client.stream(messages, tool_schemas or None, on_delta=on_delta)
            else:
                response = client.complete(messages, tool_schemas or None)
        except Exception as exc:
            hooks.on_error("llm", exc)
            trace.event("error", where="llm", error=str(exc))
            trace.close()
            raise

        cost = trace.add_usage(response.usage, profile)
        trace.event(
            "llm_response",
            step=step,
            has_tool_calls=bool(response.tool_calls),
            prompt_tokens=response.usage.prompt_tokens,
            completion_tokens=response.usage.completion_tokens,
            step_cost_usd=cost,
        )
        hooks.after_step(step, response)

        if not response.tool_calls:
            answer, stop_reason = response.content or "", "final"
            break

        messages.append(assistant_message(response))
        for call in response.tool_calls:
            result = run_tool(registry, call, hooks, trace)
            messages.append(
                {"role": "tool", "tool_call_id": call.id, "content": result}
            )
        step += 1

    trace.event(
        "run_end",
        mode=MODE,
        stop_reason=stop_reason,
        steps=step,
        total_tokens=trace.total_tokens,
        cost_usd=trace.cost_usd,
    )
    trace.close()
    # Record the final answer in the body so a resumed session sees this reply.
    # Budget-stop notices are synthetic, so they stay out of the saved history.
    if stop_reason == "final" and answer:
        messages.append({"role": "assistant", "content": answer})
    return RunResult(
        answer=answer,
        steps=step,
        stop_reason=stop_reason,
        trace=trace,
        mode=MODE,
        messages=messages[1:],
    )
