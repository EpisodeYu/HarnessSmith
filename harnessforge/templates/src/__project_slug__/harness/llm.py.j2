"""LLM client: OpenAI SDK over Chat Completions (provider-agnostic via base_url).

The loop talks to a tiny provider-neutral interface (``LLMClient``) returning
plain dataclasses, so the same loop runs against any OpenAI-compatible endpoint
— or the built-in ``MockLLM`` for offline tests and smoke runs. Chat Completions
+ ``tools`` is deliberate: it is the API third-party / local endpoints actually
implement (vLLM, together, groq, ...).
"""

from __future__ import annotations

import time
from collections.abc import Callable
from dataclasses import dataclass, field
from typing import Any, Protocol

from .config import Config, LLMProfileConfig, resolve_env
from .debuglog import log


@dataclass
class Usage:
    prompt_tokens: int = 0
    completion_tokens: int = 0
    total_tokens: int = 0


@dataclass
class ToolCall:
    id: str
    name: str
    arguments: str  # raw JSON string as returned by the model


@dataclass
class LLMResponse:
    content: str | None = None
    tool_calls: list[ToolCall] = field(default_factory=list)
    usage: Usage = field(default_factory=Usage)


class LLMClient(Protocol):
    """Anything that can turn messages (+tool schemas) into an LLMResponse.

    ``stream`` does the same thing but also forwards text tokens to ``on_delta``
    as they arrive (for live UIs); it still returns the fully assembled response.

    ``on_thinking`` is the *thinking* channel, separate from ``on_delta`` (which
    only ever carries final-answer text): reasoning models can sit silent for
    seconds before the first token, so a client forwards any reasoning increments
    here and the UI shows "thinking …" instead of a dead wait. The chunk may be
    ``""`` (the model is reasoning but its content is hidden). Provider-neutral:
    native Anthropic thinking blocks and a compatible endpoint's
    ``reasoning_content`` both land on this one callback; models without a
    visible thinking phase simply never call it.

    ``cancel`` is an optional cooperative cancel predicate: ``stream`` checks it
    each chunk and stops (closing the stream) the moment it returns ``True``, so a
    Stop button / Ctrl-C can cut model generation mid-token. ``complete`` can't
    interrupt its single blocking call, but accepts ``cancel`` for a uniform
    signature (the caller re-checks it at the next step boundary).
    """

    def complete(
        self,
        messages: list[dict],
        tools: list[dict] | None,
        *,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        ...

    def stream(
        self,
        messages: list[dict],
        tools: list[dict] | None,
        *,
        on_delta: Callable[[str], None] | None = None,
        on_thinking: Callable[[str], None] | None = None,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        ...


class OpenAIClient:
    """Thin adapter over the OpenAI SDK's Chat Completions endpoint."""

    def __init__(self, profile: LLMProfileConfig) -> None:
        from openai import OpenAI

        api_key = resolve_env(profile.api_key_env) or "missing-api-key"
        base_url = resolve_env(profile.base_url_env)
        self._client = OpenAI(api_key=api_key, base_url=base_url)
        self.model = profile.model
        self.temperature = profile.temperature
        self.max_tokens = profile.max_tokens
        self.reasoning_effort = profile.reasoning_effort

    def _request_kwargs(self, messages: list[dict], tools: list[dict] | None) -> dict[str, Any]:
        kwargs: dict[str, Any] = {"model": self.model, "messages": messages}
        if tools:
            kwargs["tools"] = tools
            kwargs["tool_choice"] = "auto"
        # Sampling knobs are sent ONLY when set. Reasoning models (GPT-5.x /
        # o-series) reject `temperature`; non-reasoning models reject
        # `reasoning_effort`. Leaving the irrelevant one unset keeps the same
        # client provider-agnostic across both kinds.
        if self.temperature is not None:
            kwargs["temperature"] = self.temperature
        if self.max_tokens is not None:
            kwargs["max_tokens"] = self.max_tokens
        if self.reasoning_effort is not None:
            kwargs["reasoning_effort"] = self.reasoning_effort
        return kwargs

    def complete(
        self,
        messages: list[dict],
        tools: list[dict] | None = None,
        *,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        # A single non-streaming call can't be interrupted mid-flight; ``cancel``
        # is accepted for a uniform signature and takes effect at the next step
        # boundary (the loop re-checks it). Web chat defaults to streaming, where
        # cancellation IS mid-token (see ``stream``).
        log.debug(
            "llm complete: model=%s messages=%d tools=%d",
            self.model, len(messages), len(tools or []),
        )
        started = time.monotonic()
        try:
            resp = self._client.chat.completions.create(**self._request_kwargs(messages, tools))
        except Exception as exc:
            log.debug(
                "llm complete FAILED after %.1fs: %s: %s",
                time.monotonic() - started, type(exc).__name__, exc,
            )
            raise
        log.debug("llm complete: response in %.1fs", time.monotonic() - started)
        message = resp.choices[0].message
        calls = [
            ToolCall(id=tc.id, name=tc.function.name, arguments=tc.function.arguments)
            for tc in (message.tool_calls or [])
        ]
        raw = resp.usage
        usage = (
            Usage(raw.prompt_tokens, raw.completion_tokens, raw.total_tokens)
            if raw
            else Usage()
        )
        return LLMResponse(content=message.content, tool_calls=calls, usage=usage)

    def stream(
        self,
        messages: list[dict],
        tools: list[dict] | None = None,
        *,
        on_delta: Callable[[str], None] | None = None,
        on_thinking: Callable[[str], None] | None = None,
        cancel: Callable[[], bool] | None = None,
    ) -> LLMResponse:
        """Stream a Chat Completions response, assembling the same LLMResponse.

        Text deltas are pushed to ``on_delta`` as they arrive; reasoning deltas
        (the ``reasoning_content`` field some compatible endpoints emit for
        thinking models) go to ``on_thinking`` — they are progress, not answer
        text, and never enter the assembled response. Tool-call and
        usage deltas are accumulated across chunks. ``include_usage`` asks for a
        final usage chunk; providers that ignore it leave usage at 0 (so a
        cost/token budget can't trigger — same caveat as a profile without prices).

        ``cancel`` is checked each chunk: when it returns ``True`` the underlying
        HTTP stream is closed and we stop reading, returning the half-assembled
        response (the loop discards it at the next boundary). This is how a Stop
        button cuts the model off mid-generation without waiting for it to finish.
        """
        kwargs = self._request_kwargs(messages, tools)
        kwargs["stream"] = True
        kwargs["stream_options"] = {"include_usage": True}

        log.debug(
            "llm stream: model=%s messages=%d tools=%d",
            self.model, len(messages), len(tools or []),
        )
        started = time.monotonic()
        content: list[str] = []
        calls: dict[int, dict[str, str]] = {}
        usage = Usage()
        try:
            stream_obj = self._client.chat.completions.create(**kwargs)
        except Exception as exc:
            log.debug(
                "llm stream FAILED after %.1fs: %s: %s",
                time.monotonic() - started, type(exc).__name__, exc,
            )
            raise
        for chunk in stream_obj:
            if cancel is not None and cancel():
                stream_obj.close()  # stop the model: close the HTTP stream and bail
                break
            if chunk.usage is not None:
                usage = Usage(
                    chunk.usage.prompt_tokens,
                    chunk.usage.completion_tokens,
                    chunk.usage.total_tokens,
                )
            if not chunk.choices:
                continue
            delta = chunk.choices[0].delta
            # Non-standard but common on OpenAI-compatible reasoning endpoints
            # (DeepSeek-R1 style): the model's reasoning streams here before any
            # content. Not part of the SDK's typed delta, hence getattr.
            reasoning = getattr(delta, "reasoning_content", None)
            if reasoning and on_thinking is not None:
                on_thinking(reasoning)
            if delta.content:
                content.append(delta.content)
                if on_delta is not None:
                    on_delta(delta.content)
            for tc in delta.tool_calls or []:
                slot = calls.setdefault(tc.index, {"id": "", "name": "", "arguments": ""})
                if tc.id:
                    slot["id"] = tc.id
                if tc.function and tc.function.name:
                    slot["name"] = tc.function.name
                if tc.function and tc.function.arguments:
                    slot["arguments"] += tc.function.arguments
        tool_calls = [
            ToolCall(id=calls[i]["id"], name=calls[i]["name"], arguments=calls[i]["arguments"])
            for i in sorted(calls)
        ]
        log.debug(
            "llm stream: done in %.1fs (tool_calls=%d)",
            time.monotonic() - started, len(tool_calls),
        )
        return LLMResponse(content="".join(content) or None, tool_calls=tool_calls, usage=usage)


def _client_for_profile(profile: LLMProfileConfig) -> LLMClient:
    """Pick the client implementation for a profile by its ``provider``.

    The anthropic module is imported lazily and only exists in repos generated
    with an anthropic profile — a repo generated without one fails here with a
    pointer instead of a bare ImportError.
    """
    if profile.provider == "anthropic":
        try:
            from .llm_anthropic import AnthropicClient
        except ImportError as exc:
            raise RuntimeError(
                f"profile {profile.name!r} sets provider: anthropic, but this repo "
                "was generated without the native Anthropic client. Regenerate with "
                "an anthropic profile in the spec, or add harness/llm_anthropic.py "
                "and the `anthropic` dependency yourself."
            ) from exc
        return AnthropicClient(profile)
    return OpenAIClient(profile)


def make_client(config: Config, role: str = "generation", *, mock: bool = False) -> LLMClient:
    """Build a single LLM client for ``role``; ``mock=True`` returns an offline one."""
    if mock:
        from .mock import MockLLM

        return MockLLM()
    return _client_for_profile(config.profile_for(role))


class ClientRouter:
    """Resolve and cache one client per role (``generation`` / ``compaction`` / ...).

    The loop uses ``generation``; context summarization uses ``compaction``. Pass
    ``client_for`` (the bound method) into ``run()`` to route within one turn.
    """

    def __init__(self, config: Config, *, mock: bool = False) -> None:
        self._config = config
        self._mock = mock
        self._cache: dict[str, LLMClient] = {}

    def client_for(self, role: str = "generation") -> LLMClient:
        if self._mock:
            key = f"mock:{role}"
            if key not in self._cache:
                from .mock import MockLLM

                self._cache[key] = MockLLM()
            return self._cache[key]
        profile = self._config.profile_for(role)
        if profile.name not in self._cache:
            self._cache[profile.name] = _client_for_profile(profile)
        return self._cache[profile.name]
