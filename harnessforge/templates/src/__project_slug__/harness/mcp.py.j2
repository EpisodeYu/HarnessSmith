"""Optional MCP tool bridge (generated only when ``mcp.enabled``).

MCP tools register into the SAME :class:`~{{ project_slug }}.harness.tools.Registry`
as built-in tools and run through the SAME loop/trace — ``loop.py`` is untouched.
*Which* servers to connect to and *which* tools to allowlist are runtime
``config.yaml`` knobs; transport is chosen per server by shape (``command`` ->
stdio subprocess, ``url`` -> remote Streamable HTTP).

The MCP SDK is asyncio; all of it hides behind a synchronous ``McpManager.call``.
One background thread owns one event loop; each server gets its OWN task that
enters and exits that server's session (anyio requires a session be entered and
exited in the *same* task). Servers connect concurrently, so startup costs
``max`` per-server connect time, not the sum.
"""

from __future__ import annotations

import asyncio
import concurrent.futures
import threading
from contextlib import AsyncExitStack
from typing import TYPE_CHECKING, Any

from .tools import HIGH, SAFE, Registry, Tool
from .tools import registry as default_registry

if TYPE_CHECKING:
    from .config import Config, McpConfig, McpServerConfig


def _bearer_headers(server: McpServerConfig) -> dict[str, str]:
    """Build request headers for a remote server, resolving the token by NAME."""
    from .config import resolve_env

    token = resolve_env(server.auth_env) if server.auth_env else None
    return {"Authorization": f"Bearer {token}"} if token else {}


_WINDOWS_CMD_SHIMS = {"npx", "npm", "yarn", "pnpm"}


def _missing_launcher_message(command: str) -> str:
    if command.lower().removesuffix(".cmd").removesuffix(".bat") in _WINDOWS_CMD_SHIMS:
        return (
            f"MCP stdio launcher {command!r} was not found on PATH. "
            "Install Node.js (which provides npx/npm) or edit config.yaml to use "
            "a launcher that exists on this machine."
        )
    if command.lower() == "uvx":
        return (
            "MCP stdio launcher 'uvx' was not found on PATH. Install uv or edit "
            "config.yaml to use a launcher that exists on this machine."
        )
    return f"MCP stdio launcher {command!r} was not found on PATH."


def _windows_cmd_exe() -> str:
    import os
    import shutil

    return os.environ.get("COMSPEC") or shutil.which("cmd.exe") or "cmd.exe"


def _windows_stdio_command(command: str, args: list[str]) -> tuple[str, list[str]]:
    """Make a stdio command launchable on Windows.

    ``npx`` (and ``npm``/``yarn``/``pnpm``) are usually ``.cmd`` batch shims;
    Windows ``CreateProcess`` — which the asyncio subprocess used by the MCP SDK
    calls — cannot execute a ``.cmd``/``.bat`` directly (it fails with
    ``WinError 2``), even when the file is on PATH. Hand those to ``cmd.exe``,
    which knows how to run them. Real ``.exe`` commands (``uvx``, ``python``, …)
    are launched directly and left untouched. If the launcher is missing, fail
    before entering the MCP transport so status pages show an actionable message
    instead of a raw ``WinError 2``.
    """
    import shutil
    import sys

    if sys.platform != "win32":
        return command, args
    resolved = shutil.which(command)
    if not resolved:
        raise FileNotFoundError(_missing_launcher_message(command))
    if resolved.lower().endswith((".cmd", ".bat")):
        return _windows_cmd_exe(), ["/d", "/c", resolved, *args]
    return command, args


def _open_streams(server: McpServerConfig):
    """Return the (read, write) stream context manager for ``server``'s transport.

    Transport is ``server.kind`` (explicit ``transport`` or inferred from shape):
    ``stdio`` launches a subprocess; ``http`` is the modern Streamable HTTP;
    ``sse`` is the legacy HTTP+SSE transport for older remote servers.
    """
    from .config import resolve_env

    kind = server.kind
    if kind == "stdio":
        import os

        from mcp import StdioServerParameters
        from mcp.client.stdio import stdio_client

        env = dict(os.environ)
        for name in server.env:  # inject named secrets from .env into the child
            value = resolve_env(name)
            if value is not None:
                env[name] = value
        command, args = _windows_stdio_command(server.command, server.args)
        return stdio_client(
            StdioServerParameters(command=command, args=args, env=env)
        )

    headers = _bearer_headers(server)
    if kind == "sse":  # legacy HTTP+SSE transport (older servers)
        from mcp.client.sse import sse_client

        return sse_client(server.url, headers=headers)

    from mcp.client import streamable_http as sh

    if hasattr(sh, "streamablehttp_client"):  # SDK <2.x
        return sh.streamablehttp_client(server.url, headers=headers)
    import httpx  # SDK >=2.x: headers go on a pre-built client

    return sh.streamable_http_client(server.url, http_client=httpx.AsyncClient(headers=headers))


def _result_text(result: Any) -> str:
    """Flatten an MCP CallToolResult's content blocks into a plain string."""
    parts = [getattr(b, "text", "") for b in (getattr(result, "content", None) or [])]
    text = "\n".join(p for p in parts if p)
    return f"ERROR: {text}" if getattr(result, "isError", False) else text


class McpManager:
    """Owns one background event loop + the full MCP session lifecycle.

    ``start()`` connects every configured server CONCURRENTLY (failures are
    isolated: a server that won't start is skipped and recorded in ``errors``,
    not fatal) and lists its tools into ``discovered``. ``call()`` is synchronous
    and thread-safe; ``close()`` shuts the sessions down cleanly.
    """

    def __init__(self, config: McpConfig) -> None:
        self._config = config
        self._loop = asyncio.new_event_loop()
        self._thread = threading.Thread(target=self._thread_main, daemon=True)
        self._ready: concurrent.futures.Future = concurrent.futures.Future()
        self._inbox: asyncio.Queue | None = None
        self._closing: asyncio.Event | None = None
        self._server_tasks: list[asyncio.Task] = []
        self._sessions: dict[str, Any] = {}
        self.discovered: dict[str, list] = {}
        self.errors: dict[str, str] = {}

    def _thread_main(self) -> None:
        asyncio.set_event_loop(self._loop)
        try:
            self._loop.run_until_complete(self._main())
        except Exception as exc:  # surface startup failures to start()
            if not self._ready.done():
                self._ready.set_exception(exc)
        finally:
            self._loop.close()

    async def _main(self) -> None:
        self._inbox = asyncio.Queue()
        self._closing = asyncio.Event()
        timeout = self._config.connect_timeout_seconds
        # One task per server, all started at once: each owns its session for the
        # whole run and connects in parallel, so startup is max(per-server), not sum.
        done_events: list[asyncio.Event] = []
        for server in self._config.servers:
            done = asyncio.Event()
            done_events.append(done)
            self._server_tasks.append(asyncio.create_task(self._run_server(server, timeout, done)))
        for done in done_events:  # ready once every server has connected or failed
            await done.wait()
        self._ready.set_result(True)
        await self._serve()
        self._closing.set()  # release each server task to tear down its own session
        if self._server_tasks:
            await asyncio.gather(*self._server_tasks, return_exceptions=True)

    async def _run_server(self, server: McpServerConfig, timeout: float, done: asyncio.Event) -> None:
        """Own ONE server's session for the whole run, inside a single task.

        Connect (open transport + ``initialize`` + ``list_tools``) under ``timeout``,
        signal ``done`` (so startup can proceed), then hold the session open until
        ``close()``. Entering and exiting the session in the same task is required by
        anyio; a connect failure/timeout is isolated into ``errors`` and never aborts
        the other servers.
        """
        assert self._closing is not None
        try:
            async with AsyncExitStack() as stack:
                # `asyncio.wait_for(coro)` wraps `coro` in another Task. Anyio's
                # MCP transports require async context managers to be entered and
                # exited in the SAME task, so use `asyncio.timeout()` instead.
                async with asyncio.timeout(timeout):
                    await self._connect(stack, server)
                done.set()
                await self._closing.wait()  # keep the session alive until shutdown
        except Exception as exc:  # connect failure/timeout: isolate, never fatal
            self.errors[server.name] = str(exc)
            done.set()

    async def _connect(self, stack: AsyncExitStack, server: McpServerConfig) -> None:
        """Open one server's session and list its tools (under a startup timeout)."""
        from mcp import ClientSession

        streams = await stack.enter_async_context(_open_streams(server))
        session = await stack.enter_async_context(ClientSession(streams[0], streams[1]))
        await session.initialize()
        self._sessions[server.name] = session
        self.discovered[server.name] = list((await session.list_tools()).tools)

    async def _serve(self) -> None:
        assert self._inbox is not None
        while True:
            req = await self._inbox.get()
            if req is None:
                return
            server, tool, arguments, fut = req
            try:
                fut.set_result(_result_text(await self._sessions[server].call_tool(tool, arguments)))
            except Exception as exc:
                fut.set_exception(exc)

    def start(self) -> None:
        self._thread.start()
        self._ready.result()  # block until every server is connected (or skipped)

    def call(self, server: str, tool: str, arguments: dict) -> str:
        fut: concurrent.futures.Future = concurrent.futures.Future()
        self._loop.call_soon_threadsafe(self._inbox.put_nowait, (server, tool, arguments, fut))
        return fut.result()

    def close(self) -> None:
        if self._loop.is_closed() or self._inbox is None:
            return
        self._loop.call_soon_threadsafe(self._inbox.put_nowait, None)
        self._thread.join(timeout=10)

    def status(self) -> list[dict]:
        """Per-server health, read after ``start()`` — the source of truth for the
        management page / ``mcp status``: each configured server's transport, live
        connection state, discovered tool count, and connect error (if any)."""
        out: list[dict] = []
        for server in self._config.servers:
            tools = self.discovered.get(server.name)
            out.append(
                {
                    "name": server.name,
                    "transport": server.kind,
                    "connected": server.name in self._sessions,
                    "error": self.errors.get(server.name),
                    "tool_count": len(tools) if tools is not None else 0,
                }
            )
        return out


def rebuild_manager(old: "McpManager | None", config: McpConfig) -> McpManager:
    """Reconnect: start a fresh manager for ``config``, then close the old one.

    The new manager is fully started (every server connected or failure-isolated)
    BEFORE the old one is closed, so a hot-reconnect never leaves a window with no
    sessions. The caller keeps the returned manager and re-syncs the registry.
    """
    manager = McpManager(config)
    manager.start()
    if old is not None:
        old.close()
    return manager


def sync_mcp_tools(
    config: "Config", manager: McpManager, registry: Registry | None = None
) -> list[str]:
    """Re-sync the registry's MCP tools to ``config`` + ``manager.discovered``.

    Unlike :func:`register_mcp_tools` (append-only, for a one-shot CLI run), this
    first DROPS every existing ``<server>__<tool>`` entry, then re-registers the
    currently-allowlisted discovered tools — so a long-lived process (the web
    server) stays consistent across runtime allowlist/server edits: what's
    registered (hence offered to the model) always matches the panel's view.
    """
    registry = registry or default_registry
    registry.remove_where(lambda name: "__" in name)
    return register_mcp_tools(config, manager, registry)


def register_mcp_tools(
    config: "Config", manager: McpManager, registry: Registry | None = None
) -> list[str]:
    """Register allowlisted MCP tools into ``registry`` (default: the shared one).

    Only tools allowlisted in ``config.tools`` are registered — by exact
    ``{server}__{tool}`` name or by a ``{server}__*`` wildcard that enables the
    server's whole toolset (see :func:`~{{ project_slug }}.harness.tools.in_allowlist`);
    a non-allowlisted MCP tool is never connected to the model. Risk is per-tool: a
    tool listed in its server's ``safe_tools`` registers as ``risk=safe`` (read-only;
    offered to plan/ask); every other tool defaults to ``risk=high`` (mutating/
    external; agent-only, opt in deliberately).
    """
    from .tools import in_allowlist

    registry = registry or default_registry
    allowed = config.enabled_tool_names()
    safe_by_server = {s.name: set(s.safe_tools) for s in config.mcp.servers}
    registered: list[str] = []
    for server, tools in manager.discovered.items():
        safe = safe_by_server.get(server, set())
        for tool in tools:
            name = f"{server}__{tool.name}"
            if not in_allowlist(name, allowed):
                continue
            registry.register(
                Tool(
                    name=name,
                    description=tool.description or "",
                    parameters=tool.inputSchema or {"type": "object", "properties": {}},
                    func=_make_caller(manager, server, tool.name),
                    risk=SAFE if tool.name in safe else HIGH,
                )
            )
            registered.append(name)
    return registered


def _make_caller(manager: McpManager, server: str, tool: str):
    def _call(**kwargs: Any) -> str:
        return manager.call(server, tool, kwargs)

    return _call
