"""Command-line interface: ``run`` a single turn (one question -> one answer).

``--mock`` runs the loop against the built-in offline LLM (no API key, no
network) — handy for smoke tests and Docker. Otherwise it uses the configured
OpenAI-compatible endpoint, reading the key from the env-var your config names.
"""

from __future__ import annotations

from pathlib import Path

import typer

from ..harness.config import load_config
from ..harness.llm import ClientRouter
from ..harness.loop import run as run_loop

app = typer.Typer(
    add_completion=False,
    help="Your agent harness (generated by HarnessForge).",
)


@app.callback()
def _main() -> None:
    """Your agent harness (generated by HarnessForge)."""


@app.command()
def run(
    prompt: str = typer.Argument(
        None, help="Your message. Omit to be prompted interactively."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    role: str = typer.Option("generation", "--role", help="LLM role to use."),
    mode: str = typer.Option(
        None,
        "--mode",
        help="Loop paradigm to use (default: config.paradigms.default).",
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
    stream: bool = typer.Option(
        False, "--stream/--no-stream", help="Stream the answer token-by-token."
    ),
) -> None:
    """Run one turn of the agent loop."""
    config = load_config(config_path)
    if prompt is None:
        prompt = typer.prompt("You")
{% if spec.skills.enabled %}    # `/skill-name rest...` manually loads a skill's full instructions — including
    # skills marked `disable-model-invocation` that aren't auto-injected.
    if prompt.startswith("/"):
        from ..harness.skills import load_skill_body

        skill_name, _, rest = prompt[1:].partition(" ")
        body = load_skill_body(config, skill_name)
        if body.startswith("ERROR"):
            typer.secho(body, fg=typer.colors.YELLOW, err=True)
        else:
            prompt = f"{body}\n\n{rest}".strip()
{% endif %}{% if spec.mcp.enabled %}    from ..harness.mcp import McpManager, register_mcp_tools

    # Only launch servers with at least one allowlisted (enabled) tool, so a
    # predefined-but-off server (e.g. Desktop Commander) stays dormant until you
    # enable one of its tools in config.yaml.
    _active = {n.split("__", 1)[0] for n in config.enabled_tool_names() if "__" in n}
    _servers = [s for s in config.mcp.servers if s.name in _active]
    mcp_manager = (
        McpManager(config.mcp.model_copy(update={"servers": _servers}))
        if _servers
        else None
    )
    if mcp_manager is not None:
        mcp_manager.start()
        register_mcp_tools(config, mcp_manager)
{% endif %}    router = ClientRouter(config, mock=mock)

    printed = False

    def _on_delta(text: str) -> None:
        nonlocal printed
        printed = True
        typer.echo(text, nl=False)

    try:
        result = run_loop(
            prompt,
            mode=mode,
            client_for=router.client_for,
            config=config,
            role=role,
            on_delta=_on_delta if stream else None,
        )
    except ValueError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    if printed:
        typer.echo("")  # finish the streamed line
    else:
        typer.echo(result.answer)  # non-stream, or a budget-stop message
    typer.secho(
        f"[{result.mode}] [{result.stop_reason}] steps={result.steps} "
        f"tokens={result.trace.total_tokens} cost=${result.trace.cost_usd:.4f}",
        fg=typer.colors.BRIGHT_BLACK,
    )
{% if spec.mcp.enabled %}    if mcp_manager is not None:
        mcp_manager.close()
{% endif %}
{% if interfaces.web %}

def _find_free_port(preferred: int, host: str = "127.0.0.1") -> int:
    """Return a bindable port: try ``preferred`` upward, else an OS-assigned one."""
    import socket

    for candidate in range(preferred, preferred + 64):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.bind((host, candidate))
                return candidate
            except OSError:
                continue
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind((host, 0))
        return sock.getsockname()[1]


@app.command()
def serve(
    host: str = typer.Option(
        "127.0.0.1", "--host", help="Bind host (use 0.0.0.0 to expose on the network)."
    ),
    port: int = typer.Option(
        0, "--port", help="Bind port; 0 (default) auto-picks a free port from 8000."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
) -> None:
    """Serve the web chat + live /config panel."""
    import uvicorn

    from .web import create_app

    bind_port = port if port else _find_free_port(8000, host)
    config = load_config(config_path)
{% if spec.mcp.enabled %}    from ..harness.mcp import McpManager, register_mcp_tools

    _active = {n.split("__", 1)[0] for n in config.enabled_tool_names() if "__" in n}
    _servers = [s for s in config.mcp.servers if s.name in _active]
    if _servers:
        mcp_manager = McpManager(config.mcp.model_copy(update={"servers": _servers}))
        mcp_manager.start()
        register_mcp_tools(config, mcp_manager)
{% endif %}    typer.secho(
        f"Serving on http://{host}:{bind_port}  (open this; Ctrl-C to stop)",
        fg=typer.colors.GREEN,
    )
    uvicorn.run(create_app(config, mock=mock), host=host, port=bind_port)
{% endif %}

if __name__ == "__main__":
    app()
