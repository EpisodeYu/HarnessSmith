"""Command-line interface: ``run`` a single turn (one question -> one answer).

``--mock`` runs the loop against the built-in offline LLM (no API key, no
network) — handy for smoke tests and Docker. Otherwise it uses the configured
OpenAI-compatible endpoint, reading the key from the env-var your config names.
"""

from __future__ import annotations

from pathlib import Path

import typer

from ..harness.config import load_config
from ..harness.llm import ClientRouter
from ..harness.loop import run as run_loop

app = typer.Typer(
    add_completion=False,
    help="Your agent harness (generated by HarnessForge).",
)


@app.callback()
def _main() -> None:
    """Your agent harness (generated by HarnessForge)."""


@app.command()
def run(
    prompt: str = typer.Argument(
        None, help="Your message. Omit to be prompted interactively."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    role: str = typer.Option("generation", "--role", help="LLM role to use."),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
    stream: bool = typer.Option(
        False, "--stream/--no-stream", help="Stream the answer token-by-token."
    ),
) -> None:
    """Run one turn of the agent loop."""
    config = load_config(config_path)
    if prompt is None:
        prompt = typer.prompt("You")
{% if spec.mcp.enabled %}    from ..harness.mcp import McpManager, register_mcp_tools

    mcp_manager = McpManager(config.mcp)
    if config.mcp.servers:
        mcp_manager.start()
        register_mcp_tools(config, mcp_manager)
{% endif %}    router = ClientRouter(config, mock=mock)

    printed = False

    def _on_delta(text: str) -> None:
        nonlocal printed
        printed = True
        typer.echo(text, nl=False)

    result = run_loop(
        prompt,
        client_for=router.client_for,
        config=config,
        role=role,
        on_delta=_on_delta if stream else None,
    )
    if printed:
        typer.echo("")  # finish the streamed line
    else:
        typer.echo(result.answer)  # non-stream, or a budget-stop message
    typer.secho(
        f"[{result.stop_reason}] steps={result.steps} "
        f"tokens={result.trace.total_tokens} cost=${result.trace.cost_usd:.4f}",
        fg=typer.colors.BRIGHT_BLACK,
    )
{% if spec.mcp.enabled %}    if config.mcp.servers:
        mcp_manager.close()
{% endif %}
{% if interfaces.web %}

@app.command()
def serve(
    host: str = typer.Option(
        "127.0.0.1", "--host", help="Bind host (use 0.0.0.0 to expose on the network)."
    ),
    port: int = typer.Option(8000, "--port", help="Bind port."),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
) -> None:
    """Serve the web chat + live /config panel."""
    import uvicorn

    from .web import create_app

    config = load_config(config_path)
{% if spec.mcp.enabled %}    from ..harness.mcp import McpManager, register_mcp_tools

    if config.mcp.servers:
        mcp_manager = McpManager(config.mcp)
        mcp_manager.start()
        register_mcp_tools(config, mcp_manager)
{% endif %}    uvicorn.run(create_app(config, mock=mock), host=host, port=port)
{% endif %}

if __name__ == "__main__":
    app()
