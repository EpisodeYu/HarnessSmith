"""Command-line interface: ``run`` a single turn (one question -> one answer).

``--mock`` runs the loop against the built-in offline LLM (no API key, no
network) — handy for smoke tests and Docker. Otherwise it uses the configured
OpenAI-compatible endpoint, reading the key from the env-var your config names.
"""

from __future__ import annotations

from pathlib import Path

import typer

from ..harness.config import LLMProfileConfig, load_config, resolve_env
from ..harness.llm import ClientRouter
from ..harness.loop import run as run_loop

app = typer.Typer(
    add_completion=False,
    help="Your agent harness (generated by HarnessForge).",
)


@app.callback()
def _main() -> None:
    """Your agent harness (generated by HarnessForge)."""


def _profile_preflight(profile: LLMProfileConfig) -> str | None:
    """Offline sanity check for an LLM profile; returns an error message or None.

    Catches the two traps that otherwise surface as a confusing provider error:
    no model, and no resolvable API key (with no custom base_url). Run before any
    network call so ``run`` / ``test-llm`` can point you at the fix.
    """
    if not profile.model.strip():
        return "model is required (set it under llms: in config.yaml)"
    if not resolve_env(profile.api_key_env) and not resolve_env(profile.base_url_env):
        return (
            f"no API key: env var {profile.api_key_env} is not set in .env or the "
            f"environment — run `set-key {profile.api_key_env}` first "
            "(or configure a custom base_url)"
        )
    return None

{% if spec.mcp.enabled %}
def _start_mcp(config):
    """Launch MCP servers that have at least one enabled tool; return the manager.

    Only servers with an allowlisted (enabled) tool are launched, so a
    predefined-but-off server (e.g. Desktop Commander) stays dormant. Returns
    ``None`` when nothing needs launching; the caller must ``.close()`` the
    manager when done (``serve`` lets it live for the process lifetime).
    """
    from ..harness.mcp import McpManager, register_mcp_tools

    active = {n.split("__", 1)[0] for n in config.enabled_tool_names() if "__" in n}
    servers = [s for s in config.mcp.servers if s.name in active]
    if not servers:
        return None
    manager = McpManager(config.mcp.model_copy(update={"servers": servers}))
    manager.start()
    register_mcp_tools(config, manager)
    return manager
{% endif %}{% if spec.skills.enabled %}
def _expand_skill(config, prompt: str) -> str:
    """``/skill-name rest...`` -> the skill's full instructions + rest.

    Lets you manually load a skill (including ones marked
    ``disable-model-invocation`` that aren't auto-injected). A non-``/`` prompt or
    an unknown skill is returned unchanged (with a warning for the latter).
    """
    if not prompt.startswith("/"):
        return prompt
    from ..harness.skills import load_skill_body

    skill_name, _, rest = prompt[1:].partition(" ")
    body = load_skill_body(config, skill_name)
    if body.startswith("ERROR"):
        typer.secho(body, fg=typer.colors.YELLOW, err=True)
        return prompt
    return f"{body}\n\n{rest}".strip()
{% endif %}{% if spec.memory.enabled %}
def _setup_memory(config) -> None:
    """Register the configured memory backend's tools so the loop can offer them."""
    from ..harness.memory import register_memory_tools

    register_memory_tools(config)
{% endif %}

@app.command()
def run(
    prompt: str = typer.Argument(
        None, help="Your message. Omit to be prompted interactively."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    role: str = typer.Option("generation", "--role", help="LLM role to use."),
    mode: str = typer.Option(
        None,
        "--mode",
        help="Loop paradigm to use (default: config.paradigms.default).",
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
    stream: bool = typer.Option(
        False, "--stream/--no-stream", help="Stream the answer token-by-token."
    ),
    continue_session: bool = typer.Option(
        False, "--continue", help="Resume the most recent saved session."
    ),
    resume: str = typer.Option(
        None, "--resume", help="Resume a specific session by id."
    ),
) -> None:
    """Run one turn of the agent loop."""
    from ..harness.config import ConfigError
    from ..harness import session as session_store

    config = load_config(config_path)
    # Fail fast with an actionable hint instead of a provider traceback when the
    # LLM isn't usable yet (no profile, no model, or no key). The mock path needs
    # neither. `test-llm` does the same checks plus a live probe.
    if not mock:
        try:
            error = _profile_preflight(config.profile_for(role))
        except ConfigError as exc:
            error = f"{exc} — add a profile under llms: in {config_path}"
        if error:
            typer.secho(error, fg=typer.colors.RED, err=True)
            raise typer.Exit(code=2)
    if prompt is None:
        prompt = typer.prompt("You")
{% if spec.skills.enabled %}    prompt = _expand_skill(config, prompt)
{% endif %}{% if spec.mcp.enabled %}    mcp_manager = _start_mcp(config)
{% endif %}{% if spec.memory.enabled %}    _setup_memory(config)
{% endif %}    # Resolve the session to resume (or mint a new one) and load its history.
    sessions_cfg = config.sessions
    session_id, history = (
        session_store.resolve(
            continue_=continue_session, resume_id=resume, sessions_dir=sessions_cfg.dir
        )
        if sessions_cfg.enabled
        else (None, None)
    )
    router = ClientRouter(config, mock=mock)

    printed = False

    def _on_delta(text: str) -> None:
        nonlocal printed
        printed = True
        typer.echo(text, nl=False)

    try:
        result = run_loop(
            prompt,
            mode=mode,
            client_for=router.client_for,
            config=config,
            role=role,
            on_delta=_on_delta if stream else None,
            history=history,
        )
    except ValueError as exc:  # bad --mode / invalid config value
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    except Exception as exc:  # LLM / network / tool failure — show it, not a traceback
        if printed:
            typer.echo("")  # close any half-streamed line
        typer.secho(f"run failed: {exc}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    if printed:
        typer.echo("")  # finish the streamed line
    else:
        typer.echo(result.answer)  # non-stream, or a budget-stop message
    if sessions_cfg.enabled and session_id is not None:
        session_store.save(session_id, result.messages, sessions_cfg.dir, mode=result.mode)
{% if spec.memory.enabled %}    from ..harness.memory import record_turn

    record_turn(config, result.messages)
{% endif %}    summary = (
        f"[{result.mode}] [{result.stop_reason}] steps={result.steps} "
        f"tokens={result.trace.total_tokens} cost=${result.trace.cost_usd:.4f}"
    )
    if session_id is not None:
        summary += f" session={session_id}  (resume: run --resume {session_id})"
    typer.secho(summary, fg=typer.colors.BRIGHT_BLACK)
{% if spec.mcp.enabled %}    if mcp_manager is not None:
        mcp_manager.close()
{% endif %}
@app.command()
def chat(
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    role: str = typer.Option("generation", "--role", help="LLM role to use."),
    mode: str = typer.Option(
        None, "--mode", help="Loop paradigm to use (default: config.paradigms.default)."
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
    stream: bool = typer.Option(
        True, "--stream/--no-stream", help="Stream answers token-by-token."
    ),
    continue_session: bool = typer.Option(
        False, "--continue", help="Resume the most recent saved session."
    ),
    resume: str = typer.Option(
        None, "--resume", help="Resume a specific session by id."
    ),
) -> None:
    """Multi-turn interactive chat (REPL): keep talking, the agent remembers.

    Type a message and press Enter; the agent answers and the conversation is
    carried (and saved) across turns. Ctrl-D or ``/exit`` quits. Resume later
    with ``chat --continue`` / ``run --resume <id>``.
    """
    from ..harness.config import ConfigError
    from ..harness import session as session_store

    config = load_config(config_path)
    if not mock:
        try:
            error = _profile_preflight(config.profile_for(role))
        except ConfigError as exc:
            error = f"{exc} — add a profile under llms: in {config_path}"
        if error:
            typer.secho(error, fg=typer.colors.RED, err=True)
            raise typer.Exit(code=2)

    sessions_cfg = config.sessions
    if sessions_cfg.enabled:
        session_id, history = session_store.resolve(
            continue_=continue_session, resume_id=resume, sessions_dir=sessions_cfg.dir
        )
    else:
        session_id, history = session_store.new_id(), []
    history = list(history)
{% if spec.mcp.enabled %}    mcp_manager = _start_mcp(config)
{% endif %}{% if spec.memory.enabled %}    _setup_memory(config)
{% endif %}    router = ClientRouter(config, mock=mock)
    state = {"printed": False}

    def _on_delta(text: str) -> None:
        state["printed"] = True
        typer.echo(text, nl=False)

    typer.secho(
        f"Chat session {session_id} — Ctrl-D or /exit to quit.", fg=typer.colors.GREEN
    )
    if history:
        typer.secho(
            f"  resumed {len(history)} prior message(s).", fg=typer.colors.BRIGHT_BLACK
        )
    try:
        while True:
            try:
                prompt = typer.prompt("You")
            except (EOFError, typer.Abort):
                typer.echo("")
                break
            if prompt.strip() in {"/exit", "/quit"}:
                break
            if not prompt.strip():
                continue
{% if spec.skills.enabled %}            prompt = _expand_skill(config, prompt)
{% endif %}            state["printed"] = False
            try:
                result = run_loop(
                    prompt,
                    mode=mode,
                    client_for=router.client_for,
                    config=config,
                    role=role,
                    on_delta=_on_delta if stream else None,
                    history=history,
                )
            except Exception as exc:  # one bad turn shouldn't end the whole session
                if state["printed"]:
                    typer.echo("")
                typer.secho(f"run failed: {exc}", fg=typer.colors.RED, err=True)
                continue
            if state["printed"]:
                typer.echo("")
            else:
                typer.echo(result.answer)
            typer.secho(
                f"[{result.mode}] [{result.stop_reason}] steps={result.steps} "
                f"tokens={result.trace.total_tokens} cost=${result.trace.cost_usd:.4f}",
                fg=typer.colors.BRIGHT_BLACK,
            )
            history = result.messages
{% if spec.memory.enabled %}            from ..harness.memory import record_turn

            record_turn(config, history)
{% endif %}            if sessions_cfg.enabled:
                session_store.save(
                    session_id, history, sessions_cfg.dir, mode=result.mode
                )
{% if spec.memory.enabled %}        from ..harness.memory import end_session

        end_session(config, history)
{% endif %}    finally:
{% if spec.mcp.enabled %}        if mcp_manager is not None:
            mcp_manager.close()
{% else %}        pass
{% endif %}

@app.command(name="set-key")
def set_key(
    name: str = typer.Argument(
        ..., help="The env-var NAME to set (e.g. OPENAI_API_KEY)."
    ),
) -> None:
    """Store a secret VALUE in the local .env (write-only; never printed/committed).

    config.yaml only ever holds the env-var NAME; this fills in its value in .env
    (gitignored) so you don't have to set OS environment variables by hand.
    """
    from ..harness.config import ConfigError, set_env_value

    value = typer.prompt(f"Value for {name}", hide_input=True)
    try:
        set_env_value(name, value)
    except ConfigError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)
    typer.secho(
        f"Saved {name} to .env (gitignored). It is never printed or committed.",
        fg=typer.colors.GREEN,
    )


@app.command(name="test-llm")
def test_llm(
    role: str = typer.Option(
        "generation", "--role", help="Test the profile bound to this role."
    ),
    profile: str = typer.Option(
        None, "--profile", help="Test this profile by name (overrides --role)."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """Probe an LLM profile with a real one-shot call — is the key/endpoint live?

    Same checks as the web LLM tab's "Test" button: a profile with no model or no
    resolvable key (and no custom base_url) fails fast without a network call; the
    key is read from .env / the environment and never printed. Uses the same
    client path as the loop, so PASSED means a real turn would connect too.
    """
    from ..harness.config import ConfigError
    from ..harness.llm import OpenAIClient

    config = load_config(config_path)
    try:
        if profile is not None:
            matches = [p for p in config.llms if p.name == profile]
            if not matches:
                raise ConfigError(f"no LLM profile named {profile!r} in config.yaml")
            target = matches[0]
        else:
            target = config.profile_for(role)
    except ConfigError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=2)

    typer.echo(f"Testing profile {target.name!r} (model {target.model!r}) ...")
    error = _profile_preflight(target)
    if error:
        typer.secho(error, fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    try:
        OpenAIClient(target).complete([{"role": "user", "content": "ping"}], None)
    except Exception as exc:  # network / auth / model error — report cleanly
        typer.secho(f"FAILED: {exc}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    typer.secho("PASSED — the endpoint responded.", fg=typer.colors.GREEN)


@app.command()
def info(
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """List the registered extension points vs what config.yaml selects.

    Paradigms / context strategies / context conditions / budget conditions
    registered in code, alongside what's currently selected. A name your config
    selects but that isn't registered is flagged — usually a typo, or a module you
    forgot to import so its ``@register_*`` never ran.
    """
    from ..harness.budget import BUDGET_CONDITIONS
    from ..harness.context import CONDITIONS, STRATEGIES
    from ..harness.paradigms import PARADIGMS

    config = load_config(config_path)

    def _section(label: str, registered: list[str], selected: set[str]) -> None:
        typer.secho(label, fg=typer.colors.CYAN)
        for name in registered:
            mark = "  (selected)" if name in selected else ""
            typer.echo(f"  - {name}{mark}")
        for name in sorted(s for s in selected if s and s not in registered):
            typer.secho(
                f"  ! {name} — selected but NOT registered (import its module?)",
                fg=typer.colors.YELLOW,
            )

    _section("paradigms (registered):", list(PARADIGMS), set(config.paradigms.enabled))
    typer.echo(f"  default: {config.paradigms.default}")
    _section("context strategies (registered):", list(STRATEGIES), {config.context.strategy})
    _section("context conditions (registered):", list(CONDITIONS), set(config.context.triggers))
    typer.echo(f"  combine: {config.context.combine}  triggers: {config.context.triggers}")
    _section("budget conditions (registered):", list(BUDGET_CONDITIONS), set(config.budget.conditions))
    typer.echo(f"  combine: {config.budget.combine}")
{% if spec.memory.enabled %}    from ..harness.memory import BACKENDS as MEMORY_BACKENDS

    _section("memory backends (registered):", list(MEMORY_BACKENDS), {config.memory.backend})
{% endif %}

{% if spec.memory.enabled %}
@app.command()
def memory(
    action: str = typer.Argument(
        "show", help="show | clear | path — inspect or reset long-term memory."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
) -> None:
    """Inspect or reset the agent's long-term memory note.

    ``show`` prints it, ``path`` prints the file location, ``clear`` erases it.
    Memory is the agent's self-maintained cross-session note — normally it edits
    it itself with the memory tools; this is the manual escape hatch.
    """
    from ..harness.memory import get_backend

    config = load_config(config_path)
    backend = get_backend(config)
    if backend is None:
        typer.secho(
            f"unknown memory backend {config.memory.backend!r} "
            "(is its module imported so @register_memory ran?)",
            fg=typer.colors.RED,
            err=True,
        )
        raise typer.Exit(code=2)
    if action == "path":
        typer.echo(str(getattr(backend, "path", config.memory.path)))
    elif action == "clear":
        if hasattr(backend, "clear"):
            backend.clear()
        typer.secho("memory cleared.", fg=typer.colors.GREEN)
    else:  # show (default)
        reader = getattr(backend, "read", backend.recall)
        typer.echo(reader() or "(memory is empty)")
{% endif %}

{% if interfaces.web %}

def _find_free_port(preferred: int, host: str = "127.0.0.1") -> int:
    """Return a bindable port: try ``preferred`` upward, else an OS-assigned one."""
    import socket

    for candidate in range(preferred, preferred + 64):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.bind((host, candidate))
                return candidate
            except OSError:
                continue
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind((host, 0))
        return sock.getsockname()[1]


@app.command()
def serve(
    host: str = typer.Option(
        "127.0.0.1", "--host", help="Bind host (use 0.0.0.0 to expose on the network)."
    ),
    port: int = typer.Option(
        0, "--port", help="Bind port; 0 (default) auto-picks a free port from 8000."
    ),
    config_path: Path = typer.Option(
        Path("config.yaml"), "--config", "-c", help="Path to config.yaml."
    ),
    mock: bool = typer.Option(
        False, "--mock", help="Use the offline mock LLM (no API key / network)."
    ),
) -> None:
    """Serve the web chat + live /config panel."""
    import uvicorn

    from .web import create_app

    bind_port = port if port else _find_free_port(8000, host)
    config = load_config(config_path)
{% if spec.mcp.enabled %}    # Launched servers live for the process lifetime (uvicorn runs until Ctrl-C).
    _start_mcp(config)
{% endif %}{% if spec.memory.enabled %}    _setup_memory(config)
{% endif %}    typer.secho(
        f"Serving on http://{host}:{bind_port}  (open this; Ctrl-C to stop)",
        fg=typer.colors.GREEN,
    )
    import sys as _sys

    # On Linux you may be reaching this over SSH; surface the forward command.
    if _sys.platform.startswith("linux"):
        typer.secho(
            "  remote? forward this port from your machine:\n"
            f"    ssh -L {bind_port}:127.0.0.1:{bind_port} <user>@<host>",
            fg=typer.colors.BRIGHT_BLACK,
        )
    uvicorn.run(create_app(config, mock=mock), host=host, port=bind_port)
{% endif %}

