    @app.get("/memory")
    def get_memory() -> dict:
        """Return the agent's long-term memory note + its size and whether it's
        read-only / oversized (the memory panel shows the size and an oversized
        warning). The note is plain markdown you own (the agent maintains it with
        the memory tools); it never holds secrets (keys stay in .env)."""
        from ..harness.memory import get_backend, is_oversized

        cfg = app.state.config
        backend = get_backend(cfg)
        reader = getattr(backend, "read", None) if backend is not None else None
        content = reader() if reader is not None else (backend.recall() if backend else "")
        return {
            "content": content,
            "read_only": cfg.memory.read_only,
            "size": len(content),
            "inject_max_chars": cfg.memory.inject_max_chars,
            "oversized": is_oversized(cfg),
        }

    @app.post("/memory")
    async def set_memory(request: Request):
        """Overwrite the whole memory note (manual curation). Rejected when memory
        is configured read-only or the backend has no writable note."""
        from ..harness.memory import get_backend

        cfg = app.state.config
        if cfg.memory.read_only:
            return JSONResponse({"error": "memory is read-only"}, status_code=400)
        backend = get_backend(cfg)
        if backend is None or not hasattr(backend, "write"):
            return JSONResponse(
                {"error": "memory backend has no writable note"}, status_code=400
            )
        backend.write(str((await request.json()).get("content", "")))
        return {"ok": True}

    @app.delete("/memory")
    def clear_memory() -> dict:
        """Forget everything (clear the note). Idempotent."""
        from ..harness.memory import get_backend

        backend = get_backend(app.state.config)
        if backend is not None and hasattr(backend, "clear"):
            backend.clear()
        return {"ok": True}

    @app.post("/memory/consolidate")
    async def consolidate_memory() -> dict:
        """Condense the note via the compaction-role model (manual trigger for the
        memory panel's "Consolidate" button). Off the reply path — it runs in a
        threadpool. Returns whether it ran plus the rewritten note + new size."""
        from ..harness.memory import consolidate

        cfg = app.state.config
        ran = await run_in_threadpool(lambda: consolidate(cfg, mock=app.state.mock))
        return {
            "ok": True,
            "ran": ran,
            **get_memory(),  # content + size + oversized after the rewrite
        }
