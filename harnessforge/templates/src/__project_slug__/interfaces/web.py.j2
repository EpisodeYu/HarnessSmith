"""Optional web interface: a streaming chat + a live ``/config`` panel (FastAPI).

Generated only when ``interfaces.web`` is enabled. ``/chat`` streams the loop's
progress over Server-Sent Events by listening on the existing :class:`Hooks`
extension point — the loop itself is untouched. ``/config`` reads and edits the
*runtime behavioral* config in-process (prompts, budget, enabled tools, context,
sampling) and never exposes secrets: profiles only carry env-var NAMES. Edits
apply to the running process; restart reloads ``config.yaml`` from disk.

Run it with ``{{ project_slug }} serve`` or ``uvicorn``.
"""

from __future__ import annotations

import json
import queue
import threading
from pathlib import Path

from fastapi import FastAPI, Request
from fastapi.concurrency import run_in_threadpool
from fastapi.responses import HTMLResponse, JSONResponse, StreamingResponse

from ..harness.config import (
    Config,
    ConfigError,
    LLMProfileConfig,
    load_config,
    resolve_env,
    set_env_value,
)
from ..harness.budget import BUDGET_CONDITIONS
from ..harness.context import CONDITIONS, STRATEGIES
from ..harness.hooks import Hooks
from ..harness.llm import ClientRouter, LLMResponse, OpenAIClient, ToolCall
from ..harness.loop import run as run_loop
from ..harness.paradigms import PARADIGMS
from ..harness import session as session_store

_INDEX_HTML = (Path(__file__).parent / "web_index.html").read_text(encoding="utf-8")

# Behavioral config the panel may edit. Structural config (which interfaces or
# modules exist) is NOT here — that requires regenerating. ``secrets`` is never
# editable or returned, so a real key value can never enter the panel.
_EDITABLE_FIELDS = (
    "llms", "roles", "prompts", "tools", "context", "paradigms",
    "observability", "budget",
)


class _StreamHooks(Hooks):
    """Push loop lifecycle events onto a queue, formatted as SSE later."""

    def __init__(self, q: queue.Queue) -> None:
        self._q = q

    def after_step(self, step: int, response: LLMResponse) -> None:
        self._q.put(("step", {"step": step, "tools": [c.name for c in response.tool_calls]}))

    def before_tool(self, call: ToolCall) -> None:
        self._q.put(("tool_call", {"name": call.name, "arguments": call.arguments}))

    def after_tool(self, call: ToolCall, result: str) -> None:
        self._q.put(("tool_result", {"name": call.name, "result": result}))

    def on_error(self, where: str, error: Exception) -> None:
        self._q.put(("error", {"where": where, "error": str(error)}))


def _sse(event: str, data: dict) -> str:
    return f"event: {event}\ndata: {json.dumps(data, ensure_ascii=False)}\n\n"


def _safe_repo_path(path: str) -> Path | None:
    """Resolve ``path`` under the project dir, or ``None`` if it's empty, absolute,
    or escapes the project root. Confines rule-file reads/writes to this repo so the
    panel can never read/overwrite arbitrary files on the host."""
    if not path or Path(path).is_absolute():
        return None
    root = Path.cwd().resolve()
    candidate = (root / path).resolve()
    try:
        candidate.relative_to(root)
    except ValueError:
        return None
    return candidate


def _chat_events(
    message: str,
    config: Config,
    *,
    mock: bool,
    stream: bool = True,
    mode: str | None = None,
    session_id: str | None = None,
    history: list[dict] | None = None,
):
    """Drive one ``run()`` in a worker thread and yield its events as SSE.

    With ``stream=True`` assistant text is forwarded token-by-token as
    ``event: token``; otherwise only step/tool/final events are emitted. ``mode``
    selects the loop paradigm (defaults to ``config.paradigms.default``).
    ``history`` resumes a prior conversation; the updated body is saved under
    ``session_id`` when sessions are enabled.
    """
    q: queue.Queue = queue.Queue()
    hooks = _StreamHooks(q)
    on_delta = (lambda text: q.put(("token", {"text": text}))) if stream else None

    def worker() -> None:
        try:
            router = ClientRouter(config, mock=mock)
            result = run_loop(
                message,
                mode=mode,
                client_for=router.client_for,
                config=config,
                hooks=hooks,
                on_delta=on_delta,
                history=history,
            )
            if session_id is not None and config.sessions.enabled:
                session_store.save(
                    session_id, result.messages, config.sessions.dir, mode=result.mode
                )
            q.put(("final", {
                "answer": result.answer,
                "mode": result.mode,
                "stop_reason": result.stop_reason,
                "steps": result.steps,
                "tokens": result.trace.total_tokens,
                "cost_usd": round(result.trace.cost_usd, 6),
            }))
        except Exception as exc:  # never leave the stream hanging
            q.put(("error", {"where": "run", "error": str(exc)}))
        finally:
            q.put(None)

    # Tell the client which session this turn belongs to (so it can resume).
    if session_id is not None:
        yield _sse("session", {"id": session_id})
    threading.Thread(target=worker, daemon=True).start()
    while True:
        item = q.get()
        if item is None:
            break
        yield _sse(*item)


def create_app(config: Config | None = None, *, mock: bool = False) -> FastAPI:
    """Build the FastAPI app. ``config`` defaults to ``load_config()`` (config.yaml)."""
    app = FastAPI(title="{{ display_name }} — web")
    app.state.config = config or load_config()
    app.state.mock = mock

    @app.get("/", response_class=HTMLResponse)
    def index() -> str:
        return _INDEX_HTML

    @app.get("/chat")
    def chat(
        message: str,
        stream: bool = True,
        mode: str | None = None,
        session: str | None = None,
    ) -> StreamingResponse:
        cfg = app.state.config
        # Resume the given session, or mint a new id; disabled sessions => one-shot.
        if cfg.sessions.enabled:
            session_id = session or session_store.new_id()
            history = session_store.load(session_id, cfg.sessions.dir) if session else []
        else:
            session_id, history = None, None
        return StreamingResponse(
            _chat_events(
                message, cfg, mock=app.state.mock, stream=stream, mode=mode,
                session_id=session_id, history=history,
            ),
            media_type="text/event-stream",
        )

    @app.get("/sessions")
    def sessions() -> dict:
        """List saved sessions (most recent first) for the chat session picker."""
        cfg = app.state.config
        if not cfg.sessions.enabled:
            return {"sessions": []}
        return {"sessions": session_store.summaries(cfg.sessions.dir)}

    @app.get("/sessions/{session_id}")
    def session_detail(session_id: str) -> dict:
        """Return one session's message body so the UI can replay it on resume."""
        cfg = app.state.config
        return {
            "id": session_id,
            "messages": session_store.load(session_id, cfg.sessions.dir),
        }

    @app.get("/paradigms")
    def paradigms() -> dict:
        """The runtime paradigm roster, for the chat-mode dropdown."""
        return app.state.config.paradigms.model_dump(mode="json")

    @app.get("/registries")
    def registries() -> dict:
        """What's registered in code — the extension universe behind the config
        dropdowns. A custom ``@register_paradigm`` / ``@register_strategy`` /
        ``@register_condition`` / ``@register_budget_condition`` shows up here once
        its module is imported, so the panel can offer it (and flag a config name
        that isn't registered). ``/config`` holds what's currently *selected*; this
        holds what *exists*.
        """
        return {
            "paradigms": list(PARADIGMS),
            "strategies": list(STRATEGIES),
            "conditions": list(CONDITIONS),
            "budget_conditions": list(BUDGET_CONDITIONS),
        }
{% if spec.mcp.enabled %}
    @app.get("/mcp/discover")
    async def mcp_discover() -> dict:
        """Connect every configured MCP server and list its tools, so the panel can
        offer them without hand-writing the ``<server>__<tool>`` allowlist.

        Read-only: it lists what each server exposes (and which names are already
        allowlisted/enabled); actually enabling a tool still goes through POST
        /config. Per-server failures are reported in ``error`` (never fatal), and
        a slow/missing server is skipped under ``connect_timeout_seconds``.
        """
        from ..harness.mcp import McpManager

        config = app.state.config
        if not config.mcp.servers:
            return {"servers": []}
        enabled = config.enabled_tool_names()
        listed = {tool.name for tool in config.tools}

        def _scan() -> tuple[dict, dict]:
            manager = McpManager(config.mcp)
            try:
                manager.start()  # connects all servers (failures isolated into .errors)
                return (
                    {
                        server: [(t.name, t.description or "") for t in tools]
                        for server, tools in manager.discovered.items()
                    },
                    dict(manager.errors),
                )
            finally:
                manager.close()

        discovered, errors = await run_in_threadpool(_scan)
        servers = []
        for server in config.mcp.servers:
            tools = []
            for name, description in discovered.get(server.name, []):
                full = f"{server.name}__{name}"
                tools.append({
                    "name": full,
                    "short": name,
                    "description": description,
                    "listed": full in listed,
                    "enabled": full in enabled,
                })
            servers.append(
                {"name": server.name, "error": errors.get(server.name), "tools": tools}
            )
        return {"servers": servers}
{% endif %}

    @app.get("/config")
    def get_config() -> dict:
        # model_dump holds only env-var NAMES (api_key_env), never secret values.
        return app.state.config.model_dump(mode="json", include=set(_EDITABLE_FIELDS))

    @app.post("/env")
    async def set_env(request: Request):
        """Write a secret VALUE into the local .env (write-only; never returned).

        config.yaml stores only the env-var NAME; this fills its value in .env
        (gitignored). The value is never echoed back, logged, or put in config.
        """
        body = await request.json()
        name = str(body.get("name", "")).strip()
        if not name:
            return JSONResponse({"error": "name required"}, status_code=400)
        try:
            set_env_value(name, str(body.get("value", "")))
        except ConfigError as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        return {"ok": True, "name": name}  # never return the value

    @app.post("/test-llm")
    async def test_llm(request: Request) -> dict:
        """Probe one LLM profile with a real one-shot call. Returns ``{ok, error}``.

        Uses the SAME client path as the loop (so the result reflects real usage):
        sampling knobs are sent only when set. Secrets stay server-side — the
        request carries the env-var NAME, the key is resolved from .env here.
        Obvious config gaps (no model, unresolved key with no custom base_url) are
        reported up front without a network call.
        """
        body = await request.json()
        try:
            profile = LLMProfileConfig.model_validate(body)
        except Exception as exc:
            return {"ok": False, "error": f"invalid profile: {exc}"}
        if not profile.model.strip():
            return {"ok": False, "error": "model is required"}
        api_key = resolve_env(profile.api_key_env)
        base_url = resolve_env(profile.base_url_env)
        if not api_key and not base_url:
            return {"ok": False, "error": (
                f"no API key: env var {profile.api_key_env} is not set in .env or the "
                "environment — set its value first (or configure a custom base_url)"
            )}

        def _probe() -> None:
            OpenAIClient(profile).complete([{"role": "user", "content": "ping"}], None)

        try:
            await run_in_threadpool(_probe)
            return {"ok": True}
        except Exception as exc:
            return {"ok": False, "error": str(exc)}

    @app.post("/config")
    async def set_config(request: Request):
        patch = await request.json()
        current = app.state.config.model_dump(mode="json")
        for key in _EDITABLE_FIELDS:  # secrets/structural keys are ignored
            if key in patch:
                current[key] = patch[key]
        try:
            app.state.config = Config.model_validate(current)
        except Exception as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        return app.state.config.model_dump(mode="json", include=set(_EDITABLE_FIELDS))

    @app.get("/rules")
    def get_rules() -> dict:
        """Return the content of each always-apply rule file the agent injects: the
        explicit ``prompts.rules_files`` plus any auto-recognized convention file
        present at the root (CLAUDE.md), flagged ``auto`` so the panel can show it
        read-only. A not-yet-written (or out-of-repo) file comes back empty. These
        are plain markdown files you own — the AGENTS.md / CLAUDE.md pattern."""
        from ..harness.prompts import _CONVENTION_RULE_FILES

        seen: set[str] = set()
        rules: list[dict] = []

        def _add(path: str, auto: bool) -> None:
            key = str(Path(path))
            if key in seen:
                return
            seen.add(key)
            resolved = _safe_repo_path(path)
            exists = resolved is not None and resolved.is_file()
            if auto and not exists:
                return  # only surface convention files that actually exist
            content = resolved.read_text(encoding="utf-8") if exists else ""
            rules.append({"path": path, "content": content, "exists": exists, "auto": auto})

        for path in app.state.config.prompts.rules_files:
            _add(path, False)
        for path in _CONVENTION_RULE_FILES:
            _add(path, True)
        return {"rules": rules}

    @app.post("/rules")
    async def set_rule(request: Request):
        """Write one rule file's content to disk (markdown you own). The path must be
        relative and stay inside the project directory — absolute paths or ``..``
        escapes are rejected. Add the path to ``prompts.rules_files`` (POST /config)
        for it to be injected."""
        body = await request.json()
        resolved = _safe_repo_path(str(body.get("path", "")).strip())
        if resolved is None:
            return JSONResponse(
                {"error": "path must be relative and inside the project directory"},
                status_code=400,
            )
        resolved.parent.mkdir(parents=True, exist_ok=True)
        resolved.write_text(str(body.get("content", "")), encoding="utf-8")
        return {"ok": True}

    return app


app = create_app()
