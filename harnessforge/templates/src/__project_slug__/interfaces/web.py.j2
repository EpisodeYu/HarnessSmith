class _StreamHooks(Hooks):
    """Push loop lifecycle events onto a queue, formatted as SSE later.

    Composes with an ``inner`` Hooks (the one named in ``config.hooks``, if any):
    each lifecycle method runs the user's hook first, then emits the SSE event, so
    a configured guardrail / audit hook works under the web UI too — not just the CLI.
    """

    def __init__(self, q: queue.Queue, inner: Hooks | None = None) -> None:
        self._q = q
        self._inner = inner or Hooks()

    def before_step(self, step: int, messages: list[dict]) -> None:
        self._inner.before_step(step, messages)

    def after_step(self, step: int, response: LLMResponse) -> None:
        self._inner.after_step(step, response)
        self._q.put(("step", {"step": step, "tools": [c.name for c in response.tool_calls]}))

    def before_tool(self, call: ToolCall) -> None:
        self._inner.before_tool(call)
        self._q.put(("tool_call", {"name": call.name, "arguments": call.arguments}))

    def after_tool(self, call: ToolCall, result: str) -> None:
        self._inner.after_tool(call, result)
        self._q.put(("tool_result", {"name": call.name, "result": result}))

    def on_error(self, where: str, error: Exception) -> None:
        self._inner.on_error(where, error)
        self._q.put(("error", {"where": where, "error": str(error)}))


def _sse(event: str, data: dict) -> str:
    return f"event: {event}\ndata: {json.dumps(data, ensure_ascii=False)}\n\n"


class WebAsker:
    """Ask the user over the open SSE stream + a POST back — the web side of the
    shared interaction channel (the ``ask_question`` tool, and HITL confirmation
    later).

    ``ask`` pushes an ``("ask", {...})`` event (the page renders a card), then
    BLOCKS on a per-request reply queue until ``POST /chat/{run_id}/respond`` (or a
    cancel/disconnect sentinel) delivers the answer. The loop is serial, so one run
    has at most one pending ask at a time; a small per-run table maps request id ->
    reply queue. A ``None`` sentinel (stop / disconnect) degrades fail-closed
    (a question -> "use your judgment", an approval -> reject).
    """

    def __init__(self, event_q: queue.Queue, pending: dict, lock) -> None:
        self._q = event_q
        self._pending = pending  # this run's {request_id -> reply Queue}
        self._lock = lock

    def ask(self, req) -> AskResponse:
        request_id = session_store.new_id()
        reply_q: queue.Queue = queue.Queue()
        with self._lock:
            self._pending[request_id] = reply_q
        self._q.put((
            "ask",
            {
                "request_id": request_id,
                "kind": req.kind,
                "prompt": req.prompt,
                "options": [{"id": o.id, "label": o.label} for o in req.options],
                "allow_text": req.allow_text,
                "allow_multiple": req.allow_multiple,
                "context": req.context,
            },
        ))
        try:
            reply = reply_q.get()  # blocks until /respond or a cancel sentinel
        finally:
            with self._lock:
                self._pending.pop(request_id, None)
        if reply is None:  # stopped / disconnected -> fail-closed degrade
            return noninteractive_response(req)
        return AskResponse(
            option_ids=list(reply.get("option_ids") or []),
            text=reply.get("text"),
        )


_TITLE_PROMPT = (
    "Generate a very short title naming the TOPIC of the user's request. "
    "Reply in the SAME language as the request.\n\n"
    "Rules:\n"
    "- Output ONLY the title — no quotes, no surrounding punctuation, no commentary.\n"
    "- A concise noun phrase, not a full sentence.\n"
    "- <= 8 words, or <= 16 Chinese characters."
)


def _generate_title(client, question: str) -> str:
    """Summarize the first user message into a short session title (best-effort).

    Uses the ``title`` role's client (falls back to ``generation``). Any failure
    returns "" so the caller just leaves the title empty (retried next turn) —
    auto-titling must never break the chat.
    """
    q = (question or "").strip()
    if not q:
        return ""
    try:
        resp = client.complete(
            [
                {"role": "system", "content": _TITLE_PROMPT},
                {"role": "user", "content": q[:2000]},
            ],
            None,
        )
    except Exception:
        return ""
    text = (resp.content or "").strip()
    line = next((ln.strip() for ln in text.splitlines() if ln.strip()), "")
    return line.strip("\"'").strip()[:60]


def _safe_repo_path(path: str) -> Path | None:
    """Resolve ``path`` under the project dir, or ``None`` if it's empty, absolute,
    or escapes the project root. Confines rule-file reads/writes to this repo so the
    panel can never read/overwrite arbitrary files on the host."""
    if not path or Path(path).is_absolute():
        return None
    root = Path.cwd().resolve()
    candidate = (root / path).resolve()
    try:
        candidate.relative_to(root)
    except ValueError:
        return None
    return candidate


def _chat_events(
    message: str,
    config: Config,
    *,
    mock: bool,
    stream: bool = True,
    mode: str | None = None,
    session_id: str | None = None,
    history: list[dict] | None = None,
    auto_title: bool = False,
    runs: dict | None = None,
    pending: dict | None = None,
    lock=None,
):
    """Drive one ``run()`` in a worker thread and yield its events as SSE.

    With ``stream=True`` assistant text is forwarded token-by-token as
    ``event: token``; otherwise only step/tool/final events are emitted. ``mode``
    selects the loop paradigm (defaults to ``config.paradigms.default``).
    ``history`` resumes a prior conversation; the updated body is saved under
    ``session_id`` when sessions are enabled. When ``auto_title`` is set, the
    first message is summarized into a session title (``title`` role) BEFORE the
    answer so the sidebar names the session up front.

    A cancel token is registered in ``runs`` under a fresh ``run_id`` (emitted as
    the first ``event: run``) so ``POST /chat/{run_id}/stop`` — or a client
    disconnect (``GeneratorExit``) — can stop the loop mid-flight. An interrupted
    turn still persists its partial body (``status="interrupted"``) and emits
    ``event: stopped`` instead of ``event: final``, so the chat stays resumable.
    Each completed step is also write-ahead checkpointed for crash safety.

    ``pending`` registers this run's open asks (an ``event: ask`` card waiting for
    ``POST /chat/{run_id}/respond``) so a reply can reach the blocked worker, and a
    stop/disconnect can unblock any pending ask (fail-closed) instead of stranding
    the worker thread.
    """
    q: queue.Queue = queue.Queue()
    hooks = _StreamHooks(q, load_hooks(config))
    on_delta = (lambda text: q.put(("token", {"text": text}))) if stream else None
    router = ClientRouter(config, mock=mock)

    # Register this run's cancel token so /stop (and disconnect) can reach it, plus
    # a per-run pending-ask table so /respond can deliver an answer to the worker.
    run_id = session_store.new_id()
    cancel_event = threading.Event()
    run_pending: dict = {}
    if runs is not None and lock is not None:
        with lock:
            runs[run_id] = cancel_event
            if pending is not None:
                pending[run_id] = run_pending

    # The asker the loop reaches via the interaction contextvar: over the web it's
    # the SSE-card asker; with no pending table (e.g. a direct unit call) it degrades.
    asker = (
        WebAsker(q, run_pending, lock)
        if pending is not None and lock is not None
        else NonInteractiveAsker()
    )

    # Auto-title first (best-effort): the sidebar gets a name before the answer.
    new_title = ""
    if auto_title and message.strip():
        title_role = "title" if "title" in config.roles else "generation"
        new_title = _generate_title(router.client_for(title_role), message)

    save_mode = mode or config.paradigms.default

    def _checkpoint(body: list[dict]) -> None:
        if session_id is not None and config.sessions.enabled:
            session_store.checkpoint(session_id, body, config.sessions.dir, mode=save_mode)

    def worker() -> None:
        try:
            # Set the asker inside the worker thread: a ContextVar does not
            # propagate across threads, so the loop must bind it here to reach
            # the user (ask_question / HITL) from this thread.
            with using_asker(asker):
                result = run_loop(
                    message,
                    mode=mode,
                    client_for=router.client_for,
                    config=config,
                    hooks=hooks,
                    on_delta=on_delta,
                    history=history,
                    cancel=cancel_event.is_set,
                    checkpoint=_checkpoint,
                )
            interrupted = result.stop_reason == "interrupted"
            if session_id is not None and config.sessions.enabled:
                session_store.save(
                    session_id, result.messages, config.sessions.dir,
                    mode=result.mode, title=new_title or None,
                    status="interrupted" if interrupted else "complete",
                )
{% if spec.memory.enabled %}            from ..harness.memory import record_turn

            record_turn(config, result.messages)
{% endif %}            payload = {
                "answer": result.answer,
                "mode": result.mode,
                "stop_reason": result.stop_reason,
                "steps": result.steps,
                "tokens": result.trace.total_tokens,
                "cost_usd": round(result.trace.cost_usd, 6),
                "session": session_id,
            }
            # Interrupted = stopped on purpose: emit `stopped` (resumable), not a
            # synthetic final answer.
            q.put(("stopped" if interrupted else "final", payload))
        except Exception as exc:  # never leave the stream hanging
            q.put(("error", {"where": "run", "error": str(exc)}))
        finally:
            q.put(None)

    # Announce the run id (for /stop) + session id (to resume) up front, then the
    # title (if we made one) so the sidebar updates immediately.
    yield _sse("run", {"run_id": run_id})
    if session_id is not None:
        yield _sse("session", {"id": session_id})
    if new_title:
        yield _sse("title", {"id": session_id, "title": new_title})
    threading.Thread(target=worker, daemon=True).start()
    try:
        while True:
            item = q.get()
            if item is None:
                break
            yield _sse(*item)
    except GeneratorExit:
        # Client disconnected (closed tab / dropped network): cancel the run so
        # the loop stops at the next boundary instead of running on unwatched, and
        # unblock any pending ask (fail-closed) so the worker thread isn't stranded.
        cancel_event.set()
        if lock is not None:
            with lock:
                for reply_q in list(run_pending.values()):
                    reply_q.put(None)
        raise
    finally:
        if runs is not None and lock is not None:
            with lock:
                runs.pop(run_id, None)
                if pending is not None:
                    pending.pop(run_id, None)


def create_app(
    config: Config | None = None,
    *,
    mock: bool = False,
    config_path: str | Path | None = None,
) -> FastAPI:
    """Build the FastAPI app.

    With no ``config`` it loads ``config_path`` (default ``config.yaml``) and
    keeps that path so a ``/config`` Save persists back to it. When ``config`` is
    passed in (e.g. tests) the path is only tracked if given explicitly — a
    config built in code (no path) never gets written to a stray file.
    """
    app = FastAPI(title="{{ display_name }} — web")
    if config is None:
        config_path = config_path or DEFAULT_CONFIG_PATH
        config = load_config(config_path)
    app.state.config = config
    # Where a /config Save writes back to (None = apply in-process, don't persist).
    app.state.config_path = Path(config_path) if config_path is not None else None
    app.state.mock = mock
    # In-flight chat runs: run_id -> cancel Event, so POST /chat/{run_id}/stop can
    # signal a running loop. The lock guards the dict across worker threads.
    app.state.runs = {}
    # Open asks per run: run_id -> {request_id -> reply Queue}, so POST
    # /chat/{run_id}/respond can deliver an answer to a blocked worker (and stop /
    # disconnect can unblock any pending ask). Guarded by the same lock.
    app.state.pending = {}
    app.state.runs_lock = threading.Lock()
    # Load config.extensions so custom @register_* (tools / paradigms / conditions /
    # backends) are available to this web process; serve() also runs the full
    # diagnostics + fail-fast before binding.
    import_extensions(app.state.config)
{% if spec.memory.enabled %}    from ..harness.memory import register_memory_tools

    register_memory_tools(app.state.config)
{% endif %}
    @app.get("/", response_class=HTMLResponse)
    def index() -> str:
        return _INDEX_HTML

    @app.get("/chat")
    def chat(
        message: str,
        stream: bool = True,
        mode: str | None = None,
        session: str | None = None,
        edit_turn: int | None = None,
    ) -> StreamingResponse:
        cfg = app.state.config
        # Resume the given session, or mint a new id; disabled sessions => one-shot.
        if cfg.sessions.enabled:
            session_id = session or session_store.new_id()
            history = session_store.load(session_id, cfg.sessions.dir) if session else []
            # Re-ask: an edited historical question. Drop everything from that user
            # turn onward, then regenerate from there (destructive truncation — the
            # later conversation is overwritten on save, not forked).
            if edit_turn is not None and history:
                history = session_store.truncate_to_turn(history, edit_turn)
        else:
            session_id, history = None, None
        # Auto-title a session that has no title yet (new, or an earlier attempt
        # failed). Skips sessions that already have one.
        auto_title = bool(
            cfg.sessions.enabled
            and cfg.sessions.auto_title
            and session_id is not None
            and not session_store.title_of(session_id, cfg.sessions.dir)
        )
        return StreamingResponse(
            _chat_events(
                message, cfg, mock=app.state.mock, stream=stream, mode=mode,
                session_id=session_id, history=history, auto_title=auto_title,
                runs=app.state.runs, pending=app.state.pending, lock=app.state.runs_lock,
            ),
            media_type="text/event-stream",
        )

    @app.post("/chat/{run_id}/stop")
    def stop_chat(run_id: str) -> dict:
        """Stop an in-flight chat run: set its cancel token so the loop ends at the
        next boundary (mid-token for a streaming turn; the partial answer is
        dropped and the conversation saved as resumable). Any pending ask is
        unblocked fail-closed so a stopped run never strands a worker. Idempotent —
        an unknown or already-finished run_id is a no-op 200."""
        with app.state.runs_lock:
            event = app.state.runs.get(run_id)
            replies = list(app.state.pending.get(run_id, {}).values())
        if event is not None:
            event.set()
        for reply_q in replies:
            reply_q.put(None)  # unblock a pending ask (question degrades / approval rejects)
        return {"ok": True, "run_id": run_id}

    @app.post("/chat/{run_id}/respond")
    async def respond_chat(run_id: str, request: Request):
        """Deliver the user's answer to a pending ask — the card shown for an
        ``event: ask`` (a model ``ask_question``, or HITL confirmation later).

        Body ``{request_id, option_ids, text}`` is routed to the blocked worker so
        the loop resumes with the answer. Idempotent — an unknown run/request id is
        a no-op 200 (e.g. the run already finished or was stopped)."""
        body = await request.json()
        request_id = str(body.get("request_id", ""))
        with app.state.runs_lock:
            reply_q = app.state.pending.get(run_id, {}).get(request_id)
        if reply_q is not None:
            reply_q.put(
                {"option_ids": body.get("option_ids", []), "text": body.get("text")}
            )
        return {"ok": True}

    @app.get("/sessions")
    def sessions() -> dict:
        """List saved sessions (most recent first) for the chat session picker."""
        cfg = app.state.config
        if not cfg.sessions.enabled:
            return {"sessions": []}
        return {"sessions": session_store.summaries(cfg.sessions.dir)}

    @app.get("/sessions/{session_id}")
    def session_detail(session_id: str) -> dict:
        """Return one session's message body so the UI can replay it on resume."""
        cfg = app.state.config
        return {
            "id": session_id,
            "messages": session_store.load(session_id, cfg.sessions.dir),
        }

    @app.patch("/sessions/{session_id}")
    async def rename_session(session_id: str, request: Request):
        """Rename a session (set its sidebar title); keeps its messages."""
        cfg = app.state.config
        if not cfg.sessions.enabled:
            return JSONResponse({"error": "sessions disabled"}, status_code=400)
        title = str((await request.json()).get("title", "")).strip()[:120]
        if not session_store.set_title(session_id, title, cfg.sessions.dir):
            return JSONResponse({"error": "unknown session"}, status_code=404)
        return {"id": session_id, "title": title}

    @app.delete("/sessions/{session_id}")
    def delete_session(session_id: str) -> dict:
        """Delete a session (idempotent — a missing one is a no-op)."""
        cfg = app.state.config
        session_store.delete(session_id, cfg.sessions.dir)
        return {"ok": True}

    @app.get("/paradigms")
    def paradigms() -> dict:
        """The runtime paradigm roster, for the chat-mode dropdown."""
        return app.state.config.paradigms.model_dump(mode="json")

    @app.get("/registries")
    def registries() -> dict:
        """What's registered in code — the extension universe behind the config
        dropdowns. A custom ``@register_paradigm`` / ``@register_strategy`` /
        ``@register_condition`` / ``@register_budget_condition`` shows up here once
        its module is imported, so the panel can offer it (and flag a config name
        that isn't registered). ``/config`` holds what's currently *selected*; this
        holds what *exists*.
        """
        return {
            "paradigms": list(PARADIGMS),
            "strategies": list(STRATEGIES),
            "conditions": list(CONDITIONS),
            "budget_conditions": list(BUDGET_CONDITIONS),
{% if spec.memory.enabled %}            "memory": list(_MEMORY_BACKENDS),
{% endif %}        }
{% if spec.mcp.enabled %}
    @app.get("/mcp/discover")
    async def mcp_discover() -> dict:
        """Connect every configured MCP server and list its tools, so the panel can
        offer them without hand-writing the ``<server>__<tool>`` allowlist.

        Read-only: it lists what each server exposes (and which names are already
        allowlisted/enabled); actually enabling a tool still goes through POST
        /config. Per-server failures are reported in ``error`` (never fatal), and
        a slow/missing server is skipped under ``connect_timeout_seconds``.
        """
        from ..harness.mcp import McpManager

        config = app.state.config
        if not config.mcp.servers:
            return {"servers": []}
        enabled = config.enabled_tool_names()
        listed = {tool.name for tool in config.tools}

        def _scan() -> tuple[dict, dict]:
            manager = McpManager(config.mcp)
            try:
                manager.start()  # connects all servers (failures isolated into .errors)
                return (
                    {
                        server: [(t.name, t.description or "") for t in tools]
                        for server, tools in manager.discovered.items()
                    },
                    dict(manager.errors),
                )
            finally:
                manager.close()

        discovered, errors = await run_in_threadpool(_scan)
        servers = []
        for server in config.mcp.servers:
            tools = []
            for name, description in discovered.get(server.name, []):
                full = f"{server.name}__{name}"
                tools.append({
                    "name": full,
                    "short": name,
                    "description": description,
                    "listed": full in listed,
                    "enabled": full in enabled,
                })
            servers.append(
                {"name": server.name, "error": errors.get(server.name), "tools": tools}
            )
        return {"servers": servers}
{% endif %}

    @app.get("/config")
    def get_config() -> dict:
        # model_dump holds only env-var NAMES (api_key_env), never secret values.
        return app.state.config.model_dump(mode="json", include=set(_EDITABLE_FIELDS))

    @app.post("/env")
    async def set_env(request: Request):
        """Write a secret VALUE into the local .env (write-only; never returned).

        config.yaml stores only the env-var NAME; this fills its value in .env
        (gitignored). The value is never echoed back, logged, or put in config.
        """
        body = await request.json()
        name = str(body.get("name", "")).strip()
        if not name:
            return JSONResponse({"error": "name required"}, status_code=400)
        try:
            set_env_value(name, str(body.get("value", "")))
        except ConfigError as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        return {"ok": True, "name": name}  # never return the value

    @app.post("/test-llm")
    async def test_llm(request: Request) -> dict:
        """Probe one LLM profile with a real one-shot call. Returns ``{ok, error}``.

        Uses the SAME client path as the loop (so the result reflects real usage):
        sampling knobs are sent only when set. Secrets stay server-side — the
        request carries the env-var NAME, the key is resolved from .env here.
        Obvious config gaps (no model, unresolved key with no custom base_url) are
        reported up front without a network call.
        """
        body = await request.json()
        try:
            profile = LLMProfileConfig.model_validate(body)
        except Exception as exc:
            return {"ok": False, "error": f"invalid profile: {exc}"}
        if not profile.model.strip():
            return {"ok": False, "error": "model is required"}
        api_key = resolve_env(profile.api_key_env)
        base_url = resolve_env(profile.base_url_env)
        if not api_key and not base_url:
            return {"ok": False, "error": (
                f"no API key: env var {profile.api_key_env} is not set in .env or the "
                "environment — set its value first (or configure a custom base_url)"
            )}

        def _probe() -> None:
            OpenAIClient(profile).complete([{"role": "user", "content": "ping"}], None)

        try:
            await run_in_threadpool(_probe)
            return {"ok": True}
        except Exception as exc:
            return {"ok": False, "error": str(exc)}

    @app.post("/config")
    async def set_config(request: Request):
        patch = await request.json()
        current = app.state.config.model_dump(mode="json")
        for key in _EDITABLE_FIELDS:  # secrets/structural keys are ignored
            if key in patch:
                current[key] = patch[key]
        try:
            app.state.config = Config.model_validate(current)
        except Exception as exc:
            return JSONResponse({"error": str(exc)}, status_code=400)
        # Persist the editable fields back to config.yaml (comments preserved) so
        # the edit survives a restart, not just this process. exclude_none keeps
        # unset knobs from being written out as explicit `null`s; secrets are
        # never in _EDITABLE_FIELDS, so only env-var NAMES ever reach the file.
        if app.state.config_path is not None:
            updates = app.state.config.model_dump(
                mode="json", include=set(_EDITABLE_FIELDS), exclude_none=True
            )
            try:
                save_config(updates, app.state.config_path)
            except Exception as exc:
                return JSONResponse(
                    {"error": f"applied in-process but could not write config.yaml: {exc}"},
                    status_code=500,
                )
        return app.state.config.model_dump(mode="json", include=set(_EDITABLE_FIELDS))

    @app.get("/rules")
    def get_rules() -> dict:
        """Return the content of each always-apply rule file the agent injects: the
        explicit ``prompts.rules_files`` plus any auto-recognized convention file
        present at the root (CLAUDE.md), flagged ``auto`` so the panel can show it
        read-only. A not-yet-written (or out-of-repo) file comes back empty. These
        are plain markdown files you own — the AGENTS.md / CLAUDE.md pattern."""
        from ..harness.prompts import _CONVENTION_RULE_FILES

        seen: set[str] = set()
        rules: list[dict] = []

        def _add(path: str, auto: bool) -> None:
            key = str(Path(path))
            if key in seen:
                return
            seen.add(key)
            resolved = _safe_repo_path(path)
            exists = resolved is not None and resolved.is_file()
            if auto and not exists:
                return  # only surface convention files that actually exist
            content = resolved.read_text(encoding="utf-8") if exists else ""
            rules.append({"path": path, "content": content, "exists": exists, "auto": auto})

        for path in app.state.config.prompts.rules_files:
            _add(path, False)
        for path in _CONVENTION_RULE_FILES:
            _add(path, True)
        return {"rules": rules}

    @app.post("/rules")
    async def set_rule(request: Request):
        """Write one rule file's content to disk (markdown you own). The path must be
        relative and stay inside the project directory — absolute paths or ``..``
        escapes are rejected. Add the path to ``prompts.rules_files`` (POST /config)
        for it to be injected."""
        body = await request.json()
        resolved = _safe_repo_path(str(body.get("path", "")).strip())
        if resolved is None:
            return JSONResponse(
                {"error": "path must be relative and inside the project directory"},
                status_code=400,
            )
        resolved.parent.mkdir(parents=True, exist_ok=True)
        resolved.write_text(str(body.get("content", "")), encoding="utf-8")
        return {"ok": True}
