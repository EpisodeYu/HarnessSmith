        tools_group_custom: "你的工具", tools_group_builtin: "内置工具", tools_group_mcp: "MCP",
        tools_scan: "扫描 MCP", tools_scanning: "正在连接服务器…", tools_scanned: "已发现",
        tools_extend_hint: "你自己的工具:在 harness/tools.py 用 @registry.tool 注册,再把名字加进 config.yaml 的 tools: 才会出现在这里。MCP 工具会从你配置的服务器自动发现(扫描)—— 勾上即加入 allowlist。勾选框可实时开关某个工具(免重启)。见 AGENTS.md。",
        prompts_system: "系统提示", prompts_rules: "规则文件(常驻)",
        rule_add: "+ 添加规则文件", rule_path_ph: "路径,如 RULES.md",
        rule_auto: "自动", rule_auto_hint: "在项目根目录自动识别(CLAUDE.md)—— 无需列出也会注入。可在此编辑正文;保存即写入该文件。",
        rules_hint: "你拥有的纯 markdown 文件(AGENTS.md / CLAUDE.md 模式),每轮原文注入系统提示。在此编辑正文;保存会写入文件 + 生效列表。",
        paradigms_enabled: "启用的范式", paradigms_default: "默认范式",
        par_extend_hint: "可自定义:在 harness/paradigms/ 用 @register_paradigm 注册,import 后即在此出现(见 AGENTS.md)。",
{% if spec.memory.enabled %}        mem_hint: "一份 agent 跨会话维护的简短笔记,每轮注入系统提示。agent 用记忆工具自行维护,你也可在此编辑。",
        mem_readonly: "只读(agent 只能读记忆,不能写)",
        mem_backend: "后端", mem_capacity: "容量(注入上限 inject_max_chars)",
        mem_auto: "会话结束时若超出容量自动整理(用 memory 角色模型)",
        mem_policy: "记忆策略(记什么 / 何时写)",
        mem_policy_ph: "例如:记住稳定的用户偏好、决策、项目事实;不要记临时闲聊。",
        mem_note: "当前记忆笔记", mem_oversized: "笔记已超过注入上限——较早的笔记不会再被召回。整理可精简它。",
        mem_save_note: "保存笔记", mem_consolidate: "整理", mem_clear: "清空",
        mem_saved: "已保存", mem_cleared: "已清空", mem_consolidating: "整理中…",
        mem_consolidated: "已整理", mem_consolidate_noop: "无需整理",
        mem_chars: "字符",
        mem_extend_hint: "可自定义:在 harness/memory.py 用 @register_memory 注册后端,import 后即出现在后端列表(见 AGENTS.md)。",
{% endif %}        obs_trace: "写 JSONL trace", obs_tracedir: "trace 目录",
      },
    };
    let lang = localStorage.getItem("hf_lang") || "{{ language }}";
    const t = (k) => (I18N[lang] && I18N[lang][k]) || k;

    function applyI18n() {
      document.documentElement.lang = lang;
      $("lang").value = lang;
      document.querySelectorAll("[data-i18n]").forEach((el) => { el.textContent = t(el.dataset.i18n); });
      document.querySelectorAll("[data-i18n-ph]").forEach((el) => { el.placeholder = t(el.dataset.i18nPh); });
      document.querySelectorAll("[data-i18n-title]").forEach((el) => { el.title = t(el.dataset.i18nTitle); });
      buildCfgTabs();
      renderSessionList();
      updateMainTitle();
    }
    $("lang").addEventListener("change", () => {
      lang = $("lang").value; localStorage.setItem("hf_lang", lang); applyI18n();
    });

    // ---- chat (unchanged behavior) -------------------------------------
    function line(text, cls) {
      const el = document.createElement("div");
      el.className = cls || "text-slate-700";
      el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    // Render the inline interaction card for an `event: ask` (a model
    // ask_question, or — later — HITL tool confirmation). The answer is POSTed
    // back to /chat/{run_id}/respond, which unblocks the waiting loop. Themed and
    // inline (no native browser dialogs).
    function renderAskCard(data) {
      const runId = currentRunId;
      const card = document.createElement("div");
      card.className = "ask-card rounded-lg border border-indigo-300 bg-indigo-50 p-3 space-y-2";
      const prompt = document.createElement("div");
      prompt.className = "font-medium text-slate-800 whitespace-pre-wrap";
      prompt.textContent = data.prompt;
      card.appendChild(prompt);
      if (data.kind === "approval" && data.context && data.context.tool) {
        const ctx = document.createElement("div");
        ctx.className = "text-xs text-slate-500 whitespace-pre-wrap";
        ctx.textContent = data.context.tool + " " + (data.context.arguments || "");
        card.appendChild(ctx);
      }

      let answered = false;
      const submit = (optionIds, text) => {
        if (answered) return;
        answered = true;
        // Collapse the interactive card into a compact transcript line so it reads
        // as part of the conversation and scrolls/flows with it (no lingering
        // widget pinned at the bottom).
        const picked = (data.options || [])
          .filter((o) => (optionIds || []).includes(o.id))
          .map((o) => o.label);
        let summary = picked.join(", ");
        if (text) summary = summary ? (summary + " · " + text) : text;
        if (!summary) summary = t("ask_skip");
        card.className = "whitespace-pre-wrap text-sm text-indigo-700";
        card.textContent = "❓ " + data.prompt + " → " + summary;
        log.scrollTop = log.scrollHeight;
        fetch("/chat/" + encodeURIComponent(runId) + "/respond", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            request_id: data.request_id, option_ids: optionIds || [],
            text: (text == null || text === "") ? null : text,
          }),
        }).catch(() => {});
      };

      if (data.kind === "approval") {
        const bar = document.createElement("div");
        bar.className = "flex flex-wrap gap-2";
        (data.options || []).forEach((o) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "rounded bg-slate-800 px-3 py-1 text-xs text-white";
          b.textContent = o.label;
          b.addEventListener("click", () => submit([o.id], null));
          bar.appendChild(b);
        });
        card.appendChild(bar);
      } else {
        const inputs = [];  // the real-option radios/checkboxes (not "Other")
        const hasOptions = !!(data.options && data.options.length);
        // The free-text box. With options it's a Cursor-style "Other": hidden until
        // the last "Other…" entry is picked; a pure free-text question shows it now.
        let ta = null;
        if (data.allow_text) {
          ta = document.createElement("textarea");
          ta.className = "w-full rounded border px-2 py-1 text-sm";
          ta.rows = 2;
          ta.placeholder = t("ask_other_ph");
        }
        const showText = () => { if (ta) { ta.classList.remove("hidden"); ta.focus(); } };
        const hideText = () => { if (ta) ta.classList.add("hidden"); };

        let other = null;  // the synthetic "Other" radio/checkbox
        if (hasOptions) {
          const list = document.createElement("div");
          list.className = "space-y-1";
          data.options.forEach((o) => {
            const lbl = document.createElement("label");
            lbl.className = "flex items-center gap-2 text-sm";
            const inp = document.createElement("input");
            inp.type = data.allow_multiple ? "checkbox" : "radio";
            inp.name = "ask_" + data.request_id;
            inp.value = o.id;
            inputs.push(inp);
            // single-select: picking a real option puts the custom box away
            inp.addEventListener("change", () => { if (!data.allow_multiple) hideText(); });
            const span = document.createElement("span");
            span.textContent = o.label;
            lbl.append(inp, span);
            list.appendChild(lbl);
          });
          if (data.allow_text) {
            const lbl = document.createElement("label");
            lbl.className = "flex items-center gap-2 text-sm";
            other = document.createElement("input");
            other.type = data.allow_multiple ? "checkbox" : "radio";
            other.name = "ask_" + data.request_id;
            other.value = "__other__";
            other.addEventListener("change", () => { other.checked ? showText() : hideText(); });
            const span = document.createElement("span");
            span.textContent = t("ask_other");
            lbl.append(other, span);
            list.appendChild(lbl);
          }
          card.appendChild(list);
        }
        if (ta) {
          if (hasOptions) ta.classList.add("hidden");  // revealed by "Other"
          card.appendChild(ta);
        }

        const bar = document.createElement("div");
        bar.className = "flex items-center gap-2";
        const send = document.createElement("button");
        send.type = "button";
        send.className = "rounded bg-indigo-600 px-3 py-1 text-xs text-white";
        send.textContent = t("ask_submit");
        send.addEventListener("click", () => {
          const ids = inputs.filter((i) => i.checked).map((i) => i.value);
          // free text counts for a pure free-text question, or when "Other" is picked
          const wantsText = !hasOptions || (other && other.checked);
          submit(ids, (ta && wantsText) ? ta.value.trim() : null);
        });
        const skip = document.createElement("button");
        skip.type = "button";
        skip.className = "px-2 py-1 text-xs text-slate-500";
        skip.textContent = t("ask_skip");
        skip.addEventListener("click", () => submit([], null));
        bar.append(send, skip);
        card.appendChild(bar);
      }
      log.appendChild(card);
      log.scrollTop = log.scrollHeight;
    }

    async function loadParadigms() {
      try {
        const data = await (await fetch("/paradigms")).json();
        $("mode").innerHTML = "";
        for (const name of data.enabled) {
          const opt = document.createElement("option");
          opt.value = name; opt.textContent = name;
          if (name === data.default) opt.selected = true;
          $("mode").appendChild(opt);
        }
      } catch (err) { /* dropdown stays empty; chat still works with the default */ }
    }
    loadParadigms();

    // ---- chat sessions (AI-Studio-style left sidebar) ------------------
    let currentSession = null;   // id of the open session (null = unsaved draft)
    let currentTitle = "";       // its title (shown in the main header)
    let sessionsCache = [];      // last /sessions payload (relabel on lang switch)
    let editingId = null;        // row being inline-renamed
    let confirmingId = null;     // row showing the inline delete confirmation
    let currentRunId = null;     // id of the in-flight run (for POST /chat/{id}/stop)
    let activeES = null;         // the open EventSource while streaming
    let streaming = false;       // true while a turn is in flight (Send -> Stop)

    function chatIsEmpty() { return !currentSession && log.children.length === 0; }

    function updateMainTitle() {
      const inConfig = !$("view-config").classList.contains("hidden");
      $("main-title").textContent = inConfig ? t("nav_config") : (currentTitle || t("chat_untitled"));
    }

    function renderSessionList() {
      const box = $("session-list");
      box.innerHTML = "";
      if (!sessionsCache.length) {
        const empty = document.createElement("p");
        empty.className = "px-2 py-2 text-xs text-slate-400";
        empty.textContent = t("chat_sessions_empty");
        box.appendChild(empty);
        return;
      }
      for (const s of sessionsCache) {
        const row = document.createElement("div");
        box.appendChild(row);

        // Inline rename: the row's label becomes a text input (Enter / blur save,
        // Esc cancels) — themed in-page editing, not a browser dialog.
        if (s.id === editingId) {
          row.className = "flex items-center rounded-lg bg-slate-50 px-1";
          const input = document.createElement("input");
          input.className = "w-full rounded border px-1 py-1 text-sm";
          input.value = s.title || "";
          input.addEventListener("keydown", (e) => {
            if (e.key === "Enter") { e.preventDefault(); commitRename(s, input.value); }
            else if (e.key === "Escape") { e.preventDefault(); editingId = null; renderSessionList(); }
          });
          input.addEventListener("blur", () => commitRename(s, input.value));
          row.appendChild(input);
          setTimeout(() => { input.focus(); input.select(); }, 0);
          continue;
        }

        // Inline delete confirmation: the row shows Delete / Cancel in place —
        // themed in-page confirm, not a browser dialog.
        if (s.id === confirmingId) {
          row.className = "flex items-center gap-1 rounded-lg bg-red-50 px-1";
          const name = document.createElement("span");
          name.className = "min-w-0 flex-1 truncate px-1 py-1.5 text-slate-600";
          name.textContent = s.title || s.preview || t("chat_untitled");
          const del = document.createElement("button");
          del.type = "button";
          del.className = "shrink-0 rounded bg-red-600 px-1.5 py-0.5 text-xs text-white hover:bg-red-700";
          del.textContent = t("session_delete");
          del.addEventListener("click", () => commitDelete(s));
          const cancel = document.createElement("button");
          cancel.type = "button";
          cancel.className = "shrink-0 px-1.5 py-0.5 text-xs text-slate-500 hover:text-slate-800";
          cancel.textContent = t("session_cancel");
          cancel.addEventListener("click", () => { confirmingId = null; renderSessionList(); });
          row.append(name, del, cancel);
          continue;
        }

        const active = s.id === currentSession;
        row.className = "flex items-center gap-0.5 rounded-lg px-1 "
          + (active ? "bg-slate-200" : "hover:bg-slate-100");
        const label = s.title || s.preview || t("chat_untitled");
        const open = document.createElement("button");
        open.type = "button";
        open.className = "min-w-0 flex-1 truncate px-1 py-1.5 text-left" + (active ? " font-medium" : "");
        open.textContent = label;
        open.title = label;
        open.addEventListener("click", () => openSession(s.id));
        const ren = document.createElement("button");
        ren.type = "button";
        ren.className = "shrink-0 px-1 text-xs text-slate-400 hover:text-slate-700";
        ren.textContent = "✎";
        ren.title = t("session_rename");
        ren.addEventListener("click", (e) => { e.stopPropagation(); renameSession(s); });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "shrink-0 px-1 text-xs text-slate-400 hover:text-red-600";
        del.textContent = "🗑";
        del.title = t("session_delete");
        del.addEventListener("click", (e) => { e.stopPropagation(); deleteSession(s); });
        row.append(open, ren, del);
      }
    }

    // Enter inline edit / confirm modes (one at a time).
    function renameSession(s) { editingId = s.id; confirmingId = null; renderSessionList(); }
    function deleteSession(s) { confirmingId = s.id; editingId = null; renderSessionList(); }

    async function commitRename(s, value) {
      if (editingId !== s.id) return;  // guard the blur+Enter / Esc race
      editingId = null;
      const next = (value || "").trim();
      if (next && next !== s.title) {
        try {
          const resp = await fetch("/sessions/" + encodeURIComponent(s.id), {
            method: "PATCH", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title: next }),
          });
          if (resp.ok) {
            s.title = next;
            if (s.id === currentSession) { currentTitle = next; updateMainTitle(); }
          }
        } catch (err) { /* keep the old title on failure */ }
      }
      renderSessionList();
    }

    async function commitDelete(s) {
      confirmingId = null;
      try {
        const resp = await fetch("/sessions/" + encodeURIComponent(s.id), { method: "DELETE" });
        if (!resp.ok) { renderSessionList(); return; }
      } catch (err) { renderSessionList(); return; }
      sessionsCache = sessionsCache.filter((x) => x.id !== s.id);
      if (s.id === currentSession) {
        currentSession = null; currentTitle = ""; log.innerHTML = ""; updateMainTitle();
      }
      renderSessionList();
    }

    async function loadSessions() {
      try {
        const data = await (await fetch("/sessions")).json();
        sessionsCache = data.sessions || [];
      } catch (err) { sessionsCache = []; }
      renderSessionList();
    }

    // A replayed user message + an inline "edit" control (re-ask). `turn` is the
    // user-turn ordinal; clicking edit turns the line into a textarea, then an
    // in-page confirm ("discards the rest"), then regenerates from that turn.
    function addUserLine(text, turn) {
      const row = document.createElement("div");
      row.className = "flex items-start gap-2 font-semibold";
      const span = document.createElement("div");
      span.className = "min-w-0 flex-1 whitespace-pre-wrap";
      span.textContent = "you: " + text;
      row.appendChild(span);
      if (currentSession && turn >= 0 && !streaming) {
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "shrink-0 text-xs font-normal text-slate-400 hover:text-slate-700";
        edit.textContent = "✎";
        edit.title = t("reask_edit");
        edit.addEventListener("click", () => beginReask(row, turn, text));
        row.appendChild(edit);
      }
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
      return row;
    }

    function renderHistory(messages) {
      log.innerHTML = "";
      let turn = -1;
      for (const m of messages || []) {
        if (m.role === "user") { turn += 1; addUserLine(m.content || "", turn); }
        else if (m.role === "assistant") { if (m.content) line(m.content, "text-slate-900 whitespace-pre-wrap"); }
        else if (m.role === "tool") line("← " + (m.content || ""), "text-emerald-700");
      }
    }

    // Re-ask: edit a historical question, confirm in-page, then regenerate from
    // that turn (the server truncates everything after it — destructive, not a fork).
    function beginReask(row, turn, text) {
      if (streaming) return;
      row.innerHTML = "";
      row.className = "rounded-lg border border-slate-300 bg-white p-2 space-y-2";
      const ta = document.createElement("textarea");
      ta.className = "w-full rounded border px-2 py-1 text-sm";
      ta.rows = 2; ta.value = text;
      const bar = document.createElement("div");
      bar.className = "flex items-center gap-2";
      const send = document.createElement("button");
      send.type = "button";
      send.className = "rounded bg-slate-800 px-3 py-1 text-xs text-white";
      send.textContent = t("reask_send");
      send.addEventListener("click", () => confirmReask(row, turn, ta.value));
      const cancel = document.createElement("button");
      cancel.type = "button";
      cancel.className = "px-2 py-1 text-xs text-slate-500";
      cancel.textContent = t("session_cancel");
      cancel.addEventListener("click", () => { if (currentSession) openSession(currentSession); });
      bar.append(send, cancel);
      row.append(ta, bar);
      ta.focus();
    }

    function confirmReask(row, turn, newText) {
      const trimmed = (newText || "").trim();
      if (!trimmed) return;
      const bar = document.createElement("div");
      bar.className = "flex items-center gap-2 rounded bg-amber-50 p-2 text-xs text-amber-800";
      const warn = document.createElement("span");
      warn.className = "flex-1"; warn.textContent = t("reask_warn");
      const ok = document.createElement("button");
      ok.type = "button"; ok.className = "shrink-0 rounded bg-amber-600 px-2 py-0.5 text-white";
      ok.textContent = t("reask_confirm");
      ok.addEventListener("click", () => commitReask(turn, trimmed));
      const no = document.createElement("button");
      no.type = "button"; no.className = "shrink-0 px-2 py-0.5 text-slate-500";
      no.textContent = t("session_cancel");
      no.addEventListener("click", () => bar.remove());
      bar.append(warn, ok, no);
      row.appendChild(bar);
    }

    // Reload the authoritative history, cut it at this user turn, replay it, then
    // regenerate by sending the edited question with edit_turn (the server saves
    // the truncated+new body over the old one).
    async function commitReask(turn, text) {
      if (!currentSession) return;
      try {
        const data = await (await fetch("/sessions/" + encodeURIComponent(currentSession))).json();
        const msgs = data.messages || [];
        let count = -1, cut = msgs.length;
        for (let i = 0; i < msgs.length; i++) {
          if (msgs[i].role === "user") { count += 1; if (count === turn) { cut = i; break; } }
        }
        renderHistory(msgs.slice(0, cut));
      } catch (err) { /* fall back to whatever's on screen */ }
      startChat(text, { editTurn: turn });
    }

    async function openSession(id) {
      if (!id) return;
      try {
        const data = await (await fetch("/sessions/" + encodeURIComponent(id))).json();
        currentSession = id;
        const meta = sessionsCache.find((s) => s.id === id);
        currentTitle = meta ? (meta.title || "") : "";
        renderHistory(data.messages);
        show("chat");
        renderSessionList();
        updateMainTitle();
      } catch (err) { line("error loading session", "text-red-600"); }
    }

    // Point 3: a fresh empty draft — clicking "New chat" again is a no-op, and an
    // empty draft is never persisted (the server only saves on a completed turn).
    $("chat-new").addEventListener("click", () => {
      if (chatIsEmpty()) { show("chat"); return; }
      currentSession = null; currentTitle = ""; log.innerHTML = "";
      show("chat");
      renderSessionList();
      updateMainTitle();
    });
    loadSessions();
    updateMainTitle();

    // While a turn is in flight the Send button becomes a Stop button (clicking it
    // POSTs /chat/{run_id}/stop). Driven here so a forgotten reset can't strand it.
    function setStreaming(on) {
      streaming = on;
      const btn = $("chat-send");
      btn.textContent = on ? t("chat_stop") : t("chat_send");
      btn.classList.toggle("bg-red-600", on);
      btn.classList.toggle("bg-slate-800", !on);
    }
    function endStream(es) {
      if (es) es.close();
      if (activeES === es) activeES = null;
      currentRunId = null;
      setStreaming(false);
    }
    // Stop the running turn: the server sets the cancel token, the loop ends at the
    // next boundary, emits `stopped`, and saves the partial conversation (resumable).
    function stopChat() {
      if (!currentRunId) return;
      fetch("/chat/" + encodeURIComponent(currentRunId) + "/stop", { method: "POST" }).catch(() => {});
    }

    // Run one turn over SSE. `opts.editTurn` (re-ask) regenerates from a past user
    // turn; `opts.mode` overrides the dropdown (used internally). Reused by the
    // form submit and by re-ask.
    function startChat(message, opts) {
      opts = opts || {};
      const mode = (opts.mode != null) ? opts.mode : $("mode").value;
      const stream = $("stream").checked;
      line("you" + (mode ? " (" + mode + ")" : "") + ": " + message, "font-semibold");

      let answer = null;
      let url = "/chat?message=" + encodeURIComponent(message) + "&stream=" + stream;
      if (mode) url += "&mode=" + encodeURIComponent(mode);
      if (currentSession) url += "&session=" + encodeURIComponent(currentSession);
      if (opts.editTurn != null) url += "&edit_turn=" + encodeURIComponent(opts.editTurn);
      const es = new EventSource(url);
      activeES = es;
      setStreaming(true);

      es.addEventListener("run", (ev) => {
        currentRunId = JSON.parse(ev.data).run_id;  // enable Stop for this run
      });
      es.addEventListener("session", (ev) => {
        currentSession = JSON.parse(ev.data).id;  // remember it so the next turn resumes
      });
      es.addEventListener("title", (ev) => {
        const d = JSON.parse(ev.data);
        currentTitle = d.title || "";
        updateMainTitle();
        const meta = sessionsCache.find((s) => s.id === d.id);
        if (meta) { meta.title = currentTitle; renderSessionList(); }
      });
      es.addEventListener("token", (ev) => {
        if (answer === null) answer = line("", "text-slate-900 whitespace-pre-wrap");
        answer.textContent += JSON.parse(ev.data).text;
        log.scrollTop = log.scrollHeight;
      });
      es.addEventListener("ask", (ev) => {
        answer = null;  // a later text run starts a NEW line BELOW the card
        renderAskCard(JSON.parse(ev.data));  // inline card; answer POSTs to /respond
      });
      es.addEventListener("tool_call", (ev) => {
        const d = JSON.parse(ev.data);
        answer = null;  // close the current text run so the next one lands below this
        if (d.name === "ask_question") return;  // shown as the ask card instead
        line("→ tool " + d.name + " " + d.arguments, "text-amber-700");
      });
      es.addEventListener("tool_result", (ev) => {
        const d = JSON.parse(ev.data);
        answer = null;  // next streamed text gets a fresh line below the tool output
        if (d.name === "ask_question") return;  // the answer is already on the card
        line("← " + d.name + ": " + d.result, "text-emerald-700");
      });
      es.addEventListener("error", (ev) => {
        if (ev.data) line("error: " + ev.data, "text-red-600");
        endStream(es);
      });
      es.addEventListener("stopped", (ev) => {
        const d = JSON.parse(ev.data);
        line(t("chat_stopped") + " · steps=" + d.steps, "text-xs text-amber-600");
        endStream(es);
        loadSessions();  // the partial turn is saved — refresh the picker
      });
      es.addEventListener("final", (ev) => {
        const d = JSON.parse(ev.data);
        if (answer === null) line(d.answer, "text-slate-900 whitespace-pre-wrap");
        line("[" + d.mode + "] [" + d.stop_reason + "] steps=" + d.steps + " tokens=" + d.tokens + " cost=" + d.cost_usd, "text-xs text-slate-400");
        endStream(es);
        loadSessions();  // refresh the picker (new session appears / preview updates)
      });
    }

    $("chat-form").addEventListener("submit", (e) => {
      e.preventDefault();
      if (streaming) { stopChat(); return; }  // the button is "Stop" mid-turn
      if (!hasLLM()) { show("config"); showCfg("llm"); return; }
      const message = $("msg").value.trim();
      if (!message) return;
      $("msg").value = "";
      startChat(message, {});
    });

    // ---- config: functional sub-tabs ------------------------------------
    const CFG_TABS = ["llm", "context", "budget", "tools", "prompts", "paradigms",{% if spec.memory.enabled %} "memory",{% endif %} "observability"];
    let cfgTab = "llm";
    let cfg = {};
    // Tracks unsaved edits in the config view. Edits live only in the DOM until
    // Save (POST /config); this flag drives the "unsaved" marker, the leave/reload
    // guards, and stops a tab switch back to Config from reloading over the edits.
    let dirty = false;
    // Serialized form of everything the config view persists (the config patch +
    // the rule-file editor contents) as of the last load/Save. "unsaved" means
    // the view no longer matches this baseline. We compare against it rather than
    // trust raw input/change events because a programmatic rebuild (renderConfig)
    // tears down focused fields, and the browser fires DEFERRED blur/change on
    // them that can land AFTER a Save resets the flag — those events don't change
    // the serialized form, so a recompare keeps the view correctly "saved".
    let savedSnapshot = "";
    // Rule files from GET /rules: [{path, content, exists, auto}]. `auto` = an
    // auto-recognized convention file (root CLAUDE.md) shown read-only, editable in
    // place but not added to the explicit rules_files list. Save writes contents
    // back via POST /rules.
    let ruleFiles = [];
    // What's registered in code (GET /registries): the universe the Context +
    // Paradigms dropdowns are built from. A configured name missing here is flagged.
    let reg = { paradigms: [], strategies: [], conditions: [], budget_conditions: []{% if spec.memory.enabled %}, memory: [] {% endif %} };
    const UNREG = " \u26a0";  // appended to a name selected in config but not registered

    function buildCfgTabs() {
      const nav = $("cfg-tabs");
      if (!nav) return;
      nav.innerHTML = "";
      for (const name of CFG_TABS) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = t("subtab_" + name);
        b.className = "px-3 py-2 " + (name === cfgTab ? "border-b-2 border-slate-800 font-semibold" : "text-slate-500");
        b.addEventListener("click", () => showCfg(name));
        nav.appendChild(b);
      }
    }
    function showCfg(name) {
      cfgTab = name;
      document.querySelectorAll("[data-cfg]").forEach((p) => p.classList.toggle("hidden", p.dataset.cfg !== name));
      buildCfgTabs();
{% if spec.mcp.enabled %}      // Auto-discover MCP tools the first time the Tools tab opens (cached after).
      if (name === "tools" && mcpDiscovered === null) discoverMcp();
{% endif %}    }

    const numOrNull = (v) => { v = (v ?? "").toString().trim(); return v === "" ? null : Number(v); };
    const esc = (v) => (v == null ? "" : String(v).replace(/'/g, "&#39;"));
    const escNum = (v) => (v ? esc(v) : "");  // hide 0 / null behind the placeholder

    // One LLM profile card: name/model + API key + base_url always visible;
    // sampling knobs under "Advanced", per-1M prices under "Pricing".
    function profileCard(p) {
      p = p || {};
      const reasoning = p.reasoning_effort || "";
      const reOpt = (v, label) =>
        "<option value='" + v + "'" + (reasoning === v ? " selected" : "") + ">" + (label || v) + "</option>";
      const div = document.createElement("div");
      div.className = "profile rounded-lg border p-3 space-y-2";
      div.innerHTML =
        "<div class='flex items-start justify-between gap-2'>" +
          "<div class='grid grid-cols-2 gap-2 flex-1'>" +
            "<label class='text-xs'>" + t("profile_name") + "<input class='p-name mt-1 w-full rounded border px-2 py-1' value='" + esc(p.name) + "'/></label>" +
            "<label class='text-xs'>" + t("profile_model") + "<input class='p-model mt-1 w-full rounded border px-2 py-1 font-mono' value='" + esc(p.model) + "'/></label>" +
          "</div>" +
          "<button type='button' class='p-remove text-xs text-red-600'>" + t("profile_remove") + "</button>" +
        "</div>" +
        keyRow("profile_key_section", "p-key", esc(p.api_key_env || "OPENAI_API_KEY"), "p-keyval", "p-setkey", "p-keystatus", t("set_key_ph"), t("set_key_btn"), "password") +
        keyRow("profile_url_section", "p-baseurl", esc(p.base_url_env || "OPENAI_BASE_URL"), "p-urlval", "p-seturl", "p-urlstatus", t("set_url_ph"), t("set_url_btn"), "text") +
        "<div class='flex items-center gap-2'>" +
          "<button type='button' class='p-test rounded border px-3 py-1 text-xs'>" + t("test_btn") + "</button>" +
          "<span class='p-teststatus text-xs'></span>" +
        "</div>" +
        "<details class='text-xs'><summary class='cursor-pointer text-slate-600'>" + t("adv_section") + "</summary>" +
          "<div class='mt-2 grid grid-cols-3 gap-2'>" +
            "<label>" + t("profile_temp") + "<input class='p-temp mt-1 w-full rounded border px-2 py-1' placeholder='" + t("temp_ph") + "' value='" + escNum(p.temperature) + "'/></label>" +
            "<label>" + t("profile_maxtok") + "<input class='p-maxtok mt-1 w-full rounded border px-2 py-1' value='" + escNum(p.max_tokens) + "'/></label>" +
            "<label>" + t("profile_reasoning") + "<select class='p-reasoning mt-1 w-full rounded border px-2 py-1'>" +
              reOpt("", t("reasoning_default")) + reOpt("none") + reOpt("minimal") + reOpt("low") + reOpt("medium") + reOpt("high") + reOpt("xhigh") +
            "</select></label>" +
          "</div></details>" +
        "<details class='text-xs'><summary class='cursor-pointer text-slate-600'>" + t("stats_section") + "</summary>" +
          "<div class='mt-2 grid grid-cols-2 gap-2'>" +
            "<label>" + t("profile_input_cost") + "<input class='p-pcost mt-1 w-full rounded border px-2 py-1' placeholder='" + t("cost_ph") + "' value='" + escNum(p.input_cost_per_million) + "'/></label>" +
            "<label>" + t("profile_output_cost") + "<input class='p-ccost mt-1 w-full rounded border px-2 py-1' placeholder='" + t("cost_ph") + "' value='" + escNum(p.output_cost_per_million) + "'/></label>" +
          "</div></details>";
      return div;
    }
    // An env-var row: NAME input + write-only VALUE input that posts to /env.
    function keyRow(sectionKey, nameCls, nameVal, valCls, btnCls, statusCls, ph, btnLabel, valType) {
      return "<div><div class='text-xs text-slate-500'>" + t(sectionKey) + "</div>" +
        "<div class='mt-1 flex items-center gap-2'>" +
          "<input class='" + nameCls + " w-44 rounded border px-2 py-1 font-mono text-xs' title='" + t("profile_varname") + "' value='" + nameVal + "'/>" +
          "<input type='" + valType + "' class='" + valCls + " flex-1 rounded border px-2 py-1' placeholder='" + ph + "'/>" +
          "<button type='button' class='" + btnCls + " rounded border px-2 py-1 text-xs whitespace-nowrap'>" + btnLabel + "</button>" +
          "<span class='" + statusCls + " text-xs text-emerald-700'></span>" +
        "</div></div>";
    }

    // Build a profile object from one card's live inputs (used by Save + Test).
    function cardToProfile(w) {
      const g = (cls) => { const el = w.querySelector("." + cls); return el ? el.value.trim() : ""; };
      const o = { name: g("p-name"), model: g("p-model") };
      if (g("p-key")) o.api_key_env = g("p-key");
      if (g("p-baseurl")) o.base_url_env = g("p-baseurl");
      const temp = numOrNull(g("p-temp")); if (temp != null) o.temperature = temp;
      const mt = numOrNull(g("p-maxtok")); if (mt != null) o.max_tokens = mt;
      const re = g("p-reasoning"); if (re) o.reasoning_effort = re;
      o.input_cost_per_million = numOrNull(g("p-pcost")) ?? 0;
      o.output_cost_per_million = numOrNull(g("p-ccost")) ?? 0;
      return o;
    }
    // Options come from the LIVE profile-name inputs (so renaming/adding a profile
    // is reflected at once). Every named profile is listed — duplicates included.
    function roleOptions(selected) {
      let html = "";
      document.querySelectorAll("#cfg-profiles .p-name").forEach((inp) => {
        const name = inp.value.trim();
        if (!name) return;
        html += "<option value='" + esc(name) + "'" + (selected === name ? " selected" : "") + ">" + esc(name) + "</option>";
      });
      return html;
    }
    // generation + compaction are always shown; any extra configured role is kept.
    // Both default to the empty "(first profile)" option — that mirrors the runtime
    // fallback (an unset role resolves to the first profile, NOT to generation).
    function buildRoles() {
      const rc = $("cfg-roles");
      const prev = {};  // preserve current picks across a live rebuild
      rc.querySelectorAll(".role-target").forEach((el) => { prev[el.dataset.role] = el.value; });
      rc.innerHTML = "";
      const roles = cfg.roles || {};
      const names = ["generation", "compaction", "title"{% if spec.memory.enabled %}, "memory"{% endif %}];
      Object.keys(roles).forEach((r) => { if (!names.includes(r)) names.push(r); });
      names.forEach((role) => {
        const selected = (role in prev) ? prev[role] : (roles[role] || "");
        const known = t("role_" + role);
        const label = known === ("role_" + role) ? role : known;
        rc.insertAdjacentHTML("beforeend",
          "<label class='flex items-center gap-2 text-sm'><span class='w-44 font-mono'>" + label + "</span>" +
          "<select class='role-target rounded border px-2 py-1' data-role='" + role + "'>" +
            "<option value=''>" + t("role_use_first") + "</option>" + roleOptions(selected) +
          "</select></label>");
      });
    }

    // "Configured" means at least one profile names a model. A profile that only
    // carries env-var names (the generated scaffold) doesn't count — chat stays
    // gated until you fill in a model, so a half-set-up product can't silently
    // call the API with an empty/guessed model.
    const hasLLM = () => !!(cfg.llms && cfg.llms.some((p) => p && (p.model || "").trim()));
    function gateChat() {
      const none = !hasLLM();
      $("no-llm").classList.toggle("hidden", !none);
      ["msg", "mode", "stream", "chat-send"].forEach((id) => { $(id).disabled = none; });
    }

    // Build the Context tab from the registries: the strategy dropdown lists every
    // registered strategy, and there's one threshold input per registered condition
    // (built-ins + anything you @register and import). A configured name that isn't
    // registered is still shown, flagged, so it round-trips instead of vanishing.
    function buildContext() {
      const ctx = cfg.context || {};
      const sel = $("cfg-ctx-strategy"); sel.innerHTML = "";
      const strategies = reg.strategies.slice();
      if (ctx.strategy && !strategies.includes(ctx.strategy)) strategies.push(ctx.strategy);
      strategies.forEach((name) => {
        const ok = reg.strategies.includes(name);
        const o = document.createElement("option");
        o.value = name; o.textContent = name + (ok ? "" : UNREG);
        if (!ok) o.title = t("cfg_unregistered");
        sel.appendChild(o);
      });
      sel.value = ctx.strategy || "summarize";
      $("cfg-ctx-keep").value = ctx.keep_last_turns ?? 6;
      $("cfg-ctx-combine").value = ctx.combine || "or";
      const trig = ctx.triggers || {};
      const names = reg.conditions.slice();
      Object.keys(trig).forEach((n) => { if (!names.includes(n)) names.push(n); });
      const box = $("cfg-ctx-triggers"); box.innerHTML = "";
      names.forEach((name) => {
        const ok = reg.conditions.includes(name);
        const label = document.createElement("label");
        label.className = "flex items-center gap-2 text-sm";
        const span = document.createElement("span");
        span.className = "w-44 font-mono"; span.textContent = name + (ok ? "" : UNREG);
        if (!ok) span.title = t("cfg_unregistered");
        const inp = document.createElement("input");
        inp.type = "number"; inp.min = "1"; inp.placeholder = "\u2014";
        inp.className = "cfg-trigger w-40 rounded border px-2 py-1";
        inp.dataset.cond = name;
        inp.value = trig[name] ?? "";
        label.appendChild(span); label.appendChild(inp);
        box.appendChild(label);
      });
    }

    // Build the Budget tab from the registries (same shape as Context): a combine
    // selector plus one row per registered budget condition (built-ins + anything
    // you @register and import), each with a threshold and an optional window
    // (seconds) that turns it into a rate. A configured-but-unregistered name is
    // still shown, flagged, so it round-trips instead of vanishing.
    function buildBudget() {
      const bud = cfg.budget || {};
      $("cfg-bud-combine").value = bud.combine || "or";
      const conds = bud.conditions || {};
      const names = reg.budget_conditions.slice();
      Object.keys(conds).forEach((n) => { if (!names.includes(n)) names.push(n); });
      const box = $("cfg-bud-conditions"); box.innerHTML = "";
      names.forEach((name) => {
        const ok = reg.budget_conditions.includes(name);
        const cur = conds[name] || {};
        const row = document.createElement("div");
        row.className = "flex items-center gap-2 text-sm";
        const span = document.createElement("span");
        span.className = "w-44 font-mono"; span.textContent = name + (ok ? "" : UNREG);
        if (!ok) span.title = t("cfg_unregistered");
        const thr = document.createElement("input");
        thr.type = "number"; thr.min = "0"; thr.step = "any"; thr.placeholder = "\u2014";
        thr.className = "cfg-bud-threshold w-32 rounded border px-2 py-1";
        thr.dataset.cond = name;
        thr.value = cur.threshold ?? "";
        const wnd = document.createElement("input");
        wnd.type = "number"; wnd.min = "0"; wnd.step = "any"; wnd.placeholder = t("bud_window_ph");
        wnd.className = "cfg-bud-window w-32 rounded border px-2 py-1";
        wnd.dataset.cond = name;
        wnd.value = cur.window_seconds ?? "";
        row.appendChild(span); row.appendChild(thr); row.appendChild(wnd);
        box.appendChild(row);
      });
    }

    // The default dropdown only offers currently-checked paradigms.
    function parDefaultOptions() {
      const sel = $("cfg-par-default");
      const prev = sel.value;
      const checked = Array.from(document.querySelectorAll(".cfg-par-cb"))
        .filter((c) => c.checked).map((c) => c.dataset.name);
      sel.innerHTML = "";
      checked.forEach((name) => {
        const o = document.createElement("option"); o.value = name; o.textContent = name; sel.appendChild(o);
      });
      if (checked.includes(prev)) sel.value = prev;
    }

    // Build the Paradigms tab: a checkbox per registered paradigm (checked = in
    // config.paradigms.enabled). A newly @register_paradigm'd one shows up here as
    // an unchecked item to enable; an enabled-but-unregistered name is flagged.
    function buildParadigms() {
      const par = cfg.paradigms || {};
      const enabled = par.enabled || [];
      const names = reg.paradigms.slice();
      enabled.forEach((n) => { if (!names.includes(n)) names.push(n); });
      const box = $("cfg-par-list"); box.innerHTML = "";
      names.forEach((name) => {
        const ok = reg.paradigms.includes(name);
        const label = document.createElement("label");
        label.className = "flex items-center gap-2 text-sm";
        const cb = document.createElement("input");
        cb.type = "checkbox"; cb.className = "cfg-par-cb"; cb.dataset.name = name;
        cb.checked = enabled.includes(name);
        cb.addEventListener("change", parDefaultOptions);
        const span = document.createElement("span");
        span.className = "font-mono"; span.textContent = name + (ok ? "" : UNREG);
        if (!ok) span.title = t("cfg_unregistered");
        label.appendChild(cb); label.appendChild(span);
        box.appendChild(label);
      });
      parDefaultOptions();
      if (par.default && Array.from($("cfg-par-default").options).some((o) => o.value === par.default)) {
        $("cfg-par-default").value = par.default;
      }
    }

    // The in-process tools this product ships in harness/tools.py (+ read_skill
    // from skills.py when enabled). Any other name without "__" is one YOU
    // registered — those sort to the very top. Only affects grouping, never
    // behavior; keep in sync if you rename a built-in.
    const BUILTIN_TOOLS = new Set(["get_current_time", "calculator", "ask_question"{% if spec.skills.enabled %}, "read_skill"{% endif %}{% if spec.memory.enabled %}, "memory_read", "memory_append", "memory_write"{% endif %}]);
    // Tools discovered from MCP servers (GET /mcp/discover), cached per page load so
    // a server's tools can be offered without hand-writing the allowlist. null =
    // not scanned yet; buildTools then falls back to whatever's already in config.
    let mcpDiscovered = null;

    // One tool checkbox. data-name + data-listed drive the save: a listed tool
    // round-trips (unchecking just disables it), a discovered-but-unlisted tool is
    // written only when you tick it (so config isn't bloated with every MCP tool).
    function toolRow(name, short, enabled, listed) {
      return "<label class='flex items-center gap-2 text-sm'>" +
        "<input type='checkbox' class='tool-en' data-name='" + esc(name) + "' data-listed='" + (listed ? "1" : "0") + "' " +
        (enabled ? "checked" : "") + "/> <span class='font-mono'>" + short + "</span></label>";
    }

    // Tools is a flat allowlist in config, grouped here for legibility: tools you
    // registered first, then the built-ins, then each MCP server's tools folded
    // into a collapsed group. With a scan, a server shows its FULL tool set (tick
    // to allowlist); without one, it falls back to the listed entries.
    function buildTools() {
      const box = $("cfg-tools");
      box.innerHTML = "";
      const listedEnabled = new Map();  // full name -> enabled (from config allowlist)
      (cfg.tools || []).forEach((tl) => listedEnabled.set(tl.name, !!tl.enabled));

      const custom = [], builtin = [];
      (cfg.tools || []).forEach((tl) => {
        if (tl.name.indexOf("__") > 0) return;  // MCP handled below
        (BUILTIN_TOOLS.has(tl.name) ? builtin : custom).push(tl);
      });
      const localSection = (titleKey, items) => {
        if (!items.length) return;
        box.insertAdjacentHTML("beforeend",
          "<p class='text-xs font-medium text-slate-500'>" + t(titleKey) + "</p>" +
          "<div class='mb-1 space-y-1 pl-1'>" +
          items.map((tl) => toolRow(tl.name, tl.name, tl.enabled, true)).join("") + "</div>");
      };
      localSection("tools_group_custom", custom);
      localSection("tools_group_builtin", builtin);

      const groups = new Map();  // server -> [{name, short, enabled, listed}]
      const errors = new Map();
      const seen = new Set();
      if (mcpDiscovered) {
        (mcpDiscovered.servers || []).forEach((s) => {
          if (!groups.has(s.name)) groups.set(s.name, []);
          if (s.error) errors.set(s.name, s.error);
          (s.tools || []).forEach((tl) => {
            groups.get(s.name).push({
              name: tl.name, short: tl.short,
              enabled: listedEnabled.get(tl.name) || false, listed: listedEnabled.has(tl.name),
            });
            seen.add(tl.name);
          });
        });
      }
      (cfg.tools || []).forEach((tl) => {  // listed MCP tools not covered by a scan
        const sep = tl.name.indexOf("__");
        if (sep <= 0 || seen.has(tl.name)) return;
        const server = tl.name.slice(0, sep);
        if (!groups.has(server)) groups.set(server, []);
        groups.get(server).push({ name: tl.name, short: tl.name.slice(sep + 2), enabled: tl.enabled, listed: true });
      });
      // One collapsed <details> per MCP server (collapsed = the noisy tools stay
      // out of the way); the summary shows enabled/total (+ any connect error).
      for (const [server, items] of groups) {
        const en = items.filter((e) => e.enabled).length;
        const err = errors.get(server);
        box.insertAdjacentHTML("beforeend",
          "<details class='rounded border'><summary class='cursor-pointer px-2 py-1 text-sm'>" +
          "<span class='font-medium'>" + t("tools_group_mcp") + " · " + server + "</span> " +
          "<span class='text-xs text-slate-500'>(" + en + "/" + items.length + ")</span>" +
          (err ? " <span class='text-xs text-red-600'>" + esc(err) + "</span>" : "") +
          "</summary><div class='space-y-1 px-2 pb-2 pl-4'>" +
          items.map((e) => toolRow(e.name, e.short, e.enabled, e.listed)).join("") + "</div></details>");
      }
    }
{% if spec.mcp.enabled %}
    // Scan configured MCP servers for their tools and re-render (cached per page
    // load). Async: the panel shows the listed tools immediately, then fills in the
    // full discovered set when the scan returns.
    async function discoverMcp() {
      const status = $("cfg-mcp-status");
      const btn = $("cfg-mcp-scan");
      status.className = "text-xs text-slate-500";
      status.textContent = t("tools_scanning");
      if (btn) btn.disabled = true;
      try {
        mcpDiscovered = await (await fetch("/mcp/discover")).json();
        buildTools();
        const n = (mcpDiscovered.servers || []).reduce((a, s) => a + (s.tools || []).length, 0);
        status.textContent = t("tools_scanned") + " (" + n + ")";
      } catch (e) {
        status.className = "text-xs text-red-600";
        status.textContent = String(e);
      } finally {
        if (btn) btn.disabled = false;
      }
    }
{% endif %}

    // One rule-file row: editable path + its markdown content + remove. Content is
    // loaded from GET /rules and written back by Save (POST /rules), so you edit the
    // actual files (AGENTS.md / CLAUDE.md style), multiple allowed.
    function ruleRow(path, content, auto) {
      const div = document.createElement("div");
      div.className = "rule rounded-lg border p-2 space-y-1";
      if (auto) div.dataset.auto = "1";
      div.innerHTML =
        "<div class='flex items-center gap-2'>" +
          "<input class='r-path flex-1 rounded border px-2 py-1 font-mono text-xs' placeholder='" + t("rule_path_ph") + "' value='" + esc(path) + "'" + (auto ? " readonly" : "") + "/>" +
          (auto
            ? "<span class='rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-500' title='" + t("rule_auto_hint") + "'>" + t("rule_auto") + "</span>"
            : "<button type='button' class='r-remove text-xs text-red-600'>" + t("profile_remove") + "</button>") +
        "</div>" +
        "<textarea class='r-content w-full rounded border px-2 py-1 font-mono text-xs' rows='4'></textarea>";
      div.querySelector(".r-content").value = content || "";
      return div;
    }
    function buildRules() {
      const box = $("cfg-rules");
      box.innerHTML = "";
      ruleFiles.forEach((r) => box.appendChild(ruleRow(r.path, r.content, r.auto)));
    }
    async function loadRules() {
      try { ruleFiles = (await (await fetch("/rules")).json()).rules || []; }
      catch (e) { ruleFiles = []; }
    }

{% if spec.memory.enabled %}    // The note body (markdown file) from GET /memory — separate from cfg.memory
    // (the config knobs). Editing the note has its own Save/Clear/Consolidate
    // buttons and is NOT part of the main config Save.
    let memInfo = { content: "", read_only: false, size: 0, oversized: false };
    async function loadMemory() {
      try { memInfo = await (await fetch("/memory")).json(); }
      catch (e) { memInfo = { content: "", read_only: false, size: 0, oversized: false }; }
    }
    // Build the Memory tab: read-only switch + backend dropdown (from /registries)
    // + capacity + auto-consolidate + policy, then the note body with its own
    // action buttons. A configured backend that isn't registered is still shown,
    // flagged, so it round-trips instead of vanishing.
    function buildMemory() {
      const mem = cfg.memory || {};
      $("cfg-mem-readonly").checked = !!mem.read_only;
      const sel = $("cfg-mem-backend"); sel.innerHTML = "";
      const backends = (reg.memory || []).slice();
      const current = mem.backend || "file";
      if (!backends.includes(current)) backends.push(current);
      backends.forEach((name) => {
        const ok = (reg.memory || []).includes(name);
        const o = document.createElement("option");
        o.value = name; o.textContent = name + (ok ? "" : UNREG);
        if (!ok) o.title = t("cfg_unregistered");
        sel.appendChild(o);
      });
      sel.value = current;
      $("cfg-mem-capacity").value = mem.inject_max_chars ?? 4000;
      $("cfg-mem-auto").checked = !!mem.auto_consolidate;
      $("cfg-mem-policy").value = mem.policy || "";
      // The note body lives outside the dirty/Save flow — stop its edits bubbling
      // to the view-config "unsaved" marker (it has its own Save note button).
      const note = $("cfg-mem-content");
      note.value = memInfo.content || "";
      note.oninput = (e) => e.stopPropagation();
      note.onchange = (e) => e.stopPropagation();
      $("cfg-mem-size").textContent = (memInfo.size || 0) + " / " + (memInfo.inject_max_chars ?? mem.inject_max_chars ?? 4000) + " " + t("mem_chars");
      $("cfg-mem-oversized").classList.toggle("hidden", !memInfo.oversized);
      $("cfg-mem-status").textContent = "";
    }
{% endif %}    function renderConfig() {
      const pc = $("cfg-profiles");
      pc.innerHTML = "";
      (cfg.llms || []).forEach((p) => pc.appendChild(profileCard(p)));
      buildRoles();
      buildContext();
      buildBudget();
      buildTools();
      // prompts
      const pr = cfg.prompts || {};
      $("cfg-p-system").value = pr.system || "";
      buildRules();
      buildParadigms();
{% if spec.memory.enabled %}      buildMemory();
{% endif %}      // observability
      const obs = cfg.observability || {};
      $("cfg-obs-trace").checked = !!obs.trace;
      $("cfg-obs-tracedir").value = obs.trace_dir || "traces";
    }

    function collectConfig() {
      const patch = {};
      patch.llms = Array.from(document.querySelectorAll("#cfg-profiles .profile"))
        .map(cardToProfile)
        .filter((o) => o.name || o.model);  // drop empty (freshly-added, unfilled) cards
      const roles = {};
      document.querySelectorAll("#cfg-roles .role-target").forEach((el) => {
        if (el.value.trim()) roles[el.dataset.role] = el.value.trim();
      });
      patch.roles = roles;
      patch.context = {
        strategy: $("cfg-ctx-strategy").value,
        keep_last_turns: Number($("cfg-ctx-keep").value || 6),
        combine: $("cfg-ctx-combine").value,
      };
      const triggers = {};
      document.querySelectorAll("#cfg-ctx-triggers .cfg-trigger").forEach((el) => {
        const v = numOrNull(el.value); if (v != null) triggers[el.dataset.cond] = v;
      });
      patch.context.triggers = triggers;
      const budConditions = {};
      document.querySelectorAll("#cfg-bud-conditions .cfg-bud-threshold").forEach((el) => {
        const v = numOrNull(el.value);
        if (v == null) return;  // blank threshold = condition off
        const name = el.dataset.cond;
        const wEl = document.querySelector("#cfg-bud-conditions .cfg-bud-window[data-cond='" + name + "']");
        const w = wEl ? numOrNull(wEl.value) : null;
        budConditions[name] = w != null ? { threshold: v, window_seconds: w } : { threshold: v };
      });
      patch.budget = { combine: $("cfg-bud-combine").value, conditions: budConditions };
      // Collect from the live checkboxes: a previously-listed tool always
      // round-trips (unchecking just disables it); a discovered tool is written to
      // the allowlist only when ticked, so config isn't bloated with every tool a
      // server happens to expose.
      const toolsOut = [];
      document.querySelectorAll("#cfg-tools .tool-en").forEach((cb) => {
        if (cb.dataset.listed === "1" || cb.checked) {
          toolsOut.push({ name: cb.dataset.name, enabled: cb.checked });
        }
      });
      patch.tools = toolsOut;
      const prompts = {};
      if ($("cfg-p-system").value.trim()) prompts.system = $("cfg-p-system").value.trim();
      // Only explicit rows go into rules_files; auto-recognized convention files
      // (root CLAUDE.md) are injected by convention and stay out of the list.
      prompts.rules_files = Array.from(document.querySelectorAll("#cfg-rules .rule"))
        .filter((row) => row.dataset.auto !== "1")
        .map((row) => row.querySelector(".r-path").value.trim()).filter(Boolean);
      patch.prompts = prompts;
      patch.paradigms = {
        enabled: Array.from(document.querySelectorAll(".cfg-par-cb"))
          .filter((c) => c.checked).map((c) => c.dataset.name),
        default: $("cfg-par-default").value.trim(),
      };
      patch.observability = { trace: $("cfg-obs-trace").checked, trace_dir: $("cfg-obs-tracedir").value.trim() || "traces" };
{% if spec.memory.enabled %}      // Memory config knobs (the note body is saved separately). Spread the
      // current memory config first so unsurfaced fields (path) round-trip.
      patch.memory = Object.assign({}, cfg.memory || {}, {
        backend: $("cfg-mem-backend").value,
        read_only: $("cfg-mem-readonly").checked,
        inject_max_chars: Number($("cfg-mem-capacity").value || 4000),
        auto_consolidate: $("cfg-mem-auto").checked,
        policy: $("cfg-mem-policy").value.trim() || null,
      });
{% endif %}      return patch;
    }

    // Everything the config view persists, serialized: the config patch plus the
    // rule-file editor rows (path + body, which Save writes via POST /rules but
    // collectConfig doesn't carry). Comparing this to `savedSnapshot` is how we
    // decide "unsaved", so it must be a pure read of the current DOM.
    function configSnapshot() {
      const rules = Array.from(document.querySelectorAll("#cfg-rules .rule"))
        .map((row) => [row.querySelector(".r-path").value, row.querySelector(".r-content").value]);
      return JSON.stringify([collectConfig(), rules]);
    }
    // Recompute "unsaved" from the actual view vs. the last saved snapshot. Driven
    // by edits (and rule add/remove); using a comparison rather than a sticky flag
    // means a stray event from a programmatic rebuild can't leave it wrongly set.
    function refreshDirty() { setDirty(configSnapshot() !== savedSnapshot); }
    // Capture the current view as the saved baseline (call after load/Save once
    // the DOM reflects server state), then clear the marker.
    function markSaved() { savedSnapshot = configSnapshot(); setDirty(false); }

    // Flip the unsaved marker + highlight the Save button so a forgotten Save is
    // visible.
    function setDirty(v) {
      dirty = v;
      $("cfg-unsaved").classList.toggle("hidden", !v);
      $("cfg-save").classList.toggle("ring-2", v);
      $("cfg-save").classList.toggle("ring-amber-400", v);
    }

    async function loadConfig() {
      cfg = await (await fetch("/config")).json();
      try { reg = await (await fetch("/registries")).json(); } catch (e) { /* keep last */ }
      await loadRules();  // rule files (explicit + auto-recognized) for the Prompts tab
{% if spec.memory.enabled %}      await loadMemory();  // the long-term memory note for the Memory tab
{% endif %}      renderConfig();
      gateChat();
      markSaved();  // the freshly rendered view is, by definition, the saved state
      $("cfg-status").textContent = "";
    }
    $("cfg-add-profile").addEventListener("click", () => {
      $("cfg-profiles").appendChild(profileCard({}));
      buildRoles();  // a new (empty) profile may already provide a name to bind
    });
    // Keep the role dropdowns in sync as profile names are typed.
    $("cfg-profiles").addEventListener("input", (e) => {
      if (e.target.classList.contains("p-name")) buildRoles();
    });
    // Test a profile, remove it, or write an env-var VALUE (api key / base url)
    // into the local .env (gitignored). Written values are write-only: posted
    // once, never read back into the UI.
    $("cfg-profiles").addEventListener("click", async (e) => {
      const rm = e.target.closest(".p-remove");
      if (rm) { rm.closest(".profile").remove(); buildRoles(); return; }
      const testBtn = e.target.closest(".p-test");
      if (testBtn) {
        const row = testBtn.closest(".profile");
        const status = row.querySelector(".p-teststatus");
        status.className = "p-teststatus text-xs text-slate-500";
        status.textContent = t("test_running");
        testBtn.disabled = true;
        try {
          const resp = await fetch("/test-llm", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(cardToProfile(row)),
          });
          const data = await resp.json();
          if (data.ok) { status.className = "p-teststatus text-xs font-semibold text-emerald-700"; status.textContent = "PASSED"; }
          else { status.className = "p-teststatus text-xs text-red-600"; status.textContent = data.error || t("cfg_invalid"); }
        } catch (err) {
          status.className = "p-teststatus text-xs text-red-600"; status.textContent = String(err);
        } finally { testBtn.disabled = false; }
        return;
      }
      const isKey = e.target.closest(".p-setkey");
      const btn = isKey || e.target.closest(".p-seturl");
      if (!btn) return;
      const row = btn.closest(".profile");
      const sel = isKey
        ? { name: ".p-key", val: ".p-keyval", status: ".p-keystatus" }
        : { name: ".p-baseurl", val: ".p-urlval", status: ".p-urlstatus" };
      const name = row.querySelector(sel.name).value.trim();
      const status = row.querySelector(sel.status);
      if (!name) { status.textContent = t("key_need_name"); return; }
      const resp = await fetch("/env", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, value: row.querySelector(sel.val).value }),
      });
      const data = await resp.json();
      if (resp.ok) { row.querySelector(sel.val).value = ""; status.textContent = t("key_saved"); }
      else { status.textContent = data.error || t("cfg_invalid"); }
    });
    // Recompute "unsaved" by comparing the live view to the saved snapshot on
    // every edit (delegated). This is robust to the spurious input/change events a
    // programmatic rebuild fires while tearing down focused fields: those don't
    // change the serialized form, so the view still reads as saved.
    $("view-config").addEventListener("input", refreshDirty);
    $("view-config").addEventListener("change", refreshDirty);

    $("cfg-reload").addEventListener("click", () => {
      if (!dirty || confirm(t("cfg_reload_confirm"))) loadConfig();
    });
    $("cfg-rule-add").addEventListener("click", () => { $("cfg-rules").appendChild(ruleRow("", "", false)); refreshDirty(); });
    $("cfg-rules").addEventListener("click", (e) => {
      const rm = e.target.closest(".r-remove");
      if (rm) { rm.closest(".rule").remove(); refreshDirty(); }  // drops it from the list, not from disk
    });

    // Write every rule file's content to disk (POST /rules), then return any error.
    // Folding this into Save (not a per-file button) keeps the unsaved guard honest:
    // one Save persists both the files and the active list. Auto-recognized files
    // (CLAUDE.md) are written too, so editing them in place sticks.
    async function saveRuleFiles() {
      let err = "";
      for (const row of document.querySelectorAll("#cfg-rules .rule")) {
        const path = row.querySelector(".r-path").value.trim();
        if (!path) continue;
        const resp = await fetch("/rules", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path, content: row.querySelector(".r-content").value }),
        });
        if (!resp.ok) err = (await resp.json()).error || t("cfg_invalid");
      }
      return err;
    }
{% if spec.mcp.enabled %}    $("cfg-mcp-scan").addEventListener("click", discoverMcp);
{% endif %}
    $("cfg-save").addEventListener("click", async () => {
      const ruleErr = await saveRuleFiles();  // write the rule files before saving the list
      const resp = await fetch("/config", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(collectConfig()),
      });
      const data = await resp.json();
      if (resp.ok) {
        cfg = data; await loadRules();{% if spec.memory.enabled %} await loadMemory();{% endif %} renderConfig(); gateChat(); loadParadigms(); markSaved();
        $("cfg-status").textContent = ruleErr ? (t("cfg_saved") + " — " + ruleErr) : t("cfg_saved");
      } else { $("cfg-status").textContent = (data.error || t("cfg_invalid")); }
    });
{% if spec.memory.enabled %}
    // Memory note actions — immediate (not part of the main config Save), each
    // refreshes the note + size after. Save note = POST /memory (overwrite),
    // Consolidate = POST /memory/consolidate (memory-role rewrite), Clear =
    // DELETE /memory.
    async function refreshMemory() { await loadMemory(); buildMemory(); }
    $("cfg-mem-save").addEventListener("click", async () => {
      const status = $("cfg-mem-status");
      const resp = await fetch("/memory", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content: $("cfg-mem-content").value }),
      });
      if (resp.ok) { await refreshMemory(); $("cfg-mem-status").textContent = t("mem_saved"); }
      else { status.textContent = (await resp.json()).error || t("cfg_invalid"); }
    });
    $("cfg-mem-clear").addEventListener("click", async () => {
      await fetch("/memory", { method: "DELETE" });
      await refreshMemory(); $("cfg-mem-status").textContent = t("mem_cleared");
    });
    $("cfg-mem-consolidate").addEventListener("click", async () => {
      const btn = $("cfg-mem-consolidate"), status = $("cfg-mem-status");
      btn.disabled = true; status.textContent = t("mem_consolidating");
      try {
        const data = await (await fetch("/memory/consolidate", { method: "POST" })).json();
        await refreshMemory();
        status.textContent = data.ran ? t("mem_consolidated") : t("mem_consolidate_noop");
      } catch (e) { status.textContent = String(e); }
      finally { btn.disabled = false; }
    });
{% endif %}

    function show(which) {
      $("view-chat").classList.toggle("hidden", which !== "chat");
      $("view-config").classList.toggle("hidden", which !== "config");
      $("tab-config").classList.toggle("bg-slate-100", which === "config");
      $("tab-config").classList.toggle("font-medium", which === "config");
      updateMainTitle();
      // Don't reload over unsaved edits when coming back to Config — that silent
      // overwrite was the main way users lost a profile they forgot to Save.
      if (which === "config") { showCfg(cfgTab); if (!dirty) loadConfig(); }
    }
    // Leaving Config with unsaved edits: remind that they won't apply until Saved.
    function leaveConfigOk() {
      if (!dirty || $("view-config").classList.contains("hidden")) return true;
      return confirm(t("cfg_leave_confirm"));
    }
    $("tab-chat").addEventListener("click", () => { if (leaveConfigOk()) show("chat"); });
    $("tab-config").addEventListener("click", () => show("config"));
    $("no-llm-link").addEventListener("click", () => { show("config"); showCfg("llm"); });
    // A reload/close drops in-DOM edits entirely — let the browser confirm.
    window.addEventListener("beforeunload", (e) => {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = "";
    });

    applyI18n();
    loadConfig();  // populate cfg up front so the chat gate (no-LLM banner) is correct
  </script>
</body>
</html>
