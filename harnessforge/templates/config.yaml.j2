# Runtime configuration for {{ project_slug }} (generated by HarnessForge).
# Secrets are NEVER stored here — only env-var NAMES. Real values live in .env.
version: "{{ spec.version }}"
project_slug: {{ project_slug }}

llms:
{% for profile in llms %}  - name: {{ profile.name }}
    model: {{ profile.model }}
    api_key_env: {{ profile.api_key_env }}
{% if profile.base_url_env %}    base_url_env: {{ profile.base_url_env }}
{% endif %}    # Optional sampling knobs (passed through when set):
    # temperature: 0.7
    # max_tokens: 1024
    # Optional cost accounting. Required if you use budget.max_cost_usd —
    # otherwise cost stays 0 and the cost limit never triggers. USD per 1K tokens.
    # prompt_cost_per_1k: 0.0
    # completion_cost_per_1k: 0.0
{% endfor %}
roles:
{% for role, target in roles.items() %}  {{ role }}: {{ target }}
{% endfor %}
prompts:
{% if spec.prompts.system %}  system: {{ spec.prompts.system | tojson }}
{% endif %}{% if spec.prompts.persona %}  persona: {{ spec.prompts.persona | tojson }}
{% endif %}
tools:
{% for tool in tools %}  - name: {{ tool.name }}
    enabled: {{ tool.enabled | tojson }}
{% endfor %}
# Context-window management (runtime knob). truncate = keep system + recent turns;
# summarize = fold older turns via the `compaction` role; none = off.
# Unset max_context_tokens means no limit (default behaves like a plain loop).
context:
  strategy: truncate
  keep_last_turns: 6
  # max_context_tokens: 8000

# Loop paradigms (runtime roster). `enabled` lists the selectable paradigms; pick
# one per turn via `run --mode <name>` (CLI) or the web dropdown. `default` is
# used when none is chosen. To add your own: write a function decorated with
# @register_paradigm("name") under harness/paradigms/, then add "name" here.
paradigms:
  enabled: [{{ spec.paradigms | join(", ") }}]
  default: {{ spec.paradigms[0] }}

observability:
  trace: {{ observability.trace | tojson }}
  trace_dir: {{ observability.trace_dir }}

# Per-run guardrails — set any combination; the loop stops at the first one hit.
# Available limits: max_steps (rounds), max_seconds, max_tokens, max_cost_usd.
budget:
{% if spec.budget.max_steps is not none %}  max_steps: {{ spec.budget.max_steps }}
{% endif %}{% if spec.budget.max_seconds is not none %}  max_seconds: {{ spec.budget.max_seconds }}
{% endif %}{% if spec.budget.max_cost_usd is not none %}  max_cost_usd: {{ spec.budget.max_cost_usd }}
{% endif %}  # max_tokens: 100000      # total prompt+completion tokens across the run
  # max_cost_usd: 1.00       # needs per-1K-token prices on the llm profile above
{% if spec.mcp.enabled %}
# MCP tool servers (runtime knob — add/remove without regenerating). Each server
# uses stdio (set `command`) OR remote Streamable HTTP (set `url`). Secrets are
# referenced by env-var NAME only, never values. A discovered tool is offered to
# the model only when allowlisted in `tools:` above as `<server>__<tool>`.
mcp:
  servers: []
  # - name: filesystem          # stdio: launched as a subprocess
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-filesystem", "/data"]
  #   env: []                    # env-var NAMES to inject into the subprocess
  # - name: github               # remote Streamable HTTP
  #   url: https://api.example.com/mcp/
  #   auth_env: GITHUB_MCP_TOKEN  # env-var NAME holding a bearer token
{% endif %}
