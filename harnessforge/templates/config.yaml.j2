# Runtime configuration for {{ project_slug }} (generated by HarnessForge).
# Secrets are NEVER stored here — only env-var NAMES. Real values live in .env.
version: "{{ spec.version }}"
project_slug: {{ project_slug }}

llms:
{% for profile in llms %}  - name: {{ profile.name }}
    model: {{ profile.model | tojson }}   # required: your model id (e.g. gpt-4o); empty = configure before chatting
    api_key_env: {{ profile.api_key_env }}
{% if profile.base_url_env %}    base_url_env: {{ profile.base_url_env }}
{% endif %}    # Optional sampling knobs (sent ONLY when set; leave unset to use the model
    # default). Reasoning models (GPT-5.x / o-series) reject `temperature` and want
    # it omitted; non-reasoning models reject `reasoning_effort`.
    # temperature: 0.7          # unset = provider default (~1.0 for chat models)
    # max_tokens: 1024
    # reasoning_effort: medium  # reasoning models only: none/minimal/low/medium/high/xhigh
    # Optional cost accounting. Required if you use the budget max_cost condition —
    # otherwise cost stays 0 and the cost limit never triggers. Price per 1,000,000 tokens,
    # in your own currency (fill in your local price).
    # input_cost_per_million: 0.0
    # output_cost_per_million: 0.0
{% endfor %}
# Map roles to profile names above. `generation` is the main loop; `compaction`
# (optional) is used by context summarize; `title` (optional) names sessions in
# the web sidebar{% if spec.memory.enabled %}; `memory` (optional) is the memory manager that consolidates
# long-term memory{% endif %}. All optional roles fall back to the first profile if unset.
roles:
{% for role, target in roles.items() %}  {{ role }}: {{ target }}
{% endfor %}{% if "compaction" not in roles %}  # compaction: {{ (llms[0].name if llms else "default") }}
{% endif %}{% if "title" not in roles %}  # title: {{ (llms[0].name if llms else "default") }}        # web session-title model (a small/cheap model is ideal)
{% endif %}{% if spec.memory.enabled and "memory" not in roles %}  # memory: {{ (llms[0].name if llms else "default") }}       # long-term memory manager (used by `memory consolidate`)
{% endif %}
prompts:
{% if spec.prompts.system %}  system: {{ spec.prompts.system | tojson }}
{% endif %}  # Always-apply project rules: markdown files injected into EVERY system
  # prompt (the open AGENTS.md / CLAUDE.md / .cursor rules pattern). Drop a file,
  # list it here — no regeneration needed. A missing file is skipped. A CLAUDE.md
  # at the project root is auto-recognized even if unlisted (AGENTS.md is not — it's
  # the harness dev guide, not a runtime rule).
  rules_files: {{ spec.prompts.rules_files | tojson }}

tools:
{% for tool in tools %}  - name: {{ tool.name }}
    enabled: {{ tool.enabled | tojson }}
{% endfor %}  - name: ask_question
    enabled: true    # built-in: pause and ask the user a clarifying question (safe; off in non-interactive runs)
{% if mcp_tool_allowlist %}  # MCP tools (allowlist): a `<server>__*` wildcard enables ALL of that server's
  # tools (read + mutating/shell). To narrow it, replace the wildcard with explicit
  # `<server>__<tool>` lines, or toggle individual tools on the web Tools panel.
{% for entry in mcp_tool_allowlist %}  - name: {{ entry.name }}
    enabled: {{ entry.enabled | tojson }}
{% endfor %}{% endif %}{% if spec.skills.enabled %}  - name: read_skill
    enabled: true   # standard Agent Skills: read a SKILL.md body on demand (low-risk)
{% endif %}{% if spec.memory.enabled %}  - name: memory_read
    enabled: true    # long-term memory: read your cross-session note (low-risk)
  - name: memory_append
    enabled: true    # long-term memory: append a durable note (writes a local file)
  - name: memory_write
    enabled: true    # long-term memory: replace the whole note (writes a local file)
{% endif %}
# HITL tool confirmation (opt-in guardrail; default off). Which tools must pause
# for your OK before they run — a safety net against the agent fat-fingering a
# dangerous tool. One of: none (default, never ask), high (only risk=high tools
# like shell/file-writes), all (every tool, read-only included), or an explicit
# list of tool names (e.g. [shell, write_file]). On a prompt you pick: allow once
# / reject / allow for this session / always allow (the last rewrites this line).
# A GUARDRAIL, not a security boundary — code you own can bypass it; real
# isolation is Docker. Non-interactive runs (pipe / CI / --mock) and a stopped or
# disconnected web run reject by default (fail-closed).
confirm: {{ confirm_default }}

# Context-window management (runtime knob). A condition in `triggers` decides
# WHEN to compact (combined by `combine`: or/and); `strategy` decides HOW.
# truncate = keep system + recent turns; summarize = fold older turns via the
# `compaction` role; none = off. Built-in conditions: max_tokens (estimated
# prompt tokens) and max_turns (user turns). Empty triggers = never compact.
# Add your own with @register_condition / @register_strategy (see harness/context.py).
{% set sctx = spec.context or {} %}{% set triggers = sctx.get("triggers", {"max_tokens": 192000}) %}context:
  strategy: {{ sctx.get("strategy", "summarize") }}
  keep_last_turns: {{ sctx.get("keep_last_turns", 6) }}
  combine: {{ sctx.get("combine", "or") }}   # or = any trigger fires; and = all must fire
  triggers:
{% for name, value in triggers.items() %}    {{ name }}: {{ value }}
{% endfor %}{% if not triggers %}    {}
{% endif %}    # max_turns: 40   # also compact after N user turns (combine decides and/or)

# Loop paradigms (runtime roster). `enabled` lists the selectable paradigms; pick
# one per turn via `run --mode <name>` (CLI) or the web dropdown. `default` is
# used when none is chosen. To add your own: write a function decorated with
# @register_paradigm("name") under harness/paradigms/, then add "name" here.
paradigms:
  enabled: [{{ spec.paradigms | join(", ") }}]
  default: {{ spec.paradigms[0] }}

observability:
  trace: {{ observability.trace | tojson }}
  trace_dir: {{ observability.trace_dir }}

# Conversation persistence (resume). When enabled (default), each run saves the
# message body to <dir>/<id>.json so `run --continue` / `run --resume <id>` /
# `chat` / the web session can pick it up. Stores message text only — NEVER
# secrets (keys stay in .env). enabled: false = no persistence (single-shot runs).
# auto_title (web only): summarize a session's first message into a short title
# (via the `title` role) for the web sidebar; the CLI never auto-titles.
# Stop/continue: Stop (web button) / Ctrl-C (CLI) cuts the model off and saves the
# partial conversation (status "interrupted") so the next message just continues —
# the model sees what was already done. Each completed step is also write-ahead
# checkpointed (status "running") via an atomic single-file write, so a hard crash
# still leaves a resumable session; on resume a dangling tool call is auto-repaired.
sessions:
  enabled: true
  dir: .harness/sessions
  auto_title: true

# Per-run guardrails (reset each turn). Each entry in `conditions` is a limit;
# `combine` decides when to stop: or = any limit hit (safe default), and = all
# must hit. Built-ins (harness/budget.py): max_steps (rounds), max_seconds,
# max_tokens (prompt+completion), max_cost (needs per-1M prices on the profile).
# A bare number is a cumulative threshold; use {threshold, window_seconds} to make
# it a RATE over a tumbling window. Add your own with @register_budget_condition.
# Empty conditions = no budget. Persistent day/week/month quotas are a v1+ add-on.
budget:
  combine: {{ spec.budget.combine }}   # or = stop at first limit; and = stop only when all fire
{% if spec.budget.conditions %}  conditions:
{% for name, cond in spec.budget.conditions.items() %}{% set thr = (cond.threshold | int) if cond.threshold == (cond.threshold | int) else cond.threshold %}{% if cond.window_seconds is not none %}{% set wnd = (cond.window_seconds | int) if cond.window_seconds == (cond.window_seconds | int) else cond.window_seconds %}    {{ name }}: {threshold: {{ thr }}, window_seconds: {{ wnd }}}
{% else %}    {{ name }}: {{ thr }}
{% endif %}{% endfor %}{% else %}  conditions: {}
{% endif %}    # max_tokens: {threshold: 50000, window_seconds: 60}   # rate: 50k tokens / 60s
    # max_cost: 1.00       # cumulative; needs per-1M-token prices on the profile above

# Runtime extension points (optional). `extensions` imports your own modules at
# startup so their @register_* run (custom tools / paradigms / budget & context
# conditions / memory backends that live outside the built-in files). `hooks`
# mounts a Hooks subclass (logging / guardrails / redaction / HITL) by dotted
# path — the CLI and web load it automatically. See harness/extensions.py + AGENTS.md.
extensions: []
# hooks: "{{ project_slug }}.harness.hooks:Hooks"   # "package.module:ClassName"
{% if spec.mcp.enabled %}
# MCP tool servers (runtime knob — add/remove without regenerating, or use the
# web "MCP" tab). Each server uses stdio (set `command`) OR remote Streamable HTTP
# / SSE (set `url`; `transport: http` default, `sse` for older servers). Secrets
# are referenced by env-var NAME only, never values. A discovered tool is offered
# to the model only when allowlisted in `tools:` above as `<server>__<tool>`. On
# the CLI a server launches only when ≥1 of its tools is enabled; the web server
# connects every configured server (so its MCP page shows live status) and offers
# only allowlisted tools. `safe_tools` marks read-only tools so read-only
# paradigms (plan/ask) may use them.
mcp:
{% if mcp_servers %}  servers:
{% for s in mcp_servers %}    - name: {{ s.name }}
{% if s.get("description") %}      description: {{ s.description | tojson }}
{% endif %}{% if s.get("command") %}      command: {{ s.command }}
      args: {{ s.args | tojson }}
{% if s.get("env") %}      env: {{ s.env | tojson }}            # env-var NAMES injected into the subprocess
{% endif %}{% endif %}{% if s.get("url") %}      url: {{ s.url }}
{% if s.get("auth_env") %}      auth_env: {{ s.auth_env }}        # env-var NAME holding a bearer token
{% endif %}{% endif %}{% if s.get("safe_tools") %}      safe_tools: {{ s.safe_tools | tojson }}
{% endif %}{% endfor %}{% else %}  servers: []
{% endif %}  connect_timeout_seconds: 120  # per-server startup timeout; first uvx/npx cold starts can be slow on Windows
  # Add more from the catalog (`harnessforge new --mcp-server <name>`) or paste any
  # MCP marketplace block here (Smithery / Glama / MCP.so / official Registry).
  # Remote (SaaS, e.g. Composio) servers use `url` + `auth_env` instead of command.
{% endif %}{% if spec.skills.enabled %}
# Standard Agent Skills (SKILL.md). `dirs` is where to discover <dir>/<name>/SKILL.md.
# A skill's name+description is injected into the system prompt; the model reads the
# full SKILL.md on demand (the read_skill tool above, or a file tool). Drop a skill in
# skills/<name>/SKILL.md to add one. Add .claude/skills / .cursor/skills to share.
skills:
  dirs: ["skills"]
{% endif %}{% if spec.memory.enabled %}
# Cross-session long-term memory: a small self-maintained note injected into every
# system prompt + read/write tools the agent calls (memory_read/append/write in
# `tools:` above). `backend` names a registered backend (built-in: file). The note
# lives at `path` (under .harness/, gitignored, never holds secrets). Memory is a
# few notes the agent curates on purpose — distinct from RAG (corpus retrieval).
# Add your own backend with @register_memory (see harness/memory.py), then set
# `backend:` to its name.
memory:
  backend: file
  path: .harness/memory.md
  inject_max_chars: 4000   # cap injected note size (keeps the prompt thin)
  read_only: false         # true = only the read tool (the agent can't write memory)
  policy: null             # optional: what/when to remember — injected to shape how the agent curates memory
  auto_consolidate: false  # true = condense an oversized note at chat-session end (uses the memory role, never the reply path)
{% endif %}
